page 14 (
    name: Purchase Register
    alias: PURCHASE-REGISTER
    title: Purchase Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function printPurchase(purchaseNo) {
                $s('P200_PURCHASE_NO', purchaseNo);
                openModal('purchase-print');
                apex.region('purchase-print').refresh();
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region purchase-print-report (
        name: PURCHASE PRINT REPORT
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_total NUMBER := 0;
                
                BEGIN
                
                    FOR h IN
                    (
                        SELECT P.PURCHASE_CODE,
                               TO_CHAR(P.PURCHASE_DATE,'DD-MON-YYYY') PURCHASE_DATE,
                               S.SUPPLIER_NAME,
                               S.MOBILE_NO,
                               S.ADDRESS,
                               P.REMARKS
                        FROM TRN_PURCHASE_MST P
                        JOIN MST_SUPPLIER S
                          ON S.SUPPLIER_NO = P.SUPPLIER_NO
                        WHERE P.PURCHASE_NO = :P200_PURCHASE_NO
                    )
                    LOOP
                
                        HTP.P('
                
                <style>
                
                body{
                    font-family:Segoe UI,Arial,sans-serif;
                    font-size:13px;
                    margin:25px;
                    color:#222;
                }
                
                .toolbar{
                    text-align:right;
                    margin-bottom:20px;
                }
                
                .btn{
                    border:none;
                    padding:10px 20px;
                    border-radius:5px;
                    cursor:pointer;
                    color:#fff;
                    font-size:14px;
                    font-weight:600;
                    margin-left:5px;
                }
                
                .print-btn{
                    background:#1f4e79;
                }
                
                .close-btn{
                    background:#6b7280;
                }
                
                .company{
                    text-align:center;
                    border-bottom:3px solid #1f4e79;
                    padding-bottom:10px;
                }
                
                .company h1{
                    margin:0;
                    color:#1f4e79;
                    font-size:30px;
                }
                
                .company p{
                    margin:3px;
                }
                
                .title{
                    text-align:center;
                    margin:20px 0;
                }
                
                .title span{
                    border:2px solid #1f4e79;
                    padding:8px 30px;
                    color:#1f4e79;
                    font-size:22px;
                    font-weight:bold;
                }
                
                .info{
                    width:100%;
                    border-collapse:collapse;
                    margin-bottom:20px;
                }
                
                .info td{
                    border:1px solid #ddd;
                    padding:8px;
                }
                
                .detail{
                    width:100%;
                    border-collapse:collapse;
                }
                
                .detail th{
                    background:#1f4e79;
                    color:#fff;
                    padding:10px;
                    border:1px solid #ddd;
                }
                
                .detail td{
                    border:1px solid #ddd;
                    padding:8px;
                }
                
                .totalbox{
                    width:300px;
                    float:right;
                    margin-top:20px;
                    border-collapse:collapse;
                }
                
                .totalbox td{
                    border:1px solid #ccc;
                    padding:10px;
                }
                
                .footer{
                    margin-top:100px;
                }
                
                .sign{
                    width:30%;
                    display:inline-block;
                    text-align:center;
                }
                
                .sign hr{
                    border:1px solid black;
                }
                
                .watermark{
                    position:fixed;
                    top:45%;
                    left:20%;
                    font-size:90px;
                    color:#f3f3f3;
                    transform:rotate(-30deg);
                    z-index:-1;
                }
                
                @media print{
                
                    .toolbar{
                        display:none;
                    }
                
                    body{
                        margin:0;
                    }
                
                }
                
                </style>
                
                <div class="toolbar">
                
                    <button class="btn print-btn"
                            onclick="window.print();">
                        🖨 Print
                    </button>
                
                    <button class="btn close-btn"
                            onclick="apex.navigation.dialog.close(true);">
                        ✖ Close
                    </button>
                
                </div>
                
                <div class="watermark">
                    PURCHASE
                </div>
                
                <div class="company">
                    <h1>YOUR COMPANY NAME</h1>
                    <p>Dhaka, Bangladesh</p>
                    <p>Phone: 017XXXXXXXX</p>
                </div>
                
                <div class="title">
                    <span>PURCHASE VOUCHER</span>
                </div>
                
                <table class="info">
                
                <tr>
                    <td><b>Purchase No</b></td>
                    <td>'
                    || h.PURCHASE_CODE ||
                    '</td>
                
                    <td><b>Date</b></td>
                    <td>'
                    || h.PURCHASE_DATE ||
                    '</td>
                </tr>
                
                <tr>
                    <td><b>Supplier</b></td>
                    <td>'
                    || h.SUPPLIER_NAME ||
                    '</td>
                
                    <td><b>Mobile</b></td>
                    <td>'
                    || h.MOBILE_NO ||
                    '</td>
                </tr>
                
                <tr>
                    <td><b>Address</b></td>
                    <td colspan="3">'
                    || NVL(h.ADDRESS,'') ||
                    '</td>
                </tr>
                
                </table>
                
                <table class="detail">
                
                <tr>
                    <th>SL</th>
                    <th>Code</th>
                    <th>Product Name</th>
                    <th>Qty</th>
                    <th>Rate</th>
                    <th>Amount</th>
                </tr>
                
                ');
                
                    END LOOP;
                
                
                    FOR d IN
                    (
                        SELECT ROW_NUMBER() OVER
                               (
                                   ORDER BY D.PURCHASE_DTL_NO
                               ) SL,
                
                               P.PRODUCT_CODE,
                               P.PRODUCT_NAME,
                               D.PURCHASE_QTY,
                               D.PURCHASE_RATE,
                               D.TOTAL_AMOUNT
                
                        FROM TRN_PURCHASE_DTL D
                        JOIN MST_PRODUCT P
                          ON P.PRODUCT_NO = D.PRODUCT_NO
                        WHERE D.PURCHASE_NO = :P200_PURCHASE_NO
                    )
                    LOOP
                
                        v_total := v_total + NVL(d.TOTAL_AMOUNT,0);
                
                        HTP.P('
                
                <tr>
                
                    <td align="center">'
                    || d.SL ||
                    '</td>
                
                    <td>'
                    || d.PRODUCT_CODE ||
                    '</td>
                
                    <td>'
                    || d.PRODUCT_NAME ||
                    '</td>
                
                    <td align="right">'
                    || d.PURCHASE_QTY ||
                    '</td>
                
                    <td align="right">'
                    || d.PURCHASE_RATE ||
                    '</td>
                
                    <td align="right">'
                    || TO_CHAR(d.TOTAL_AMOUNT,
                              '999G999G999D99')
                    || '</td>
                
                </tr>
                
                ');
                
                    END LOOP;
                
                
                    HTP.P('
                
                </table>
                
                <table class="totalbox">
                
                <tr>
                    <td>
                        <b>Grand Total</b>
                    </td>
                
                    <td align="right">
                        <b>'
                        || TO_CHAR(v_total,
                                   '999G999G999D99')
                        || '</b>
                    </td>
                
                </tr>
                
                </table>
                
                <div style="clear:both"></div>
                
                <br><br>
                
                <div>
                    <b>Remarks :</b>
                    Goods received in good condition.
                </div>
                
                <div class="footer">
                
                    <div class="sign">
                        <hr>
                        Prepared By
                    </div>
                
                    <div class="sign">
                        <hr>
                        Checked By
                    </div>
                
                    <div class="sign">
                        <hr>
                        Approved By
                    </div>
                
                </div>
                
                ');
                
                END;
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: purchase-print
        }
        config {
            buildOption: @commented-out
        }
    )

    region register (
        name: Delivery Challan Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       P.PURCHASE_NO,
                
                       P.PURCHASE_CODE,
                
                       P.PURCHASE_DATE,
                
                       S.SUPPLIER_CODE,
                
                       S.SUPPLIER_NAME,
                
                       S.MOBILE_NO,
                
                       NVL(
                           (
                               SELECT SUM(D.PURCHASE_QTY)
                               FROM TRN_PURCHASE_DTL D
                               WHERE D.PURCHASE_NO = P.PURCHASE_NO
                           ),
                           0
                       ) TOTAL_QTY,
                
                       NVL(
                           (
                               SELECT SUM(D.TOTAL_AMOUNT)
                               FROM TRN_PURCHASE_DTL D
                               WHERE D.PURCHASE_NO = P.PURCHASE_NO
                           ),
                           0
                       ) TOTAL_AMOUNT,
                
                       CASE P.APPROVAL_STATUS
                           WHEN 'P' THEN
                               '<span style="
                                    background:#f59e0b;
                                    color:white;
                                    padding:3px 8px;
                                    border-radius:10px;">
                                    Pending
                                </span>'
                
                           WHEN 'A' THEN
                               '<span style="
                                    background:#22c55e;
                                    color:white;
                                    padding:3px 8px;
                                    border-radius:10px;">
                                    Approved
                                </span>'
                       END APPROVAL_STATUS,
                
                       P.CREATED_BY,
                       P.CREATED_DATE,
                
                       P.APPROVED_BY,
                       P.APPROVED_DATE,
                
                    --    '<button class="t-Button t-Button--primary t-Button--small"
                    --         onclick="printPurchase('||P.PURCHASE_NO||')">
                    --         <span class="fa fa-print"></span>
                    --      </button>' 
                         NULL PRINT_BTN
                
                FROM TRN_PURCHASE_MST P
                JOIN MST_SUPPLIER S
                  ON S.SUPPLIER_NO = P.SUPPLIER_NO
                
                ORDER BY P.PURCHASE_NO DESC;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 23387565586569172735
        }

