    process challan-populate (
        name: CHALLAN_POPULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_DATA CLOB;
                BEGIN
                
                    SELECT JSON_ARRAYAGG(
                             JSON_OBJECT(
                
                               'SL_NUMBER' VALUE ROWNUM,
                
                               'INVOICE_DTL_NO' VALUE D.INVOICE_DTL_NO,
                               'ORDER_DTL_NO' VALUE D.ORDER_DTL_NO,
                
                               'PRODUCT_NO' VALUE D.PRODUCT_NO,
                               'PRODUCT_CODE' VALUE PR.PRODUCT_CODE,
                               'PRODUCT_NAME' VALUE PR.PRODUCT_NAME,
                               'DESCRIPTION' VALUE PR.DESCRIPTION,
                               'BRAND_NO' VALUE PR.BRAND_NO,
                
                               'UOM_NO' VALUE D.UOM_NO,
                
                               'PACK_QTY' VALUE D.PACK_QTY,
                
                               --------------------------------------------------
                               -- Invoice Qty
                               --------------------------------------------------
                               'ORDER_QTY' VALUE D.ORDER_QTY,
                
                               'INVOICE_QTY' VALUE D.SALES_QTY,
                
                               'PREVIOUS_DELIVERY_QTY'
                                    VALUE NVL(D.DELIVERED_QTY,0),
                
                               'BALANCE_QTY'
                                    VALUE (D.SALES_QTY - NVL(D.DELIVERED_QTY,0)),
                
                               'DELIVERY_QTY'
                                    VALUE (D.SALES_QTY - NVL(D.DELIVERED_QTY,0)),
                
                               --------------------------------------------------
                               -- Base Qty
                               --------------------------------------------------
                               'BASE_QTY'
                                    VALUE ((D.SALES_QTY - NVL(D.DELIVERED_QTY,0))
                                           * NVL(D.PACK_QTY,1)),
                
                               'PREVIOUS_DELIVERY_BASE_QTY'
                                    VALUE (NVL(D.DELIVERED_QTY,0)
                                           * NVL(D.PACK_QTY,1)),
                
                               'BALANCE_BASE_QTY'
                                    VALUE ((D.SALES_QTY - NVL(D.DELIVERED_QTY,0))
                                           * NVL(D.PACK_QTY,1)),
                
                               --------------------------------------------------
                               -- Rate
                               --------------------------------------------------
                               'SALES_RATE' VALUE D.SALES_RATE,
                
                               'BASE_RATE' VALUE D.BASE_RATE,
                
                               --------------------------------------------------
                               -- Amount
                               --------------------------------------------------
                               'TOTAL_AMOUNT'
                                    VALUE ((D.SALES_QTY - NVL(D.DELIVERED_QTY,0))
                                           * D.SALES_RATE)
                
                             )
                             RETURNING CLOB
                           )
                      INTO V_DATA
                      FROM TRN_SALES_INVOICE_DTL D
                      JOIN MST_PRODUCT PR
                        ON PR.PRODUCT_NO = D.PRODUCT_NO
                     WHERE D.INVOICE_NO = APEX_APPLICATION.G_X01
                       AND NVL(D.SALES_QTY,0) > NVL(D.DELIVERED_QTY,0);
                
                    IF V_DATA IS NULL THEN
                        V_DATA := '[]';
                    END IF;
                
                    HTP.PRN(V_DATA);
                
                EXCEPTION
                    WHEN OTHERS THEN
                        HTP.PRN('[]');
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 11193744205550922919
        }
    )

    process customer-return-detail-save-interactive-grid-data (
        name: DELIVERY DTL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @customer-return-detail
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    ------------------------------------------------
                    -- Header Validation
                    ------------------------------------------------
                
                    IF :P105_INVOICE_NO IS NULL THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select invoice.'
                        );
                
                    END IF;
                
                    ------------------------------------------------
                    -- Qty Validation
                    ------------------------------------------------
                
                    IF NVL(:DELIVERY_QTY,0) <= 0 THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Delivery quantity must be greater than zero.'
                        );
                
                    END IF;
                
                    ------------------------------------------------
                    -- Balance Validation
                    ------------------------------------------------
                
                   IF :DELIVERY_QTY > :BALANCE_QTY THEN
                
                    RAISE_APPLICATION_ERROR(
                        -20001,
                        'Delivery quantity exceeds balance quantity.'
                    );
                
                END IF;
                    ------------------------------------------------
                    -- Insert
                    ------------------------------------------------
                
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        INSERT INTO TRN_DELIVERY_DTL
                        (
                            DELIVERY_DTL_NO,
                            DELIVERY_NO,
                            INVOICE_DTL_NO,
                            ORDER_DTL_NO,
                            PRODUCT_NO,
                            UOM_NO,
                            PACK_QTY,
                            ORDER_QTY,
                            INVOICE_QTY,
                            PREVIOUS_DELIVERY_QTY,
                            DELIVERY_QTY,
                            BALANCE_QTY,
                            BASE_QTY,
                            SALES_RATE,
                            BASE_RATE,
                            TOTAL_AMOUNT,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_DELIVERY_DTL_NO.NEXTVAL,
                            :P105_DELIVERY_NO,
                            :INVOICE_DTL_NO,
                            :ORDER_DTL_NO,
                            :PRODUCT_NO,
                            :UOM_NO,
                            :PACK_QTY,
                            :ORDER_QTY,
                            :INVOICE_QTY,
                            :PREVIOUS_DELIVERY_QTY,
                            :DELIVERY_QTY,
                            :BALANCE_QTY,
                            :BASE_QTY,
                            :SALES_RATE,
                            :BASE_RATE,
                            NVL(:DELIVERY_QTY,0) * NVL(:SALES_RATE,0),
                            :REMARKS,
                            :APP_USER,
                            SYSDATE
                        )
                        RETURNING DELIVERY_DTL_NO
                        INTO :DELIVERY_DTL_NO;
                
                    ------------------------------------------------
                    -- Update
                    ------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        UPDATE TRN_DELIVERY_DTL
                           SET UOM_NO        = :UOM_NO,
                               PACK_QTY      = :PACK_QTY,
                               ORDER_QTY     = :ORDER_QTY,
                               INVOICE_QTY   = :INVOICE_QTY,
                               DELIVERY_QTY  = :DELIVERY_QTY,
                               BALANCE_QTY   = :BALANCE_QTY,
                               BASE_QTY      = :BASE_QTY,
                               SALES_RATE    = :SALES_RATE,
                               BASE_RATE     = :BASE_RATE,
                               TOTAL_AMOUNT  = NVL(:DELIVERY_QTY,0) * NVL(:SALES_RATE,0),
                               REMARKS       = :REMARKS,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE DELIVERY_DTL_NO = :DELIVERY_DTL_NO;
                
                    ------------------------------------------------
                    -- Delete
                    ------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        IF :P105_APPROVAL_STATUS = 'A' THEN
                
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Approved delivery cannot be deleted.'
                            );
                
                        END IF;
                
                        DELETE
                          FROM TRN_DELIVERY_DTL
                         WHERE DELIVERY_DTL_NO = :DELIVERY_DTL_NO;
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 10327111591808918532
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process delete-delivery-challan (
        name: DELETE DELIVERY CHALLAN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                
                    IF :P105_APPROVAL_STATUS = 'A' THEN
                    RAISE_APPLICATION_ERROR(
                        -20001,
                        'Approved delivery cannot be deleted.'
                    );
                END IF;
                     
                    IF :P105_DELIVERY_NO IS NOT NULL THEN
                
                        DELETE
                          FROM TRN_DELIVERY_DTL
                         WHERE DELIVERY_NO = :P105_DELIVERY_NO;
                
                        DELETE
                          FROM TRN_DELIVERY_MST
                         WHERE DELIVERY_NO = :P105_DELIVERY_NO;
                
                        :P105_DELIVERY_NO := NULL;
                
                        apex_application.g_print_success_message :=
                            'Delivery deleted successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 10654189275544424047
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

