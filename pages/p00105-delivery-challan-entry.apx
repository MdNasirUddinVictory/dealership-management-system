    region customer-return-detail (
        name: DELIVERY DTL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT
                       D.DELIVERY_DTL_NO,
                
                       D.INVOICE_DTL_NO,
                
                       D.ORDER_DTL_NO,
                
                       D.PRODUCT_NO,
                
                       P.PRODUCT_CODE,
                
                       P.PRODUCT_NAME,
                
                       P.DESCRIPTION,
                
                       P.BRAND_NO,
                
                       D.UOM_NO,
                
                       U.UOM_NAME,
                
                       D.PACK_QTY,
                
                       D.ORDER_QTY,
                
                       D.INVOICE_QTY,
                
                       D.BASE_QTY,
                
                       D.BASE_RATE,
                
                       NVL(D.PREVIOUS_DELIVERY_QTY,0)
                           PREVIOUS_DELIVERY_QTY,
                
                       D.BALANCE_QTY,
                
                       D.DELIVERY_QTY,
                
                       D.SALES_RATE,
                
                       D.TOTAL_AMOUNT,
                
                       D.REMARKS
                
                FROM TRN_DELIVERY_DTL D
                
                JOIN MST_PRODUCT P
                  ON P.PRODUCT_NO=D.PRODUCT_NO
                
                LEFT JOIN MST_UOM U
                  ON U.UOM_NO=D.UOM_NO
                
                WHERE D.DELIVERY_NO=:P105_DELIVERY_NO
                
                ORDER BY D.DELIVERY_DTL_NO);
                ```
            pageItemsToSubmit: [
                P105_INVOICE_NO
                P105_DELIVERY_NO
            ]
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: regionBody
        }
