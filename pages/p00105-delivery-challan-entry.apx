page 105 (
    name: Delivery Challan Entry
    alias: DELIVERY-CHALLAN-ENTRY
    title: Delivery Challan Entry
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function populate() {
            
                if (!$v('P105_INVOICE_NO')) {
                    apex.message.alert('Please Select Invoice!');
                    return;
                }
            
                var model = apex.region("customer-return")
                                .widget()
                                .interactiveGrid("getViews", "grid")
                                .model;
            
                // Grid already contains data
                if (model.getTotalRecords() > 0) {
                    apex.message.alert(
                        'Delivery details already exist.'
                    );
                    return;
                }
            
                apex.server.process(
                    'CHALLAN_POPULATE',
                    {
                        x01: $v('P105_INVOICE_NO')
                    },
                    {
                        success: function (pData) {
            
                            var json = JSON.parse(pData);
            
                            // No data found
                            if (!json || json.length === 0) {
                                apex.message.alert(
                                    'No pending delivery items found.'
                                );
                                return;
                            }
            
                            for (var key in json) {
            
                                if (json.hasOwnProperty(key)) {
            
                                    var rec = model.insertNewRecord();
            
                                    if (json[key].PRODUCT_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "PRODUCT_NO",
                                            json[key].PRODUCT_NO.toString()
                                        );
                                    }
            
                                    if (json[key].ORDER_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "ORDER_QTY",
                                            json[key].ORDER_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].INVOICE_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "INVOICE_QTY",
                                            json[key].INVOICE_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].PREVIOUS_DELIVERY_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "PREVIOUS_DELIVERY_QTY",
                                            json[key].PREVIOUS_DELIVERY_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].BALANCE_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "BALANCE_QTY",
                                            json[key].BALANCE_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].SALES_RATE) {
                                        model.setRecordValue(
                                            rec,
                                            "SALES_RATE",
                                            json[key].SALES_RATE.toString()
                                        );
                                    }
            
                                    if (json[key].PRODUCT_NAME) {
                                        model.setRecordValue(
                                            rec,
                                            "PRODUCT_NAME",
                                            json[key].PRODUCT_NAME
                                        );
                                    }
            
                                    if (json[key].PRODUCT_CODE) {
                                        model.setRecordValue(
                                            rec,
                                            "PRODUCT_CODE",
                                            json[key].PRODUCT_CODE
                                        );
                                    }
            
                                    if (json[key].INVOICE_DTL_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "INVOICE_DTL_NO",
                                            json[key].INVOICE_DTL_NO.toString()
                                        );
                                    }
            
                                    if (json[key].ORDER_DTL_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "ORDER_DTL_NO",
                                            json[key].ORDER_DTL_NO.toString()
                                        );
                                    }
            
                                                            if (json[key].UOM_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "UOM_NO",
                                            json[key].UOM_NO.toString()
                                        );
                                    }
            
                                    if (json[key].PACK_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "PACK_QTY",
                                            json[key].PACK_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].BASE_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "BASE_QTY",
                                            json[key].BASE_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].BASE_RATE) {
                                        model.setRecordValue(
                                            rec,
                                            "BASE_RATE",
                                            json[key].BASE_RATE.toString()
                                        );
                                    }
            
                                    if (json[key].DELIVERY_QTY) {
                                        model.setRecordValue(
                                            rec,
                                            "DELIVERY_QTY",
                                            json[key].DELIVERY_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].TOTAL_AMOUNT) {
                                        model.setRecordValue(
                                            rec,
                                            "TOTAL_AMOUNT",
                                            json[key].TOTAL_AMOUNT.toString()
                                        );
                                    }
            
                                    if (json[key].DESCRIPTION) {
                                        model.setRecordValue(
                                            rec,
                                            "DESCRIPTION",
                                            json[key].DESCRIPTION
                                        );
                                    }
            
                                    if (json[key].BRAND_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "BRAND_NO",
                                            json[key].BRAND_NO.toString()
                                        );
                                    }
                                }
                            }
            
                            apex.message.showPageSuccess(
                                json.length +
                                ' item(s) loaded successfully.'
                            );
                        },
            
                        error: function () {
                            apex.message.alert(
                                'Error while loading delivery data.'
                            );
                        },
            
                        dataType: "text"
                    }
                );
            }
            ```
    }
