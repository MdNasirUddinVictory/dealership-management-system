    region register_1 (
        name: DELIVERY MST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       M.DELIVERY_NO,
                       M.DELIVERY_CODE,
                       M.DELIVERY_DATE,
                       M.INVOICE_NO,
                       I.INVOICE_DATE,
                       M.CUSTOMER_NO,
                       C.CUSTOMER_NAME,
                       C.MOBILE_NO,
                       M.DELIVERY_ADDRESS,
                       M.DELIVERY_PERSON,
                       M.VEHICLE_NO,
                       M.CONTACT_NO,
                
                       M.REMARKS,
                
                       M.APPROVAL_STATUS,
                       M.APPROVED_BY,
                       M.APPROVED_DATE,
                
                       M.CREATED_BY,
                       M.CREATED_DATE,
                
                       M.UPDATED_BY,
                       M.UPDATED_DATE
                
                FROM TRN_DELIVERY_MST M
                LEFT JOIN TRN_SALES_INVOICE_MST I
                       ON I.INVOICE_NO = M.INVOICE_NO
                LEFT JOIN MST_CUSTOMER C
                       ON C.CUSTOMER_NO = M.CUSTOMER_NO
                WHERE M.DELIVERY_NO = :P105_DELIVERY_NO
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: invoice_list
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

