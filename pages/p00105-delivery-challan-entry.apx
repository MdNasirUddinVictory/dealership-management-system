    process process-form-delivery-mst (
        name: Process form DELIVERY MST
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    BEGIN
                
                    IF :P105_INVOICE_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select invoice.'
                        );
                    END IF;
                
                END;
                
                
                    IF :P105_DELIVERY_NO IS NULL THEN
                        -- INSERT
                                :P105_DELIVERY_NO := SEQ_DELIVERY_NO.NEXTVAL;
                        INSERT INTO TRN_DELIVERY_MST (
                            DELIVERY_NO,
                            DELIVERY_CODE,
                            DELIVERY_DATE,
                            INVOICE_NO,
                            CUSTOMER_NO,
                            DELIVERY_ADDRESS,
                            DELIVERY_PERSON,
                            VEHICLE_NO,
                            CONTACT_NO,
                            REMARKS,
                            APPROVAL_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES (
                            :P105_DELIVERY_NO,
                            'DEL-'||LPAD(:P105_DELIVERY_NO,4,'0'),
                            :P105_DELIVERY_DATE,
                            :P105_INVOICE_NO,
                            :P105_CUSTOMER_NO,
                            :P105_DELIVERY_ADDRESS,
                            :P105_DELIVERY_PERSON,
                            :P105_VEHICLE_NO,
                            :P105_CONTACT_NO,
                            :P105_REMARKS,
                            'P',
                            :APP_USER,
                            SYSDATE
                        );
                        apex_application.g_print_success_message :=
                            'Delivery Created Successfully!';
                    
                    ELSE
                        -- UPDATE
                        UPDATE TRN_DELIVERY_MST
                           SET
                               DELIVERY_DATE     = :P105_DELIVERY_DATE,
                               INVOICE_NO        = :P105_INVOICE_NO,
                               CUSTOMER_NO       = :P105_CUSTOMER_NO,
                               DELIVERY_ADDRESS  = :P105_DELIVERY_ADDRESS,
                               DELIVERY_PERSON   = :P105_DELIVERY_PERSON,
                               VEHICLE_NO        = :P105_VEHICLE_NO,
                               CONTACT_NO        = :P105_CONTACT_NO,
                               REMARKS           = :P105_REMARKS,
                               UPDATED_BY        = :APP_USER,
                               UPDATED_DATE      = SYSDATE
                         WHERE DELIVERY_NO = :P105_DELIVERY_NO;
                             apex_application.g_print_success_message :=
                            'Delivery Updated Successfully!';
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10326851552040576604
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

