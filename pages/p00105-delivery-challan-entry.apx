    dynamicAction new_1 (
        name: Delivery quantity exceeds balance
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @customer-return-detail
            columns: DELIVERY_QTY
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.clearErrors();
                    
                    var deliveryQty = parseFloat($v("DELIVERY_QTY")) || 0;
                    var balanceQty  = parseFloat($v("BALANCE_QTY")) || 0;
                    var salesRate   = parseFloat($v("SALES_RATE")) || 0;
                    var packQty     = parseFloat($v("PACK_QTY")) || 1;
                    
                    if (packQty <= 0) {
                        packQty = 1;
                    }
                    
                    if (deliveryQty > balanceQty) {
                    
                        apex.message.alert("Delivery quantity exceeds balance quantity.");
                    
                        $s("DELIVERY_QTY", "");
                        $s("BASE_QTY", "");
                        $s("BASE_RATE", "");
                        $s("TOTAL_AMOUNT", "");
                    
                        return;
                    }
                    
                    /* Dynamic Calculation */
                    
                    var baseQty    = deliveryQty * packQty;
                    var baseRate   = salesRate / packQty;
                    var totalAmt   = deliveryQty * salesRate;
                    
                    $s("BASE_QTY", baseQty.toFixed(3));
                    $s("BASE_RATE", baseRate.toFixed(6));
                    $s("TOTAL_AMOUNT", totalAmt.toFixed(2));
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

