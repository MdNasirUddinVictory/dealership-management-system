page 23 (
    name: Customer Return Print
    alias: CUSTOMER-RETURN-PRINT
    title: Customer Return Print
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region delivery-challan-print (
        name: Customer Return Print
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                v_total         NUMBER := 0;
                v_status_html   VARCHAR2(500);
                
                
                BEGIN
                
                FOR h IN
                (
                    SELECT R.RETURN_CODE,
                           TO_CHAR(R.RETURN_DATE,'DD-MON-YYYY') RETURN_DATE,
                           I.INVOICE_CODE,
                           C.CUSTOMER_NAME,
                           C.MOBILE_NO,
                           C.ADDRESS,
                           R.RETURN_REASON,
                           R.APPROVAL_STATUS
                      FROM TRN_CUSTOMER_RETURN_MST R
                      JOIN TRN_SALES_INVOICE_MST I
                        ON I.INVOICE_NO = R.INVOICE_NO
                      JOIN MST_CUSTOMER C
                        ON C.CUSTOMER_NO = R.CUSTOMER_NO
                     WHERE R.RETURN_NO = :P23_RETURN_NO
                )
                LOOP
                
                    v_status_html :=
                        CASE h.APPROVAL_STATUS
                            WHEN 'P' THEN
                                '<span style="
                                    background:#f59e0b;
                                    color:white;
                                    padding:4px 10px;
                                    border-radius:15px;
                                    font-size:11px;
                                    font-weight:600;">
                                    Pending
                                 </span>'
                
                            WHEN 'A' THEN
                                '<span style="
                                    background:#16a34a;
                                    color:white;
                                    padding:4px 10px;
                                    border-radius:15px;
                                    font-size:11px;
                                    font-weight:600;">
                                    Approved
                                 </span>'
                
                            WHEN 'R' THEN
                                '<span style="
                                    background:#dc2626;
                                    color:white;
                                    padding:4px 10px;
                                    border-radius:15px;
                                    font-size:11px;
                                    font-weight:600;">
                                    Rejected
                                 </span>'
                        END;
                
                    HTP.P('
                
                
                <style>
                
                body{
                    font-family:Segoe UI,Arial,sans-serif;
                    font-size:13px;
                    margin:20px;
                    color:#222;
                }
                
                .toolbar{
                    text-align:right;
                    margin-bottom:10px;
                }
                
                .btn{
                    border:none;
                    padding:5px 10px;
                    border-radius:4px;
                    color:#fff;
                    cursor:pointer;
                    font-size:11px;
                    font-weight:600;
                }
                
                .print-btn{
                    background:#1f4e79;
                }
                
                .close-btn{
                    background:#6b7280;
                }
                
                .company{
                    text-align:center;
                    border-bottom:3px solid #1f4e79;
                    padding-bottom:10px;
                }
                
                .company h1{
                    margin:0;
                    color:#1f4e79;
                    font-size:28px;
                }
                
                .company p{
                    margin:2px;
                }
                
                .title{
                    text-align:center;
                    margin:18px 0;
                }
                
                .title span{
                    border:2px solid #1f4e79;
                    padding:6px 25px;
                    color:#1f4e79;
                    font-size:20px;
                    font-weight:bold;
                }
                
                .info{
                    width:100%;
                    border-collapse:collapse;
                    margin-bottom:18px;
                }
                
                .info td{
                    border:1px solid #ddd;
                    padding:8px;
                }
                
                .detail{
                    width:100%;
                    border-collapse:collapse;
                }
                
                .detail th{
                    background:#1f4e79;
                    color:white;
                    padding:9px;
                    border:1px solid #ddd;
                }
                
                .detail td{
                    border:1px solid #ddd;
                    padding:7px;
                }
                
                .totalbox{
                    width:320px;
                    float:right;
                    margin-top:15px;
                    border-collapse:collapse;
                }
                
                .totalbox td{
                    border:1px solid #ddd;
                    padding:8px;
                }
                
                .footer{
                    margin-top:80px;
                }
                
                .sign{
                    width:30%;
                    display:inline-block;
                    text-align:center;
                }
                
                .sign hr{
                    border:1px solid #444;
                }
                
                .watermark{
                    position:fixed;
                    top:42%;
                    left:22%;
                    font-size:75px;
                    color:#f4f4f4;
                    transform:rotate(-30deg);
                    z-index:-1;
                }
                
                @media print{
                
                    .toolbar{
                        display:none;
                    }
                
                    body{
                        margin:0;
                    }
                
                }
                
                </style>
                
                <div class="toolbar">
                
                <button class="btn print-btn"
                onclick="window.print();">
                🖨 Print </button>
                
                <button class="btn close-btn"
                onclick="apex.navigation.dialog.close(true);">
                ✖ Close </button>
                
                </div>
                
                <div class="watermark">
                RETURN
                </div>
                
                <div class="company">
                
                <h1>YOUR COMPANY NAME</h1>
                
                <p>Dhaka, Bangladesh</p>
                
                <p>Phone : 017XXXXXXXX</p>
                
                </div>
                
                <div class="title">
                <span>CUSTOMER RETURN</span>
                </div>
                
                <table class="info">
                
                <tr>
                <td><b>Return No</b></td>
                <td>'||h.RETURN_CODE||'</td>
                
                <td><b>Date</b></td>
                <td>'||h.RETURN_DATE||'</td>
                </tr>
                
                <tr>
                <td><b>Invoice No</b></td>
                <td>'||h.INVOICE_CODE||'</td>
                
                <td><b>Customer</b></td>
                <td>'||h.CUSTOMER_NAME||'</td>
                </tr>
                
                <tr>
                <td><b>Status</b></td>
                <td>'||v_status_html||'</td>
                
                <td><b>Mobile</b></td>
                <td>'||NVL(h.MOBILE_NO,'')||'</td>
                </tr>
                
                <tr>
                <td><b>Reason</b></td>
                <td>'||NVL(h.RETURN_REASON,'')||'</td>
                
                <td><b>Address</b></td>
                <td>'||NVL(h.ADDRESS,'')||'</td>
                </tr>
                
                </table>
                
                <table class="detail">
                
                <tr>
                <th>SL</th>
                <th>Code</th>
                <th>Product Name</th>
                <th>Invoice Qty</th>
                <th>Return Qty</th>
                <th>Rate</th>
                <th>Amount</th>
                </tr>
                
                ');
                
                END LOOP;
                
                FOR d IN
                (
                    SELECT ROW_NUMBER() OVER
                           (
                               ORDER BY D.RETURN_DTL_NO
                           ) SL,
                
                           P.PRODUCT_CODE,
                
                           P.PRODUCT_NAME,
                
                           D.INVOICE_QTY,
                
                           D.RETURN_QTY,
                
                           D.SALES_RATE,
                
                           D.TOTAL_AMOUNT
                
                      FROM TRN_CUSTOMER_RETURN_DTL D
                
                      JOIN MST_PRODUCT P
                        ON P.PRODUCT_NO = D.PRODUCT_NO
                
                     WHERE D.RETURN_NO = :P23_RETURN_NO
                )
                LOOP
                
                    v_total := v_total + NVL(d.TOTAL_AMOUNT,0);
                
                    HTP.P('
                \```
                
                <tr>
                
                <td align="center">'||d.SL||'</td>
                
                <td>'||d.PRODUCT_CODE||'</td>
                
                <td>'||d.PRODUCT_NAME||'</td>
                
                <td align="right">'||d.INVOICE_QTY||'</td>
                
                <td align="right">'||d.RETURN_QTY||'</td>
                
                <td align="right">'||
                TO_CHAR(d.SALES_RATE,'999G999D99')
                ||'</td>
                
                <td align="right">'||
                TO_CHAR(d.TOTAL_AMOUNT,'999G999G999D99')
                ||'</td>
                
                </tr>
                
                ');
                
                END LOOP;
                
                HTP.P('
                
                
                </table>
                
                <table class="totalbox">
                
                <tr>
                
                <td>
                <b>Total Return Amount</b>
                </td>
                
                <td align="right">
                <b>'||
                TO_CHAR(v_total,'999G999G999D99')
                ||'</b>
                </td>
                
                </tr>
                
                </table>
                
                <div style="clear:both"></div>
                
                <br><br>
                
                <div>
                <b>Remarks :</b>
                Returned goods received from customer.
                </div>
                
                <div class="footer">
                
                <div class="sign">
                <hr>
                Prepared By
                </div>
                
                <div class="sign">
                <hr>
                Received By
                </div>
                
                <div class="sign">
                <hr>
                Approved By
                </div>
                
                </div>
                
                ');
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P23_RETURN_NO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @delivery-challan-print
            slot: regionBody
        }
    )

)

