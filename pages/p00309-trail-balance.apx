    region trial-balance-summary_1 (
        name: Trial Balance Summary
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* ============================================================
                   DEALER INVENTORY & SALES MANAGEMENT SYSTEM
                   HEAD-WISE TRIAL BALANCE REPORT
                   ============================================================ */
                
                DECLARE
                    v_html CLOB := '';
                
                    /* Current Head */
                    v_current_head_no   NUMBER := NULL;
                    v_current_head_code VARCHAR2(100);
                    v_current_head_name VARCHAR2(500);
                
                    /* Head Total */
                    v_head_dr NUMBER := 0;
                    v_head_cr NUMBER := 0;
                
                    /* Grand Total */
                    v_total_dr NUMBER := 0;
                    v_total_cr NUMBER := 0;
                
                    /* Serial */
                    v_row_no NUMBER := 0;
                
                BEGIN
                
                    /* =========================================================
                       REPORT HEADER
                       ========================================================= */
                
                    v_html :=
                    '<div id="trial_balance_report"
                        style="
                            width:100%;
                            background:#fff;
                            font-family:Arial,Helvetica,sans-serif;
                            color:#111;
                            box-sizing:border-box;
                            padding:20px 28px;
                        ">
                
                        <div style="
                            position:relative;
                            min-height:85px;
                        ">
                
                            <!-- LEFT -->
                
                            <div style="
                                position:absolute;
                                left:0;
                                top:0;
                                font-size:12px;
                                line-height:18px;
                                color:#333;
                            ">
                
                                <div style="
                                    font-size:18px;
                                    font-weight:700;
                                    color:#222;
                                    margin-bottom:5px;
                                ">
                                    Dealer Inventory &amp; Sales Management System
                                </div>
                
                                <div>
                                    Trial Balance Report
                                </div>
                
                            </div>
                
                
                            <!-- CENTER -->
                
                            <div style="
                                position:absolute;
                                left:50%;
                                transform:translateX(-50%);
                                text-align:center;
                            ">
                
                                <div style="
                                    width:58px;
                                    height:58px;
                                    margin:auto;
                                    border:2px solid #34495e;
                                    border-radius:10px;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    font-size:25px;
                                    font-weight:700;
                                    color:#34495e;
                                    background:#f8fafc;
                                ">
                                    D
                                </div>
                
                            </div>
                
                
                            <!-- RIGHT -->
                
                            <div style="
                                position:absolute;
                                right:0;
                                top:0;
                                text-align:right;
                                font-size:12px;
                                line-height:18px;
                                color:#333;
                            ">
                
                                <div>
                                    Date:
                                    <b>'
                                    || TO_CHAR(
                                           SYSDATE,
                                           'DD Mon YYYY HH:MI:SS PM'
                                       )
                                    || '</b>
                                </div>
                
                            </div>
                
                        </div>
                
                
                        <!-- REPORT TITLE -->
                
                        <div style="
                            text-align:center;
                            margin-top:5px;
                            margin-bottom:22px;
                        ">
                
                            <div style="
                                font-size:17px;
                                font-weight:700;
                                color:#111;
                            ">
                                Trial Balance
                            </div>
                
                            <div style="
                                margin-top:4px;
                                font-size:12px;
                                font-weight:600;
                                color:#333;
                            ">
                                As on '
                                || TO_CHAR(
                                       TO_DATE(
                                           :P309_TO_DATE,
                                           'MM/DD/YYYY'
                                       ),
                                       'DD/MM/YYYY'
                                   )
                                || '
                            </div>
                
                        </div>
                
                
                        <!-- TABLE -->
                
                        <div style="
                            width:100%;
                            overflow-x:auto;
                        ">
                
                        <table style="
                            width:100%;
                            min-width:800px;
                            border-collapse:collapse;
                            font-size:12px;
                        ">
                
                        <thead>
                
                            <tr style="
                                background:#e9e9e9;
                                color:#111;
                            ">
                
                                <th style="
                                    width:55px;
                                    padding:8px 6px;
                                    border:1px solid #fff;
                                    text-align:center;
                                ">
                                    Sl#
                                </th>
                
                                <th style="
                                    width:140px;
                                    padding:8px 8px;
                                    border:1px solid #fff;
                                    text-align:left;
                                ">
                                    GL Code
                                </th>
                
                                <th style="
                                    padding:8px 8px;
                                    border:1px solid #fff;
                                    text-align:left;
                                ">
                                    GL Description
                                </th>
                
                                <th style="
                                    width:180px;
                                    padding:8px 8px;
                                    border:1px solid #fff;
                                    text-align:right;
                                ">
                                    Debit Amount
                                </th>
                
                                <th style="
                                    width:180px;
                                    padding:8px 8px;
                                    border:1px solid #fff;
                                    text-align:right;
                                ">
                                    Credit Amount
                                </th>
                
                            </tr>
                
                        </thead>
                
                        <tbody>';
                
                
                    /* =========================================================
                       ACCOUNT DATA
                       ========================================================= */
                
                    FOR R IN
                    (
                        WITH
                
                        /* =====================================================
                           OPENING BALANCE
                           ===================================================== */
                
                        OPENING AS
                        (
                            SELECT
                                ACCOUNT_NO,
                
                                NVL(
                                    SUM(OPENING_DEBIT),
                                    0
                                ) AS OPENING_DEBIT,
                
                                NVL(
                                    SUM(OPENING_CREDIT),
                                    0
                                ) AS OPENING_CREDIT
                
                            FROM ACC_OPENING_BALANCE
                
                            WHERE APPROVAL_STATUS = 'A'
                
                            GROUP BY ACCOUNT_NO
                        ),
                
                
                        /* =====================================================
                           PERIOD TRANSACTION
                           ===================================================== */
                
                        PERIOD AS
                        (
                            SELECT
                                D.ACCOUNT_NO,
                
                                NVL(
                                    SUM(D.DEBIT_AMOUNT),
                                    0
                                ) AS PERIOD_DEBIT,
                
                                NVL(
                                    SUM(D.CREDIT_AMOUNT),
                                    0
                                ) AS PERIOD_CREDIT
                
                            FROM ACC_VOUCHER_MST M
                
                            JOIN ACC_VOUCHER_DTL D
                              ON D.VOUCHER_NO = M.VOUCHER_NO
                
                            WHERE M.APPROVAL_STATUS = 'A'
                
                              AND M.VOUCHER_DATE >=
                                  TO_DATE(
                                      :P309_FROM_DATE,
                                      'MM/DD/YYYY'
                                  )
                
                              AND M.VOUCHER_DATE <
                                  TO_DATE(
                                      :P309_TO_DATE,
                                      'MM/DD/YYYY'
                                  ) + 1
                
                            GROUP BY D.ACCOUNT_NO
                        ),
                
                
                        /* =====================================================
                           ACCOUNT BALANCE
                           ===================================================== */
                
                        ACCOUNT_BALANCE AS
                        (
                            SELECT
                
                                H.ACCOUNT_NO,
                
                                H.PARENT_ACCOUNT_NO,
                
                                H.ACCOUNT_CODE,
                
                                H.ACCOUNT_NAME,
                
                                H.ACCOUNT_TYPE,
                
                                H.ACCOUNT_LEVEL,
                
                                NVL(
                                    O.OPENING_DEBIT,
                                    0
                                ) AS OPENING_DEBIT,
                
                                NVL(
                                    O.OPENING_CREDIT,
                                    0
                                ) AS OPENING_CREDIT,
                
                                NVL(
                                    P.PERIOD_DEBIT,
                                    0
                                ) AS PERIOD_DEBIT,
                
                                NVL(
                                    P.PERIOD_CREDIT,
                                    0
                                ) AS PERIOD_CREDIT,
                
                
                                /* TOTAL DEBIT */
                
                                NVL(O.OPENING_DEBIT,0)
                                +
                                NVL(P.PERIOD_DEBIT,0)
                
                                AS TOTAL_DEBIT,
                
                
                                /* TOTAL CREDIT */
                
                                NVL(O.OPENING_CREDIT,0)
                                +
                                NVL(P.PERIOD_CREDIT,0)
                
                                AS TOTAL_CREDIT
                
                            FROM MST_ACCOUNT_HEAD H
                
                            LEFT JOIN OPENING O
                              ON O.ACCOUNT_NO = H.ACCOUNT_NO
                
                            LEFT JOIN PERIOD P
                              ON P.ACCOUNT_NO = H.ACCOUNT_NO
                
                            WHERE H.IS_POSTING = 'Y'
                
                              AND H.ACTIVE_STATUS = 'Y'
                        ),
                
                
                        /* =====================================================
                           FINAL TRIAL BALANCE
                           ===================================================== */
                
                        FINAL_DATA AS
                        (
                            SELECT
                
                                A.*,
                
                
                                /* NET DEBIT */
                
                                CASE
                                    WHEN
                                        A.TOTAL_DEBIT >
                                        A.TOTAL_CREDIT
                                    THEN
                                        A.TOTAL_DEBIT -
                                        A.TOTAL_CREDIT
                                    ELSE
                                        0
                                END AS BALANCE_DEBIT,
                
                
                                /* NET CREDIT */
                
                                CASE
                                    WHEN
                                        A.TOTAL_CREDIT >
                                        A.TOTAL_DEBIT
                                    THEN
                                        A.TOTAL_CREDIT -
                                        A.TOTAL_DEBIT
                                    ELSE
                                        0
                                END AS BALANCE_CREDIT
                
                            FROM ACCOUNT_BALANCE A
                        )
                
                
                        /* =====================================================
                           GET PARENT / HEAD INFORMATION
                           ===================================================== */
                
                        SELECT
                
                            F.*,
                
                            PH.ACCOUNT_NO
                                AS HEAD_ACCOUNT_NO,
                
                            PH.ACCOUNT_CODE
                                AS HEAD_CODE,
                
                            PH.ACCOUNT_NAME
                                AS HEAD_NAME
                
                        FROM FINAL_DATA F
                
                        JOIN MST_ACCOUNT_HEAD PH
                          ON PH.ACCOUNT_NO = F.PARENT_ACCOUNT_NO
                
                        WHERE
                               F.BALANCE_DEBIT <> 0
                            OR F.BALANCE_CREDIT <> 0
                
                        ORDER BY
                
                            PH.ACCOUNT_CODE,
                
                            F.ACCOUNT_CODE
                
                    )
                
                    LOOP
                
                
                        /* =====================================================
                           NEW HEAD
                           ===================================================== */
                
                        IF v_current_head_no IS NULL
                           OR v_current_head_no <> R.HEAD_ACCOUNT_NO
                        THEN
                
                
                            /* =================================================
                               PREVIOUS HEAD SUB TOTAL
                               ================================================= */
                
                            IF v_current_head_no IS NOT NULL
                            THEN
                
                                v_html :=
                                    v_html ||
                
                                    '<tr>
                
                                        <td colspan="3"
                                            style="
                                                padding:6px 8px;
                                                text-align:right;
                                                border-bottom:2px solid #777;
                                                font-weight:700;
                                            ">
                                            Sub Total:
                                        </td>
                
                
                                        <td style="
                                            padding:6px 8px;
                                            text-align:right;
                                            border-bottom:2px solid #777;
                                            font-weight:700;
                                        ">'
                                        ||
                                        TO_CHAR(
                                            v_head_dr,
                                            'FM999G999G999G990D00'
                                        )
                                        ||
                                        '</td>
                
                
                                        <td style="
                                            padding:6px 8px;
                                            text-align:right;
                                            border-bottom:2px solid #777;
                                            font-weight:700;
                                        ">'
                                        ||
                                        TO_CHAR(
                                            v_head_cr,
                                            'FM999G999G999G990D00'
                                        )
                                        ||
                                        '</td>
                
                                    </tr>';
                
                            END IF;
                
                
                            /* =================================================
                               RESET
                               ================================================= */
                
                            v_head_dr := 0;
                            v_head_cr := 0;
                
                            v_current_head_no := R.HEAD_ACCOUNT_NO;
                
                            v_current_head_code := R.HEAD_CODE;
                
                            v_current_head_name := R.HEAD_NAME;
                
                            v_row_no := 0;
                
                
                            /* =================================================
                               HEAD TITLE
                               ================================================= */
                
                            v_html :=
                                v_html ||
                
                                '<tr>
                
                                    <td colspan="5"
                                        style="
                                            padding:12px 0 7px 0;
                                            font-size:14px;
                                            font-weight:700;
                                            color:#222;
                                        ">
                
                                        Head Code:
                                        <span>'
                                        ||
                                        APEX_ESCAPE.HTML(
                                            R.HEAD_CODE
                                        )
                                        ||
                                        '</span>
                
                                        &nbsp;&nbsp;
                
                                        <span>'
                                        ||
                                        APEX_ESCAPE.HTML(
                                            R.HEAD_NAME
                                        )
                                        ||
                                        '</span>
                
                                    </td>
                
                                </tr>';
                
                        END IF;
                
                
                        /* =====================================================
                           ACCOUNT ROW
                           ===================================================== */
                
                        v_row_no := v_row_no + 1;
                
                
                        v_html :=
                            v_html ||
                
                            '<tr>
                
                                <!-- SL -->
                
                                <td style="
                                    padding:6px;
                                    text-align:center;
                                    border-bottom:1px solid #e5e5e5;
                                ">'
                                ||
                                v_row_no
                                ||
                                '</td>
                
                
                                <!-- GL CODE -->
                
                                <td style="
                                    padding:6px 8px;
                                    border-bottom:1px solid #e5e5e5;
                                ">'
                                ||
                                APEX_ESCAPE.HTML(
                                    R.ACCOUNT_CODE
                                )
                                ||
                                '</td>
                
                
                                <!-- DESCRIPTION -->
                
                                <td style="
                                    padding:6px 8px;
                                    border-bottom:1px solid #e5e5e5;
                                ">'
                                ||
                                APEX_ESCAPE.HTML(
                                    R.ACCOUNT_NAME
                                )
                                ||
                                '</td>
                
                
                                <!-- DEBIT -->
                
                                <td style="
                                    padding:6px 8px;
                                    text-align:right;
                                    border-bottom:1px solid #e5e5e5;
                                ">'
                                ||
                                TO_CHAR(
                                    R.BALANCE_DEBIT,
                                    'FM999G999G999G990D00'
                                )
                                ||
                                '</td>
                
                
                                <!-- CREDIT -->
                
                                <td style="
                                    padding:6px 8px;
                                    text-align:right;
                                    border-bottom:1px solid #e5e5e5;
                                ">'
                                ||
                                TO_CHAR(
                                    R.BALANCE_CREDIT,
                                    'FM999G999G999G990D00'
                                )
                                ||
                                '</td>
                
                            </tr>';
                
                
                        /* =====================================================
                           HEAD TOTAL
                           ===================================================== */
                
                        v_head_dr :=
                            v_head_dr +
                            R.BALANCE_DEBIT;
                
                        v_head_cr :=
                            v_head_cr +
                            R.BALANCE_CREDIT;
                
                
                        /* =====================================================
                           GRAND TOTAL
                           ===================================================== */
                
                        v_total_dr :=
                            v_total_dr +
                            R.BALANCE_DEBIT;
                
                        v_total_cr :=
                            v_total_cr +
                            R.BALANCE_CREDIT;
                
                
                    END LOOP;
                
                
                    /* =========================================================
                       LAST HEAD SUB TOTAL
                       ========================================================= */
                
                    IF v_current_head_no IS NOT NULL
                    THEN
                
                        v_html :=
                            v_html ||
                
                            '<tr>
                
                                <td colspan="3"
                                    style="
                                        padding:7px 8px;
                                        text-align:right;
                                        border-bottom:2px solid #777;
                                        font-weight:700;
                                    ">
                                    Sub Total:
                                </td>
                
                
                                <td style="
                                    padding:7px 8px;
                                    text-align:right;
                                    border-bottom:2px solid #777;
                                    font-weight:700;
                                ">'
                                ||
                                TO_CHAR(
                                    v_head_dr,
                                    'FM999G999G999G990D00'
                                )
                                ||
                                '</td>
                
                
                                <td style="
                                    padding:7px 8px;
                                    text-align:right;
                                    border-bottom:2px solid #777;
                                    font-weight:700;
                                ">'
                                ||
                                TO_CHAR(
                                    v_head_cr,
                                    'FM999G999G999G990D00'
                                )
                                ||
                                '</td>
                
                            </tr>';
                
                    END IF;
                
                
                    /* =========================================================
                       GRAND TOTAL
                       ========================================================= */
                
                    v_html :=
                        v_html ||
                
                        '<tr>
                
                            <td colspan="3"
                                style="
                                    padding:10px 8px;
                                    text-align:right;
                                    background:#e9e9e9;
                                    border-top:2px solid #555;
                                    border-bottom:2px solid #555;
                                    font-size:13px;
                                    font-weight:700;
                                ">
                                Grand Total:
                            </td>
                
                
                            <td style="
                                padding:10px 8px;
                                text-align:right;
                                background:#e9e9e9;
                                border-top:2px solid #555;
                                border-bottom:2px solid #555;
                                font-size:13px;
                                font-weight:700;
                            ">'
                            ||
                            TO_CHAR(
                                v_total_dr,
                                'FM999G999G999G990D00'
                            )
                            ||
                            '</td>
                
                
                            <td style="
                                padding:10px 8px;
                                text-align:right;
                                background:#e9e9e9;
                                border-top:2px solid #555;
                                border-bottom:2px solid #555;
                                font-size:13px;
                                font-weight:700;
                            ">'
                            ||
                            TO_CHAR(
                                v_total_cr,
                                'FM999G999G999G990D00'
                            )
                            ||
                            '</td>
                
                        </tr>
                
                
                        </tbody>
                
                        </table>
                
                        </div>
                
                
                        <!-- FOOTER -->
                
                        <div style="
                            margin-top:18px;
                            padding-top:8px;
                            border-top:1px solid #ddd;
                            text-align:right;
                            font-size:10px;
                            color:#777;
                        ">
                
                            Generated on:
                            '
                            ||
                            TO_CHAR(
                                SYSDATE,
                                'DD Mon YYYY HH:MI:SS PM'
                            )
                            ||
                            '
                
                        </div>
                
                
                    </div>';
                
                
                    RETURN v_html;
                
                
                EXCEPTION
                
                    WHEN OTHERS
                    THEN
                
                        RETURN
                
                        '<div style="
                            padding:12px;
                            color:#c0392b;
                            background:#fff5f5;
                            border:1px solid #f5c6cb;
                            border-radius:6px;
                            font-size:12px;
                        ">
                
                            <b>
                                Trial Balance report unavailable.
                            </b>
                
                            <br><br>
                
                            <small>'
                            ||
                            APEX_ESCAPE.HTML(
                                SQLERRM
                            )
                            ||
                            '</small>
                
                        </div>';
                
                END;
                ```
            pageItemsToSubmit: [
                P309_FROM_DATE
                P309_TO_DATE
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        config {
            buildOption: @commented-out
        }
    )

    region trial-balance-summary_1_1 (
        name: Trial Balance Summary
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/25/2026 4:14:59 PM (QP5 v5.388) */
                DECLARE
                    v_html               CLOB := '';
                
                    v_current_type       VARCHAR2 (1) := NULL;
                    v_type_name          VARCHAR2 (100);
                
                    /* Section Total */
                    v_sec_opening_dr     NUMBER := 0;
                    v_sec_opening_cr     NUMBER := 0;
                    v_sec_period_dr      NUMBER := 0;
                    v_sec_period_cr      NUMBER := 0;
                    v_sec_closing_dr     NUMBER := 0;
                    v_sec_closing_cr     NUMBER := 0;
                
                    /* Grand Total */
                    v_total_opening_dr   NUMBER := 0;
                    v_total_opening_cr   NUMBER := 0;
                    v_total_period_dr    NUMBER := 0;
                    v_total_period_cr    NUMBER := 0;
                    v_total_closing_dr   NUMBER := 0;
                    v_total_closing_cr   NUMBER := 0;
                
                    /* Summary */
                    v_opening_balance    NUMBER := 0;
                    v_closing_balance    NUMBER := 0;
                BEGIN
                    /* =========================================================
                       STEP 1
                       FIRST CALCULATE GRAND TOTAL
                       ========================================================= */
                
                    WITH
                        OPENING
                        AS
                            (  SELECT ACCOUNT_NO,
                                      NVL (SUM (OPENING_DEBIT), 0)      AS OPENING_DEBIT,
                                      NVL (SUM (OPENING_CREDIT), 0)     AS OPENING_CREDIT
                                 FROM ACC_OPENING_BALANCE
                                WHERE APPROVAL_STATUS = 'A'
                             GROUP BY ACCOUNT_NO),
                        PERIOD
                        AS
                            (  SELECT D.ACCOUNT_NO,
                                      NVL (SUM (D.DEBIT_AMOUNT), 0)      AS PERIOD_DEBIT,
                                      NVL (SUM (D.CREDIT_AMOUNT), 0)     AS PERIOD_CREDIT
                                 FROM ACC_VOUCHER_MST M
                                      JOIN ACC_VOUCHER_DTL D ON D.VOUCHER_NO = M.VOUCHER_NO
                                WHERE     M.APPROVAL_STATUS = 'A'
                                      AND M.VOUCHER_DATE >=
                                          TO_DATE ( :P309_FROM_DATE, 'MM/DD/YYYY')
                                      AND M.VOUCHER_DATE <
                                          TO_DATE ( :P309_TO_DATE, 'MM/DD/YYYY') + 1
                             GROUP BY D.ACCOUNT_NO),
                        TB
                        AS
                            (SELECT H.ACCOUNT_NO,
                                    NVL (O.OPENING_DEBIT, 0)      AS OPENING_DEBIT,
                                    NVL (O.OPENING_CREDIT, 0)     AS OPENING_CREDIT,
                                    NVL (P.PERIOD_DEBIT, 0)       AS PERIOD_DEBIT,
                                    NVL (P.PERIOD_CREDIT, 0)      AS PERIOD_CREDIT
                               FROM MST_ACCOUNT_HEAD  H
                                    LEFT JOIN OPENING O ON O.ACCOUNT_NO = H.ACCOUNT_NO
                                    LEFT JOIN PERIOD P ON P.ACCOUNT_NO = H.ACCOUNT_NO
                              WHERE H.IS_POSTING = 'Y' AND H.ACTIVE_STATUS = 'Y'),
                        CALC
                        AS
                            (SELECT TB.*,
                                    (  OPENING_DEBIT
                                     - OPENING_CREDIT
                                     + PERIOD_DEBIT
                                     - PERIOD_CREDIT)    AS NET_BALANCE
                               FROM TB)
                    SELECT NVL (SUM (OPENING_DEBIT), 0),
                           NVL (SUM (OPENING_CREDIT), 0),
                           NVL (SUM (PERIOD_DEBIT), 0),
                           NVL (SUM (PERIOD_CREDIT), 0),
                           NVL (SUM (CASE WHEN NET_BALANCE > 0 THEN NET_BALANCE ELSE 0 END),
                                0),
                           NVL (
                               SUM (
                                   CASE
                                       WHEN NET_BALANCE < 0 THEN ABS (NET_BALANCE)
                                       ELSE 0
                                   END),
                               0)
                      INTO v_total_opening_dr,
                           v_total_opening_cr,
                           v_total_period_dr,
                           v_total_period_cr,
                           v_total_closing_dr,
                           v_total_closing_cr
                      FROM CALC
                     WHERE    OPENING_DEBIT <> 0
                           OR OPENING_CREDIT <> 0
                           OR PERIOD_DEBIT <> 0
                           OR PERIOD_CREDIT <> 0;
                
                
                    /* =========================================================
                       SUMMARY VALUES
                       ========================================================= */
                
                    v_opening_balance := v_total_opening_dr;  -- ABS (v_total_opening_dr - v_total_opening_cr);
                
                    v_closing_balance := v_total_closing_dr;  --ABS (v_total_closing_dr - v_total_closing_cr);
                
                
                    /* =========================================================
                       HEADER
                       ========================================================= */
                
                    v_html :=
                           '<div id="trial_balance_report"
                          style="
                              width:100%;
                              background:#fff;
                              border:1px solid #e1e5e9;
                              border-radius:8px;
                              overflow:hidden;
                              font-family:Arial,sans-serif;
                              box-sizing:border-box;
                          ">
                
                        <!-- ================= HEADER ================= -->
                
                        <div style="
                            padding:12px 14px;
                            border-bottom:1px solid #e1e5e9;
                            background:#f8fafc;
                        ">
                
                            <div style="
                                font-size:18px;
                                font-weight:700;
                                color:#263238;
                            ">
                                Trial Balance
                            </div>
                
                            <div style="
                                margin-top:3px;
                                font-size:11px;
                                color:#78909c;
                            ">
                                From '
                        || TO_CHAR (TO_DATE ( :P309_FROM_DATE, 'MM/DD/YYYY'), 'DD Mon YYYY')
                        || ' To '
                        || TO_CHAR (TO_DATE ( :P309_TO_DATE, 'MM/DD/YYYY'), 'DD Mon YYYY')
                        || '
                            </div>
                
                        </div>
                
                
                        <!-- ================= SUMMARY ================= -->
                
                        <div style="
                            display:grid;
                            grid-template-columns:repeat(4,minmax(150px,1fr));
                            gap:7px;
                            padding:9px;
                            background:#fff;
                        ">
                
                
                            <!-- Opening -->
                
                            <div style="
                                padding:8px 10px;
                                border:1px solid #e1e5e9;
                                border-radius:6px;
                                background:#f8fafc;
                            ">
                
                                <div style="
                                    font-size:10px;
                                    color:#78909c;
                                ">
                                    Opening Balance
                                </div>
                
                                <div style="
                                    margin-top:3px;
                                    font-size:14px;
                                    font-weight:700;
                                    color:#34495e;
                                ">
                                    ৳ '
                        || TO_CHAR (v_opening_balance, 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                
                
                            <!-- Debit -->
                
                            <div style="
                                padding:8px 10px;
                                border:1px solid #d6e7ff;
                                border-radius:6px;
                                background:#f8fbff;
                            ">
                
                                <div style="
                                    font-size:10px;
                                    color:#78909c;
                                ">
                                    Period Debit
                                </div>
                
                                <div style="
                                    margin-top:3px;
                                    font-size:14px;
                                    font-weight:700;
                                    color:#2980b9;
                                ">
                                    ৳ '
                        || TO_CHAR (v_total_period_dr, 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                            <!-- Credit -->
                
                            <div style="
                                padding:8px 10px;
                                border:1px solid #f4d6d6;
                                border-radius:6px;
                                background:#fffafa;
                            ">
                
                                <div style="
                                    font-size:10px;
                                    color:#78909c;
                                ">
                                    Period Credit
                                </div>
                
                                <div style="
                                    margin-top:3px;
                                    font-size:14px;
                                    font-weight:700;
                                    color:#c0392b;
                                ">
                                    ৳ '
                        || TO_CHAR (v_total_period_cr, 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                
                
                            <!-- Closing -->
                
                            <div style="
                                padding:8px 10px;
                                border:1px solid #d5f0df;
                                border-radius:6px;
                                background:#f8fff9;
                            ">
                
                                <div style="
                                    font-size:10px;
                                    color:#78909c;
                                ">
                                    Closing Balance
                                </div>
                
                                <div style="
                                    margin-top:3px;
                                    font-size:14px;
                                    font-weight:700;
                                    color:#27ae60;
                                ">
                                    ৳ '
                        || TO_CHAR (v_closing_balance, 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                
                        </div>
                
                
                        <!-- ================= TABLE ================= -->
                
                        <div style="
                            width:100%;
                            overflow-x:auto;
                        ">
                
                        <table style="
                            width:100%;
                            min-width:850px;
                            border-collapse:collapse;
                            font-size:11px;
                        ">
                
                        <thead>
                
                            <tr style="
                                background:#f1f5f9;
                                color:#475569;
                            ">
                
                                <th style="
                                    padding:8px 9px;
                                    text-align:left;
                                    border-bottom:1px solid #dfe4e8;
                                ">
                                    Account
                                </th>
                
                                <th style="
                                    padding:8px;
                                    text-align:right;
                                    border-bottom:1px solid #dfe4e8;
                                ">
                                    Opening
                                </th>
                
                                <th style="
                                    padding:8px;
                                    text-align:right;
                                    border-bottom:1px solid #dfe4e8;
                                ">
                                    Debit
                                </th>
                
                                <th style="
                                    padding:8px;
                                    text-align:right;
                                    border-bottom:1px solid #dfe4e8;
                                ">
                                    Credit
                                </th>
                
                                <th style="
                                    padding:8px;
                                    text-align:right;
                                    border-bottom:1px solid #dfe4e8;
                                ">
                                    Closing
                                </th>
                
                            </tr>
                
                        </thead>
                
                        <tbody>';
                
                
                    /* =========================================================
                       STEP 2
                       ACCOUNT DETAIL
                       ========================================================= */
                
                    FOR R
                        IN (WITH
                                OPENING
                                AS
                                    (  SELECT ACCOUNT_NO,
                                              NVL (SUM (OPENING_DEBIT), 0)     AS OPENING_DEBIT,
                                              NVL (SUM (OPENING_CREDIT), 0)    AS OPENING_CREDIT
                                         FROM ACC_OPENING_BALANCE
                                        WHERE APPROVAL_STATUS = 'A'
                                     GROUP BY ACCOUNT_NO),
                                PERIOD
                                AS
                                    (  SELECT D.ACCOUNT_NO,
                                              NVL (SUM (D.DEBIT_AMOUNT), 0)     AS PERIOD_DEBIT,
                                              NVL (SUM (D.CREDIT_AMOUNT), 0)    AS PERIOD_CREDIT
                                         FROM ACC_VOUCHER_MST M
                                              JOIN ACC_VOUCHER_DTL D
                                                  ON D.VOUCHER_NO = M.VOUCHER_NO
                                        WHERE     M.APPROVAL_STATUS = 'A'
                                              AND M.VOUCHER_DATE >=
                                                  TO_DATE ( :P309_FROM_DATE, 'MM/DD/YYYY')
                                              AND M.VOUCHER_DATE <
                                                  TO_DATE ( :P309_TO_DATE, 'MM/DD/YYYY') + 1
                                     GROUP BY D.ACCOUNT_NO),
                                TB
                                AS
                                    (SELECT H.ACCOUNT_NO,
                                            H.ACCOUNT_CODE,
                                            H.ACCOUNT_NAME,
                                            H.ACCOUNT_TYPE,
                                            NVL (O.OPENING_DEBIT, 0)      AS OPENING_DEBIT,
                                            NVL (O.OPENING_CREDIT, 0)     AS OPENING_CREDIT,
                                            NVL (P.PERIOD_DEBIT, 0)       AS PERIOD_DEBIT,
                                            NVL (P.PERIOD_CREDIT, 0)      AS PERIOD_CREDIT
                                       FROM MST_ACCOUNT_HEAD  H
                                            LEFT JOIN OPENING O
                                                ON O.ACCOUNT_NO = H.ACCOUNT_NO
                                            LEFT JOIN PERIOD P ON P.ACCOUNT_NO = H.ACCOUNT_NO
                                      WHERE H.IS_POSTING = 'Y' AND H.ACTIVE_STATUS = 'Y'),
                                CALC
                                AS
                                    (SELECT TB.*,
                                            (  OPENING_DEBIT
                                             - OPENING_CREDIT
                                             + PERIOD_DEBIT
                                             - PERIOD_CREDIT)    AS NET_BALANCE
                                       FROM TB)
                              SELECT ACCOUNT_NO,
                                     ACCOUNT_CODE,
                                     ACCOUNT_NAME,
                                     ACCOUNT_TYPE,
                                     OPENING_DEBIT,
                                     OPENING_CREDIT,
                                     PERIOD_DEBIT,
                                     PERIOD_CREDIT,
                                     NET_BALANCE
                                FROM CALC
                               WHERE    OPENING_DEBIT <> 0
                                     OR OPENING_CREDIT <> 0
                                     OR PERIOD_DEBIT <> 0
                                     OR PERIOD_CREDIT <> 0
                            ORDER BY CASE ACCOUNT_TYPE
                                         WHEN 'A' THEN 1
                                         WHEN 'L' THEN 2
                                         WHEN 'C' THEN 3
                                         WHEN 'I' THEN 4
                                         WHEN 'E' THEN 5
                                         ELSE 6
                                     END,
                                     ACCOUNT_CODE)
                    LOOP
                        /* =====================================================
                           NEW ACCOUNT TYPE
                           ===================================================== */
                
                        IF v_current_type IS NULL OR v_current_type <> R.ACCOUNT_TYPE
                        THEN
                            /* Previous Section Total */
                
                            IF v_current_type IS NOT NULL
                            THEN
                                v_html :=
                                       v_html
                                    || '<tr>
                
                                    <td colspan="5"
                                        style="
                                            padding:7px 9px;
                                            text-align:right;
                                            background:#f8fafc;
                                            border-bottom:1px solid #e1e5e9;
                                            font-weight:700;
                                            color:#64748b;
                                        ">
                
                                        Section Total
                
                                        &nbsp;&nbsp;
                
                                        <span style="color:#2980b9;">
                                            Debit:
                                            ৳ '
                                    || TO_CHAR (v_sec_period_dr, 'FM999G999G999G990D00')
                                    || '
                                        </span>
                
                                        &nbsp;&nbsp;
                
                                        <span style="color:#c0392b;">
                                            Credit:
                                            ৳ '
                                    || TO_CHAR (v_sec_period_cr, 'FM999G999G999G990D00')
                                    || '
                                        </span>
                
                                    </td>
                
                                </tr>';
                            END IF;
                
                
                            /* Reset */
                
                            v_sec_opening_dr := 0;
                            v_sec_opening_cr := 0;
                            v_sec_period_dr := 0;
                            v_sec_period_cr := 0;
                            v_sec_closing_dr := 0;
                            v_sec_closing_cr := 0;
                
                
                            v_current_type := R.ACCOUNT_TYPE;
                
                
                            v_type_name :=
                                CASE R.ACCOUNT_TYPE
                                    WHEN 'A' THEN 'Assets'
                                    WHEN 'L' THEN 'Liabilities'
                                    WHEN 'C' THEN 'Capital / Equity'
                                    WHEN 'I' THEN 'Income'
                                    WHEN 'E' THEN 'Expenses'
                                    ELSE 'Other Accounts'
                                END;
                
                
                            /* Section Header */
                
                            v_html := v_html || '<tr>
                
                                <td colspan="5"
                                    style="
                                        padding:7px 9px;
                                        background:#f4f6f8;
                                        border-top:6px solid #fff;
                                        border-bottom:1px solid #e1e5e9;
                                        color:#34495e;
                                        font-size:11px;
                                        font-weight:700;
                                        text-transform:uppercase;
                                        letter-spacing:.5px;
                                    ">
                
                                    ' || v_type_name || '
                
                                </td>
                
                            </tr>';
                        END IF;
                
                
                        /* =====================================================
                           ACCOUNT ROW
                           ===================================================== */
                
                        v_html :=
                               v_html
                            || '<tr>
                
                            <!-- ACCOUNT -->
                
                            <td style="
                                padding:7px 9px;
                                border-bottom:1px solid #edf0f2;
                            ">
                
                                <div style="
                                    font-weight:600;
                                    color:#263238;
                                ">
                                    '
                            || APEX_ESCAPE.HTML (R.ACCOUNT_NAME)
                            || '
                                </div>
                
                                <div style="
                                    margin-top:2px;
                                    font-size:9px;
                                    color:#94a3b8;
                                ">
                                    Code: '
                            || APEX_ESCAPE.HTML (R.ACCOUNT_CODE)
                            || '
                                </div>
                
                            </td>
                
                
                            <!-- OPENING -->
                
                            <td style="
                                padding:7px 8px;
                                text-align:right;
                                border-bottom:1px solid #edf0f2;
                                color:#475569;
                            ">
                
                                '
                            || CASE
                                   WHEN R.OPENING_DEBIT > R.OPENING_CREDIT
                                   THEN
                                          TO_CHAR (R.OPENING_DEBIT - R.OPENING_CREDIT,
                                                   'FM999G999G999G990D00')
                                       || ' <span style="
                                            color:#2980b9;
                                            font-size:9px;
                                            font-weight:700;
                                        ">DR</span>'
                                   WHEN R.OPENING_CREDIT > R.OPENING_DEBIT
                                   THEN
                                          TO_CHAR (R.OPENING_CREDIT - R.OPENING_DEBIT,
                                                   'FM999G999G999G990D00')
                                       || ' <span style="
                                            color:#c0392b;
                                            font-size:9px;
                                            font-weight:700;
                                        ">CR</span>'
                                   ELSE
                                       '0.00'
                               END
                            || '
                
                            </td>
                
                
                            <!-- DEBIT -->
                
                            <td style="
                                padding:7px 8px;
                                text-align:right;
                                border-bottom:1px solid #edf0f2;
                                color:#2980b9;
                            ">
                
                                '
                            || TO_CHAR (R.PERIOD_DEBIT, 'FM999G999G999G990D00')
                            || '
                
                            </td>
                
                
                            <!-- CREDIT -->
                
                            <td style="
                                padding:7px 8px;
                                text-align:right;
                                border-bottom:1px solid #edf0f2;
                                color:#c0392b;
                            ">
                
                                '
                            || TO_CHAR (R.PERIOD_CREDIT, 'FM999G999G999G990D00')
                            || '
                
                            </td>
                
                
                            <!-- CLOSING -->
                
                            <td style="
                                padding:7px 8px;
                                text-align:right;
                                border-bottom:1px solid #edf0f2;
                                font-weight:700;
                            ">
                
                                '
                            || CASE
                                   WHEN R.NET_BALANCE > 0
                                   THEN
                                          TO_CHAR (R.NET_BALANCE, 'FM999G999G999G990D00')
                                       || ' <span style="
                                            color:#2980b9;
                                            font-size:9px;
                                            font-weight:700;
                                        ">DR</span>'
                                   WHEN R.NET_BALANCE < 0
                                   THEN
                                          TO_CHAR (ABS (R.NET_BALANCE),
                                                   'FM999G999G999G990D00')
                                       || ' <span style="
                                            color:#c0392b;
                                            font-size:9px;
                                            font-weight:700;
                                        ">CR</span>'
                                   ELSE
                                       '0.00'
                               END
                            || '
                
                            </td>
                
                        </tr>';
                
                
                        /* =====================================================
                           SECTION TOTAL
                           ===================================================== */
                
                        v_sec_opening_dr := v_sec_opening_dr + R.OPENING_DEBIT;
                
                        v_sec_opening_cr := v_sec_opening_cr + R.OPENING_CREDIT;
                
                        v_sec_period_dr := v_sec_period_dr + R.PERIOD_DEBIT;
                
                        v_sec_period_cr := v_sec_period_cr + R.PERIOD_CREDIT;
                    END LOOP;
                
                
                    /* =========================================================
                       LAST SECTION TOTAL
                       ========================================================= */
                
                    IF v_current_type IS NOT NULL
                    THEN
                        v_html :=
                               v_html
                            || '<tr>
                
                            <td colspan="5"
                                style="
                                    padding:7px 9px;
                                    text-align:right;
                                    background:#f8fafc;
                                    border-bottom:1px solid #e1e5e9;
                                    font-weight:700;
                                    color:#64748b;
                                ">
                
                                Section Total
                
                                &nbsp;&nbsp;
                
                                <span style="color:#2980b9;">
                                    Debit:
                                    ৳ '
                            || TO_CHAR (v_sec_period_dr, 'FM999G999G999G990D00')
                            || '
                                </span>
                
                                &nbsp;&nbsp;
                
                                <span style="color:#c0392b;">
                                    Credit:
                                    ৳ '
                            || TO_CHAR (v_sec_period_cr, 'FM999G999G999G990D00')
                            || '
                                </span>
                
                            </td>
                
                        </tr>';
                    END IF;
                
                
                    /* =========================================================
                       FINAL TOTAL + BALANCE STATUS
                       ========================================================= */
                
                    v_html :=
                           v_html
                        || '</tbody>
                
                        </table>
                
                        </div>
                
                
                        <!-- ================= FOOTER ================= -->
                
                        <div style="
                            padding:10px;
                            background:#f8fafc;
                            border-top:1px solid #e1e5e9;
                        ">
                
                            <div style="
                                display:grid;
                                grid-template-columns:
                                    repeat(3,minmax(150px,1fr));
                                gap:7px;
                            ">
                
                
                                <!-- TOTAL DEBIT -->
                
                                <div style="
                                    padding:8px 10px;
                                    background:#fff;
                                    border:1px solid #d6e7ff;
                                    border-radius:6px;
                                ">
                
                                    <div style="
                                        font-size:10px;
                                        color:#78909c;
                                    ">
                                        Total Debit
                                    </div>
                
                                    <div style="
                                        margin-top:3px;
                                        font-size:14px;
                                        font-weight:700;
                                        color:#2980b9;
                                    ">
                                        ৳ '
                        || TO_CHAR (v_total_period_dr, 'FM999G999G999G990D00')
                        || '
                                    </div>
                
                                </div>
                
                
                                <!-- TOTAL CREDIT -->
                
                                <div style="
                                    padding:8px 10px;
                                    background:#fff;
                                    border:1px solid #f4d6d6;
                                    border-radius:6px;
                                ">
                
                                    <div style="
                                        font-size:10px;
                                        color:#78909c;
                                    ">
                                        Total Credit
                                    </div>
                
                                    <div style="
                                        margin-top:3px;
                                        font-size:14px;
                                        font-weight:700;
                                        color:#c0392b;
                                    ">
                                        ৳ '
                        || TO_CHAR (v_total_period_cr, 'FM999G999G999G990D00')
                        || '
                                    </div>
                
                                </div>
                
                
                                <!-- BALANCE STATUS -->
                
                                <div style="
                                    padding:8px 10px;
                                    background:#fff;
                                    border:1px solid '
                        || CASE
                               WHEN ROUND (v_total_period_dr, 2) =
                                    ROUND (v_total_period_cr, 2)
                               THEN
                                   '#d5f0df'
                               ELSE
                                   '#f4d6d6'
                           END
                        || ';
                                    border-radius:6px;
                                    text-align:center;
                                ">
                
                                    <div style="
                                        font-size:10px;
                                        color:#78909c;
                                    ">
                                        Trial Balance Status
                                    </div>
                
                                    <div style="
                                        margin-top:3px;
                                        font-size:13px;
                                        font-weight:700;
                                        color:'
                        || CASE
                               WHEN ROUND (v_total_period_dr, 2) =
                                    ROUND (v_total_period_cr, 2)
                               THEN
                                   '#27ae60'
                               ELSE
                                   '#c0392b'
                           END
                        || ';
                                    ">
                
                                       '
                        || CASE
                               WHEN ROUND (v_total_period_dr, 2) =
                                    ROUND (v_total_period_cr, 2)
                               THEN
                                   '✓ BALANCED'
                               ELSE
                                   '⚠ NOT BALANCED'
                           END
                        || '
                                    </div>
                
                                </div>
                
                            </div>
                
                            <!-- Difference -->
                
                            <div style="
                                margin-top:7px;
                                text-align:right;
                                font-size:10px;
                                color:#78909c;
                            ">
                                Difference:
                
                                <b style="color:#34495e;">
                                    ৳ '
                        || TO_CHAR (ABS (v_total_period_dr - v_total_period_cr),
                                    'FM999G999G999G990D00')
                        || '
                                </b>
                            </div>
                        </div>
                
                   </div>';
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                            padding:10px;
                            color:#c0392b;
                            background:#fff5f5;
                            border:1px solid #f5c6cb;
                            border-radius:6px;
                            font-size:12px;
                        ">
                            <b>Trial Balance report unavailable.</b>
                            <br><br>
                            <small>' || APEX_ESCAPE.HTML (SQLERRM) || '</small>
                
                        </div>';
                END;
                ```
            pageItemsToSubmit: [
                P309_FROM_DATE
                P309_TO_DATE
            ]
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    pageItem P309_FROM_DATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate - 60
        }
    )

    pageItem P309_TO_DATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
            customAttributes: disabled
        }
    )

    button new (
        buttonName: New
        label: New
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-reset
            customAttributes: disabled
        }
    )

