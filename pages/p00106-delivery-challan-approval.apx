    region register (
        name: Delivery Challan Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT
                       M.DELIVERY_NO,
                
                       M.DELIVERY_CODE,
                
                       M.DELIVERY_DATE,
                
                       I.INVOICE_CODE,
                
                       I.INVOICE_DATE,
                
                       C.CUSTOMER_NAME,
                
                       C.MOBILE_NO,
                
                       M.DELIVERY_PERSON,
                
                       M.VEHICLE_NO,
                
                       (
                           SELECT NVL(SUM(D.DELIVERY_QTY),0)
                             FROM TRN_DELIVERY_DTL D
                            WHERE D.DELIVERY_NO = M.DELIVERY_NO
                       ) TOTAL_QTY,
                
                       (
                           SELECT NVL(SUM(D.TOTAL_AMOUNT),0)
                             FROM TRN_DELIVERY_DTL D
                            WHERE D.DELIVERY_NO = M.DELIVERY_NO
                       ) TOTAL_AMOUNT,
                
                       CASE M.APPROVAL_STATUS
                           WHEN 'P' THEN
                               '<span style="
                                    background:#f59e0b;
                                    color:white;
                                    padding:3px 8px;
                                    border-radius:12px;
                                    font-size:11px;
                                    font-weight:600;">
                                    Pending
                                </span>'
                
                           WHEN 'A' THEN
                               '<span style="
                                    background:#22c55e;
                                    color:white;
                                    padding:3px 8px;
                                    border-radius:12px;
                                    font-size:11px;
                                    font-weight:600;">
                                    Approved
                                </span>'
                
                           WHEN 'R' THEN
                               '<span style="
                                    background:#ef4444;
                                    color:white;
                                    padding:3px 8px;
                                    border-radius:12px;
                                    font-size:11px;
                                    font-weight:600;">
                                    Rejected
                                </span>'
                       END APPROVAL_STATUS,
                
                      null DETAILS,
                       M.CREATED_BY,
                
                       M.CREATED_DATE
                
                FROM TRN_DELIVERY_MST M
                
                JOIN TRN_SALES_INVOICE_MST I
                  ON I.INVOICE_NO = M.INVOICE_NO
                
                JOIN MST_CUSTOMER C
                  ON C.CUSTOMER_NO = M.CUSTOMER_NO
                WHERE M.APPROVAL_STATUS = 'P'
                ORDER BY M.DELIVERY_NO DESC);
                ```
        }
