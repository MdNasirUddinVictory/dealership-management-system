    process approve-purchase (
        name: APPROVE_DELIVERY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_invoice_no      NUMBER;
                    v_order_no        NUMBER;
                    v_total_invoice   NUMBER;
                    v_total_delivery  NUMBER;
                    v_stock           NUMBER;
                    v_exists          NUMBER;
                
                    v_delivery_no     NUMBER := APEX_APPLICATION.G_X01;
                
                BEGIN
                
                    ----------------------------------------------------
                    -- Only Pending Delivery Can Approve
                    ----------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_DELIVERY_MST
                     WHERE DELIVERY_NO = v_delivery_no
                       AND APPROVAL_STATUS = 'P';
                
                    IF v_exists = 0 THEN
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('status','ERROR');
                        APEX_JSON.WRITE(
                            'message',
                            'Only pending delivery can be approved.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                        RETURN;
                
                    END IF;
                
                    ----------------------------------------------------
                    -- Already Approved
                    ----------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_DELIVERY_MST
                     WHERE DELIVERY_NO = v_delivery_no
                       AND APPROVAL_STATUS = 'A';
                
                    IF v_exists > 0 THEN
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('status','ERROR');
                        APEX_JSON.WRITE(
                            'message',
                            'Delivery already approved.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                        RETURN;
                
                    END IF;
                
                    ----------------------------------------------------
                    -- Detail Exists
                    ----------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_DELIVERY_DTL
                     WHERE DELIVERY_NO = v_delivery_no;
                
                    IF v_exists = 0 THEN
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('status','ERROR');
                        APEX_JSON.WRITE(
                            'message',
                            'Delivery details not found.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                        RETURN;
                
                    END IF;
                
                    ----------------------------------------------------
                    -- Stock Already Posted
                    ----------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_STOCK_LEDGER
                     WHERE TRAN_TYPE = 'DELIVERY'
                       AND REF_NO = v_delivery_no;
                
                    IF v_exists > 0 THEN
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('status','ERROR');
                        APEX_JSON.WRITE(
                            'message',
                            'Stock already posted.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                        RETURN;
                
                    END IF;
                
                    ----------------------------------------------------
                    -- Stock Validation
                    ----------------------------------------------------
                FOR r IN
                (
                    SELECT PRODUCT_NO,
                           BASE_QTY
                      FROM TRN_DELIVERY_DTL
                     WHERE DELIVERY_NO = v_delivery_no
                )
                LOOP
                
                    SELECT NVL(SUM(QTY_IN) - SUM(QTY_OUT),0)
                      INTO v_stock
                      FROM TRN_STOCK_LEDGER
                     WHERE PRODUCT_NO = r.PRODUCT_NO;
                
                    IF r.BASE_QTY > v_stock THEN
                
                        APEX_JSON.OPEN_OBJECT;
                
                        APEX_JSON.WRITE('status','ERROR');
                
                        APEX_JSON.WRITE(
                            'message',
                            'Insufficient stock for product.'
                        );
                
                        APEX_JSON.CLOSE_OBJECT;
                
                        RETURN;
                
                    END IF;
                
                END LOOP;
                
                    ----------------------------------------------------
                    -- Approve Delivery
                    ----------------------------------------------------
                
                    UPDATE TRN_DELIVERY_MST
                       SET APPROVAL_STATUS = 'A',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE
                     WHERE DELIVERY_NO = v_delivery_no;
                
                    ----------------------------------------------------
                    -- Stock Ledger Posting
                    ----------------------------------------------------
                INSERT INTO TRN_STOCK_LEDGER
                (
                    LEDGER_NO,
                    TRAN_DATE,
                    TRAN_TYPE,
                    REF_NO,
                    PRODUCT_NO,
                    QTY_IN,
                    QTY_OUT,
                    CREATED_BY,
                    CREATED_DATE
                )
                SELECT
                    SEQ_LEDGER_NO.NEXTVAL,
                    SYSDATE,
                    'DELIVERY',
                    DELIVERY_NO,
                    PRODUCT_NO,
                    0,
                    BASE_QTY,
                    :APP_USER,
                    SYSDATE
                FROM TRN_DELIVERY_DTL
                WHERE DELIVERY_NO = v_delivery_no;
                
                    ----------------------------------------------------
                    -- Get Invoice No
                    ----------------------------------------------------
                
                    SELECT INVOICE_NO
                      INTO v_invoice_no
                      FROM TRN_DELIVERY_MST
                     WHERE DELIVERY_NO = v_delivery_no;
                
                    ----------------------------------------------------
                    -- Get Order No
                    ----------------------------------------------------
                
                    SELECT ORDER_NO
                      INTO v_order_no
                      FROM TRN_SALES_INVOICE_MST
                     WHERE INVOICE_NO = v_invoice_no;
                
                    ----------------------------------------------------
                    -- Update Invoice Detail
                    ----------------------------------------------------
                
                    UPDATE TRN_SALES_INVOICE_DTL I
                       SET DELIVERED_QTY =
                           (
                               SELECT NVL(SUM(D.DELIVERY_QTY),0)
                                 FROM TRN_DELIVERY_DTL D
                                 JOIN TRN_DELIVERY_MST M
                                   ON M.DELIVERY_NO = D.DELIVERY_NO
                                WHERE D.INVOICE_DTL_NO =
                                      I.INVOICE_DTL_NO
                                  AND M.APPROVAL_STATUS = 'A'
                           )
                     WHERE I.INVOICE_NO = v_invoice_no;
                
                    ----------------------------------------------------
                    -- Update Order Detail
                    ----------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_DTL O
                       SET DELIVERED_QTY =
                           (
                               SELECT NVL(SUM(D.DELIVERY_QTY),0)
                                 FROM TRN_DELIVERY_DTL D
                                 JOIN TRN_DELIVERY_MST M
                                   ON M.DELIVERY_NO = D.DELIVERY_NO
                                WHERE D.ORDER_DTL_NO =
                                      O.ORDER_DTL_NO
                                  AND M.APPROVAL_STATUS = 'A'
                           ),
                
                           BALANCE_QTY =
                               ORDER_QTY -
                               (
                                   SELECT NVL(SUM(D.DELIVERY_QTY),0)
                                     FROM TRN_DELIVERY_DTL D
                                     JOIN TRN_DELIVERY_MST M
                                       ON M.DELIVERY_NO = D.DELIVERY_NO
                                    WHERE D.ORDER_DTL_NO =
                                          O.ORDER_DTL_NO
                                      AND M.APPROVAL_STATUS = 'A'
                               )
                
                     WHERE O.ORDER_NO = v_order_no;
                
                    ----------------------------------------------------
                    -- Total Invoice Qty
                    ----------------------------------------------------
                
                    SELECT NVL(SUM(SALES_QTY),0)
                      INTO v_total_invoice
                      FROM TRN_SALES_INVOICE_DTL
                     WHERE INVOICE_NO = v_invoice_no;
                
                    ----------------------------------------------------
                    -- Total Delivered Qty
                    ----------------------------------------------------
                
                    SELECT NVL(SUM(DELIVERED_QTY),0)
                      INTO v_total_delivery
                      FROM TRN_SALES_INVOICE_DTL
                     WHERE INVOICE_NO = v_invoice_no;
                
                    ----------------------------------------------------
                    -- Update Invoice Status
                    ----------------------------------------------------
                
                    UPDATE TRN_SALES_INVOICE_MST
                       SET DELIVERY_STATUS =
                           CASE
                               WHEN v_total_delivery = 0
                                    THEN 'P'
                               WHEN v_total_delivery < v_total_invoice
                                    THEN 'PD'
                               ELSE 'D'
                           END
                     WHERE INVOICE_NO = v_invoice_no;
                
                    ----------------------------------------------------
                    -- Update Order Status
                    ----------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_MST
                       SET ORDER_STATUS =
                           CASE
                               WHEN v_total_delivery = 0
                                    THEN 'I'
                               WHEN v_total_delivery < v_total_invoice
                                    THEN 'PD'
                               ELSE 'D'
                           END,
                
                           DELIVERY_BY = :APP_USER,
                           DELIVERY_DATE = SYSDATE
                
                     WHERE ORDER_NO = v_order_no;
                
                         -- Sales Voucher Posting
                    ----------------------------------------------------
                
                    PKG_FINANCE.POST_SALES
                    (
                        P_INVOICE_NO => v_invoice_no
                    );
                
                
                    ----------------------------------------------------
                    -- Success
                    ----------------------------------------------------
                
                    COMMIT;
                
                    APEX_JSON.OPEN_OBJECT;
                
                    APEX_JSON.WRITE(
                        'status',
                        'SUCCESS'
                    );
                
                    APEX_JSON.WRITE(
                        'message',
                        'Delivery challan approved successfully.'
                    );
                
                    APEX_JSON.CLOSE_OBJECT;
                
                EXCEPTION
                
                    WHEN OTHERS THEN
                
                        ROLLBACK;
                
                        APEX_JSON.OPEN_OBJECT;
                
                        APEX_JSON.WRITE(
                            'status',
                            'ERROR'
                        );
                
                        APEX_JSON.WRITE(
                            'message',
                            SQLERRM
                        );
                
                        APEX_JSON.CLOSE_OBJECT;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 10654366816675089734
        }
    )

