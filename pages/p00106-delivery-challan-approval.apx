    region purchase-details (
        name: CHALLAN DETAILS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM (
                    SELECT
                        ROW_NUMBER() OVER (
                            ORDER BY D.DELIVERY_DTL_NO
                        ) SL,
                
                        P.PRODUCT_CODE,
                        P.PRODUCT_NAME,
                
                        D.PACK_QTY,
                        D.BASE_QTY,
                
                        D.INVOICE_QTY,
                        D.PREVIOUS_DELIVERY_QTY,
                        D.DELIVERY_QTY,
                        D.BALANCE_QTY,
                
                        D.SALES_RATE,
                        D.TOTAL_AMOUNT,
                
                        D.REMARKS
                
                    FROM TRN_DELIVERY_DTL D
                
                    JOIN MST_PRODUCT P
                      ON P.PRODUCT_NO = D.PRODUCT_NO
                
                    WHERE D.DELIVERY_NO = :P106_DELIVERY_NO
                )
                ORDER BY SL;
                ```
            pageItemsToSubmit: P106_DELIVERY_NO
        }
        layout {
            sequence: 30
            parentRegion: @approval-process
            slot: regionBody
