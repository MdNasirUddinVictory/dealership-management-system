page 106 (
    name: Delivery Challan Approval
    alias: DELIVERY-CHALLAN-APPROVAL
    title: Delivery Challan Approval
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function f_openModal(deliveryNo) {
            
                apex.item("P106_DELIVERY_NO").setValue(deliveryNo);
            
                openModal('challan_approve');
            
                apex.region('challan-detail').refresh();
            
            }
            
            
            function approveDelivery(pdeliveryNo) {
                        if (!confirm('Are you sure you want to Delivery this Invoice ?')) {
                    return;
                }
                apex.server.process(
                    'APPROVE_DELIVERY',   // Callback process নাম
                    {
                        x01: pdeliveryNo  // delivery no পাঠাচ্ছি
                    },
                    {
                        success: function (data) {
                            if (data.status === 'SUCCESS') {
                                apex.message.showPageSuccess(data.message);
                                // প্রয়োজনে region refresh করো
                                apex.region('challan-detail').refresh();
                            } else {
                                apex.message.showErrors([{
                                    type: 'error',
                                    location: 'page',
                                    message: data.message,
                                    unsafe: false
                                }]);
                            }
                        },
                        error: function (err) {
                            apex.message.showErrors([{
                                type: 'error',
                                location: 'page',
                                message: 'Unexpected error occurred.',
                                unsafe: false
                            }]);
                        }
                    }
                );
            
            }
            
            
            function rejectPurchase(pPurchaseNo) {
            
                if (!confirm('Are you sure you want to reject this purchase?')) {
                    return;
                }
            
                apex.server.process(
                    "REJECT_PURCHASE",
                    {
                        x01: pPurchaseNo
                    },
                    {
                        dataType: "text",
                        success: function (pData) {
            
                            if (pData === "SUCCESS") {
            
                                apex.message.showPageSuccess(
                                    "Challan rejected successfully."
                                );
            
                                apex.region("challan-detail").refresh();
            
                            } else {
            
                                apex.message.alert(pData);
            
                            }
                        },
                        error: function () {
            
                            apex.message.alert(
                                "Unable to process request."
                            );
            
                        }
                    }
                );
            
            }
            ```
    }
