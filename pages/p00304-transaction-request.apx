                font-size: 19px;
            
                line-height: 1;
            }
            
            
            /* =====================================================
               TABLET
               ===================================================== */
            
            @media (max-width: 1000px) {
            
                .receive-card {
                    padding: 11px 13px;
                }
            
            
                .receive-section {
                    width: 220px;
            
                    padding: 0 15px;
                }
            
            
                .receive-title {
                    font-size: 16px;
                }
            
            
                .delivery-section {
                    padding-left: 12px;
            
                    gap: 10px;
                }
            
            
                .delivery-title {
                    font-size: 11px;
            
                    padding: 6px 8px;
                }
            
            
