            /* =====================================================
               MOBILE
               ===================================================== */
            
            @media (max-width: 700px) {
            
                .receive-card {
                    display: flex;
            
                    flex-direction: column;
            
                    align-items: stretch;
            
                    padding: 12px;
            
                    gap: 10px;
                }
            
            
                /* LEFT */
            
                .customer-section {
                    width: 100%;
            
                    padding-right: 0;
            
                    padding-bottom: 9px;
            
                    border-right: none;
            
                    border-bottom: 1px solid #eeeeee;
                }
            
            
                /* MIDDLE */
            
                .receive-section {
