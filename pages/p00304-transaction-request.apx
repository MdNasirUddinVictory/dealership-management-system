            templateOptions: #DEFAULT#
        }
    )

    region trn-dtl (
        name: TRN DTL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT
                    T.TRANSACTION_DTL_NO,
                    T.TRANSACTION_NO,
                
                    T.REF_TYPE,
                    T.REF_NO,
                
                    T.DOC_NO,
                    T.DOC_CODE,
                    T.DOC_DATE,
                
                    T.PRODUCT_NO,
                
                    P.PRODUCT_CODE,
                    P.PRODUCT_NAME,
                
                    T.INVOICE_AMOUNT,
                    T.PREVIOUS_AMOUNT,
                    T.DUE_AMOUNT,
                    T.ALLOCATE_AMOUNT,
                
                    T.REMARKS,
                    T.CREATED_BY,
                    T.CREATED_DATE
                
                FROM TRN_TRANSACTION_DTL T
                
                LEFT JOIN MST_PRODUCT P
                       ON P.PRODUCT_NO = T.PRODUCT_NO
                
                WHERE T.TRANSACTION_NO = :P304_TRANSACTION_NO
                
                ORDER BY T.TRANSACTION_DTL_NO);
                ```
            pageItemsToSubmit: P304_TRANSACTION_NO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: transaction-dtl
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
