    region order-summery (
        name: ORDER SUMMERY
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/30/2026 4:27:51 PM (QP5 v5.388) */
                DECLARE
                    l_html              CLOB := '';
                
                    l_invoice_code      VARCHAR2 (100);
                    l_invoice_date      DATE;
                    l_customer_name     VARCHAR2 (300);
                
                    l_item_count        NUMBER;
                    l_grand_total       NUMBER;
                
                    /* PAYMENT SUMMARY */
                    l_received_amount   NUMBER := 0;
                    l_due_amount        NUMBER := 0;
                BEGIN
                    /* =====================================================
                       NO INVOICE SELECTED
                       ===================================================== */
                
                    IF :P304_INVOICE IS NULL
                    THEN
                        RETURN '
                        <div class="invoice-history-empty">
                
                            <i class="fa fa-file-text-o"></i>
                
                            <div>
                                Select an invoice to view product history
                            </div>
                
                        </div>';
                    END IF;
                
                
                    /* =====================================================
                       INVOICE HEADER + PAYMENT
                       ===================================================== */
                
                    SELECT m.INVOICE_CODE,
                           m.INVOICE_DATE,
                           c.CUSTOMER_NAME,
                           NVL (m.RECEIVED_AMOUNT, 0),
                           NVL (m.DUE_AMOUNT,
                                NVL (m.TOTAL_AMOUNT, 0) - NVL (m.RECEIVED_AMOUNT, 0))
                      INTO l_invoice_code,
                           l_invoice_date,
                           l_customer_name,
                           l_received_amount,
                           l_due_amount
                      FROM TRN_SALES_INVOICE_MST  m
                           JOIN MST_CUSTOMER c ON c.CUSTOMER_NO = m.CUSTOMER_NO
                     WHERE m.INVOICE_NO = :P304_INVOICE;
                
                
                    /* =====================================================
                       PRODUCT SUMMARY
                       ===================================================== */
                
                    SELECT COUNT (*), NVL (SUM (d.TOTAL_AMOUNT), 0)
                      INTO l_item_count, l_grand_total
                      FROM TRN_SALES_INVOICE_DTL d
                     WHERE d.INVOICE_NO = :P304_INVOICE;
                
                
                    /* =====================================================
                       PRODUCT HISTORY CARD
                       ===================================================== */
                
                    l_html :=
                           '
                
                    <div class="invoice-history-card">
                
                
                        <!-- =================================================
                             HEADER
                             ================================================= -->
                
                        <div class="history-header">
                
                            <div class="history-title-area">
                
                                <div class="history-title">
                                    Product History
                                </div>
                
                                <div class="history-subtitle">'
                        || apex_escape.html (l_invoice_code)
                        || ' &nbsp;•&nbsp; '
                        || apex_escape.html (l_customer_name)
                        || '
                                </div>
                
                            </div>
                
                            <div class="history-date">'
                        || TO_CHAR (l_invoice_date, 'DD Mon YYYY')
                        || '
                            </div>
                
                        </div>
                
                
                        <!-- =================================================
                             TABLE HEADER
                             ================================================= -->
                
                        <div class="product-head">
                
                            <div class="product-col">
                                Product
                            </div>
                
                            <div class="qty-col">
                                Qty
                            </div>
                
                            <div class="price-col">
                                Price
                            </div>
                
                            <div class="total-col">
                                Total
                            </div>
                
                        </div>';
                
                
                    /* =====================================================
                       PRODUCT ROWS
                       ===================================================== */
                
                    FOR r
                        IN (  SELECT d.PRODUCT_NO,
                                     p.PRODUCT_CODE,
                                     p.PRODUCT_NAME,
                                     d.SALES_QTY,
                                     d.SALES_RATE,
                                     d.TOTAL_AMOUNT
                               FROM TRN_SALES_INVOICE_DTL d
                                    JOIN MST_PRODUCT p ON p.PRODUCT_NO = d.PRODUCT_NO
                              WHERE d.INVOICE_NO = :P304_INVOICE
                           ORDER BY d.INVOICE_DTL_NO)
                    LOOP
                        l_html :=
                               l_html
                            || '
                
                        <div class="product-row">
                
                
                            <!-- PRODUCT -->
                
                            <div class="product-col">
                
                                <div class="product-name">'
                            || apex_escape.html (r.PRODUCT_NAME)
                            || '
                                </div>
                
                                <div class="product-code">'
                            || apex_escape.html (r.PRODUCT_CODE)
                            || '
                                </div>
                
                            </div>
                
                
                            <!-- QTY -->
                
                            <div class="qty-col">
                
                                <span class="qty-value">'
                            || TO_CHAR (r.SALES_QTY, 'FM999999999990.999')
                            || '
                                </span>
                
                            </div>
                
                
                            <!-- PRICE -->
                
                            <div class="price-col">
                
                                ৳ '
                            || TO_CHAR (r.SALES_RATE, 'FM999999999990.00')
                            || '
                
                            </div>
                
                
                            <!-- TOTAL -->
                
                            <div class="total-col">
                
                                ৳ '
                            || TO_CHAR (r.TOTAL_AMOUNT, 'FM999999999990.00')
                            || '
                
                            </div>
                
                        </div>';
                    END LOOP;
                
                
                    /* =====================================================
                       PRODUCT FOOTER
                       ===================================================== */
                
                    l_html :=
                           l_html
                        || '
                
                        <div class="history-footer">
                
                            <div class="item-count">'
                        || l_item_count
                        || ' Item(s)
                            </div>
                
                            <div class="history-total-label">
                
                                Total
                
                                <strong>
                                    ৳ '
                        || TO_CHAR (l_grand_total, 'FM999999999990.00')
                        || '
                                </strong>
                
                            </div>
                
                        </div>
                
                    </div>';
                
                
                    /* =====================================================
                       PAYMENT SUMMARY BLOCK
                       ===================================================== */
                
                    l_html :=
                           l_html
                        || '
                
                    <div class="invoice-payment-summary">
                
                        <!-- PAYMENT -->
                
                        <div class="payment-line">
                
                            <span class="payment-label">
                                Payment
                            </span>
                
                            <span class="payment-value payment-received">
                                ৳ '
                        || TO_CHAR (l_received_amount, 'FM999999999990.00')
                        || '
                            </span>
                
                        </div>
                
                
                        <!-- DUE -->
                
                        <div class="payment-line">
                
                            <span class="payment-label">
                                Due
                            </span>
                
                            <span class="payment-value payment-due">
                                ৳ '
                        || TO_CHAR (l_due_amount, 'FM999999999990.00')
                        || '
                            </span>
                
                        </div>
                
                
                        <!-- STATUS -->
                
                        <div class="payment-line payment-status-row">
                
                            <span class="payment-label">
                                Status
                            </span>
                
                            <span class="payment-status '
                        || CASE
                               WHEN l_due_amount = 0 THEN 'status-paid'
                               WHEN l_received_amount > 0 THEN 'status-partial'
                               ELSE 'status-unpaid'
                           END
                        || '">
                
                                '
                        || CASE
                               WHEN l_due_amount = 0
                               THEN
                                   '<i class="fa fa-check-circle"></i> PAID'
                               WHEN l_received_amount > 0
                               THEN
                                   '<i class="fa fa-adjust"></i> PARTIAL'
                               ELSE
                                   '<i class="fa fa-clock-o"></i> UNPAID'
                           END
                        || '
                
                            </span>
                
                        </div>
                
                
                    </div>';
                
                
                    RETURN l_html;
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        RETURN '
                
                        <div class="invoice-history-empty">
                
                            <i class="fa fa-file-o"></i>
                
                            <div>
                                Invoice information not found
                            </div>
                
                        </div>';
                END;
                ```
            pageItemsToSubmit: P304_INVOICE
        }
        layout {
            sequence: 2
            parentRegion: @main
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region trn-mst (
        name: TRN_MST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TRANSACTION_NO,
                       TRANSACTION_CODE,
                       TRANSACTION_DATE,
                       TRANSACTION_TYPE,
                       PARTY_TYPE,
                       PARTY_NO,
                       PAY_MODE,
                       BANK_ACCOUNT_NO,
                       TOTAL_AMOUNT,
                       REMARKS,
                       APPROVAL_STATUS,
                       DECODE(APPROVAL_STATUS,'A','Approved','Pending') STATUS,
                       VOUCHER_NO,
                       CREATED_BY,
                       CREATED_DATE,
                       APPROVED_BY,
                       APPROVED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from TRN_TRANSACTION_MST
                ```
        }
        layout {
            sequence: 20
            parentRegion: @main
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

