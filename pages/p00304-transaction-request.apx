                color: #858b94;
            }
            
            
            .history-date {
                font-size: 11px;
            
                color: #6d737b;
            
                white-space: nowrap;
            }
            
            
            /* =====================================================
               TABLE HEADER
               ===================================================== */
            
            .product-head,
            .product-row {
                display: grid;
            
                grid-template-columns:
                    minmax(250px, 1fr)
                    80px
                    110px
                    120px;
            
                align-items: center;
            }
            
            
            .product-head {
                min-height: 34px;
            
                padding: 0 14px;
            
                box-sizing: border-box;
            
                background: #fff9e8;
            
                font-size: 11px;
            
                font-weight: 600;
            
                color: #33373c;
            }
            
            
            /* =====================================================
               PRODUCT ROW
               ===================================================== */
            
            .product-row {
                min-height: 46px;
            
                padding: 4px 14px;
            
                box-sizing: border-box;
            
