page 304 (
    name: Transaction Request
    alias: TRANSACTION-REQUEST
    title: Transaction Request
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function populateTransaction() {
            
                if (!$v('P304_PARTY_NO')) {
                    apex.message.alert('Please select party.');
                    return;
                }
            
                if (!$v('P304_TRANSACTION_TYPE')) {
                    apex.message.alert('Please select transaction type.');
                    return;
                }
            
                var model = apex.region("transaction-dtl")
                    .widget()
                    .interactiveGrid("getViews", "grid")
                    .model;
            
                // Already populated?
                if (model.getTotalRecords() > 0) {
                    apex.message.alert('Transaction details already exist.');
                    return;
                }
            
                apex.server.process(
                    'TRANSACTION_POPULATE',
                    {
                        x01: $v('P304_PARTY_NO'),
                        x02: $v('P304_TRANSACTION_TYPE')
                    },
                    {
                        success: function (pData) {
            
                            var json = JSON.parse(pData);
            
                            if (!json || json.length === 0) {
            
                                apex.message.alert(
                                    'No pending transaction found.'
                                );
            
                                return;
                            }
            
                            for (var key in json) {
            
                                if (json.hasOwnProperty(key)) {
            
                                    var rec = model.insertNewRecord();
            
                                    model.setRecordValue(
                                        rec,
                                        "REF_TYPE",
                                        json[key].REF_TYPE.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "REF_NO",
                                        json[key].REF_NO.toString()
                                    );
            
                                    // model.setRecordValue(
                                    //     rec,
                                    //     "DOC_NO",
                                    //     json[key].DOC_NO.toString()
                                    // );
            
                                    model.setRecordValue(
                                        rec,
                                        "DOC_CODE",
                                        json[key].DOC_CODE.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "DOC_DATE",
                                        json[key].DOC_DATE
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_NO",
                                        json[key].PRODUCT_NO.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_CODE",
                                        json[key].PRODUCT_CODE
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_NAME",
                                        json[key].PRODUCT_NAME
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "INVOICE_AMOUNT",
                                        json[key].INVOICE_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PREVIOUS_AMOUNT",
                                        json[key].PREVIOUS_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "DUE_AMOUNT",
                                        json[key].DUE_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "ALLOCATE_AMOUNT",
                                        json[key].ALLOCATE_AMOUNT.toString()
                                    );
            
                                }
            
                            }
            
                            apex.message.showPageSuccess(
                                json.length + ' record(s) loaded successfully.'
                            );
            
                        },
            
                        error: function () {
            
                            apex.message.alert(
                                'Error loading transaction details.'
                            );
            
                        },
            
                        dataType: "text"
            
                    }
            
                );
            
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
