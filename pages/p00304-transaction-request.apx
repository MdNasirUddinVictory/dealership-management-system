    process populate-invoice (
        name: TRANSACTION_POPULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/24/2026 4:31:33 PM (QP5 v5.388) */
                DECLARE
                    V_DATA   CLOB;
                BEGIN
                    ------------------------------------------------------------------
                    -- RECEIVE
                    ------------------------------------------------------------------
                
                    IF APEX_APPLICATION.G_X02 = 'R'
                    THEN
                        SELECT JSON_ARRAYAGG (
                                   JSON_OBJECT (
                                       'REF_TYPE' VALUE 'INVOICE',
                                       'REF_NO' VALUE M.INVOICE_NO,
                                       --'DOC_NO' VALUE M.INVOICE_NO,
                
                                       'DOC_CODE' VALUE M.INVOICE_CODE,
                                       'DOC_DATE' VALUE
                                           TO_CHAR (M.INVOICE_DATE, 'MM/DD/YYYY'),
                                       'PRODUCT_NO' VALUE D.PRODUCT_NO,
                                       'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                                       'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                                       'INVOICE_AMOUNT' VALUE D.TOTAL_AMOUNT,
                                       'PREVIOUS_AMOUNT' VALUE
                                           NVL (
                                               (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                 FROM TRN_TRANSACTION_DTL  T
                                                      JOIN TRN_TRANSACTION_MST H
                                                          ON H.TRANSACTION_NO =
                                                             T.TRANSACTION_NO
                                                WHERE     T.REF_TYPE = 'INVOICE'
                                                      AND T.REF_NO = D.INVOICE_DTL_NO
                                                      AND H.APPROVAL_STATUS = 'A'),
                                               0),
                                       'DUE_AMOUNT' VALUE
                                             D.TOTAL_AMOUNT
                                           - NVL (
                                                 (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                   FROM TRN_TRANSACTION_DTL  T
                                                        JOIN TRN_TRANSACTION_MST H
                                                            ON H.TRANSACTION_NO =
                                                               T.TRANSACTION_NO
                                                  WHERE     T.REF_TYPE = 'INVOICE'
                                                        AND T.REF_NO = D.INVOICE_DTL_NO
                                                        AND H.APPROVAL_STATUS = 'A'),
                                                 0),
                                       'ALLOCATE_AMOUNT' VALUE 0)
                                   RETURNING CLOB)
                          INTO V_DATA
                          FROM TRN_SALES_INVOICE_MST  M
                               JOIN TRN_SALES_INVOICE_DTL D ON D.INVOICE_NO = M.INVOICE_NO
                               JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         WHERE     M.CUSTOMER_NO = APEX_APPLICATION.G_X01
                               AND (  D.TOTAL_AMOUNT
                                    - NVL (
                                          (SELECT SUM (T.ALLOCATE_AMOUNT)
                                            FROM TRN_TRANSACTION_DTL  T
                                                 JOIN TRN_TRANSACTION_MST H
                                                     ON H.TRANSACTION_NO = T.TRANSACTION_NO
                                           WHERE     T.REF_TYPE = 'INVOICE'
                                                 AND T.REF_NO = D.INVOICE_DTL_NO
                                                 AND H.APPROVAL_STATUS = 'A'),
                                          0)) >
                                   0;
                    ------------------------------------------------------------------
                    -- PAYMENT
                    ------------------------------------------------------------------
                
                    ELSIF APEX_APPLICATION.G_X02 = 'P'
                    THEN
                        SELECT JSON_ARRAYAGG (
                                   JSON_OBJECT (
                                       'REF_TYPE' VALUE 'PURCHASE',
                                       'REF_NO' VALUE D.PURCHASE_NO,
                                       -- 'DOC_NO' VALUE M.PURCHASE_NO,
                
                                       'DOC_CODE' VALUE M.PURCHASE_CODE,
                                       'DOC_DATE' VALUE
                                           TO_CHAR (M.PURCHASE_DATE, 'MM/DD/YYYY'),
                                       'PRODUCT_NO' VALUE D.PRODUCT_NO,
                                       'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                                       'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                                       'INVOICE_AMOUNT' VALUE D.TOTAL_AMOUNT,
                                       'PREVIOUS_AMOUNT' VALUE
                                           NVL (
                                               (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                 FROM TRN_TRANSACTION_DTL  T
                                                      JOIN TRN_TRANSACTION_MST H
                                                          ON H.TRANSACTION_NO =
                                                             T.TRANSACTION_NO
                                                WHERE     T.REF_TYPE = 'PURCHASE'
                                                      AND T.PRODUCT_NO = D.PRODUCT_NO
                                                      AND H.APPROVAL_STATUS = 'A'),
                                               0),
                                       'DUE_AMOUNT' VALUE
                                             D.TOTAL_AMOUNT
                                           - NVL (
                                                 (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                   FROM TRN_TRANSACTION_DTL  T
                                                        JOIN TRN_TRANSACTION_MST H
                                                            ON H.TRANSACTION_NO =
                                                               T.TRANSACTION_NO
                                                  WHERE     T.REF_TYPE = 'PURCHASE'
                                                        AND T.PRODUCT_NO = D.PRODUCT_NO
                                                        AND H.APPROVAL_STATUS = 'A'),
                                                 0),
                                       'ALLOCATE_AMOUNT' VALUE   D.TOTAL_AMOUNT
                                           - NVL (
                                                 (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                   FROM TRN_TRANSACTION_DTL  T
                                                        JOIN TRN_TRANSACTION_MST H
                                                            ON H.TRANSACTION_NO =
                                                               T.TRANSACTION_NO
                                                  WHERE     T.REF_TYPE = 'PURCHASE'
                                                        AND T.PRODUCT_NO = D.PRODUCT_NO
                                                        AND H.APPROVAL_STATUS = 'A'),
                                                 0))
                                   RETURNING CLOB)
                          INTO V_DATA
                          FROM TRN_PURCHASE_MST  M
                               JOIN TRN_PURCHASE_DTL D ON D.PURCHASE_NO = M.PURCHASE_NO
                               JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         WHERE     M.SUPPLIER_NO = APEX_APPLICATION.G_X01
                         AND M.APPROVAL_STATUS = 'A'
                               AND (  D.TOTAL_AMOUNT
                                    - NVL (
                                          (SELECT SUM (T.ALLOCATE_AMOUNT)
                                            FROM TRN_TRANSACTION_DTL  T
                                                 JOIN TRN_TRANSACTION_MST H
                                                     ON H.TRANSACTION_NO = T.TRANSACTION_NO
                                           WHERE     T.REF_TYPE = 'PURCHASE'
                                                 AND T.REF_NO = D.PURCHASE_DTL_NO
                                                 AND H.APPROVAL_STATUS = 'A'),
                                          0)) >
                                   0;
                    END IF;
                
                    IF V_DATA IS NULL
                    THEN
                        V_DATA := '[]';
                    END IF;
                
                    HTP.PRN (V_DATA);
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        HTP.PRN ('[]');
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 14788393078656363429
        }
    )

    process process-form-trn-mst (
        name: Process form TRN_MST
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    -------------------------------------------------
                    -- Validation
                    -------------------------------------------------
                
                    IF :P304_TRANSACTION_DATE IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20001,'Transaction date is required.');
                    END IF;
                
                    IF :P304_TRANSACTION_TYPE IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20001,'Transaction type is required.');
                    END IF;
                
                    IF :P304_PARTY_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20001,'Please select party.');
                    END IF;
                
                    -- IF NVL(:P304_TOTAL_AMOUNT,0)<=0 THEN
                    --     RAISE_APPLICATION_ERROR(-20001,'Transaction amount must be greater than zero.');
                    -- END IF;
                
                    IF :P304_PAY_MODE='B'
                    AND :P304_BANK_ACCOUNT_NO IS NULL THEN
                
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            'Please select bank account.'
                        );
                
                    END IF;
                
                    -------------------------------------------------
                    -- Insert
                    -------------------------------------------------
                
                    IF :P304_TRANSACTION_NO IS NULL THEN
                
                        :P304_TRANSACTION_NO:=SEQ_TRANSACTION_NO.NEXTVAL;
                
                        INSERT INTO TRN_TRANSACTION_MST
                        (
                            TRANSACTION_NO,
                            TRANSACTION_CODE,
                            TRANSACTION_DATE,
                            TRANSACTION_TYPE,
                            PARTY_NO,
                            PAY_MODE,
                            BANK_ACCOUNT_NO,
                            TOTAL_AMOUNT,
                            REMARKS,
                            APPROVAL_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            :P304_TRANSACTION_NO,
                            'TRN-'||LPAD(:P304_TRANSACTION_NO,6,'0'),
                            :P304_TRANSACTION_DATE,
                            :P304_TRANSACTION_TYPE,
                            :P304_PARTY_NO,
                            :P304_PAY_MODE,
                            :P304_BANK_ACCOUNT_NO,
                            :P304_TOTAL_AMOUNT,
                            :P304_REMARKS,
                            'P',
                            :APP_USER,
                            SYSDATE
                        ) RETURNING TRANSACTION_NO INTO :P304_TRANSACTION_NO;
                
                    ELSE
                
                        IF :P304_APPROVAL_STATUS='A' THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Approved transaction cannot be modified.'
                            );
                
                        END IF;
                
                        UPDATE TRN_TRANSACTION_MST
                           SET TRANSACTION_DATE=:P304_TRANSACTION_DATE,
                               PARTY_NO=:P304_PARTY_NO,
                               PAY_MODE=:P304_PAY_MODE,
                               BANK_ACCOUNT_NO=:P304_BANK_ACCOUNT_NO,
                               TOTAL_AMOUNT=:P304_TOTAL_AMOUNT,
                               REMARKS=:P304_REMARKS,
                               UPDATED_BY=:APP_USER,
                               UPDATED_DATE=SYSDATE
                         WHERE TRANSACTION_NO=:P304_TRANSACTION_NO;
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14788394214805363441
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process trn-dtl-save-interactive-grid-data (
        name: TRN DTL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @trn-dtl
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                BEGIN
                
                    CASE :APEX$ROW_STATUS
                
                    -----------------------------------------------------
                    -- CREATE
                    -----------------------------------------------------
                
                    WHEN 'C' THEN
                
                        IF NVL(:ALLOCATE_AMOUNT,0)<=0 THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Allocate amount must be greater than zero.'
                            );
                
                        END IF;
                
                        IF TO_NUMBER(:ALLOCATE_AMOUNT)>TO_NUMBER(:DUE_AMOUNT) THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Allocate amount cannot exceed due amount.'
                            );
                
                        END IF;
                
                        INSERT INTO TRN_TRANSACTION_DTL
                        (
                            TRANSACTION_DTL_NO,
                            TRANSACTION_NO,
                            REF_TYPE,
                            REF_NO,
                            DOC_NO,
                            DOC_CODE,
                            DOC_DATE,
                            PRODUCT_NO,
                            INVOICE_AMOUNT,
                            PREVIOUS_AMOUNT,
                            DUE_AMOUNT,
                            ALLOCATE_AMOUNT,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_TRANSACTION_DTL_NO.NEXTVAL,
                            :P304_TRANSACTION_NO,
                            :REF_TYPE,
                            :REF_NO,
                            :DOC_NO,
                            :DOC_CODE,
                            :DOC_DATE,
                            :PRODUCT_NO,
                            :INVOICE_AMOUNT,
                            :PREVIOUS_AMOUNT,
                            :DUE_AMOUNT,
                            :ALLOCATE_AMOUNT,
                            :REMARKS,
                            :APP_USER,
                            SYSDATE
                        ) RETURNING TRANSACTION_DTL_NO INTO :TRANSACTION_DTL_NO ;
                
                    -----------------------------------------------------
                    -- UPDATE
                    -----------------------------------------------------
                
                    WHEN 'U' THEN
                
                        IF :P304_APPROVAL_STATUS='A' THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Approved transaction cannot be modified.'
                            );
                
                        END IF;
                
                        IF NVL(:ALLOCATE_AMOUNT,0)<=0 THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Allocate amount must be greater than zero.'
                            );
                
                        END IF;
                
                        IF :ALLOCATE_AMOUNT>:DUE_AMOUNT THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Allocate amount cannot exceed due amount.'
                            );
                
                        END IF;
                
                        UPDATE TRN_TRANSACTION_DTL
                           SET ALLOCATE_AMOUNT=:ALLOCATE_AMOUNT,
                               REMARKS=:REMARKS
                         WHERE TRANSACTION_DTL_NO=:TRANSACTION_DTL_NO;
                
                    -----------------------------------------------------
                    -- DELETE
                    -----------------------------------------------------
                
                    WHEN 'D' THEN
                
                        IF :P304_APPROVAL_STATUS='A' THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Approved transaction cannot be deleted.'
                            );
                
                        END IF;
                
                        DELETE
                          FROM TRN_TRANSACTION_DTL
                         WHERE TRANSACTION_DTL_NO=:TRANSACTION_DTL_NO;
                
                    END CASE;
                
                    DECLARE
                    V_TOTAL NUMBER;
                BEGIN
                
                    SELECT NVL(SUM(ALLOCATE_AMOUNT),0)
                      INTO V_TOTAL
                      FROM TRN_TRANSACTION_DTL
                     WHERE TRANSACTION_NO=:P304_TRANSACTION_NO;
                
                    UPDATE TRN_TRANSACTION_MST
                       SET TOTAL_AMOUNT=V_TOTAL
                     WHERE TRANSACTION_NO=:P304_TRANSACTION_NO;
                
                END;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14788394199033363440
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

