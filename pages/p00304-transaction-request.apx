    region supplier-summery (
        name: SUPPLIER SUMMERY
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/25/2026 4:45:21 PM (QP5 v5.388) */
                DECLARE
                    v_html   CLOB;
                BEGIN
                    SELECT    '<div id="supplier_summary"
                                 style="
                                    width:100%;
                                    max-width:240px;
                                    box-sizing:border-box;
                                    padding:6px 9px;
                                    border:1px solid #e1e5e9;
                                    border-radius:5px;
                                    background:#fff;
                                    font-size:11px;
                                    line-height:1.55;
                                 ">
                
                                <!-- Supplier -->
                                <div style="
                                    font-size:12px;
                                    font-weight:600;
                                    color:#333;
                                    margin-bottom:5px;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    text-overflow:ellipsis;
                                ">
                                    Supplier:
                                    '
                           || NVL (S.SUPPLIER_NAME, 'N/A')
                           || '
                                </div>
                
                                <!-- PREVIOUS -->
                                <div style="
                                    margin-top:2px;
                                    margin-bottom:4px;
                                    padding:3px 6px;
                                    border-left:3px solid #7b8794;
                                    background:#f4f6f8;
                                    color:#5f6b76;
                                    font-size:10px;
                                    font-weight:700;
                                    text-transform:uppercase;
                                    letter-spacing:.5px;
                                ">
                                    Previous
                                </div>
                
                                <!-- Purchase -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                ">
                                    <span>Purchase</span>
                
                                    <b>
                                        ৳ '
                           || TO_CHAR (NVL (X.PURCHASE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                                </div>
                
                                <!-- Paid -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                ">
                                    <span>Paid</span>
                
                                    <b>
                                        ৳ '
                           || TO_CHAR (NVL (X.PAID_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                                </div>
                
                                <!-- Due -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                    border-top:1px solid #eee;
                                    margin-top:2px;
                                    padding-top:2px;
                                ">
                                    <span>Due</span>
                
                                    <b style="
                                        color:#c0392b;
                                        font-weight:700;
                                    ">
                                        ৳ '
                           || TO_CHAR (NVL (X.DUE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                                </div>
                
                                <!-- Payment Status -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                ">
                                    <span>Status</span>
                
                                    <b style="
                                        color:'
                           || CASE X.PAYMENT_STATUS
                                  WHEN 'Paid' THEN '#27ae60'
                                  WHEN 'Unpaid' THEN '#c0392b'
                                  ELSE '#e67e22'
                              END
                           || ';
                                        font-weight:700;
                                    ">
                                        '
                           || NVL (X.PAYMENT_STATUS, 'Unpaid')
                           || '
                                    </b>
                                </div>
                
                           </div>'
                      INTO v_html
                      FROM MST_SUPPLIER  S
                           LEFT JOIN
                           (  SELECT M.SUPPLIER_NO,
                                     SUM (NVL (M.TOTAL_AMOUNT, 0))    AS PURCHASE_AMOUNT,
                                     SUM (NVL (M.PAID_AMOUNT, 0))     AS PAID_AMOUNT,
                                     SUM (NVL (M.DUE_AMOUNT, 0))      AS DUE_AMOUNT,
                                     CASE
                                         WHEN SUM (NVL (M.DUE_AMOUNT, 0)) = 0 THEN 'Paid'
                                         WHEN SUM (NVL (M.PAID_AMOUNT, 0)) = 0 THEN 'Unpaid'
                                         ELSE 'Partially Paid'
                                     END                              AS PAYMENT_STATUS
                                FROM TRN_PURCHASE_MST M
                            GROUP BY M.SUPPLIER_NO) X
                               ON X.SUPPLIER_NO = S.SUPPLIER_NO
                     WHERE S.SUPPLIER_NO = :P304_PARTY_NO;
                
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                            font-size:11px;
                            color:#777;
                            padding:6px;
                        ">
                            Supplier summary unavailable.
                         </div>';
                END;
                ```
            pageItemsToSubmit: P304_PARTY_NO
        }
        layout {
