    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function saveReceiveTransaction() {
            
                var customerNo = $v("P304_PARTY_NO");
            
                if (!customerNo) {
            
                    apex.message.alert(
                        "Please select a customer."
                    );
            
                    return;
                }
            
            
                var totalReceive = parseFloat(
                    $v("P304_TOTAL_AMOUNT") || 0
                );
            
            
                if (totalReceive <= 0) {
            
                    apex.message.alert(
                        "Please enter receive amount."
                    );
            
                    return;
                }
            
            
                var allocations = [];
            
            
                $(".invoice-card").each(function() {
            
                    var card = $(this);
            
                    var invoiceNo =
                        card.attr("data-invoice-no");
            
                    var due =
                        parseFloat(
                            card.attr("data-due") || 0
                        );
            
                    var amount =
                        parseFloat(
                            card.find(".receive-input").val() || 0
                        );
            
            
                    if (amount > 0) {
            
                        if (amount > due) {
            
                            apex.message.alert(
                                "Receive amount cannot exceed invoice due."
                            );
            
                            return false;
                        }
            
            
                        allocations.push({
                            invoice_no: Number(invoiceNo),
                            amount: amount
                        });
            
                    }
            
                });
            
            
                if (allocations.length === 0) {
            
                    apex.message.alert(
                        "Please allocate payment to at least one invoice."
                    );
            
                    return;
                }
            
            
                apex.server.process(
                    "SAVE_RECEIVE",
                    {
                        x01: JSON.stringify(allocations)
                    },
                    {
                        dataType: "json",
            
                        success: function(data) {
            
                            if (data.status === "success") {
            
                                apex.message.showPageSuccess(
                                    "Customer receive saved successfully. Transaction: "
                                    + data.transaction_code
                                );
            
                                setTimeout(function() {
            
                                    location.reload();
            
                                }, 1000);
            
                            } else {
            
                                apex.message.alert(
                                    data.message || "Unable to save transaction."
                                );
            
                            }
            
                        },
            
                        error: function(xhr) {
            
                            console.error(xhr.responseText);
            
                            apex.message.alert(
                                "Error while saving receive transaction."
                            );
            
                        }
                    }
                );
            
            }
            
            
            
            function populateTransaction() {
            
                if (!$v('P304_PARTY_NO')) {
                    apex.message.alert('Please select party.');
                    return;
                }
            
                if (!$v('P304_TRANSACTION_TYPE')) {
                    apex.message.alert('Please select transaction type.');
                    return;
                }
            
                var model = apex.region("transaction-dtl")
                    .widget()
                    .interactiveGrid("getViews", "grid")
                    .model;
            
                // Already populated?
                if (model.getTotalRecords() > 0) {
                    apex.message.alert('Transaction details already exist.');
                    return;
                }
            
                apex.server.process(
                    'TRANSACTION_POPULATE',
                    {
                        x01: $v('P304_PARTY_NO'),
                        x02: $v('P304_TRANSACTION_TYPE')
                    },
                    {
                        success: function (pData) {
            
                            var json = JSON.parse(pData);
            
                            if (!json || json.length === 0) {
            
                                apex.message.alert(
                                    'No pending transaction found.'
                                );
            
                                return;
                            }
            
                            for (var key in json) {
            
                                if (json.hasOwnProperty(key)) {
            
                                    var rec = model.insertNewRecord();
            
                                    model.setRecordValue(
                                        rec,
                                        "REF_TYPE",
                                        json[key].REF_TYPE.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "REF_NO",
                                        json[key].REF_NO.toString()
                                    );
            
                                    // model.setRecordValue(
                                    //     rec,
                                    //     "DOC_NO",
                                    //     json[key].DOC_NO.toString()
                                    // );
            
                                    model.setRecordValue(
                                        rec,
                                        "DOC_CODE",
                                        json[key].DOC_CODE.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "DOC_DATE",
                                        json[key].DOC_DATE
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_NO",
                                        json[key].PRODUCT_NO.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_CODE",
                                        json[key].PRODUCT_CODE
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_NAME",
                                        json[key].PRODUCT_NAME
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "INVOICE_AMOUNT",
                                        json[key].INVOICE_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PREVIOUS_AMOUNT",
                                        json[key].PREVIOUS_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "DUE_AMOUNT",
                                        json[key].DUE_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "ALLOCATE_AMOUNT",
                                        json[key].ALLOCATE_AMOUNT.toString()
                                    );
            
                                }
            
                            }
            
                            apex.message.showPageSuccess(
                                json.length + ' record(s) loaded successfully.'
                            );
            
                        },
            
                        error: function () {
            
                            apex.message.alert(
                                'Error loading transaction details.'
                            );
            
                        },
            
                        dataType: "text"
            
                    }
            
                );
            
            }
            ```
    }
    css {
        inline:
            ```css
            /* ================================
               CUSTOMER RECEIVED ITEMS
               ================================ */
            
            #P304_TOTAL_AMOUNT,
            #P304_PREVIOUS_PAYMNET,
            #P304_DUE_AMOUNT,
            #P304_PAYMENT_AMOUNT {
                height: 32PX;
                border: 1px solid #d9dee5;
                border-radius: 7px;
                background: #f8fafc;
                padding: 0 12px;
                font-size: 16px;
                font-weight: 700;
                text-align: right;
                box-sizing: border-box;
                transition: all 0.2s ease;
            }
            
            /* Label */
            /* label[for="P304_TOTAL_AMOUNT"],
            label[for="P304_PREVIOUS_PAYMNET"],
            label[for="P304_DUE_AMOUNT"],
            label[for="P304_PAYMENT_AMOUNT"] {
                font-size: 12px;
                font-weight: 600;
                color: #667085;
            } */
            
            /* Total */
            #P304_TOTAL_AMOUNT {
                color: #344054;
            }
            
            /* Previous Payment */
            #P304_PREVIOUS_PAYMNET {
                color: #475467;
            }
            
            /* Due */
            #P304_DUE_AMOUNT {
                color: #dc2626;
                background: #fff7f7;
                border-color: #fecaca;
            }
            
            /* Received */
            #P304_PAYMENT_AMOUNT {
                color: #15803d;
                background: #f0fdf4;
                border-color: #bbf7d0;
            }
            
            /* Focus */
            #P304_PAYMENT_AMOUNT:focus {
                border-color: #16a34a;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.10);
                outline: none;
            }
            
            /* Mobile */
            @media (max-width: 600px) {
                #P304_TOTAL_AMOUNT,
                #P304_PREVIOUS_PAYMNET,
                #P304_DUE_AMOUNT,
                #P304_PAYMENT_AMOUNT {
                    height: 40px;
                    font-size: 15px;
                }
            }
            /* =====================================================
               PAYMENT BUTTON COLOR
               ===================================================== */
            
            #payment_btn {
                width: 100%;
                height: 38px;
            
                border: none !important;
                border-radius: 25px !important;
            
                background: linear-gradient(
                    90deg,
                    #9b3db0,
                    #c21891,
                    #f0008c,
                    #c21891,
                    #9b3db0
                ) !important;
            
                background-size: 300% 100%;
            
                color: #fff !important;
            
                font-size: 18px !important;
                font-weight: 600 !important;
            
                cursor: pointer;
            
                box-shadow: 0 4px 10px rgba(194, 24, 145, 0.20) !important;
            
                transition:
                    transform 0.25s ease,
                    box-shadow 0.25s ease;
            
                animation: orderPayGradient 5s ease infinite;
            }
            
            
            /* Gradient movement */
            @keyframes orderPayGradient {
                0% {
                    background-position: 0% 50%;
                }
            
                50% {
                    background-position: 100% 50%;
                }
            
                100% {
                    background-position: 0% 50%;
                }
            }
            
            
            /* Hover Animation */
            #payment_btn:hover {
                transform: translateY(-2px) scale(1.01);
            
                box-shadow:
                    0 7px 18px rgba(194, 24, 145, 0.35) !important;
            }
            
            
            /* Click */
            #payment_btn:active {
                transform: translateY(0) scale(0.98);
            }
            
            
            
            
            /* =====================================================
               MAIN CARD
               ===================================================== */
            
            .receive-card {
                width: 100%;
            
                min-height: 88px;
            
                display: flex;
                align-items: center;
            
                box-sizing: border-box;
            
                padding: 12px 18px;
            
                background: #ffffff;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 6px;
            
                box-shadow: 0 1px 3px rgba(0,0,0,.05);
            
                overflow: hidden;
            }
            
            
            /* =====================================================
               LEFT CUSTOMER SECTION
               ===================================================== */
            
            .customer-section {
                flex: 1;
            
                min-width: 0;
            
                padding-right: 20px;
            
                border-right: 1px solid #eeeeee;
            }
            
            
            .customer-main {
                display: flex;
            
                align-items: center;
            
                gap: 10px;
            }
            
            
            /* =====================================================
               HOME BADGE
               ===================================================== */
            
            .home-badge {
                display: flex;
            
                align-items: center;
            
                justify-content: center;
            
                gap: 6px;
            
                width: 74px;
            
                height: 34px;
            
                flex-shrink: 0;
            
                background: #eaf7ed;
            
                color: #087f23;
            
                border-radius: 5px;
            
                font-size: 13px;
            
                font-weight: 500;
            }
            
            
            .home-badge i {
                font-size: 15px;
            }
            
            
            /* =====================================================
               CUSTOMER INFO
               ===================================================== */
            
            .customer-info {
                display: flex;
            
                flex-direction: column;
            
                min-width: 0;
            
                line-height: 1.25;
            }
            
            
            .customer-name {
                font-size: 14px;
            
                font-weight: 700;
            
                color: #17191c;
            
                white-space: nowrap;
            
                overflow: hidden;
            
                text-overflow: ellipsis;
            }
            
            
            .customer-phone {
                margin-top: 2px;
            
                font-size: 11px;
            
                color: #555b63;
            }
            
            
            /* =====================================================
               ADDRESS
               ===================================================== */
            
            .address-bottom {
                display: flex;
            
                align-items: center;
            
                gap: 8px;
            
                margin-top: 6px;
            
                font-size: 11px;
            
                color: #60656d;
            }
            
            
            .customer-address {
                min-width: 0;
            
