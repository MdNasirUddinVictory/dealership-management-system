                color: #33373c;
            
                background: #fafafa;
            }
            
            
            /* =====================================================
               PRICE
               ===================================================== */
            
            .price-col {
                text-align: right;
            
                font-size: 11px;
            
                color: #555b63;
            }
            
            
            /* =====================================================
               TOTAL
               ===================================================== */
            
            .total-col {
                text-align: right;
            
                font-size: 12px;
            
                font-weight: 700;
            
                color: #17191c;
            }
            
            
            /* =====================================================
               FOOTER
               ===================================================== */
            
            .history-footer {
                display: flex;
            
                align-items: center;
            
                justify-content: flex-end;
            
                gap: 20px;
            
                min-height: 38px;
            
                padding: 0 14px;
            
                background: #fafafa;
            
                border-top: 1px solid #eeeeee;
            }
            
            
            .item-count {
                font-size: 11px;
            
                color: #666d76;
            }
            
            
            .history-total-label {
                font-size: 11px;
            
                color: #666d76;
            }
            
            
            .history-total-label strong {
                margin-left: 6px;
            
                font-size: 14px;
            
                color: #17191c;
            }
            
            
            /* =====================================================
               EMPTY
               ===================================================== */
            
            .invoice-history-empty {
                min-height: 100px;
            
                display: flex;
            
                flex-direction: column;
            
                align-items: center;
            
                justify-content: center;
            
                gap: 7px;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 7px;
            
                background: #ffffff;
            
                color: #9298a1;
            
                font-size: 11px;
            }
            
            
            .invoice-history-empty i {
                font-size: 21px;
            
                color: #c1c6cc;
            }
            
            
            /* =====================================================
               MOBILE
               ===================================================== */
            
            @media (max-width: 700px) {
            
                .product-head,
                .product-row {
            
                    grid-template-columns:
                        minmax(140px, 1fr)
                        50px
                        75px
                        85px;
            
                    padding-left: 9px;
                    padding-right: 9px;
                }
            
            
                .product-head {
                    min-height: 31px;
            
                    font-size: 10px;
                }
            
            
                .product-row {
                    min-height: 42px;
            
                    padding-top: 3px;
                    padding-bottom: 3px;
                }
            
            
                .product-name {
                    font-size: 11px;
            
                    line-height: 1.15;
                }
            
            
                .product-code {
                    font-size: 8px;
                }
            
            
                .qty-value {
                    height: 21px;
            
                    font-size: 10px;
                }
            
            
                .price-col {
                    font-size: 10px;
                }
            
            
                .total-col {
                    font-size: 11px;
                }
            
            
                .history-header {
                    padding: 9px 10px;
                }
            
            
                .history-title {
                    font-size: 14px;
                }
            
            
                .history-subtitle {
                    font-size: 9px;
                }
            
            
                .history-date {
                    font-size: 10px;
                }
            
            
                .history-footer {
                    min-height: 36px;
            
                    padding: 0 10px;
                }
            
            
                .item-count,
                .history-total-label {
                    font-size: 10px;
                }
            
            
                .history-total-label strong {
                    font-size: 13px;
                }
            
            }
            
            /* =====================================================
               PAYMENT SUMMARY BLOCK
               ===================================================== */
            
            .invoice-payment-summary {
            
                width: 100%;
            
                box-sizing: border-box;
            
                margin-top: 0;              /* NO GAP */
            
                padding: 7px 14px;
            
                background: #ffffff;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 0 0 7px 7px;
            
                overflow: hidden;
            
                box-shadow: none;
            }
            
            
            /* =====================================================
               PAYMENT LINE
               ===================================================== */
            
            .payment-line {
            
                display: flex;
            
                align-items: center;
            
                justify-content: space-between;
            
                min-height: 29px;
            
                border-bottom: 1px solid #f0f1f2;
            
            }
            
            
            .payment-line:last-child {
            
                border-bottom: none;
            
            }
            
            
            /* =====================================================
               LABEL
               ===================================================== */
            
            .payment-label {
            
                font-size: 10px;
            
                font-weight: 600;
            
                letter-spacing: .2px;
            
                color: #737981;
            
            }
            
            
            /* =====================================================
               VALUE
               ===================================================== */
            
            .payment-value {
            
                font-size: 13px;
            
                font-weight: 700;
            
                letter-spacing: .1px;
            
                color: #25282d;
            
            }
            
            
            /* =====================================================
               RECEIVED / PAYMENT
               ===================================================== */
            
            .payment-received {
            
                color: #348454;
            
            }
            
            
            /* =====================================================
               DUE
               ===================================================== */
            
            .payment-due {
            
                color: #c17800;
            
            }
            
            
            /* =====================================================
               STATUS
               ===================================================== */
            
            .payment-status-row {
            
                min-height: 32px;
            
            }
            
            
            .payment-status {
            
                display: inline-flex;
            
                align-items: center;
            
                justify-content: center;
            
                gap: 5px;
            
                min-width: 68px;
            
                padding: 4px 9px;
            
                box-sizing: border-box;
            
                border-radius: 5px;
            
                font-size: 9px;
            
                font-weight: 700;
            
                letter-spacing: .4px;
            
            }
            
            
            /* =====================================================
               PAID
               ===================================================== */
            
            .status-paid {
            
                background: #edf7f0;
            
                color: #348454;
            
            }
            
            
            /* =====================================================
               PARTIAL
               ===================================================== */
            
            .status-partial {
            
                background: #fff7df;
            
                color: #a66d00;
            
            }
            
            
            /* =====================================================
               UNPAID
               ===================================================== */
            
            .status-unpaid {
            
                background: #fff0f0;
            
                color: #b84d4d;
            
            }
            
            
            /* =====================================================
               MOBILE
               ===================================================== */
            
            @media (max-width: 700px) {
            
                .invoice-payment-summary {
            
                    margin-top: 0;
            
                    padding: 5px 10px;
            
                    border-radius: 0 0 7px 7px;
            
                }
            
            
                .payment-line {
            
                    min-height: 27px;
            
                }
            
            
                .payment-label {
            
                    font-size: 9px;
            
                    font-weight: 600;
            
                }
            
            
                .payment-value {
            
                    font-size: 12px;
            
                    font-weight: 700;
            
                }
            
            
                .payment-status-row {
            
                    min-height: 30px;
            
                }
            
            
                .payment-status {
            
                    min-width: 62px;
            
                    padding: 3px 7px;
            
                    font-size: 8px;
            
                }
            
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region address (
        name: ADDRESS
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_html CLOB := '';
                    l_url  VARCHAR2(4000);
                
                    l_customer_name MST_CUSTOMER.CUSTOMER_NAME%TYPE;
                    l_customer_code MST_CUSTOMER.CUSTOMER_CODE%TYPE;
                    l_mobile_no     MST_CUSTOMER.MOBILE_NO%TYPE;
                    l_address       MST_CUSTOMER.ADDRESS%TYPE;
                BEGIN
                
                    /* =====================================================
                       GET CUSTOMER INFORMATION
                       ===================================================== */
                
                    SELECT
                        CUSTOMER_NAME,
                        CUSTOMER_CODE,
                        MOBILE_NO,
                        ADDRESS
                    INTO
                        l_customer_name,
                        l_customer_code,
                        l_mobile_no,
                        l_address
                    FROM MST_CUSTOMER
                    WHERE CUSTOMER_NO = :P304_PARTY_NO
                      AND ACTIVE_FLAG = '1';
                
                
                    /* =====================================================
                       PAGE 25 URL
                       ===================================================== */
                
                    l_url := apex_page.get_url(
                        p_page   => 25,
                        p_items  => 'P25_CUSTOMER_NO',
                        p_values => :P304_PARTY_NO
                    );
                
                
                    /* =====================================================
                       HTML
                       ===================================================== */
                
                    l_html := '
                
                    <div class="receive-card">
                
                
                        <!-- =================================================
                             LEFT : CUSTOMER / ADDRESS
                             ================================================= -->
                
                        <div class="customer-section">
                
                            <div class="customer-main">
                
                
                                <!-- HOME -->
                
                                <div class="home-badge">
                
                                    <i class="fa fa-home"></i>
                
                                    <span>
                                        Home
                                    </span>
                
                                </div>
                
                
                                <!-- CUSTOMER INFO -->
                
                                <div class="customer-info">
                
                                    <div class="customer-name">
                                        ' ||
                                        apex_escape.html(l_customer_name) ||
                                        '
                                    </div>
                
                                    <div class="customer-phone">
                                        ' ||
                                        apex_escape.html(l_mobile_no) ||
                                        '
                                    </div>
                
                                </div>
                
                            </div>
                
                
                            <!-- ADDRESS -->
                
                            <div class="address-bottom">
                
                                <span class="customer-address">
                
                                    ' ||
                                    apex_escape.html(
                                        NVL(
                                            l_address,
                                            'No delivery address available'
                                        )
                                    ) ||
                                    '
                
                                </span>
                
                
                                <a href="' ||
                                    apex_escape.html_attribute(l_url) ||
                                    '"
                                   class="change-address">
                
                                    Change address &gt;
                
                                </a>
                
                            </div>
                
                        </div>
                
                
                
                        <!-- =================================================
                             MIDDLE : CUSTOMER RECEIVE
                             ================================================= -->
                
                        <div class="receive-section">
                
                            <div class="receive-title">
                                Customer Receive
                            </div>
                
                            <div class="receive-subtitle">
                                Receive payment against customer invoice
                            </div>
                
                        </div>
                
                
                
                        <!-- =================================================
                             RIGHT : DELIVERY ADDRESS
                             ================================================= -->
                
                        <div class="delivery-section">
                
                
                            <div class="delivery-title">
                
                                <i class="fa fa-map-marker"></i>
                
                                <span>
                                    Select a delivery address
                                </span>
                
                            </div>
                
                
                            <a href="' ||
                                apex_escape.html_attribute(l_url) ||
                                '"
                               class="add-address-btn">
                
                                <span class="add-icon">+</span>
                
                                <span>
                                    Add address
                                </span>
                
                            </a>
                
                        </div>
                
                
                    </div>';
                
                
                
                    RETURN l_html;
                
                
                
                EXCEPTION
                
                    WHEN NO_DATA_FOUND THEN
                
                        RETURN '
                
                        <div class="receive-card">
                
                
                            <!-- LEFT -->
                
                            <div class="customer-section">
                
                                <div class="customer-main">
                
                                    <div class="home-badge">
                
                                        <i class="fa fa-home"></i>
                
                                        <span>
                                            Home
                                        </span>
                
                                    </div>
                
                                    <div class="customer-info">
                
                                        <div class="customer-name">
                                            No Customer
                                        </div>
                
                                        <div class="customer-phone">
                                            -
                                        </div>
                
                                    </div>
                
                                </div>
                
                
                                <div class="address-bottom">
                
                                    <span class="customer-address">
                                        Please select a customer
                                    </span>
                
                                </div>
                
                            </div>
                
                
                
                            <!-- MIDDLE -->
                
                            <div class="receive-section">
                
                                <div class="receive-title">
                                    Customer Receive
                                </div>
                
                                <div class="receive-subtitle">
                                    Receive payment against customer invoice
                                </div>
                
                            </div>
                
                
                
                            <!-- RIGHT -->
                
                            <div class="delivery-section">
                
                                <div class="delivery-title">
                
                                    <i class="fa fa-map-marker"></i>
                
                                    <span>
                                        Select a delivery address
                                    </span>
                
                                </div>
                
                                <span class="add-address-btn disabled">
                
                                    <span class="add-icon">+</span>
                
                                    Add address
                
                                </span>
                
                            </div>
                
                
                        </div>';
                
                END;
                ```
            pageItemsToSubmit: P304_PARTY_NO
        }
        layout {
            sequence: 1
            parentRegion: @main
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

