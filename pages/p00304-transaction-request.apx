    pageItem P304_PARTY_NO (
        type: selectList
        label {
            label: Customer/Supplier
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PARTY_NAME D,
                       PARTY_NO   R
                FROM
                (
                    SELECT CUSTOMER_NAME PARTY_NAME,
                           CUSTOMER_NO   PARTY_NO
                      FROM MST_CUSTOMER
                     WHERE :P304_TRANSACTION_TYPE = 'R'
                
                    UNION ALL
                
                    SELECT SUPPLIER_NAME,
                           SUPPLIER_NO
                      FROM MST_SUPPLIER
                     WHERE :P304_TRANSACTION_TYPE = 'P'
                )
                ORDER BY D;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P304_TRANSACTION_TYPE
            itemsToSubmit: P304_TRANSACTION_TYPE
        }
        layout {
            sequence: 100
            region: @trn-mst
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
        source {
            formRegion: @trn-mst
            column: PARTY_NO
            dataType: number
        }
    )

