    process invoice-wise-total-amount (
        name: INVOICE_WISE_TOTAL_AMOUNT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 BEGIN
                  SELECT M.INVOICE_NO                                AS INVOICE_NO,
                         M.TOTAL_AMOUNT                              AS INVOICE_AMOUNT,
                         NVL (M.DUE_AMOUNT, 0)                       AS DUE_AMOUNT,
                         M.RECEIVED_AMOUNT                           AS RECEIVED_AMOUNT INTO :P304_INVOICE ,:P304_TOTAL_AMOUNT,:P304_DUE_AMOUNT,:P304_PREVIOUS_PAYMNET
                    FROM TRN_SALES_INVOICE_MST M
                   WHERE M.CUSTOMER_NO = :P304_PARTY_NO AND NVL (M.DUE_AMOUNT, 0) > 0
                ORDER BY M.INVOICE_DATE DESC;
                EXCEPTION 
                WHEN NO_DATA_FOUND
                THEN NULL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12000002336732018
        }
    )

    process new (
        name: TRANSACTION_PROCESS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* ============================================================
                   CUSTOMER PAYMENT - PAGE SUBMIT PROCESS
                   PAGE : 304
                   TRANSACTION TYPE : R = Receive
                   APPROVAL STATUS  : P = Pending
                   ============================================================ */
                
                DECLARE
                    l_txn_no            NUMBER;
                    l_previous_amount   NUMBER := 0;
                    l_due_amount        NUMBER := 0;
                    l_invoice_amount    NUMBER := 0;
                    l_txn_code          VARCHAR2(100);
                    l_pending_count     NUMBER := 0;
                    l_net_amount   number :=0;
                BEGIN
                
                    /* ============================================================
                       1. VALIDATION
                       ============================================================ */
                
                    IF :P304_PARTY_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select customer.'
                        );
                    END IF;
                
                    IF :P304_INVOICE IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20002,
                            'Please select invoice.'
                        );
                    END IF;
                
                    IF NVL(:P304_PAYMENT_AMOUNT, 0) <= 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20003,
                            'Payment amount must be greater than zero.'
                        );
                    END IF;
                
                
                    /* ============================================================
                       2. CHECK PENDING PAYMENT REQUEST
                       ============================================================ */
                
                    SELECT COUNT(*)
                      INTO l_pending_count
                      FROM TRN_TRANSACTION_DTL D
                      JOIN TRN_TRANSACTION_MST M
                        ON M.TRANSACTION_NO = D.TRANSACTION_NO
                     WHERE D.REF_TYPE = 'INVOICE'
                       AND D.REF_NO = :P304_INVOICE
                       AND M.PARTY_NO = :P304_PARTY_NO
                       AND M.TRANSACTION_TYPE = 'R'
                       AND M.APPROVAL_STATUS = 'P';
                
                    IF l_pending_count > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20007,
                            'A payment request for this invoice is already pending approval. '
                            || 'Please wait until it is approved.'
                        );
                    END IF;
                
                
                    /* ============================================================
                       3. GET INVOICE AMOUNT
                          NET_AMOUNT IS ALREADY FINAL INVOICE AMOUNT
                       ============================================================ */
                
                    SELECT NVL(M.TOTAL_AMOUNT, 0),NVL(M.NET_AMOUNT, 0)
                      INTO l_invoice_amount,l_net_amount
                      FROM TRN_SALES_INVOICE_MST M
                     WHERE M.INVOICE_NO = :P304_INVOICE
                       AND M.CUSTOMER_NO = :P304_PARTY_NO;
                
                
                    /* ============================================================
                       4. GET PREVIOUS APPROVED PAYMENT
                       ============================================================ */
                
                    SELECT NVL(SUM(NVL(D.ALLOCATE_AMOUNT, 0)), 0)
                      INTO l_previous_amount
                      FROM TRN_TRANSACTION_DTL D
                      JOIN TRN_TRANSACTION_MST M
                        ON M.TRANSACTION_NO = D.TRANSACTION_NO
                     WHERE D.REF_TYPE = 'INVOICE'
                       AND D.REF_NO = :P304_INVOICE
                       AND M.PARTY_NO = :P304_PARTY_NO
                       AND M.TRANSACTION_TYPE = 'R'
                       AND M.APPROVAL_STATUS = 'A';
                
                
                    /* ============================================================
                       5. CALCULATE CURRENT INVOICE DUE
                       ============================================================ */
                
                    l_due_amount :=
                          NVL(l_net_amount, 0)
                        - NVL(l_previous_amount, 0);
                
                
                    /* ============================================================
                       6. VALIDATE INVOICE DUE
                       ============================================================ */
                
                    IF l_due_amount <= 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20004,
                            'This invoice is already fully paid.'
                        );
                    END IF;
                
                
                    /* ============================================================
                       7. VALIDATE PAYMENT AGAINST DUE
                       ============================================================ */
                
                    IF NVL(:P304_PAYMENT_AMOUNT, 0) > l_due_amount THEN
                        RAISE_APPLICATION_ERROR(
                            -20005,
                            'Payment amount cannot be greater than invoice due. '
                            || 'Current due: '
                            || TO_CHAR(
                                   l_due_amount,
                                   'FM999999999990.00'
                               )
                        );
                    END IF;
                
                
                    /* ============================================================
                       8. GENERATE TRANSACTION NUMBER
                       ============================================================ */
                
                    l_txn_no := SEQ_TRANSACTION_NO.NEXTVAL;
                
                    l_txn_code :=
                        'TRN-' || LPAD(l_txn_no, 6, '0');
                
                    :P304_TRANSACTION_NO := l_txn_no;
                
                
                    /* ============================================================
                       9. INSERT TRANSACTION MASTER
                       ============================================================ */
                
                    INSERT INTO TRN_TRANSACTION_MST (
                        TRANSACTION_NO,
                        TRANSACTION_CODE,
                        PARTY_NO,
                        PAY_MODE,
                        TRANSACTION_TYPE,
                        TRANSACTION_DATE,
                        TOTAL_AMOUNT,
                        NET_AMOUNT,
                        APPROVAL_STATUS,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    VALUES (
                        l_txn_no,
                        l_txn_code,
                        :P304_PARTY_NO,
                        :P304_PAY_MODE,
                        'R',
                        :P304_TRANSACTION_DATE,
                        :P304_TOTAL_AMOUNT,
                        :P304_DUE_AMOUNT,
                        'P',
                        :APP_USER,
                        SYSDATE
                    );
                
                
                    /* ============================================================
                       10. INSERT TRANSACTION DETAIL
                           ONE ROW PER INVOICE
                       ============================================================ */
                
                    INSERT INTO TRN_TRANSACTION_DTL (
                        TRANSACTION_DTL_NO,
                        TRANSACTION_NO,
                        REF_TYPE,
                        REF_NO,
                        DOC_NO,
                        DOC_CODE,
                        DOC_DATE,
                        PRODUCT_NO,
                        INVOICE_AMOUNT,
                        NET_AMOUNT,
                        PREVIOUS_AMOUNT,
                        DUE_AMOUNT,
                        ALLOCATE_AMOUNT,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    VALUES (
                        SEQ_TRANSACTION_DTL_NO.NEXTVAL,
                        l_txn_no,
                        'INVOICE',
                        :P304_INVOICE,
                        :P304_INVOICE,
                        (
                            SELECT M.INVOICE_CODE
                              FROM TRN_SALES_INVOICE_MST M
                             WHERE M.INVOICE_NO = :P304_INVOICE
                               AND M.CUSTOMER_NO = :P304_PARTY_NO
                        ),
                        (
                            SELECT M.INVOICE_DATE
                              FROM TRN_SALES_INVOICE_MST M
                             WHERE M.INVOICE_NO = :P304_INVOICE
                               AND M.CUSTOMER_NO = :P304_PARTY_NO
                        ),
                        NULL,
                        l_invoice_amount,
                        l_net_amount,
                        l_previous_amount,
                        l_due_amount,
                        :P304_PAYMENT_AMOUNT,
                        :APP_USER,
                        SYSDATE
                    );
                
                
                    /* ============================================================
                       11. SUCCESS MESSAGE
                       ============================================================ */
                
                    APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE :=
                           '<div class="payment-success-message">'
                        || '  <div class="payment-success-content">'
                        || '      <div class="payment-success-title">'
                        || '          Payment Transaction Created'
                        || '      </div>'
                        || '      <div class="payment-success-text">'
                        || '          Transaction <strong>'
                        ||           apex_escape.html(l_txn_code)
                        || '          </strong> created successfully and is '
                        || '          <strong>Pending Approval</strong>.'
                        || '      </div>'
                        || '  </div>'
                        || '</div>';
                
                EXCEPTION
                
                    WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(
                            -20006,
                            'Invoice not found for selected customer.'
                        );
                
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            SQLERRM
                        );
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 11998308407732001
        }
        serverSideCondition {
            whenButtonPressed: @payment-now_1
        }
    )

)

