    dynamicAction new_2 (
        name: New
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P304_MOBILE_NO
        }
        clientSideCondition {
            type: itemIsNull
            item: P304_CUSTOMER_NO
        }
        config {
            buildOption: @commented-out
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                        SELECT CUSTOMER_NO,
                               CUSTOMER_NAME,
                               ADDRESS
                          INTO :P304_CUSTOMER_NO,
                               :P304_CUSTOMER_NAME,
                               :P304_DELIVERY_ADDRESS
                          FROM (
                                SELECT *
                                  FROM MST_CUSTOMER
                                 WHERE MOBILE_NO = :P304_CONTACT_NO
                                   AND NVL(ACTIVE_FLAG,1) = 1
                                 ORDER BY CUSTOMER_NO DESC
                               )
                         WHERE ROWNUM = 1;
                    
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                    
                            :P304_CUSTOMER_NO      := NULL;
                            :P304_CUSTOMER_NAME    := NULL;
                            :P304_DELIVERY_ADDRESS := NULL;
                    
                    END;
                    ```
                itemsToSubmit: P304_CONTACT_NO
                itemsToReturn: [
                    P304_CUSTOMER_NO
                    P304_CUSTOMER_NAME
                    P304_ADDRESS
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

