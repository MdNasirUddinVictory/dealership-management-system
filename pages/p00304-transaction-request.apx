    region trn-mst (
        name: TRN_MST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TRANSACTION_NO,
                       TRANSACTION_CODE,
                       TRANSACTION_DATE,
                       TRANSACTION_TYPE,
                       PARTY_TYPE,
                       PARTY_NO,
                       PAY_MODE,
                       BANK_ACCOUNT_NO,
                       TOTAL_AMOUNT,
                       REMARKS,
                       APPROVAL_STATUS,
                       DECODE(APPROVAL_STATUS,'A','Approved','Pending') STATUS,
                       VOUCHER_NO,
                       CREATED_BY,
                       CREATED_DATE,
                       APPROVED_BY,
                       APPROVED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from TRN_TRANSACTION_MST
                ```
        }
