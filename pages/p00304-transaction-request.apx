            /* =====================================================
               MIDDLE : CUSTOMER RECEIVE
               ===================================================== */
            
            .receive-section {
                width: 260px;
            
                flex-shrink: 0;
            
                padding: 0 24px;
            
                box-sizing: border-box;
            
                display: flex;
            
                flex-direction: column;
            
                justify-content: center;
            
                align-items: center;
            
                text-align: center;
            }
            
            
            .receive-title {
                font-size: 18px;
            
                font-weight: 700;
            
                line-height: 1.2;
            
                color: #17191c;
            }
            
            
            .receive-subtitle {
                margin-top: 4px;
            
                font-size: 10px;
            
                line-height: 1.35;
            
                color: #858b94;
            
                max-width: 220px;
            }
            
            
            /* =====================================================
               RIGHT DELIVERY SECTION
               ===================================================== */
            
            .delivery-section {
                flex: 1;
            
                min-width: 0;
            
                padding-left: 20px;
            
                display: flex;
            
