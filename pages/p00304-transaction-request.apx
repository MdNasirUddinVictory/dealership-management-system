    pageItem P304_PARTY_NO (
        type: selectList
        label {
            label: Customer/Supplier
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                  SELECT PARTY_NAME AS D, PARTY_NO AS R
                    FROM (
                          SELECT C.CUSTOMER_NAME AS PARTY_NAME, C.CUSTOMER_NO AS PARTY_NO
                            FROM MST_CUSTOMER C
                           WHERE     :P304_TRANSACTION_TYPE = 'R'
                                 AND EXISTS
                                         (SELECT 1
                                            FROM TRN_SALES_INVOICE_MST I
                                           WHERE     I.CUSTOMER_NO = C.CUSTOMER_NO
                                                 AND NVL (I.DUE_AMOUNT, 0) > 0)
                          UNION ALL
                
                          SELECT S.SUPPLIER_NAME AS PARTY_NAME, S.SUPPLIER_NO AS PARTY_NO
                            FROM MST_SUPPLIER S
                           WHERE     :P304_TRANSACTION_TYPE = 'P'
                                 AND EXISTS
                                         (SELECT 1
                                            FROM TRN_PURCHASE_MST P
                                           WHERE     P.SUPPLIER_NO = S.SUPPLIER_NO
                                                 AND NVL (P.DUE_AMOUNT, 0) > 0))
                ORDER BY PARTY_NAME;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P304_TRANSACTION_TYPE
            itemsToSubmit: P304_TRANSACTION_TYPE
        }
        layout {
            sequence: 100
            region: @trn-mst
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
        source {
            formRegion: @trn-mst
            column: PARTY_NO
            dataType: number
        }
    )

