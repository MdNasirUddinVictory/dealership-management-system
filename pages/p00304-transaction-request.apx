    process invoice-wise-total-amount (
        name: INVOICE_WISE_TOTAL_AMOUNT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 BEGIN
                  SELECT M.INVOICE_NO                                AS INVOICE_NO,
                         M.TOTAL_AMOUNT                              AS INVOICE_AMOUNT,
                         NVL (M.DUE_AMOUNT, 0)                       AS DUE_AMOUNT,
                         M.RECEIVED_AMOUNT                           AS RECEIVED_AMOUNT INTO :P304_INVOICE ,:P304_TOTAL_AMOUNT,:P304_DUE_AMOUNT,:P304_PREVIOUS_PAYMNET
                    FROM TRN_SALES_INVOICE_MST M
                   WHERE M.CUSTOMER_NO = :P304_PARTY_NO AND NVL (M.DUE_AMOUNT, 0) > 0
                ORDER BY M.INVOICE_DATE DESC;
                EXCEPTION 
                WHEN NO_DATA_FOUND
                THEN NULL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12000002336732018
        }
    )

    process new (
        name: TRANSACTION_PROCESS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/30/2026 4:50:52 PM (QP5 v5.388) */
                /* =====================================================
                   CUSTOMER PAYMENT - PAGE SUBMIT PROCESS
                   ===================================================== */
                
                DECLARE
                    l_txn_no            NUMBER;
                    l_previous_amount   NUMBER;
                    l_due_amount        NUMBER;
                    l_txn_code          VARCHAR2 (100);
                
                    l_pending_count     NUMBER;
                BEGIN
                    /* =====================================================
                       VALIDATION
                       ===================================================== */
                
                
                    SELECT COUNT (*)
                      INTO l_pending_count
                      FROM TRN_TRANSACTION_DTL  d
                           JOIN TRN_TRANSACTION_MST m ON m.TRANSACTION_NO = d.TRANSACTION_NO
                     WHERE     d.REF_TYPE = 'INVOICE'
                           AND d.REF_NO = :P304_INVOICE
                           AND m.PARTY_NO = :P304_PARTY_NO
                           AND m.TRANSACTION_TYPE = 'R'
                           AND m.APPROVAL_STATUS = 'P';
                
                
                    IF l_pending_count > 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20007,
                            'A payment request for this invoice is already pending approval. Please wait until it is approved.');
                    END IF;
                
                
                    IF :P304_PARTY_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001, 'Please select customer.');
                    END IF;
                
                
                    IF :P304_INVOICE IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20002, 'Please select invoice.');
                    END IF;
                
                
                    IF NVL ( :P304_PAYMENT_AMOUNT, 0) <= 0
                    THEN
                        RAISE_APPLICATION_ERROR (-20003,
                                                 'Payment amount must be greater than zero.');
                    END IF;
                
                
                    /* =====================================================
                       GET PREVIOUS APPROVED PAYMENT
                       ===================================================== */
                
                    SELECT NVL (SUM (NVL (t.ALLOCATE_AMOUNT, 0)), 0)
                      INTO l_previous_amount
                      FROM TRN_TRANSACTION_DTL  t
                           JOIN TRN_TRANSACTION_MST h ON h.TRANSACTION_NO = t.TRANSACTION_NO
                     WHERE     t.REF_TYPE = 'INVOICE'
                           AND t.REF_NO = :P304_INVOICE
                           AND h.APPROVAL_STATUS = 'A';
                
                
                    /* =====================================================
                       GET CURRENT INVOICE DUE
                       ===================================================== */
                
                    SELECT NVL (TOTAL_AMOUNT, 0) - l_previous_amount
                      INTO l_due_amount
                      FROM TRN_SALES_INVOICE_MST
                     WHERE INVOICE_NO = :P304_INVOICE AND CUSTOMER_NO = :P304_PARTY_NO
                    FOR UPDATE;
                
                
                    /* =====================================================
                       VALIDATE INVOICE DUE
                       ===================================================== */
                
                    IF l_due_amount <= 0
                    THEN
                        RAISE_APPLICATION_ERROR (-20004,
                                                 'This invoice is already fully paid.');
                    END IF;
                
                
                    /* =====================================================
                       PAYMENT CANNOT EXCEED DUE
                       ===================================================== */
                
                    IF :P304_PAYMENT_AMOUNT > l_due_amount
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20005,
                               'Payment amount cannot be greater than invoice due. '
                            || 'Current due: '
                            || TO_CHAR (l_due_amount, 'FM999999999990.00'));
                    END IF;
                
                
                    /* =====================================================
                       GENERATE TRANSACTION NUMBER
                       ===================================================== */
                
                    l_txn_no := SEQ_TRANSACTION_NO.NEXTVAL;
                
                    l_txn_code := 'TRN-' || LPAD (l_txn_no, 6, '0');
                
                    :P304_TRANSACTION_NO := l_txn_no;
                
                
                    /* =====================================================
                       TRANSACTION MASTER
                       ===================================================== */
                
                    INSERT INTO TRN_TRANSACTION_MST (TRANSACTION_NO,
                                                     TRANSACTION_CODE,
                                                     PARTY_NO,
                                                     PAY_MODE,
                                                     TRANSACTION_TYPE,
                                                     TRANSACTION_DATE,
                                                     TOTAL_AMOUNT,
                                                     APPROVAL_STATUS,
                                                     CREATED_BY,
                                                     CREATED_DATE)
                         VALUES (l_txn_no,
                                 l_txn_code,
                                 :P304_PARTY_NO,
                                 :P304_PAY_MODE,
                                 'R',
                                 :P304_TRANSACTION_DATE,
                                 :P304_PAYMENT_AMOUNT,
                                 'P',
                                 :APP_USER,
                                 SYSDATE);
                
                
                    /* =====================================================
                       TRANSACTION DETAIL
                       ONE ROW PER INVOICE
                       ===================================================== */
                
                    INSERT INTO TRN_TRANSACTION_DTL (TRANSACTION_DTL_NO,
                                                     TRANSACTION_NO,
                                                     REF_TYPE,
                                                     REF_NO,
                                                     DOC_NO,
                                                     DOC_CODE,
                                                     DOC_DATE,
                                                     PRODUCT_NO,
                                                     INVOICE_AMOUNT,
                                                     PREVIOUS_AMOUNT,
                                                     DUE_AMOUNT,
                                                     ALLOCATE_AMOUNT,
                                                     CREATED_BY,
                                                     CREATED_DATE)
                        SELECT SEQ_TRANSACTION_DTL_NO.NEXTVAL,
                               l_txn_no,
                               'INVOICE',
                               m.INVOICE_NO,
                               m.INVOICE_NO,
                               m.INVOICE_CODE,
                               m.INVOICE_DATE,
                               NULL,
                               m.TOTAL_AMOUNT,
                               l_previous_amount,
                               l_due_amount,
                               :P304_PAYMENT_AMOUNT,
                               :APP_USER,
                               SYSDATE
                          FROM TRN_SALES_INVOICE_MST m
                         WHERE     m.INVOICE_NO = :P304_INVOICE
                               AND m.CUSTOMER_NO = :P304_PARTY_NO;
                
                
                    /* =====================================================
                       SUCCESS MESSAGE
                       ===================================================== */
                
                    APEX_APPLICATION.g_print_success_message :=
                           '<div class="payment-success-message">
                            <div class="payment-success-content">
                
                                <div class="payment-success-title">
                                    Payment Transaction Created
                                </div>
                
                                <div class="payment-success-text">
                                    Transaction <strong>'
                        || apex_escape.html (l_txn_code)
                        || '</strong>
                                    created successfully and is
                                    <strong>Pending Approval</strong>.
                                </div>
                
                            </div>
                        </div>';
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        RAISE_APPLICATION_ERROR (-20006,
                                                 'Invoice not found for selected customer.');
                END;
                ```
        }
        execution {
            sequence: 40
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 11998308407732001
        }
        serverSideCondition {
            whenButtonPressed: @payment-now_1
        }
    )

    process populate-invoice (
        name: TRANSACTION_POPULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/24/2026 4:31:33 PM (QP5 v5.388) */
                DECLARE
                    V_DATA   CLOB;
                BEGIN
                    ------------------------------------------------------------------
                    -- RECEIVE
                    ------------------------------------------------------------------
                
                    IF APEX_APPLICATION.G_X02 = 'R'
                    THEN
                        SELECT JSON_ARRAYAGG (
                                   JSON_OBJECT (
                                       'REF_TYPE' VALUE 'INVOICE',
                                       'REF_NO' VALUE M.INVOICE_NO,
                                       --'DOC_NO' VALUE M.INVOICE_NO,
                
                                       'DOC_CODE' VALUE M.INVOICE_CODE,
                                       'DOC_DATE' VALUE
                                           TO_CHAR (M.INVOICE_DATE, 'MM/DD/YYYY'),
                                       'PRODUCT_NO' VALUE D.PRODUCT_NO,
                                       'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                                       'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                                       'INVOICE_AMOUNT' VALUE D.TOTAL_AMOUNT,
                                       'PREVIOUS_AMOUNT' VALUE
                                           NVL (
                                               (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                 FROM TRN_TRANSACTION_DTL  T
                                                      JOIN TRN_TRANSACTION_MST H
                                                          ON H.TRANSACTION_NO =
                                                             T.TRANSACTION_NO
                                                WHERE     T.REF_TYPE = 'INVOICE'
                                                      AND T.REF_NO = D.INVOICE_DTL_NO
                                                      AND H.APPROVAL_STATUS = 'A'),
                                               0),
                                       'DUE_AMOUNT' VALUE
                                             D.TOTAL_AMOUNT
                                           - NVL (
                                                 (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                   FROM TRN_TRANSACTION_DTL  T
                                                        JOIN TRN_TRANSACTION_MST H
                                                            ON H.TRANSACTION_NO =
                                                               T.TRANSACTION_NO
                                                  WHERE     T.REF_TYPE = 'INVOICE'
                                                        AND T.REF_NO = D.INVOICE_DTL_NO
                                                        AND H.APPROVAL_STATUS = 'A'),
                                                 0),
                                       'ALLOCATE_AMOUNT' VALUE 0)
                                   RETURNING CLOB)
                          INTO V_DATA
                          FROM TRN_SALES_INVOICE_MST  M
                               JOIN TRN_SALES_INVOICE_DTL D ON D.INVOICE_NO = M.INVOICE_NO
                               JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         WHERE     M.CUSTOMER_NO = APEX_APPLICATION.G_X01
                               AND (  D.TOTAL_AMOUNT
                                    - NVL (
                                          (SELECT SUM (T.ALLOCATE_AMOUNT)
                                            FROM TRN_TRANSACTION_DTL  T
                                                 JOIN TRN_TRANSACTION_MST H
                                                     ON H.TRANSACTION_NO = T.TRANSACTION_NO
                                           WHERE     T.REF_TYPE = 'INVOICE'
                                                 AND T.REF_NO = D.INVOICE_DTL_NO
                                                 AND H.APPROVAL_STATUS = 'A'),
                                          0)) >
                                   0;
                    ------------------------------------------------------------------
                    -- PAYMENT
                    ------------------------------------------------------------------
                
                    ELSIF APEX_APPLICATION.G_X02 = 'P'
                    THEN
                        SELECT JSON_ARRAYAGG (
                                   JSON_OBJECT (
                                       'REF_TYPE' VALUE 'PURCHASE',
                                       'REF_NO' VALUE D.PURCHASE_NO,
                                       -- 'DOC_NO' VALUE M.PURCHASE_NO,
                
                                       'DOC_CODE' VALUE M.PURCHASE_CODE,
                                       'DOC_DATE' VALUE
                                           TO_CHAR (M.PURCHASE_DATE, 'MM/DD/YYYY'),
                                       'PRODUCT_NO' VALUE D.PRODUCT_NO,
                                       'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                                       'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                                       'INVOICE_AMOUNT' VALUE D.TOTAL_AMOUNT,
                                       'PREVIOUS_AMOUNT' VALUE
                                           NVL (
                                               (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                 FROM TRN_TRANSACTION_DTL  T
                                                      JOIN TRN_TRANSACTION_MST H
                                                          ON H.TRANSACTION_NO =
                                                             T.TRANSACTION_NO
                                                WHERE     T.REF_TYPE = 'PURCHASE'
                                                      AND T.PRODUCT_NO = D.PRODUCT_NO
                                                      AND H.APPROVAL_STATUS = 'A'),
                                               0),
                                       'DUE_AMOUNT' VALUE
                                             D.TOTAL_AMOUNT
                                           - NVL (
                                                 (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                   FROM TRN_TRANSACTION_DTL  T
                                                        JOIN TRN_TRANSACTION_MST H
                                                            ON H.TRANSACTION_NO =
                                                               T.TRANSACTION_NO
                                                  WHERE     T.REF_TYPE = 'PURCHASE'
                                                        AND T.PRODUCT_NO = D.PRODUCT_NO
                                                        AND H.APPROVAL_STATUS = 'A'),
                                                 0),
                                       'ALLOCATE_AMOUNT' VALUE   D.TOTAL_AMOUNT
                                           - NVL (
                                                 (SELECT SUM (T.ALLOCATE_AMOUNT)
                                                   FROM TRN_TRANSACTION_DTL  T
                                                        JOIN TRN_TRANSACTION_MST H
                                                            ON H.TRANSACTION_NO =
                                                               T.TRANSACTION_NO
                                                  WHERE     T.REF_TYPE = 'PURCHASE'
                                                        AND T.PRODUCT_NO = D.PRODUCT_NO
                                                        AND H.APPROVAL_STATUS = 'A'),
                                                 0))
                                   RETURNING CLOB)
                          INTO V_DATA
                          FROM TRN_PURCHASE_MST  M
                               JOIN TRN_PURCHASE_DTL D ON D.PURCHASE_NO = M.PURCHASE_NO
                               JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         WHERE     M.SUPPLIER_NO = APEX_APPLICATION.G_X01
                         AND M.APPROVAL_STATUS = 'A'
                               AND (  D.TOTAL_AMOUNT
                                    - NVL (
                                          (SELECT SUM (T.ALLOCATE_AMOUNT)
                                            FROM TRN_TRANSACTION_DTL  T
                                                 JOIN TRN_TRANSACTION_MST H
                                                     ON H.TRANSACTION_NO = T.TRANSACTION_NO
                                           WHERE     T.REF_TYPE = 'PURCHASE'
                                                 AND T.REF_NO = D.PURCHASE_DTL_NO
                                                 AND H.APPROVAL_STATUS = 'A'),
                                          0)) >
                                   0;
                    END IF;
                
                    IF V_DATA IS NULL
                    THEN
                        V_DATA := '[]';
                    END IF;
                
                    HTP.PRN (V_DATA);
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        HTP.PRN ('[]');
                END;
                ```
