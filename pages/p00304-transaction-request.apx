        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                        SELECT CUSTOMER_NO,
                               CUSTOMER_NAME,
                               ADDRESS
                          INTO :P304_CUSTOMER_NO,
                               :P304_CUSTOMER_NAME,
                               :P304_DELIVERY_ADDRESS
                          FROM (
                                SELECT *
                                  FROM MST_CUSTOMER
                                 WHERE MOBILE_NO = :P304_CONTACT_NO
                                   AND NVL(ACTIVE_FLAG,1) = 1
                                 ORDER BY CUSTOMER_NO DESC
                               )
                         WHERE ROWNUM = 1;
                    
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                    
                            :P304_CUSTOMER_NO      := NULL;
                            :P304_CUSTOMER_NAME    := NULL;
                            :P304_DELIVERY_ADDRESS := NULL;
                    
                    END;
                    ```
                itemsToSubmit: P304_CONTACT_NO
                itemsToReturn: [
                    P304_CUSTOMER_NO
                    P304_CUSTOMER_NAME
                    P304_ADDRESS
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    V_CNT NUMBER;
                
                BEGIN
                
                    -------------------------------------------------
                    -- Approved Check
                    -------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO V_CNT
                      FROM TRN_TRANSACTION_MST
                     WHERE TRANSACTION_NO = :P304_TRANSACTION_NO
                       AND APPROVAL_STATUS = 'A';
                
                    IF V_CNT > 0 THEN
                
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            'Approved transaction cannot be deleted.'
                        );
                
                    END IF;
                
                    -------------------------------------------------
                    -- Voucher Posted Check
                    -------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO V_CNT
                      FROM TRN_TRANSACTION_MST
                     WHERE TRANSACTION_NO = :P304_TRANSACTION_NO
                       AND VOUCHER_NO IS NOT NULL;
                
                    IF V_CNT > 0 THEN
                
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            'Voucher already posted. Delete is not allowed.'
                        );
                
                    END IF;
                
                    -------------------------------------------------
                    -- Delete Detail First
                    -------------------------------------------------
                
                    DELETE
                      FROM TRN_TRANSACTION_DTL
                     WHERE TRANSACTION_NO = :P304_TRANSACTION_NO;
                
                    -------------------------------------------------
                    -- Delete Master
                    -------------------------------------------------
                
                    DELETE
                      FROM TRN_TRANSACTION_MST
                     WHERE TRANSACTION_NO = :P304_TRANSACTION_NO;
                
                
                     :P304_TRANSACTION_NO := NULL;
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14788394320530363442
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

