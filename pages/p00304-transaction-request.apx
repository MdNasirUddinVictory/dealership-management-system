                }
            
            }
            
            
            
            /* ------------------------------------------------------------------------ */
            
            /* =====================================================
               INVOICE HISTORY CARD
               ===================================================== */
            
            .invoice-history-card {
                width: 100%;
                box-sizing: border-box;
            
                background: #ffffff;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 7px;
            
                overflow: hidden;
            
                box-shadow: 0 1px 3px rgba(0,0,0,.04);
            }
            
            
            /* =====================================================
               HEADER
               ===================================================== */
            
            .history-header {
                display: flex;
            
                align-items: center;
            
                justify-content: space-between;
            
                padding: 11px 14px;
            
                border-bottom: 1px solid #eeeeee;
            }
            
            
            .history-title {
                font-size: 16px;
                font-weight: 700;
            
                color: #17191c;
            }
            
            
            .history-subtitle {
                margin-top: 3px;
            
