page 202 (
    name: Delivery Report
    alias: DELIVERY-REPORT
    title: Delivery Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: customer delivery
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/6/2026 11:44:07 AM (QP5 v5.388) */
                  SELECT M.DELIVERY_NO         AS "Delivery No",
                         M.DELIVERY_CODE       AS "Delivery Code",
                         M.DELIVERY_DATE       AS "Delivery Date",
                         I.INVOICE_NO          AS "Invoice No",
                         I.INVOICE_CODE        AS "Invoice Code",
                         I.INVOICE_DATE        AS "Invoice Date",
                         M.CUSTOMER_NO         AS "Customer No",
                         C.CUSTOMER_NAME       AS "Customer Name",
                         C.MOBILE_NO           AS "Mobile No",
                         M.DELIVERY_ADDRESS    AS "Delivery Address",
                         M.DELIVERY_PERSON     AS "Delivery Person",
                         M.VEHICLE_NO          AS "Vehicle No",
                         M.CONTACT_NO          AS "Contact No",
                         NVL ( (SELECT SUM (D.DELIVERY_QTY)
                                  FROM TRN_DELIVERY_DTL D
                                 WHERE D.DELIVERY_NO = M.DELIVERY_NO),
                              0)               AS "Delivered Quantity",
                         NVL ( (SELECT SUM (D.TOTAL_AMOUNT)
                                  FROM TRN_DELIVERY_DTL D
                                 WHERE D.DELIVERY_NO = M.DELIVERY_NO),
                              0)               AS "Delivery Amount",
                         CASE M.APPROVAL_STATUS
                             WHEN 'P' THEN 'Pending'
                             WHEN 'A' THEN 'Approved'
                             WHEN 'R' THEN 'Rejected'
                         END                   AS "Approval Status",
                         M.REMARKS             AS "Remarks",
                         M.CREATED_BY          AS "Created By",
                         M.CREATED_DATE        AS "Created Date"
                    FROM TRN_DELIVERY_MST M
                         JOIN TRN_SALES_INVOICE_MST I ON I.INVOICE_NO = M.INVOICE_NO
                         JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = M.CUSTOMER_NO
                   WHERE     (   :P202_FROM_DATE IS NULL
                              OR M.DELIVERY_DATE >= TO_DATE ( :P202_FROM_DATE, 'MM/DD/YYYY'))
                         AND (   :P202_T0_DATE IS NULL
                              OR M.DELIVERY_DATE < TO_DATE ( :P202_T0_DATE, 'MM/DD/YYYY') + 1)
                         AND (   :P202_STATUS IS NULL
                              OR :P202_STATUS = 'ALL'
                              OR M.APPROVAL_STATUS = :P202_STATUS)
                         AND ( :P202_CUSTOMER IS NULL OR M.CUSTOMER_NO = :P202_CUSTOMER)
                ORDER BY M.DELIVERY_DATE DESC, M.DELIVERY_NO DESC;
                ```
            pageItemsToSubmit: [
                P202_FROM_DATE
                P202_T0_DATE
                P202_CUSTOMER
                P202_STATUS
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 36171526150259589
        }

