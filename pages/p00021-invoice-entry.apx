    region invoice-details (
        name: INVOICE DETAILS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       D.INVOICE_DTL_NO,
                
                       D.ORDER_DTL_NO,
                
                       D.PRODUCT_NO,
                
                       P.PRODUCT_CODE,
                
                       P.PRODUCT_NAME,
                
                       P.DESCRIPTION,
                
                       P.BRAND_NO,
                
                       D.UOM_NO,
                
                       U.UOM_NAME,
                
                       D.PACK_QTY,
                
                       D.ORDER_QTY,
                
                       D.BASE_QTY,
                
                       NVL(
                           (
                               SELECT SUM(X.SALES_QTY)
                                 FROM TRN_SALES_INVOICE_DTL X
                                WHERE X.ORDER_DTL_NO=D.ORDER_DTL_NO
                                  AND X.INVOICE_DTL_NO<>D.INVOICE_DTL_NO
                           ),
                           0
                       ) PREVIOUS_INVOICE_QTY,
                
                       (
                           D.ORDER_QTY-
                           NVL(
                               (
                                   SELECT SUM(X.SALES_QTY)
                                     FROM TRN_SALES_INVOICE_DTL X
                                    WHERE X.ORDER_DTL_NO=D.ORDER_DTL_NO
                                      AND X.INVOICE_DTL_NO<>D.INVOICE_DTL_NO
                               ),
                               0
                           )
                       ) BALANCE_QTY,
                
                       D.SALES_QTY,
                
                       D.SALES_RATE,
                
                       D.BASE_RATE,
                
                       D.TOTAL_AMOUNT,
                
                       D.REMARKS
                
                FROM TRN_SALES_INVOICE_DTL D
                
                JOIN MST_PRODUCT P
                ON P.PRODUCT_NO=D.PRODUCT_NO
                
                LEFT JOIN MST_UOM U
                ON U.UOM_NO=D.UOM_NO
                
                WHERE D.INVOICE_NO=:P21_INVOICE_NO;
                ```
            pageItemsToSubmit: P21_INVOICE_NO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
