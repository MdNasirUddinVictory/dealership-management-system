    region register_1 (
        name: SALES INVOICE MST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       I.INVOICE_NO,
                       I.INVOICE_CODE,
                       I.INVOICE_DATE,
                
                       I.ORDER_NO,
                
                       I.CUSTOMER_NO,
                
                       C.CUSTOMER_NAME,
                
                       C.MOBILE_NO,
                
                       C.ADDRESS,
                
                       I.TOTAL_AMOUNT,
                
                       I.DELIVERY_STATUS,
                
                       I.CREATED_BY,
                
                       I.CREATED_DATE,
                
                       I.UPDATED_BY,
                
                       I.UPDATED_DATE,
                
                       I.DELIVERY_BY,
                
                       I.DELIVERY_DATE
                
                FROM TRN_SALES_INVOICE_MST I
                
                JOIN MST_CUSTOMER C
                  ON C.CUSTOMER_NO = I.CUSTOMER_NO
                
                WHERE I.INVOICE_NO = :P21_INVOICE_NO;
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                t-Form--large
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: sales_order_list
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

