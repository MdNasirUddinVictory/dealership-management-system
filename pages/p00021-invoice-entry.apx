    process process-form-sales-invoice-mst (
        name: Process form SALES INVOICE MST
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_invoice_no      NUMBER;
                    v_invoice_code    VARCHAR2(30);
                
                    v_total_order     NUMBER;
                    v_total_invoice   NUMBER;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Header Validation
                    --------------------------------------------------
                
                    IF :P21_ORDER_NO IS NULL THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select sales order.'
                        );
                
                    END IF;
                
                    IF :P21_INVOICE_DATE IS NULL THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please enter invoice date.'
                        );
                
                    END IF;
                
                    --------------------------------------------------
                    -- New Invoice
                    --------------------------------------------------
                
                    IF :P21_INVOICE_NO IS NULL THEN
                
                        SELECT SEQ_INVOICE_NO.NEXTVAL
                          INTO v_invoice_no
                          FROM DUAL;
                
                        v_invoice_code :=
                            'INV-' || LPAD(v_invoice_no,6,'0');
                
                        INSERT INTO TRN_SALES_INVOICE_MST
                        (
                            INVOICE_NO,
                            INVOICE_CODE,
                            INVOICE_DATE,
                            ORDER_NO,
                            CUSTOMER_NO,
                            TOTAL_AMOUNT,
                            DELIVERY_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            v_invoice_no,
                            v_invoice_code,
                            :P21_INVOICE_DATE,
                            :P21_ORDER_NO,
                            :P21_CUSTOMER_NO,
                            0,
                            'P',
                            :APP_USER,
                            SYSDATE
                        );
                
                        :P21_INVOICE_NO := v_invoice_no;
                
                    --------------------------------------------------
                    -- Update Invoice
                    --------------------------------------------------
                
                    ELSE
                
                        UPDATE TRN_SALES_INVOICE_MST
                           SET INVOICE_DATE = :P21_INVOICE_DATE,
                               CUSTOMER_NO  = :P21_CUSTOMER_NO,
                               UPDATED_BY   = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE INVOICE_NO = :P21_INVOICE_NO;
                
                    END IF;
                
                   
                
                    --------------------------------------------------
                    -- Success Message
                    --------------------------------------------------
                
                    apex_application.g_print_success_message :=
                        'Invoice saved successfully.';
                
                EXCEPTION
                
                    WHEN OTHERS THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            SQLERRM
                        );
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 11401339484150981843
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

