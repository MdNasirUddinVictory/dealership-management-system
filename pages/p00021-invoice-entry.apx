    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_count NUMBER;
                
                BEGIN
                
                    SELECT COUNT(*)
                      INTO v_count
                      FROM TRN_DELIVERY_MST
                     WHERE INVOICE_NO = :P21_INVOICE_NO
                       AND APPROVAL_STATUS = 'A';
                
                    IF v_count > 0 THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Delivery already exists. Invoice cannot be deleted.'
                        );
                
                    END IF;
                
                    SELECT COUNT(*)
                      INTO v_count
                      FROM TRN_CUSTOMER_RETURN_MST
                     WHERE INVOICE_NO = :P21_INVOICE_NO
                       AND APPROVAL_STATUS = 'A';
                
                    IF v_count > 0 THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Customer return exists. Invoice cannot be deleted.'
                        );
                
                    END IF;
                
                    DELETE
                      FROM TRN_SALES_INVOICE_DTL
                     WHERE INVOICE_NO = :P21_INVOICE_NO;
                
                    DELETE
                      FROM TRN_SALES_INVOICE_MST
                     WHERE INVOICE_NO = :P21_INVOICE_NO;
                
                    UPDATE TRN_SALES_ORDER_MST
                       SET ORDER_STATUS = 'P'
                     WHERE ORDER_NO = :P21_ORDER_NO;
                
                    :P21_INVOICE_NO := null;
                
                    apex_application.g_print_success_message :=
                        'Invoice deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 11471338484512832921
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process generate-invoice (
        name: GENERATE_INVOICE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_invoice_no      NUMBER;
                    v_invoice_code    VARCHAR2(30);
                
                    v_exists          NUMBER;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Already Invoiced Check
                    --------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_SALES_INVOICE_MST
                     WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists > 0 THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Invoice already generated for this order.'
                        );
                
                    END IF;
                
                    --------------------------------------------------
                    -- Generate Invoice No
                    --------------------------------------------------
                
                    SELECT SEQ_INVOICE_NO.NEXTVAL
                      INTO v_invoice_no
                      FROM DUAL;
                
                    v_invoice_code :=
                        'INV-' || LPAD(v_invoice_no,6,'0');
                
                    --------------------------------------------------
                    -- Invoice Master
                    --------------------------------------------------
                
                    INSERT INTO TRN_SALES_INVOICE_MST
                    (
                        INVOICE_NO,
                        INVOICE_CODE,
                        INVOICE_DATE,
                        ORDER_NO,
                        CUSTOMER_NO,
                        TOTAL_AMOUNT,
                        DELIVERY_STATUS,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    SELECT
                        v_invoice_no,
                        v_invoice_code,
                        SYSDATE,
                        M.ORDER_NO,
                        M.CUSTOMER_NO,
                        (
                            SELECT NVL(SUM(TOTAL_AMOUNT),0)
                              FROM TRN_SALES_ORDER_DTL
                             WHERE ORDER_NO = M.ORDER_NO
                        ),
                        'P',
                        :APP_USER,
                        SYSDATE
                    FROM TRN_SALES_ORDER_MST M
                    WHERE M.ORDER_NO = APEX_APPLICATION.G_X01;
                
                    --------------------------------------------------
                    -- Invoice Detail
                    --------------------------------------------------
                
                    INSERT INTO TRN_SALES_INVOICE_DTL
                    (
                        INVOICE_DTL_NO,
                        INVOICE_NO,
                        ORDER_DTL_NO,
                        PRODUCT_NO,
                        ORDER_QTY,
                        SALES_QTY,
                        SALES_RATE,
                        TOTAL_AMOUNT
                    )
                    SELECT
                        SEQ_INVOICE_DTL_NO.NEXTVAL,
                        v_invoice_no,
                        ORDER_DTL_NO,
                        PRODUCT_NO,
                        ORDER_QTY,
                        ORDER_QTY,
                        SALES_RATE,
                        TOTAL_AMOUNT
                    FROM TRN_SALES_ORDER_DTL
                    WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    --------------------------------------------------
                    -- Update Order Detail
                    --------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_DTL
                       SET INVOICED_QTY =
                               NVL(INVOICED_QTY,0)
                               + ORDER_QTY,
                
                           BALANCE_QTY =
                               ORDER_QTY -
                               (
                                   NVL(INVOICED_QTY,0)
                                   + ORDER_QTY
                               ),
                
                           UPDATED_BY = :APP_USER,
                           UPDATED_DATE = SYSDATE
                
                     WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    --------------------------------------------------
                    -- Update Order Master
                    --------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_MST
                       SET ORDER_STATUS = 'I',
                           UPDATED_BY   = :APP_USER,
                           UPDATED_DATE = SYSDATE
                     WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    COMMIT;
                
                    HTP.P(
                        'Invoice generated successfully. Invoice No: '
                        || v_invoice_code
                    );
                
                EXCEPTION
                    WHEN OTHERS THEN
                
                        ROLLBACK;
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            SQLERRM
                        );
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 11427231942290783653
        }
        config {
            buildOption: @commented-out
        }
    )

    process invoice-details-save-interactive-grid-data (
        name: INVOICE DETAILS - Save Interactive Grid Data
        type: executeCode
        editableRegion: @invoice-details
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_count          NUMBER;
                    v_balance        NUMBER;
                    v_total_order    NUMBER;
                    v_total_invoice  NUMBER;
                
                BEGIN
                
                    ------------------------------------------------
                    -- Delete Validation
                    ------------------------------------------------
                
                    IF :APEX$ROW_STATUS='D' THEN
                
                        SELECT COUNT(*)
                        INTO v_count
                        FROM TRN_DELIVERY_DTL D
                             JOIN TRN_DELIVERY_MST M
                               ON M.DELIVERY_NO=D.DELIVERY_NO
                        WHERE D.PRODUCT_NO=:PRODUCT_NO
                          AND M.INVOICE_NO=:P21_INVOICE_NO
                          AND M.APPROVAL_STATUS='A';
                
                        IF v_count>0 THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Delivery already completed. Delete not allowed.'
                            );
                
                        END IF;
                
                        SELECT COUNT(*)
                        INTO v_count
                        FROM TRN_CUSTOMER_RETURN_DTL R
                             JOIN TRN_CUSTOMER_RETURN_MST M
                               ON M.RETURN_NO=R.RETURN_NO
                        WHERE R.PRODUCT_NO=:PRODUCT_NO
                          AND M.INVOICE_NO=:P21_INVOICE_NO
                          AND M.APPROVAL_STATUS='A';
                
                        IF v_count>0 THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Customer return exists. Delete not allowed.'
                            );
                
                        END IF;
                
                    END IF;
                
                    ------------------------------------------------
                    -- INSERT
                    ------------------------------------------------
                
                    IF :APEX$ROW_STATUS='C' THEN
                
                        INSERT INTO TRN_SALES_INVOICE_DTL
                        (
                            INVOICE_DTL_NO,
                            INVOICE_NO,
                            ORDER_DTL_NO,
                            PRODUCT_NO,
                            UOM_NO,
                            PACK_QTY,
                            ORDER_QTY,
                            SALES_QTY,
                            BASE_QTY,
                            SALES_RATE,
                            BASE_RATE,
                            TOTAL_AMOUNT,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_INVOICE_DTL_NO.NEXTVAL,
                            :P21_INVOICE_NO,
                            :ORDER_DTL_NO,
                            :PRODUCT_NO,
                            :UOM_NO,
                            :PACK_QTY,
                            :ORDER_QTY,
                            :SALES_QTY,
                            :BASE_QTY,
                            :SALES_RATE,
                            :BASE_RATE,
                            NVL(:SALES_QTY,0) * NVL(:SALES_RATE,0),
                            :APP_USER,
                            SYSDATE
                        );
                
                    ------------------------------------------------
                    -- UPDATE
                    ------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS='U' THEN
                
                        UPDATE TRN_SALES_INVOICE_DTL
                           SET UOM_NO       = :UOM_NO,
                               PACK_QTY     = :PACK_QTY,
                               ORDER_QTY    = :ORDER_QTY,
                               SALES_QTY    = :SALES_QTY,
                               BASE_QTY     = :BASE_QTY,
                               SALES_RATE   = :SALES_RATE,
                               BASE_RATE    = :BASE_RATE,
                               TOTAL_AMOUNT = NVL(:SALES_QTY,0) * NVL(:SALES_RATE,0),
                               UPDATED_BY   = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE INVOICE_DTL_NO = :INVOICE_DTL_NO;
                
                    ------------------------------------------------
                    -- DELETE
                    ------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS='D' THEN
                
                        DELETE
                        FROM TRN_SALES_INVOICE_DTL
                        WHERE INVOICE_DTL_NO=:INVOICE_DTL_NO;
                
                    END IF;
                
                    ------------------------------------------------
                    -- Update Invoice Total
                    ------------------------------------------------
                
                    UPDATE TRN_SALES_INVOICE_MST
                       SET TOTAL_AMOUNT =
                       (
                           SELECT NVL(SUM(TOTAL_AMOUNT),0)
                           FROM TRN_SALES_INVOICE_DTL
                           WHERE INVOICE_NO=:P21_INVOICE_NO
                       ),
                       UPDATED_BY=:APP_USER,
                       UPDATED_DATE=SYSDATE
                    WHERE INVOICE_NO=:P21_INVOICE_NO;
                
                    ------------------------------------------------
                    -- Update Order Status
                    ------------------------------------------------
                
                    SELECT NVL(SUM(BASE_QTY),0)
                    INTO v_total_order
                    FROM TRN_SALES_ORDER_DTL
                    WHERE ORDER_NO=:P21_ORDER_NO;
                
                    SELECT NVL(SUM(D.BASE_QTY),0)
                    INTO v_total_invoice
                    FROM TRN_SALES_INVOICE_DTL D
                         JOIN TRN_SALES_INVOICE_MST M
                           ON M.INVOICE_NO=D.INVOICE_NO
                    WHERE M.ORDER_NO=:P21_ORDER_NO;
                
                    UPDATE TRN_SALES_ORDER_MST
                       SET ORDER_STATUS =
                           CASE
                               WHEN v_total_invoice = 0 THEN 'P'
                               WHEN v_total_invoice < v_total_order THEN 'PI'
                               ELSE 'I'
                           END,
                           UPDATED_BY=:APP_USER,
                           UPDATED_DATE=SYSDATE
                     WHERE ORDER_NO=:P21_ORDER_NO;
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 11471337673643832913
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process invoice-populate (
        name: INVOICE_POPULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_DATA CLOB;
                BEGIN
                
                    SELECT JSON_ARRAYAGG(
                             JSON_OBJECT(
                
                               'ORDER_DTL_NO' VALUE D.ORDER_DTL_NO,
                
                               'PRODUCT_NO' VALUE D.PRODUCT_NO,
                
                               'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                
                               'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                
                               'UOM_NO' VALUE D.UOM_NO,
                
                               'PACK_QTY' VALUE D.PACK_QTY,
                
                               'BASE_QTY' VALUE D.BASE_QTY,
                
                               'BASE_RATE' VALUE D.BASE_RATE,
                
                               'ORDER_QTY' VALUE D.ORDER_QTY,
                
                               'PREVIOUS_INVOICE_QTY' VALUE NVL
                               (
                                   (
                                       SELECT SUM(I.SALES_QTY)
                                         FROM TRN_SALES_INVOICE_DTL I
                                        WHERE I.ORDER_DTL_NO=D.ORDER_DTL_NO
                                   ),
                                   0
                               ),
                
                               'BALANCE_QTY' VALUE
                               (
                                   D.ORDER_QTY-
                                   NVL
                                   (
                                       (
                                           SELECT SUM(I.SALES_QTY)
                                             FROM TRN_SALES_INVOICE_DTL I
                                            WHERE I.ORDER_DTL_NO=D.ORDER_DTL_NO
                                       ),
                                       0
                                   )
                               ),
                
                               'SALES_QTY' VALUE
                               (
                                   D.ORDER_QTY-
                                   NVL
                                   (
                                       (
                                           SELECT SUM(I.SALES_QTY)
                                             FROM TRN_SALES_INVOICE_DTL I
                                            WHERE I.ORDER_DTL_NO=D.ORDER_DTL_NO
                                       ),
                                       0
                                   )
                               ),
                
                               'SALES_RATE' VALUE D.SALES_RATE,
                
                               'TOTAL_AMOUNT' VALUE
                               (
                                   (
                                       D.ORDER_QTY-
                                       NVL
                                       (
                                           (
                                               SELECT SUM(I.SALES_QTY)
                                                 FROM TRN_SALES_INVOICE_DTL I
                                                WHERE I.ORDER_DTL_NO=D.ORDER_DTL_NO
                                           ),
                                           0
                                       )
                                   )*D.SALES_RATE
                               )
                
                             ) RETURNING CLOB
                           )
                    INTO V_DATA
                    FROM TRN_SALES_ORDER_DTL D
                         JOIN MST_PRODUCT P
                           ON P.PRODUCT_NO=D.PRODUCT_NO
                   WHERE D.ORDER_NO=APEX_APPLICATION.G_X01
                     AND
                     (
                        D.ORDER_QTY-
                        NVL
                        (
                            (
                                SELECT SUM(I.SALES_QTY)
                                  FROM TRN_SALES_INVOICE_DTL I
                                 WHERE I.ORDER_DTL_NO=D.ORDER_DTL_NO
                            ),
                            0
                        )
                     )>0;
                
                    HTP.PRN(NVL(V_DATA,'[]'));
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 11471337375671832910
        }
    )

    process new (
        name: New
        type: formInitialization
        formRegion: @register_1
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11401339570303981844
        }
