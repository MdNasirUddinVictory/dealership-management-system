page 21 (
    name: Invoice Entry
    alias: INVOICE-ENTRY
    title: Invoice Entry
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function generateInvoice(orderNo) {
            
                if (confirm('Generate Invoice?')) {
            
                    apex.server.process(
                        'GENERATE_INVOICE',
                        {
                            x01: orderNo
                        },
                        {
                            success: function (pData) {
            
                                apex.message.showPageSuccess(pData);
            
                                apex.region('sales_order_list').refresh();
            
                            }
                        }
                    );
            
                }
            }
            function populateInvoice() {
            
                if (!$v('P21_ORDER_NO')) {
                    apex.message.alert('Please select order.');
                    return;
                }
            
                var model = apex.region("invoice-dtl")
                    .widget()
                    .interactiveGrid("getViews", "grid")
                    .model;
            
                // আগে থেকেই Data আছে কিনা
                if (model.getTotalRecords() > 0) {
                    apex.message.alert('Invoice details already exist.');
                    return;
                }
            
                apex.server.process(
                    'INVOICE_POPULATE',
                    {
                        x01: $v('P21_ORDER_NO')
                    },
                    {
                        success: function (pData) {
            
                            var json = JSON.parse(pData);
            
                            // Data না থাকলে
                            if (!json || json.length === 0) {
                                apex.message.alert(
                                    'No pending order items found for invoice.'
                                );
                                return;
                            }
            
                            for (var key in json) {
            
                                if (json.hasOwnProperty(key)) {
            
                                    var rec = model.insertNewRecord();
            
                                    model.setRecordValue(
                                        rec,
                                        "ORDER_DTL_NO",
                                        json[key].ORDER_DTL_NO.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_NO",
                                        json[key].PRODUCT_NO.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "ORDER_QTY",
                                        json[key].ORDER_QTY.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PREVIOUS_INVOICE_QTY",
                                        json[key].PREVIOUS_INVOICE_QTY.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "BALANCE_QTY",
                                        json[key].BALANCE_QTY.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "SALES_QTY",
                                        json[key].SALES_QTY.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "SALES_RATE",
                                        json[key].SALES_RATE.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "TOTAL_AMOUNT",
                                        json[key].TOTAL_AMOUNT.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_NAME",
                                        json[key].PRODUCT_NAME.toString()
                                    );
            
                                    model.setRecordValue(
                                        rec,
                                        "PRODUCT_CODE",
                                        json[key].PRODUCT_CODE.toString()
                                    );
                                    model.setRecordValue(
                rec,
                "UOM_NO",
                json[key].UOM_NO.toString()
            );
            
            model.setRecordValue(
                rec,
                "PACK_QTY",
                json[key].PACK_QTY.toString()
            );
            
            model.setRecordValue(
                rec,
                "BASE_QTY",
                json[key].BASE_QTY.toString()
            );
            
            model.setRecordValue(
                rec,
                "BASE_RATE",
                json[key].BASE_RATE.toString()
            );
                                }
                            }
            
                            apex.message.showPageSuccess(
                                json.length +
                                ' item(s) loaded successfully.'
                            );
                        },
                        error: function () {
                            apex.message.alert(
                                'Error loading invoice details.'
                            );
                        },
                        dataType: "text"
                    }
                );
            }
            ```
    }
