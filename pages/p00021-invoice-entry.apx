    dynamicAction new (
        name: New
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @invoice-details
            columns: SALES_QTY
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.clearErrors();
                    
                    var salesQty   = parseFloat($v("SALES_QTY")) || 0;
                    var balanceQty = parseFloat($v("BALANCE_QTY")) || 0;
                    var salesRate  = parseFloat($v("SALES_RATE")) || 0;
                    var packQty    = parseFloat($v("PACK_QTY")) || 1;
                    
                    if (packQty <= 0) {
                        packQty = 1;
                    }
                    
                    if (salesQty > balanceQty) {
                    
                        apex.message.alert("Invoice quantity exceeds balance quantity.");
                    
                        $s("SALES_QTY", "");
                        $s("BASE_QTY", "");
                        $s("BASE_RATE", "");
                        $s("TOTAL_AMOUNT", "");
                    
                        return;
                    }
                    
                    /* Calculate */
                    
                    var baseQty    = salesQty * packQty;
                    var baseRate   = salesRate / packQty;
                    var totalAmt   = salesQty * salesRate;
                    
                    $s("BASE_QTY", baseQty.toFixed(3));
                    $s("BASE_RATE", baseRate.toFixed(6));
                    $s("TOTAL_AMOUNT", totalAmt.toFixed(2));
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

