page 101 (
    name: Low Stock Alert
    alias: LOW-STOCK-ALERT
    title: Low Stock Alert
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region register (
        name: Low Stock Alert
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PRODUCT_NAME,
                       CURRENT_STOCK,
                       MIN_STOCK_QTY
                FROM (
                    SELECT P.PRODUCT_NAME,
                           P.MIN_STOCK_QTY,
                           NVL(SUM(L.QTY_IN),0)
                           -
                           NVL(SUM(L.QTY_OUT),0) CURRENT_STOCK
                    FROM MST_PRODUCT P
                    LEFT JOIN TRN_STOCK_LEDGER L
                      ON L.PRODUCT_NO = P.PRODUCT_NO
                    GROUP BY
                        P.PRODUCT_NAME,
                        P.MIN_STOCK_QTY
                )
                WHERE CURRENT_STOCK <= MIN_STOCK_QTY;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 34937524708382783128
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @PRODUCT_NAME
                layout {
                    sequence: 31
                }
            )

            displayColumn (
                column: @CURRENT_STOCK
                layout {
                    sequence: 32
                }
            )

            displayColumn (
                column: @MIN_STOCK_QTY
                layout {
                    sequence: 33
                }
            )

        )

        column CURRENT_STOCK (
            type: numberField
            heading {
                heading: Current Stock
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                databaseColumn: CURRENT_STOCK
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column MIN_STOCK_QTY (
            type: numberField
            heading {
                heading: Min Stock Qty
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: MIN_STOCK_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PRODUCT_NAME (
            type: textarea
            heading {
                heading: Product Name
            }
            layout {
                sequence: 10
            }
            validation {
                valueRequired: true
                maxLength: 300
            }
            source {
                databaseColumn: PRODUCT_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
            customAttributes: disabled
        }
    )

    button new (
        buttonName: New
        label: New
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-reset
            customAttributes: disabled
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
            customAttributes: disabled
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
            customAttributes: disabled
        }
    )

)

