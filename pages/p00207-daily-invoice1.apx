    pageItem P207_INVOICE_NO_PREVIEW (
        type: selectList
        label {
            label: Invoice
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT INVOICE_CODE AS DISPLAY_VALUE,
                       INVOICE_NO   AS RETURN_VALUE
                  FROM TRN_SALES_INVOICE_MST
                  WHERE (:P207_CUSTOMER_NO_PREVIEW IS NULL OR CUSTOMER_NO = :P207_CUSTOMER_NO_PREVIEW )
                 ORDER BY INVOICE_DATE DESC
                ```
            displayExtraValues: false
            nullDisplayValue: --Select Invoice--
        }
        cascadingLov {
            parentItems: P207_CUSTOMER_NO_PREVIEW
            itemsToSubmit: P207_CUSTOMER_NO_PREVIEW
        }
        layout {
