    region summery (
        name: "Invoice summery "
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/29/2026 2:06:07 PM (QP5 v5.388) */
                DECLARE
                    v_html             CLOB := '';
                
                    v_total_invoice    NUMBER := 0;
                    v_total_sales      NUMBER := 0;
                    v_total_received   NUMBER := 0;
                    v_total_due        NUMBER := 0;
                    v_total_qty        NUMBER := 0;
                    v_return_qty       NUMBER := 0;
                BEGIN
                    /* =====================================================
                       INVOICE SUMMARY
                       ===================================================== */
                
                    SELECT COUNT (*),
                           NVL (SUM (TOTAL_AMOUNT), 0),
                           NVL (SUM (RECEIVED_AMOUNT), 0),
                           NVL (SUM (DUE_AMOUNT), 0)
                      INTO v_total_invoice,
                           v_total_sales,
                           v_total_received,
                           v_total_due
                      FROM TRN_SALES_INVOICE_MST I
                     WHERE     I.INVOICE_DATE >=
                               NVL (TO_DATE ( :P207_FROM_DATE, 'MM/DD/YYYY'),
                                    TRUNC (SYSDATE))
                           AND I.INVOICE_DATE <
                                 NVL (TO_DATE ( :P207_TO_DATE, 'MM/DD/YYYY'),
                                      TRUNC (SYSDATE))
                               + 1
                           AND (   :P207_CUSTOMER_NO IS NULL
                                OR I.CUSTOMER_NO = :P207_CUSTOMER_NO)
                           AND ( :P207_INVOICE_NO IS NULL OR I.INVOICE_NO = :P207_INVOICE_NO);
                
                
                    /* =====================================================
                       SALES QTY
                       ===================================================== */
                
                    SELECT NVL (SUM (NVL (D.SALES_QTY, 0)), 0)
                      INTO v_total_qty
                      FROM TRN_SALES_INVOICE_MST  I
                           JOIN TRN_SALES_INVOICE_DTL D ON D.INVOICE_NO = I.INVOICE_NO
                     WHERE     I.INVOICE_DATE >=
                               NVL (TO_DATE ( :P207_FROM_DATE, 'MM/DD/YYYY'),
                                    TRUNC (SYSDATE))
                           AND I.INVOICE_DATE <
                                 NVL (TO_DATE ( :P207_TO_DATE, 'MM/DD/YYYY'),
                                      TRUNC (SYSDATE))
                               + 1
                           AND (   :P207_CUSTOMER_NO IS NULL
                                OR I.CUSTOMER_NO = :P207_CUSTOMER_NO)
                           AND ( :P207_INVOICE_NO IS NULL OR I.INVOICE_NO = :P207_INVOICE_NO);
                
                
                    /* =====================================================
                       RETURN QTY
                       ===================================================== */
                
                    SELECT NVL (SUM (NVL (R.RETURN_QTY, 0)), 0)
                      INTO v_return_qty
                      FROM TRN_SALES_INVOICE_MST  I
                           JOIN TRN_SALES_INVOICE_DTL D ON D.INVOICE_NO = I.INVOICE_NO
                           LEFT JOIN
                           (  SELECT RD.INVOICE_DTL_NO,
                                     SUM (NVL (RD.RETURN_QTY, 0))     AS RETURN_QTY
                                FROM TRN_CUSTOMER_RETURN_DTL RD
                                     JOIN TRN_CUSTOMER_RETURN_MST RM
                                         ON RM.RETURN_NO = RD.RETURN_NO
                               WHERE RM.APPROVAL_STATUS = 'A'
                            GROUP BY RD.INVOICE_DTL_NO) R
                               ON R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                     WHERE     I.INVOICE_DATE >=
                               NVL (TO_DATE ( :P207_FROM_DATE, 'MM/DD/YYYY'),
                                    TRUNC (SYSDATE))
                           AND I.INVOICE_DATE <
                                 NVL (TO_DATE ( :P207_TO_DATE, 'MM/DD/YYYY'),
                                      TRUNC (SYSDATE))
                               + 1
                           AND (   :P207_CUSTOMER_NO IS NULL
                                OR I.CUSTOMER_NO = :P207_CUSTOMER_NO)
                           AND ( :P207_INVOICE_NO IS NULL OR I.INVOICE_NO = :P207_INVOICE_NO);
                
                
                    /* =====================================================
                       HTML + CSS
                       ===================================================== */
                
                    v_html :=
                           '<style>
                
                        .invoice-summary {
                            display: grid;
                            grid-template-columns: repeat(6, 1fr);
                            gap: 10px;
                            width: 100%;
                            margin-bottom: 12px;
                        }
                
                        .invoice-summary-card {
                            display: flex;
                            align-items: center;
                            gap: 10px;
                
                            background: #ffffff;
                
                            border: 1px solid #e5e7eb;
                            border-radius: 8px;
                
                            padding: 11px 13px;
                
                            box-shadow: 0 2px 6px rgba(0,0,0,.06);
                
                            min-width: 0;
                
                            transition: all .2s ease;
                        }
                
                        .invoice-summary-card:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 4px 12px rgba(0,0,0,.10);
                        }
                
                        .invoice-summary-icon {
                            width: 38px;
                            height: 38px;
                            min-width: 38px;
                
                            display: flex;
                            align-items: center;
                            justify-content: center;
                
                            border-radius: 8px;
                
                            font-size: 18px;
                        }
                
                        .invoice-summary-content {
                            min-width: 0;
                            flex: 1;
                        }
                
                        .invoice-summary-title {
                            font-size: 11px;
                            color: #6b7280;
                            margin-bottom: 3px;
                            white-space: nowrap;
                        }
                
                        .invoice-summary-value {
                            font-size: 16px;
                            font-weight: 700;
                            color: #111827;
                            white-space: nowrap;
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                
                
                        /* TOTAL INVOICE */
                
                        .invoice-count .invoice-summary-icon {
                            background: #eef2ff;
                            color: #4f46e5;
                        }
                
                        .invoice-count .invoice-summary-value {
                            color: #4f46e5;
                        }
                
                
                        /* TOTAL SALES */
                
                        .invoice-sales .invoice-summary-icon {
                            background: #eff6ff;
                            color: #2563eb;
                        }
                
                        .invoice-sales .invoice-summary-value {
                            color: #2563eb;
                        }
                
                
                        /* RECEIVED */
                
                        .invoice-received .invoice-summary-icon {
                            background: #ecfdf5;
                            color: #198754;
                        }
                
                        .invoice-received .invoice-summary-value {
                            color: #198754;
                        }
                
                
                        /* DUE */
                
                        .invoice-due .invoice-summary-icon {
                            background: #fef2f2;
                            color: #dc3545;
                        }
                
                        .invoice-due .invoice-summary-value {
                            color: #dc3545;
                        }
                
                
                        /* SALES QTY */
                
                        .invoice-qty .invoice-summary-icon {
                            background: #fff7ed;
                            color: #ea580c;
                        }
                
                        .invoice-qty .invoice-summary-value {
                            color: #ea580c;
                        }
                
                
                        /* RETURN QTY */
                
                        .invoice-return .invoice-summary-icon {
                            background: #fdf4ff;
                            color: #9333ea;
                        }
                
                        .invoice-return .invoice-summary-value {
                            color: #9333ea;
                        }
                
                
                        /* TABLET */
                
                        @media (max-width: 1200px) {
                
                            .invoice-summary {
                                grid-template-columns: repeat(3, 1fr);
                            }
                
                        }
                
                
                        /* MOBILE */
                
                        @media (max-width: 650px) {
                
                            .invoice-summary {
                                grid-template-columns: repeat(2, 1fr);
                                gap: 7px;
                            }
                
                            .invoice-summary-card {
                                padding: 9px;
                                gap: 7px;
                            }
                
                            .invoice-summary-icon {
                                width: 32px;
                                height: 32px;
                                min-width: 32px;
                                font-size: 15px;
                            }
                
                            .invoice-summary-title {
                                font-size: 9px;
                            }
                
                            .invoice-summary-value {
                                font-size: 13px;
                            }
                
                        }
                
                
                        /* SMALL MOBILE */
                
                        @media (max-width: 380px) {
                
                            .invoice-summary {
                                grid-template-columns: 1fr 1fr;
                            }
                
                            .invoice-summary-card {
                                padding: 8px 7px;
                            }
                
                            .invoice-summary-icon {
                                width: 28px;
                                height: 28px;
                                min-width: 28px;
                                font-size: 13px;
                            }
                
                            .invoice-summary-value {
                                font-size: 12px;
                            }
                
                        }
                
                    </style>
                
                
                    <div class="invoice-summary">
                
                
                        <!-- TOTAL INVOICE -->
                
                        <div class="invoice-summary-card invoice-count">
                
                            <div class="invoice-summary-icon">
                                <span class="fa fa-file-text-o"></span>
                            </div>
                
                            <div class="invoice-summary-content">
                
                                <div class="invoice-summary-title">
                                    Total Invoice
                                </div>
                
                                <div class="invoice-summary-value">'
                        || TO_CHAR (v_total_invoice, 'FM9999999990')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- TOTAL SALES -->
                
                        <div class="invoice-summary-card invoice-sales">
                
                            <div class="invoice-summary-icon">
                                <span class="fa fa-money"></span>
                            </div>
                
                            <div class="invoice-summary-content">
                
                                <div class="invoice-summary-title">
                                    Total Sales
                                </div>
                
                                <div class="invoice-summary-value">
                                    ৳ '
                        || TO_CHAR (v_total_sales, 'FM9999999990.00')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- RECEIVED -->
                
                        <div class="invoice-summary-card invoice-received">
                
                            <div class="invoice-summary-icon">
                                <span class="fa fa-check-circle"></span>
                            </div>
                
                            <div class="invoice-summary-content">
                
                                <div class="invoice-summary-title">
                                    Received
                                </div>
                
                                <div class="invoice-summary-value">
                                    ৳ '
                        || TO_CHAR (v_total_received, 'FM9999999990.00')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- DUE -->
                
                        <div class="invoice-summary-card invoice-due">
                
                            <div class="invoice-summary-icon">
                                <span class="fa fa-exclamation-circle"></span>
                            </div>
                
                            <div class="invoice-summary-content">
                
                                <div class="invoice-summary-title">
                                    Total Due
                                </div>
                
                                <div class="invoice-summary-value">
                                    ৳ '
                        || TO_CHAR (v_total_due, 'FM9999999990.00')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- SALES QTY -->
                
                        <div class="invoice-summary-card invoice-qty">
                
                            <div class="invoice-summary-icon">
                                <span class="fa fa-cubes"></span>
                            </div>
                
                            <div class="invoice-summary-content">
                
                                <div class="invoice-summary-title">
                                    Sales Qty
                                </div>
                
                                <div class="invoice-summary-value">'
                        || TO_CHAR (v_total_qty, 'FM9999999990.00')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- RETURN QTY -->
                
                        <div class="invoice-summary-card invoice-return">
                
                            <div class="invoice-summary-icon">
                                <span class="fa fa-undo"></span>
                            </div>
                
                            <div class="invoice-summary-content">
                
                                <div class="invoice-summary-title">
                                    Return Qty
                                </div>
                
                                <div class="invoice-summary-value">'
                        || TO_CHAR (v_return_qty, 'FM9999999990.00')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                    </div>';
                
                    RETURN v_html;
                END;
                ```
            pageItemsToSubmit: [
                P207_FROM_DATE
                P207_TO_DATE
                P207_CUSTOMER_NO_PREVIEW
                P207_INVOICE_NO_PREVIEW
            ]
        }
        layout {
            sequence: 60
            parentRegion: @invoice-register_1
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P207_CUSTOMER_NO (
        type: selectList
        label {
            label: Customer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CUSTOMER_NAME AS DISPLAY_VALUE,
                       CUSTOMER_NO   AS RETURN_VALUE
                  FROM MST_CUSTOMER
                 ORDER BY CUSTOMER_NAME
                ```
            displayExtraValues: false
            nullDisplayValue: --Select--
        }
        layout {
            sequence: 30
            region: @invoice-register_1
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
    )

    pageItem P207_CUSTOMER_NO_PREVIEW (
        type: selectList
        label {
            label: Customer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CUSTOMER_NAME AS DISPLAY_VALUE,
                       CUSTOMER_NO   AS RETURN_VALUE
                  FROM MST_CUSTOMER
                 ORDER BY CUSTOMER_NAME
                ```
