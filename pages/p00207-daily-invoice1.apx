page 207 (
    name: Daily Invoice
    alias: DAILY-INVOICE1
    title: Daily Invoice
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function printSingleInvoice(btn) {
            
                var invoice = btn.closest(".inv-report-card");
            
                if (!invoice) return;
            
                var printWindow = window.open("", "_blank", "width=950,height=750");
            
                if (!printWindow) {
                    apex.message.alert("Please allow pop-ups for this site.");
                    return;
                }
            
                var styles = "";
            
                document.querySelectorAll("link[rel='stylesheet'], style")
                    .forEach(function(el) {
                        styles += el.outerHTML;
                    });
            
                printWindow.document.write(`
                    <html>
                    <head>
                        <title>Invoice</title>
            
                        ${styles}
            
                        <style>
                            @page {
                                size: A4;
                                margin: 10mm;
                            }
            
                            .invoice-print-btn {
                                display: none !important;
                            }
                        </style>
                    </head>
            
                    <body>
                        ${invoice.outerHTML}
                    </body>
                    </html>
                `);
            
                printWindow.document.close();
            
                setTimeout(function () {
                    printWindow.print();
                    printWindow.close();
                }, 700);
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region invoice-preview (
        name: Invoice Preview
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/29/2026 2:52:08 PM (QP5 v5.388) */
                DECLARE
                    v_html            CLOB := '';
                    v_invoice_count   NUMBER := 0;
                BEGIN
                    /* =========================================================
                       INVOICE HEADER
                       ========================================================= */
                
                    FOR H
                        IN (  SELECT I.INVOICE_NO,
                                     I.INVOICE_CODE,
                                     I.INVOICE_DATE,
                                     O.ORDER_CODE,
                                     C.CUSTOMER_NO,
                                     C.CUSTOMER_CODE,
                                     C.CUSTOMER_NAME,
                                     C.MOBILE_NO,
                                     C.EMAIL_ADDRESS,
                                     C.ADDRESS,
                                     NVL (I.TOTAL_AMOUNT, 0)        AS TOTAL_AMOUNT,
                                     NVL (I.RECEIVED_AMOUNT, 0)     AS RECEIVED_AMOUNT,
                                     NVL (I.DUE_AMOUNT, 0)          AS DUE_AMOUNT,
                                     I.PAYMENT_STATUS,
                                     I.DELIVERY_STATUS,
                                     I.DELIVERY_BY,
                                     I.DELIVERY_DATE,
                                     I.CREATED_BY,
                                     I.CREATED_DATE
                               FROM TRN_SALES_INVOICE_MST I
                                    LEFT JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = I.CUSTOMER_NO
                                    LEFT JOIN TRN_SALES_ORDER_MST O ON O.ORDER_NO = I.ORDER_NO
                            --   WHERE     /* =========================
                            --                FROM DATE
                            --                ========================= */
                
                            --             (   :P207_FROM_DATE IS NULL
                            --              OR I.INVOICE_DATE >=
                            --                 TO_DATE ( :P207_FROM_DATE, 'MM/DD/YYYY'))
                                    /* =========================
                                       TO DATE
                                       ========================= */
                
                                    -- WHERE (   :P207_TO_DATE IS NULL
                                    --      OR I.INVOICE_DATE <
                                    --         TO_DATE ( :P207_TO_DATE, 'MM/DD/YYYY') + 1)
                                    /* =========================
                                       CUSTOMER FILTER
                                       ========================= */
                
                                    where (  -- :P207_CUSTOMER_NO_PREVIEW IS NULL
                                       --  OR 
                                         I.CUSTOMER_NO = :P207_CUSTOMER_NO_PREVIEW  OR
                                          I.INVOICE_NO = :P207_INVOICE_NO_PREVIEW)
                                    /* =========================
                                       INVOICE FILTER
                                       ========================= */
                
                                    -- AND (  :P207_INVOICE_NO_PREVIEW IS NULL
                                    --      OR
                                    --       I.INVOICE_NO = :P207_INVOICE_NO_PREVIEW)
                           ORDER BY I.INVOICE_DATE DESC, I.INVOICE_NO DESC)
                    LOOP
                        v_invoice_count := v_invoice_count + 1;
                
                
                        /* =====================================================
                           INVOICE CARD START
                           ===================================================== */
                
                        v_html := v_html || '<div class="inv-report-card">';
                
                
                        /* =====================================================
                           PRINT BUTTON
                           ===================================================== */
                
                        v_html := v_html || '<div class="invoice-print-btn">
                
                                <button
                                    type="button"
                                    onclick="printSingleInvoice(this)"
                                    title="Print Invoice">
                
                                    <span class="fa fa-print"></span>
                
                                </button>
                
                            </div>';
                
                
                        /* =====================================================
                           HEADER
                           ===================================================== */
                
                        v_html := v_html || '<div class="inv-header">
                
                
                                <div class="inv-company">
                
                                    <div class="inv-company-name">
                
                                        <span class="fa fa-bolt"></span>
                
                                        Dealer Inventory &amp; Sales
                
                                    </div>
                
                                    <div class="inv-company-sub">
                                        Sales Invoice
                                    </div>
                
                                </div>
                
                
                                <div class="inv-title">
                
                                    <div class="inv-title-main">
                
                                        <span class="fa fa-file-text-o"></span>
                
                                        INVOICE
                
                                    </div>
                
                                    <div class="inv-copy">
                                        Original for Customer
                                    </div>
                
                                </div>
                
                
                            </div>
                
                
                            <div class="inv-line"></div>';
                
                
                        /* =====================================================
                           CUSTOMER / INVOICE INFORMATION
                           ===================================================== */
                
                        v_html :=
                               v_html
                            || '<div class="inv-info">
                
                
                                <div class="inv-left">
                
                
                                    <div>
                
                                        <span class="fa fa-hashtag"></span>
                
                                        <b>Invoice No:</b>
                
                                        '
                            || APEX_ESCAPE.HTML (H.INVOICE_CODE)
                            || '
                
                                    </div>
                
                
                                    <div>
                
                                        <span class="fa fa-calendar"></span>
                
                                        <b>Invoice Date:</b>
                
                                        '
                            || TO_CHAR (H.INVOICE_DATE, 'DD-MON-YYYY')
                            || '
                
                                    </div>';
                
                
                        /* ORDER */
                
                        IF H.ORDER_CODE IS NOT NULL
                        THEN
                            v_html := v_html || '<div>
                
                                    <span class="fa fa-shopping-cart"></span>
                
                                    <b>Order No:</b>
                
                                    ' || APEX_ESCAPE.HTML (H.ORDER_CODE) || '
                
                                </div>';
                        END IF;
                
                
                        /* CUSTOMER */
                
                        v_html :=
                               v_html
                            || '<div>
                
                                <span class="fa fa-user"></span>
                
                                <b>Customer:</b>
                
                                '
                            || APEX_ESCAPE.HTML (H.CUSTOMER_NAME)
                            || '
                
                            </div>
                
                
                            <div>
                
                                <span class="fa fa-phone"></span>
                
                                <b>Mobile:</b>
                
                                '
                            || APEX_ESCAPE.HTML (H.MOBILE_NO)
                            || '
                
                            </div>
                
                
                            </div>
                
                
                            <div class="inv-right">
                
                
                                <!-- PAYMENT -->
                
                                <div>
                
                                    <span class="fa fa-credit-card"></span>
                
                                    <b>Payment:</b>';
                
                
                        /* =====================================================
                           PAYMENT STATUS
                           P  = PAID
                           PP = PARTIAL PAID
                           UP  = UNPAID
                           ===================================================== */
                
                        IF UPPER (NVL (H.PAYMENT_STATUS, 'UP')) = 'P'
                        THEN
                            v_html := v_html || '<span class="status-badge status-paid">
                
                                    <span class="fa fa-check-circle"></span>
                
                                    Paid
                
                                </span>';
                        ELSIF UPPER (NVL (H.PAYMENT_STATUS, 'UP')) = 'PP'
                        THEN
                            v_html := v_html || '<span class="status-badge status-partial">
                
                                    <span class="fa fa-adjust"></span>
                
                                    Partial Paid
                
                                </span>';
                        ELSE
                            v_html := v_html || '<span class="status-badge status-unpaid">
                
                                    <span class="fa fa-exclamation-circle"></span>
                
                                    Unpaid
                
                                </span>';
                        END IF;
                
                
                        v_html := v_html || '</div>
                
                
                            <!-- DELIVERY -->
                
                            <div>
                
                                <span class="fa fa-truck"></span>
                
                                <b>Delivery:</b>';
                
                
                        /* =====================================================
                           DELIVERY STATUS
                           D = DELIVERED
                           P = PENDING
                           ===================================================== */
                
                        IF UPPER (NVL (H.DELIVERY_STATUS, 'P')) = 'D'
                        THEN
                            v_html :=
                                v_html || '<span class="status-badge status-delivered">
                
                                    <span class="fa fa-check"></span>
                
                                    Delivered
                
                                </span>';
                        ELSE
                            v_html := v_html || '<span class="status-badge status-pending">
                
                                    <span class="fa fa-clock-o"></span>
                
                                    Pending
                
                                </span>';
                        END IF;
                
                
                        v_html :=
                            v_html || '</div>
                
                
                            <!-- DUE -->
                
                            <div>
                
                                <span class="fa fa-money"></span>
                
                                <b>Due:</b>
                
                                <span class="due-value">
                
                                    ৳ ' || TO_CHAR (H.DUE_AMOUNT, 'FM9999999990.00') || '
                
                                </span>
                
                            </div>
                
                
                            </div>
                
                
                            </div>';
                
                
                        /* =====================================================
                           PRODUCT TABLE
                           ===================================================== */
                
                        v_html := v_html || '<table class="inv-table">
                
                
                                <thead>
                
                                    <tr>
                
                                        <th class="sl">#</th>
                
                                        <th>Product</th>
                
                                        <th class="num">Qty</th>
                
                                        <th class="num">Delivered</th>
                
                                        <th class="num">Return</th>
                
                                        <th class="num">Balance</th>
                
                                        <th class="num">Rate</th>
                
                                        <th class="num">Amount</th>
                
                                    </tr>
                
                                </thead>
                
                
                                <tbody>';
                
                
                        /* =====================================================
                           PRODUCT DETAILS
                           ===================================================== */
                
                        DECLARE
                            v_sl   NUMBER := 0;
                        BEGIN
                            FOR D
                                IN (  SELECT D.INVOICE_DTL_NO,
                                             P.PRODUCT_CODE,
                                             P.PRODUCT_NAME,
                                             PC.CATEGORY_NAME,
                                             NVL (D.SALES_QTY, 0)
                                                 AS SALES_QTY,
                                             NVL (D.DELIVERED_QTY, 0)
                                                 AS DELIVERED_QTY,
                                             NVL (D.SALES_QTY, 0) - NVL (D.DELIVERED_QTY, 0)
                                                 AS BALANCE_QTY,
                                             NVL (D.SALES_RATE, 0)
                                                 AS SALES_RATE,
                                             NVL (D.TOTAL_AMOUNT, 0)
                                                 AS TOTAL_AMOUNT,
                                             NVL (R.RETURN_QTY, 0)
                                                 AS RETURN_QTY
                                       FROM TRN_SALES_INVOICE_DTL D
                                            LEFT JOIN MST_PRODUCT P
                                                ON P.PRODUCT_NO = D.PRODUCT_NO
                                            LEFT JOIN MST_PRODUCT_CATEGORY PC
                                                ON PC.CATEGORY_NO = P.CATEGORY_NO
                                            LEFT JOIN
                                            (  SELECT RD.INVOICE_DTL_NO,
                                                      SUM (NVL (RD.RETURN_QTY, 0))    AS RETURN_QTY
                                                 FROM TRN_CUSTOMER_RETURN_DTL RD
                                                      JOIN TRN_CUSTOMER_RETURN_MST RM
                                                          ON RM.RETURN_NO = RD.RETURN_NO
                                                WHERE RM.APPROVAL_STATUS = 'A'
                                             GROUP BY RD.INVOICE_DTL_NO) R
                                                ON R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                                      WHERE D.INVOICE_NO = H.INVOICE_NO
                                   ORDER BY D.INVOICE_DTL_NO)
                            LOOP
                                v_sl := v_sl + 1;
                
                
                                v_html :=
                                       v_html
                                    || '<tr>
                
                
                                        <td class="sl">
                
                                            '
                                    || v_sl
                                    || '
                
                                        </td>
                
                
                                        <td>
                
                                            <div class="product-name">
                
                                                '
                                    || APEX_ESCAPE.HTML (D.PRODUCT_NAME)
                                    || '
                
                                            </div>
                
                
                                            <div class="product-code">
                
                                                '
                                    || APEX_ESCAPE.HTML (D.PRODUCT_CODE)
                                    || '
                
                                            </div>
                
                                        </td>
                
                
                                        <td class="num">
                
                                            '
                                    || TO_CHAR (D.SALES_QTY, 'FM999999990.00')
                                    || '
                
                                        </td>
                
                
                                        <td class="num">
                
                                            '
                                    || TO_CHAR (D.DELIVERED_QTY, 'FM999999990.00')
                                    || '
                
                                        </td>
                
                
                                        <td class="num return-value">
                
                                            '
                                    || TO_CHAR (D.RETURN_QTY, 'FM999999990.00')
                                    || '
                
                                        </td>
                
                
                                        <td class="num">
                
                                            '
                                    || TO_CHAR (D.BALANCE_QTY, 'FM999999990.00')
                                    || '
                
                                        </td>
                
                
                                        <td class="num">
                
                                            '
                                    || TO_CHAR (D.SALES_RATE, 'FM999999990.00')
                                    || '
                
                                        </td>
                
                
                                        <td class="num amount">
                
                                            '
                                    || TO_CHAR (D.TOTAL_AMOUNT, 'FM9999999990.00')
                                    || '
                
                                        </td>
                
                
                                    </tr>';
                            END LOOP;
                        END;
                
                
                        v_html := v_html || '</tbody>
                
                            </table>';
                
                
                        /* =====================================================
                           TOTAL SECTION
                           ===================================================== */
                
                        v_html := v_html || '<div class="inv-total-area">
                
                
                                <div class="inv-total-left">
                
                                    <div class="small-note">
                
                                        <span class="fa fa-info-circle"></span>
                
                                        Payment Status:
                
                                        <b>';
                
                
                        /* PAYMENT TEXT */
                
                        IF UPPER (NVL (H.PAYMENT_STATUS, 'UP')) = 'P'
                        THEN
                            v_html := v_html || 'Paid';
                        ELSIF UPPER (NVL (H.PAYMENT_STATUS, 'UP')) = 'PP'
                        THEN
                            v_html := v_html || 'Partial Paid';
                        ELSE
                            v_html := v_html || 'Unpaid';
                        END IF;
                
                
                        v_html :=
                               v_html
                            || '</b>
                
                                    </div>
                
                                </div>
                
                
                                <div class="inv-total-right">
                
                
                                    <div class="total-row">
                
                                        <span>
                
                                            <span class="fa fa-calculator"></span>
                
                                            Invoice Total
                
                                        </span>
                
                                        <b>
                
                                            ৳ '
                            || TO_CHAR (H.TOTAL_AMOUNT, 'FM9999999990.00')
                            || '
                
                                        </b>
                
                                    </div>
                
                
                                    <div class="total-row received-row">
                
                                        <span>
                
                                            <span class="fa fa-check-circle"></span>
                
                                            Received
                
                                        </span>
                
                                        <b>
                
                                            ৳ '
                            || TO_CHAR (H.RECEIVED_AMOUNT, 'FM9999999990.00')
                            || '
                
                                        </b>
                
                                    </div>
                
                
                                    <div class="total-row due-row">
                
                                        <span>
                
                                            <span class="fa fa-exclamation-circle"></span>
                
                                            Due
                
                                        </span>
                
                                        <b>
                
                                            ৳ '
                            || TO_CHAR (H.DUE_AMOUNT, 'FM9999999990.00')
                            || '
                
                                        </b>
                
                                    </div>
                
                
                                </div>
                
                
                            </div>';
                
                
                        /* =====================================================
                           PAID WATERMARK
                           ===================================================== */
                
                        IF UPPER (NVL (H.PAYMENT_STATUS, 'UP')) = 'P'
                        THEN
                            v_html := v_html || '<div class="paid-watermark">
                
                                    <span class="fa fa-check-circle"></span>
                
                                    PAID
                
                                </div>';
                        END IF;
                
                
                        /* =====================================================
                           FOOTER
                           ===================================================== */
                
                        v_html :=
                               v_html
                            || '<div class="inv-footer">
                
                
                                <span>
                
                                    <span class="fa fa-user"></span>
                
                                    Prepared By:
                
                                    '
                            || NVL (APEX_ESCAPE.HTML (H.CREATED_BY), '-')
                            || '
                
                                </span>
                
                
                                <span>
                
                                    <span class="fa fa-clock-o"></span>
                
                                    '
                            || TO_CHAR (H.CREATED_DATE, 'DD-MON-YYYY HH24:MI')
                            || '
                
                                </span>
                
                
                            </div>
                
                
                            </div>';
                    END LOOP;
                
                
                    /* =========================================================
                       NO DATA
                       ========================================================= */
                
                    IF v_invoice_count = 0
                    THEN
                        v_html := '<div class="no-invoice">
                
                
                                <div class="no-invoice-icon">
                
                                    <span class="fa fa-file-text-o"></span>
                
                                </div>
                
                
                                <div class="no-invoice-title">
                
                                    No Invoice Found
                
                                </div>
                
                
                                <div class="no-invoice-text">
                
                                    No invoice matches the selected filter.
                
                                </div>
                
                
                            </div>';
                    END IF;
                
                
                    /* =========================================================
                       CSS
                       ========================================================= */
                
                    v_html := '<style>
                
                
                        /* =========================================
                           INVOICE CARD
                           ========================================= */
                
                        .inv-report-card {
                
                            position: relative;
                
                            width: 100%;
                
                            max-width: 1050px;
                
                            margin: 0 auto 12px;
                
                            padding: 16px 18px;
                
                            background: #ffffff;
                
                            border: 1px solid #dfe3e8;
                
                            border-radius: 5px;
                
                            box-shadow:
                                0 2px 7px rgba(0,0,0,.06);
                
                            box-sizing: border-box;
                
                            font-family:
                                Arial,
                                Helvetica,
                                sans-serif;
                
                            font-size: 11px;
                
                            color: #222;
                
                            overflow: hidden;
                        }
                
                
                        /* =========================================
                           PRINT ICON
                           ========================================= */
                
                        .invoice-print-btn {
                
                            position: absolute;
                
                            top: 10px;
                
                            right: 10px;
                
                            z-index: 50;
                        }
                
                
                        .invoice-print-btn button {
                
                            width: 29px;
                
                            height: 29px;
                
                            border: 1px solid #dbe2ea;
                
                            border-radius: 5px;
                
                            background: #ffffff;
                
                            color: #64748b;
                
                            cursor: pointer;
                
                            font-size: 11px;
                
                            transition:
                                all .15s ease;
                        }
                
                
                        .invoice-print-btn button:hover {
                
                            background: #2563eb;
                
                            color: #ffffff;
                
                            border-color: #2563eb;
                
                        }
                
                
                        /* =========================================
                           HEADER
                           ========================================= */
                
                        .inv-header {
                
                            display: flex;
                
                            justify-content:
                                space-between;
                
                            align-items:
                                flex-start;
                        }
                
                
                        .inv-company-name {
                
                            font-size: 16px;
                
                            font-weight: 700;
                
                            color: #1f2937;
                        }
                
                
                        .inv-company-name .fa {
                
                            color: #2563eb;
                
                            margin-right: 4px;
                        }
                
                
                        .inv-company-sub {
                
                            margin-top: 2px;
                
                            font-size: 9px;
                
                            color: #64748b;
                        }
                
                
                        .inv-title {
                
                            text-align: right;
                
                            padding-right: 35px;
                        }
                
                
                        .inv-title-main {
                
                            font-size: 16px;
                
                            font-weight: 700;
                
                            color: #2563eb;
                        }
                
                
                        .inv-title-main .fa {
                
                            font-size: 12px;
                
                            margin-right: 3px;
                        }
                
                
                        .inv-copy {
                
                            margin-top: 2px;
                
                            font-size: 8px;
                
                            color: #6b7280;
                        }
                
                
                        .inv-line {
                
                            border-top:
                                1px solid #cfd5dc;
                
                            margin:
                                7px 0 8px;
                        }
                
                
                        /* =========================================
                           INFO
                           ========================================= */
                
                        .inv-info {
                
                            display: flex;
                
                            justify-content:
                                space-between;
                
                            gap: 20px;
                
                            line-height: 1.55;
                
                            margin-bottom: 8px;
                        }
                
                
                        .inv-left {
                
                            flex: 1;
                        }
                
                
                        .inv-right {
                
                            min-width: 205px;
                
                            text-align: right;
                        }
                
                
                        .inv-info .fa {
                
                            width: 12px;
                
                            color: #64748b;
                
                            font-size: 9px;
                        }
                
                
                        /* =========================================
                           STATUS
                           ========================================= */
                
                        .status-badge {
                
                            display: inline-flex;
                
                            align-items: center;
                
                            gap: 3px;
                
                            margin-left: 4px;
                
                            padding:
                                1px 6px;
                
                            border-radius: 10px;
                
                            font-size: 9px;
                
                            font-weight: 700;
                        }
                
                
                        .status-paid {
                
                            color: #198754;
                
                            background: #eaf8f0;
                        }
                
                
                        .status-partial {
                
                            color: #d97706;
                
                            background: #fff7e6;
                        }
                
                
                        .status-unpaid {
                
                            color: #dc3545;
                
                            background: #fff0f0;
                        }
                
                
                        .status-delivered {
                
                            color: #198754;
                
                            background: #eaf8f0;
                        }
                
                
                        .status-pending {
                
                            color: #d97706;
                
                            background: #fff7e6;
                        }
                
                
                        .due-value {
                
                            color: #dc3545;
                
                            font-weight: 700;
                
                            margin-left: 3px;
                        }
                
                
                        /* =========================================
                           PRODUCT TABLE
                           ========================================= */
                
                        .inv-table {
                
                            width: 100%;
                
                            border-collapse:
                                collapse;
                
                            font-size: 11px;
                        }
                
                
                        .inv-table th {
                
                            background: #f4f6f8;
                
                            border:
                                1px solid #bfc5cc;
                
                            padding:
                                5px 6px;
                
                            font-weight: 700;
                
                            color: #374151;
                
                            text-align: left;
                
                            line-height: 1.15;
                        }
                
                
                        .inv-table td {
                
                            border:
                                1px solid #d7dce1;
                
                            padding:
                                4px 6px;
                
                            vertical-align: middle;
                
                            line-height: 1.15;
                        }
                
                
                        .inv-table .num {
                
                            text-align: right;
                
                            white-space: nowrap;
                        }
                
                
                        .inv-table .sl {
                
                            width: 27px;
                
                            text-align: center;
                        }
                
                
                        .product-name {
                
                            font-size: 11px;
                
                            font-weight: 700;
                
                            color: #1f2937;
                
                            line-height: 1.15;
                        }
                
                
                        .product-code {
                
                            margin-top: 2px;
                
                            font-size: 9px;
                
                            color: #8a94a3;
                
                            line-height: 1;
                        }
                
                
                        .amount {
                
                            font-size: 11px;
                
                            font-weight: 700;
                        }
                
                
                        .return-value {
                
                            color: #9333ea;
                        }
                
                
                        /* =========================================
                           TOTAL
                           ========================================= */
                
                        .inv-total-area {
                
                            display: flex;
                
                            justify-content:
                                space-between;
                
                            margin-top: 8px;
                
                            padding-top: 7px;
                
                            border-top:
                                1px solid #cfd5dc;
                        }
                
                
                        .inv-total-left {
                
                            flex: 1;
                        }
                
                
                        .small-note {
                
                            color: #6b7280;
                
                            font-size: 9px;
                        }
                
                
                        .inv-total-right {
                
                            width: 255px;
                        }
                
                
                        .total-row {
                
                            display: flex;
                
                            justify-content:
                                space-between;
                
                            align-items: center;
                
                            padding:
                                3px 0;
                
                            font-size: 10px;
                        }
                
                
                        .total-row b {
                
                            min-width: 115px;
                
                            text-align: right;
                        }
                
                
                        .received-row {
                
                            color: #198754;
                
                            font-weight: 600;
                        }
                
                
                        .due-row {
                
                            color: #dc3545;
                
                            font-weight: 700;
                
                            border-top:
                                1px solid #e5e7eb;
                
                            margin-top: 2px;
                
                            padding-top: 5px;
                
                            font-size: 11px;
                        }
                
                
                        /* =========================================
                           PAID WATERMARK
                           ========================================= */
                
                        .paid-watermark {
                
                            position: absolute;
                
                            left: 50%;
                
                            top: 58%;
                
                            transform:
                                translate(-50%, -50%)
                                rotate(-18deg);
                
                            font-size: 55px;
                
                            font-weight: 800;
                
                            letter-spacing: 4px;
                
                            color:
                                rgba(25,135,84,.075);
                
                            border:
                                3px solid
                                rgba(25,135,84,.075);
                
                            border-radius: 7px;
                
                            padding:
                                3px 16px;
                
                            pointer-events: none;
                
                            user-select: none;
                
                            z-index: 10;
                
                            white-space: nowrap;
                        }
                
                
                        .paid-watermark .fa {
                
                            font-size: 40px;
                
                            margin-right: 5px;
                        }
                
                
                        /* =========================================
                           FOOTER
                           ========================================= */
                
                        .inv-footer {
                
                            display: flex;
                
                            justify-content:
                                space-between;
                
                            margin-top: 9px;
                
                            padding-top: 6px;
                
                            border-top:
                                1px solid #edf0f2;
                
                            font-size: 8px;
                
                            color: #8a94a3;
                        }
                
                
                        /* =========================================
                           NO DATA
                           ========================================= */
                
                        .no-invoice {
                
                            text-align: center;
                
                            padding:
                                35px 15px;
                
                            background: #ffffff;
                
                            border:
                                1px solid #e5e7eb;
                
                            border-radius: 6px;
                        }
                
                
                        .no-invoice-icon {
                
                            font-size: 28px;
                
                            color: #94a3b8;
                
                            margin-bottom: 7px;
                        }
                
                
                        .no-invoice-title {
                
                            font-size: 14px;
                
                            font-weight: 700;
                
                            color: #374151;
                        }
                
                
                        .no-invoice-text {
                
                            margin-top: 3px;
                
                            font-size: 10px;
                
                            color: #94a3b8;
                        }
                
                
                        /* =========================================
                           MOBILE
                           ========================================= */
                
                        @media (max-width: 700px) {
                
                            .inv-report-card {
                
                                padding: 12px;
                
                                margin-bottom: 9px;
                
                                font-size: 10px;
                            }
                
                
                            .inv-company-name,
                            .inv-title-main {
                
                                font-size: 14px;
                            }
                
                
                            .inv-title {
                
                                padding-right: 30px;
                            }
                
                
                            .inv-info {
                
                                flex-direction: column;
                
                                gap: 4px;
                            }
                
                
                            .inv-right {
                
                                min-width: auto;
                
                                text-align: left;
                            }
                
                
                            .inv-table {
                
                                font-size: 9px;
                            }
                
                
                            .inv-table th,
                            .inv-table td {
                
                                padding:
                                    4px 3px;
                            }
                
                
                            .product-name {
                
                                font-size: 9px;
                            }
                
                
                            .product-code {
                
                                font-size: 8px;
                            }
                
                
                            .inv-total-area {
                
                                flex-direction: column;
                            }
                
                
                            .inv-total-right {
                
                                width: 100%;
                
                                max-width: 255px;
                
                                margin-left: auto;
                            }
                
                
                            .paid-watermark {
                
                                font-size: 38px;
                
                                padding:
                                    2px 10px;
                
                                letter-spacing: 2px;
                            }
                
                
                            .paid-watermark .fa {
                
                                font-size: 28px;
                            }
                
                        }
                
                
                        /* =========================================
                           PRINT
                           ========================================= */
                
                        @media print {
                
                            body {
                
                                background: #ffffff !important;
                            }
                
                
                            .inv-report-card {
                
                                width: 100% !important;
                
                                max-width: 100% !important;
                
                                margin: 0 !important;
                
                                border:
                                    1px solid #999 !important;
                
                                box-shadow: none !important;
                            }
                
                
                            .invoice-print-btn {
                
                                display: none !important;
                            }
                
                
                            .paid-watermark {
                
                                display: block !important;
                            }
                
                
                            @page {
                
                                size: A4;
                
                                margin: 10mm;
                            }
                
                        }
                
                
                    </style>' || v_html;
                
                
                    RETURN v_html;
                END;
                ```
