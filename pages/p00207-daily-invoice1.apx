    dynamicAction new (
        name: DA_INVOIVE_REGISTER_REFRESH
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P207_FROM_DATE
                P207_TO_DATE
                P207_CUSTOMER_NO
                P207_INVOICE_NO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @summery
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new_1 (
        name: DA_INVOIVE_PREVIEW_REFRESH
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P207_CUSTOMER_NO_PREVIEW
                P207_INVOICE_NO_PREVIEW
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @invoice-preview
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

