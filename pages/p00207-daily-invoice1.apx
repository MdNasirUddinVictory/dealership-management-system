    region sales-report (
        name: Daily Invoice Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  SELECT I.INVOICE_NO,
                         I.INVOICE_CODE,
                         TO_CHAR (I.INVOICE_DATE, 'DD-MON-YYYY')
                             AS INVOICE_DATE,
                         O.ORDER_CODE,
                         C.CUSTOMER_CODE,
                         C.CUSTOMER_NAME,
                         C.MOBILE_NO,
                         C.EMAIL_ADDRESS,
                         C.ADDRESS,
                         D.INVOICE_DTL_NO,
                         P.PRODUCT_CODE,
                         P.PRODUCT_NAME,
                         PC.CATEGORY_NAME,
                         NVL (D.SALES_QTY, 0)
                             AS SALES_QTY,
                         NVL (D.DELIVERED_QTY, 0)
                             AS DELIVERED_QTY,
                         NVL (D.SALES_QTY, 0) - NVL (D.DELIVERED_QTY, 0)
                             AS BALANCE_QTY,
                         NVL (D.SALES_RATE, 0)
                             AS SALES_RATE,
                         NVL (I.TOTAL_AMOUNT, 0)
                             AS INVOICE_TOTAL_AMOUNT,
                         NVL (I.RECEIVED_AMOUNT, 0)
                             AS RECEIVED_AMOUNT,
                         NVL (I.DUE_AMOUNT, 0)
                             AS DUE_AMOUNT,
                         I.PAYMENT_STATUS,
                         I.DELIVERY_STATUS,
                         I.DELIVERY_BY,
                         TO_CHAR (I.DELIVERY_DATE, 'DD-MON-YYYY')
                             AS DELIVERY_DATE,
                         I.CREATED_BY,
                         TO_CHAR (I.CREATED_DATE, 'DD-MON-YYYY HH24:MI:SS')
                             AS CREATED_DATE,
                         NVL (R.RETURN_QTY, 0)
                             AS RETURN_QTY
                    FROM TRN_SALES_INVOICE_MST I
                         LEFT JOIN TRN_SALES_INVOICE_DTL D ON D.INVOICE_NO = I.INVOICE_NO
                         LEFT JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = I.CUSTOMER_NO
                         LEFT JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         LEFT JOIN MST_PRODUCT_CATEGORY PC ON PC.CATEGORY_NO = P.CATEGORY_NO
                         LEFT JOIN TRN_SALES_ORDER_MST O ON O.ORDER_NO = I.ORDER_NO
                         LEFT JOIN
                         (  SELECT D.INVOICE_DTL_NO, SUM (NVL (D.RETURN_QTY, 0)) AS RETURN_QTY
                              FROM TRN_CUSTOMER_RETURN_DTL D
                                   JOIN TRN_CUSTOMER_RETURN_MST M ON M.RETURN_NO = D.RETURN_NO
                             WHERE M.APPROVAL_STATUS = 'A'
                          GROUP BY D.INVOICE_DTL_NO) R
                             ON R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                   WHERE     I.INVOICE_DATE >=
                             NVL (TO_DATE ( :P207_FROM_DATE, 'MM/DD/YYYY'), TRUNC (SYSDATE))
                         AND I.INVOICE_DATE <
                             NVL (TO_DATE ( :P207_TO_DATE, 'MM/DD/YYYY'), TRUNC (SYSDATE)) + 1
                         AND ( :P207_CUSTOMER_NO IS NULL OR I.CUSTOMER_NO = :P207_CUSTOMER_NO)
                         AND ( :P207_INVOICE_NO IS NULL OR I.INVOICE_NO = :P207_INVOICE_NO)
                ORDER BY I.INVOICE_DATE DESC, I.INVOICE_NO DESC, D.INVOICE_DTL_NO
                ```
            pageItemsToSubmit: [
                P207_FROM_DATE
                P207_TO_DATE
                P207_CUSTOMER_NO
                P207_INVOICE_NO
            ]
        }
