    validation opening-quantity-must-be-greater-than-zero (
        name: Opening quantity must be greater than zero.
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: NVL(:P9_OPENING_QTY,0) > 0
        }
        error {
            errorMessage: Opening quantity must be greater than zero.
            associatedItem: @P9_OPENING_QTY
        }
    )

    validation opening-stock-already-exists-for-this-product (
        name: Opening stock already exists for this product.
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM TRN_OPENING_STOCK
                WHERE PRODUCT_NO = :P9_PRODUCT_NO
                  AND NVL(OPENING_NO,0) <> NVL(:P9_OPENING_NO,0)
                ```
        }
        error {
            errorMessage: Opening stock already exists for this product.
            associatedItem: @P9_OPENING_QTY
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM TRN_OPENING_STOCK
                    WHERE OPENING_NO = :P9_OPENING_NO;
                
                    apex_application.g_print_success_message :=
                        'Opening stock deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8129065651435016243
        }
    )

    process initialize-form-supplier-setup (
        name: Initialize form Supplier Setup
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8129056810661016221
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    IF :P9_OPENING_NO IS NULL THEN
                
                        INSERT INTO TRN_OPENING_STOCK
                        (
                            OPENING_NO,
                            OPENING_DATE,
                            PRODUCT_NO,
                            OPENING_QTY,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_OPENING_NO.NEXTVAL,
                            :P9_OPENING_DATE,
                            :P9_PRODUCT_NO,
                            :P9_OPENING_QTY,
                            :P9_REMARKS,
                            :APP_USER,
                            SYSDATE
                        )
                        RETURNING OPENING_NO
                             INTO :P9_OPENING_NO;
                
                        /* STOCK LEDGER POSTING */
                
                        INSERT INTO TRN_STOCK_LEDGER
                        (
                            LEDGER_NO,
                            TRAN_DATE,
                            TRAN_TYPE,
                            REF_NO,
                            PRODUCT_NO,
                            QTY_IN,
                            QTY_OUT,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_LEDGER_NO.NEXTVAL,
                            :P9_OPENING_DATE,
                            'OPENING',
                            :P9_OPENING_NO,
                            :P9_PRODUCT_NO,
                            :P9_OPENING_QTY,
                            0,
                            :P9_REMARKS,
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Opening stock saved successfully.';
                
                    ELSE
                
                        UPDATE TRN_OPENING_STOCK
                           SET OPENING_DATE = :P9_OPENING_DATE,
                               PRODUCT_NO   = :P9_PRODUCT_NO,
                               OPENING_QTY  = :P9_OPENING_QTY,
                               REMARKS      = :P9_REMARKS,
                               UPDATED_BY   = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE OPENING_NO = :P9_OPENING_NO;
                
                        /* LEDGER UPDATE */
                
                        UPDATE TRN_STOCK_LEDGER
                           SET TRAN_DATE   = :P9_OPENING_DATE,
                               PRODUCT_NO  = :P9_PRODUCT_NO,
                               QTY_IN      = :P9_OPENING_QTY,
                               REMARKS     = :P9_REMARKS
                         WHERE TRAN_TYPE = 'OPENING'
                           AND REF_NO    = :P9_OPENING_NO;
                
                        apex_application.g_print_success_message :=
                            'Opening stock updated successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8129065283753016243
        }
    )

)

