    region opening-balance-register (
        name: Opening Balance Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       O.OPENING_NO,
                       O.FIN_YEAR,
                       H.ACCOUNT_CODE,
                       H.ACCOUNT_NAME,
                       H.ACCOUNT_TYPE,
                
                       NVL(O.OPENING_DEBIT, 0)  AS OPENING_DEBIT,
                       NVL(O.OPENING_CREDIT, 0) AS OPENING_CREDIT,
                
                       CASE
                           WHEN NVL(O.OPENING_DEBIT, 0)
                              - NVL(O.OPENING_CREDIT, 0) >= 0
                           THEN NVL(O.OPENING_DEBIT, 0)
                              - NVL(O.OPENING_CREDIT, 0)
                           ELSE NVL(O.OPENING_CREDIT, 0)
                              - NVL(O.OPENING_DEBIT, 0)
                       END AS BALANCE,
                
                       CASE
                           WHEN NVL(O.OPENING_DEBIT, 0)
                              - NVL(O.OPENING_CREDIT, 0) >= 0
                           THEN 'DR'
                           ELSE 'CR'
                       END AS BALANCE_TYPE,
                
                       CASE O.APPROVAL_STATUS
                           WHEN 'P' THEN 'Pending'
                           WHEN 'A' THEN 'Approved'
                           WHEN 'R' THEN 'Rejected'
                           ELSE O.APPROVAL_STATUS
                       END AS APPROVAL_STATUS,
                
                       O.CREATED_BY,
                       O.CREATED_DATE
                
                FROM ACC_OPENING_BALANCE O
                JOIN MST_ACCOUNT_HEAD H
                  ON H.ACCOUNT_NO = O.ACCOUNT_NO
                
                WHERE (
                          :P311_FIN_YEAR IS NULL
                          OR O.FIN_YEAR = :P311_FIN_YEAR
                      )
                
                ORDER BY
                       H.ACCOUNT_CODE;
                ```
            pageItemsToSubmit: P311_FIN_YEAR
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
