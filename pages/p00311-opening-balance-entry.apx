    process initialize-form-journal-voucher (
        name: Initialize form Journal Voucher
        type: formInitialization
        formRegion: @register
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11463188357787318
        }
    )

    process process-form-voucher-mst (
        name: Process form Opening Balance Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/25/2026 1:59:43 PM (QP5 v5.388) */
                DECLARE
                    v_exists   NUMBER;
                BEGIN
                    -- Required validation
                    IF :P311_FIN_YEAR IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001, 'Financial year is required.');
                    END IF;
                
                    IF :P311_ACCOUNT_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20002, 'Please select an account.');
                    END IF;
                
                    -- Debit/Credit validation
                    IF     NVL ( :P311_OPENING_DEBIT, 0) = 0
                       AND NVL ( :P311_OPENING_CREDIT, 0) = 0
                    THEN
                        RAISE_APPLICATION_ERROR (-20003,
                                                 'Enter either debit or credit amount.');
                    END IF;
                
                    IF     NVL ( :P311_OPENING_DEBIT, 0) > 0
                       AND NVL ( :P311_OPENING_CREDIT, 0) > 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20004,
                            'Debit and credit cannot be entered together.');
                    END IF;
                
                    IF    NVL ( :P311_OPENING_DEBIT, 0) < 0
                       OR NVL ( :P311_OPENING_CREDIT, 0) < 0
                    THEN
                        RAISE_APPLICATION_ERROR (-20005,
                                                 'Opening amount cannot be negative.');
                    END IF;
                
                    -- Account validation
                    SELECT COUNT (*)
                      INTO v_exists
                      FROM MST_ACCOUNT_HEAD
                     WHERE     ACCOUNT_NO = :P311_ACCOUNT_NO
                           AND IS_POSTING = 'Y'
                           AND ACTIVE_STATUS = 'Y';
                
                    IF v_exists = 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20006,
                            'Selected account is not an active posting account.');
                    END IF;
                
                    -- Duplicate account/year validation
                    SELECT COUNT (*)
                      INTO v_exists
                      FROM ACC_OPENING_BALANCE
                     WHERE FIN_YEAR = :P311_FIN_YEAR AND ACCOUNT_NO = :P311_ACCOUNT_NO;
                
                    IF v_exists > 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20007,
                            'Opening balance already exists for this account and financial year.');
                    END IF;
                
                    -- Save opening balance
                    INSERT INTO ACC_OPENING_BALANCE (OPENING_NO,
                                                     FIN_YEAR,
                                                     ACCOUNT_NO,
                                                     OPENING_DEBIT,
                                                     OPENING_CREDIT,
                                                     APPROVAL_STATUS,
                                                     CREATED_BY,
                                                     CREATED_DATE)
                         VALUES (SEQ_OPENING_NO.NEXTVAL,
                                 :P311_FIN_YEAR,
                                 :P311_ACCOUNT_NO,
                                 NVL ( :P311_OPENING_DEBIT, 0),
                                 NVL ( :P311_OPENING_CREDIT, 0),
                                 'A',
                                 :APP_USER,
                                 SYSDATE);
                
                    APEX_APPLICATION.g_print_success_message :=
                        'Opening balance saved successfully.';
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage:
                ```
                #SQLERRM_TEXT#
                
                ```
        }
        advanced {
            executionMappingIdentifier: 11468641726787373
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

