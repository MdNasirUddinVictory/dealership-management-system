    pageItem P311_FIN_YEAR (
        type: selectList
        label {
            label: Financial Year
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       (start_year - (LEVEL - 1))
                       || '-'
                       || (start_year + 1 - (LEVEL - 1)) AS display_value,
                
                       (start_year - (LEVEL - 1))
                       || '-'
                       || (start_year + 1 - (LEVEL - 1)) AS return_value
                FROM
                (
                    SELECT CASE
                             WHEN EXTRACT(MONTH FROM SYSDATE) >= 7
                             THEN EXTRACT(YEAR FROM SYSDATE)
                             ELSE EXTRACT(YEAR FROM SYSDATE) - 1
                           END AS start_year
                    FROM DUAL
                )
                CONNECT BY LEVEL <= 10
                ORDER BY return_value DESC;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @register
            slot: regionBody
            alignment: left
        }
