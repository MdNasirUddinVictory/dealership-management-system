page 100 (
    name: Sales Report
    alias: SALES-REPORT
    title: Sales Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: Sales Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 8/23/2026 6:18:23 PM (QP5 v5.388) */
                  SELECT I.INVOICE_NO,
                         I.INVOICE_CODE,
                         I.INVOICE_DATE,
                         O.ORDER_CODE,
                         C.CUSTOMER_CODE,
                         C.CUSTOMER_NAME,
                         C.MOBILE_NO,
                         C.EMAIL_ADDRESS,
                         C.ADDRESS,
                         D.INVOICE_DTL_NO,
                         --  D.LINE_NO,
                         P.PRODUCT_CODE,
                         P.PRODUCT_NAME,
                         PC.CATEGORY_NAME,
                         D.SALES_QTY,
                         D.DELIVERED_QTY,
                         NVL (D.SALES_QTY, 0) - NVL (D.DELIVERED_QTY, 0)
                             AS BALANCE_QTY,
                         D.SALES_RATE,
                         NVL (D.TOTAL_AMOUNT, 0)
                             AS LINE_TOTAL_AMOUNT,
                         NVL (I.TOTAL_AMOUNT, 0)
                             AS INVOICE_TOTAL_AMOUNT,
                         NVL (I.RECEIVED_AMOUNT, 0)
                             AS RECEIVED_AMOUNT,
                         NVL (I.DUE_AMOUNT, 0)
                             AS DUE_AMOUNT,
                         I.PAYMENT_STATUS,
                         I.DELIVERY_STATUS,
                         I.DELIVERY_BY,
                         I.DELIVERY_DATE,
                         I.CREATED_BY,
                         I.CREATED_DATE,
                         I.UPDATED_BY,
                         I.UPDATED_DATE,
                         NVL (R.RETURN_QTY, 0)
                             AS RETURN_QTY
                    FROM TRN_SALES_INVOICE_MST I
                         LEFT JOIN TRN_SALES_INVOICE_DTL D ON D.INVOICE_NO = I.INVOICE_NO
                         LEFT JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = I.CUSTOMER_NO
                         LEFT JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         LEFT JOIN MST_PRODUCT_CATEGORY PC ON PC.CATEGORY_NO = P.CATEGORY_NO
                         LEFT JOIN TRN_SALES_ORDER_MST O ON O.ORDER_NO = I.ORDER_NO
                         LEFT JOIN
                         (  SELECT INVOICE_DTL_NO, SUM (NVL (RETURN_QTY, 0)) AS RETURN_QTY
                              FROM TRN_CUSTOMER_RETURN_DTL D
                                   JOIN TRN_CUSTOMER_RETURN_MST M ON M.RETURN_NO = D.RETURN_NO
                             WHERE M.APPROVAL_STATUS = 'A'
                          GROUP BY INVOICE_DTL_NO) R
                             ON R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                ORDER BY I.INVOICE_DATE DESC, I.INVOICE_NO DESC, D.INVOICE_DTL_NO;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
