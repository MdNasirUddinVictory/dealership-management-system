page 104 (
    name: Customer Return Register
    alias: CUSTOMER-RETURN-REGISTER
    title: Customer Return Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deliverInvoice(invoiceNo){
            
                if(confirm('Confirm Delivery?')){
            
                    apex.server.process(
                        'DELIVER_INVOICE',
                        {
                            x01: invoiceNo
                        },
                        {
                            success:function(pData){
            
                                apex.message.showPageSuccess(pData);
            
                                apex.region('invoice_list').refresh();
            
                            }
                        }
                    );
            
                }
            }
            
            
            function printInvoice(invoiceNo){
            
                window.open(
                    'f?p=&APP_ID.:20:&SESSION.::NO::P20_INVOICE_NO:' + invoiceNo,
                    '_blank'
                );
            
            }
            
            // function printInvoice(invoiceNo){
            
            //     apex.navigation.dialog(
            //         'f?p=&APP_ID.:20:&SESSION.::NO::P20_INVOICE_NO:' + invoiceNo,
            //         {
            //             title: 'Sales Invoice',
            //             height: '700',
            //             width: '1000',
            //             modal: true
            //         }
            //     );
            
            // }
            ```
    }
    security {
        formAutoComplete: false
    }

