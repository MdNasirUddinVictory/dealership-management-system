                ```sql
                SELECT 'Pending' DISPLAY_VALUE,
                       'P' RETURN_VALUE
                FROM DUAL
                
                UNION ALL
                
                SELECT 'Approved',
                       'A'
                FROM DUAL
                
                UNION ALL
                
                SELECT 'Rejected',
                       'R'
                FROM DUAL
