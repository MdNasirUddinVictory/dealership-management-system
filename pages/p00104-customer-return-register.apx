    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P104_INVOICE_NO
        }

        action native-set-value (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT I.CUSTOMER_NO ,
                           C.CUSTOMER_NAME,
                           C.MOBILE_NO,
                           I.INVOICE_DATE,
                           I.CREATED_DATE,
                           I.TOTAL_AMOUNT into :P104_CUSTOMER_NO,:P104_CUSTOMER_NAME,:P104_MOBILE_NO,:P104_DELIVERY_DATE,:P104_INVOICE_DATE,:P104_INVOICE_AMOUNT
                    FROM TRN_SALES_INVOICE_MST I
                    JOIN MST_CUSTOMER C
                      ON C.CUSTOMER_NO = I.CUSTOMER_NO
                    WHERE I.INVOICE_NO = :P104_INVOICE_NO;
                    ```
                itemsToSubmit: P104_INVOICE_NO
                itemsToReturn: [
                    P104_CUSTOMER_NAME
                    P104_MOBILE_NO
                    P104_INVOICE_DATE
                    P104_INVOICE_AMOUNT
                    P104_CUSTOMER_NO
                    P104_DELIVERY_DATE
