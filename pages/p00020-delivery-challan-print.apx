page 20 (
    name: Delivery Challan Print
    alias: DELIVERY-CHALLAN-PRINT
    title: Delivery Challan Print
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region delivery-challan-print (
        name: Delivery Challan Print
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_total NUMBER := 0;
                
                BEGIN
                
                FOR h IN
                (
                    SELECT D.DELIVERY_CODE,
                           TO_CHAR(D.DELIVERY_DATE,'DD-MON-YYYY') DELIVERY_DATE,
                           I.INVOICE_CODE,
                           C.CUSTOMER_NAME,
                           D.DELIVERY_ADDRESS,
                           D.CONTACT_NO,
                           D.VEHICLE_NO,
                           D.DELIVERY_PERSON,
                           D.REMARKS
                      FROM TRN_DELIVERY_MST D
                      JOIN TRN_SALES_INVOICE_MST I
                        ON I.INVOICE_NO = D.INVOICE_NO
                      JOIN MST_CUSTOMER C
                        ON C.CUSTOMER_NO = D.CUSTOMER_NO
                     WHERE D.DELIVERY_NO = :P20_DELIVERY_NO
                )
                LOOP
                
                HTP.P(q'~
                
                <style>
                
                body{
                    font-family:Segoe UI,Arial;
                    font-size:13px;
                    margin:25px;
                    color:#222;
                }
                
                .toolbar{
                    text-align:right;
                    margin-bottom:15px;
                }
                
                .btn{
                    border:none;
                    padding:6px 12px;
                    border-radius:4px;
                    color:#fff;
                    cursor:pointer;
                    font-size:12px;
                    font-weight:600;
                }
                
                .print-btn{
                    background:#1f4e79;
                }
                
                .close-btn{
                    background:#6b7280;
                }
                
                .company{
                    text-align:center;
                    border-bottom:3px solid #1f4e79;
                    padding-bottom:10px;
                }
                
                .company h1{
                    margin:0;
                    color:#1f4e79;
                    font-size:30px;
                }
                
                .company p{
                    margin:3px;
                }
                
                .title{
                    text-align:center;
                    margin:20px 0;
                }
                
                .title span{
                    border:2px solid #1f4e79;
                    padding:8px 30px;
                    color:#1f4e79;
                    font-size:22px;
                    font-weight:bold;
                }
                
                .info{
                    width:100%;
                    border-collapse:collapse;
                    margin-bottom:20px;
                }
                
                .info td{
                    border:1px solid #ddd;
                    padding:12px;
                }
                
                .detail{
                    width:100%;
                    border-collapse:collapse;
                }
                
                .detail th{
                    background:#1f4e79;
                    color:#fff;
                    padding:12px;
                    border:1px solid #ddd;
                }
                
                .detail td{
                    border:1px solid #ddd;
                    padding:10px;
                }
                
                .totalbox{
                    width:300px;
                    float:right;
                    margin-top:20px;
                }
                
                .totalbox td{
                    border:1px solid #ddd;
                    padding:10px;
                }
                
                .footer{
                    margin-top:100px;
                }
                
                .sign{
                    width:24%;
                    display:inline-block;
                    text-align:center;
                }
                
                .sign hr{
                    border:1px solid black;
                }
                
                .watermark{
                    position:fixed;
                    top:40%;
                    left:20%;
                    font-size:90px;
                    color:#f2f2f2;
                    transform:rotate(-30deg);
                    z-index:-1;
                }
                
                @media print{
                
                    .toolbar{
                        display:none;
                    }
                
                    body{
                        margin:0;
                    }
                }
                
                </style>
                
                <div class="toolbar">
                
                <button class="btn print-btn"
                onclick="window.print();">
                🖨 Print
                </button>
                
                <button class="btn close-btn"
                onclick="apex.navigation.dialog.close(true);">
                ✖ Close
                </button>
                
                </div>
                
                <div class="watermark">
                DELIVERY
                </div>
                
                <div class="company">
                
                <h1>YOUR COMPANY NAME</h1>
                
                <p>Dhaka, Bangladesh</p>
                
                <p>Phone : 017XXXXXXXX</p>
                
                </div>
                
                <div class="title">
                
                <span>DELIVERY CHALLAN</span>
                
                </div>
                
                <table class="info">
                
                <tr>
                <td><b>Challan No</b></td>
                <td>~');
                
                HTP.P(h.DELIVERY_CODE);
                
                HTP.P(q'~</td>
                
                <td><b>Date</b></td>
                <td>~');
                
                HTP.P(h.DELIVERY_DATE);
                
                HTP.P(q'~</td>
                </tr>
                
                <tr>
                <td><b>Invoice No</b></td>
                <td>~');
                
                HTP.P(h.INVOICE_CODE);
                
                HTP.P(q'~</td>
                
                <td><b>Customer</b></td>
                <td>~');
                
                HTP.P(h.CUSTOMER_NAME);
                
                HTP.P(q'~</td>
                </tr>
                
                <tr>
                <td><b>Contact No</b></td>
                <td>~');
                
                HTP.P(NVL(h.CONTACT_NO,''));
                
                HTP.P(q'~</td>
                
                <td><b>Vehicle No</b></td>
                <td>~');
                
                HTP.P(NVL(h.VEHICLE_NO,''));
                
                HTP.P(q'~</td>
                </tr>
                
                <tr>
                <td><b>Delivery Person</b></td>
                <td>~');
                
                HTP.P(NVL(h.DELIVERY_PERSON,''));
                
                HTP.P(q'~</td>
                
                <td><b>Address</b></td>
                <td>~');
                
                HTP.P(NVL(h.DELIVERY_ADDRESS,''));
                
                HTP.P(q'~</td>
                </tr>
                
                </table>
                
                <table class="detail">
                
                <tr>
                
                <th>SL</th>
                <th>Code</th>
                <th>Product Name</th>
                <th>Invoice Qty</th>
                <th>Previous</th>
                <th>Delivery Qty</th>
                <th>Balance</th>
                
                </tr>
                ~');
                
                END LOOP;
                
                FOR d IN
                (
                    SELECT ROW_NUMBER() OVER
                           (
                               ORDER BY D.DELIVERY_DTL_NO
                           ) SL,
                
                           P.PRODUCT_CODE,
                           P.PRODUCT_NAME,
                
                           D.INVOICE_QTY,
                
                           D.PREVIOUS_DELIVERY_QTY,
                
                           D.DELIVERY_QTY,
                
                           D.BALANCE_QTY
                
                      FROM TRN_DELIVERY_DTL D
                      JOIN MST_PRODUCT P
                        ON P.PRODUCT_NO = D.PRODUCT_NO
                     WHERE D.DELIVERY_NO = :P20_DELIVERY_NO
                )
                LOOP
                
                    v_total := v_total + NVL(d.DELIVERY_QTY,0);
                
                    HTP.P('
                
                <tr>
                
                <td align="center">'||d.SL||'</td>
                
                <td>'||d.PRODUCT_CODE||'</td>
                
                <td>'||d.PRODUCT_NAME||'</td>
                
                <td align="right">'||d.INVOICE_QTY||'</td>
                
                <td align="right">'||d.PREVIOUS_DELIVERY_QTY||'</td>
                
                <td align="right"><b>'||d.DELIVERY_QTY||'</b></td>
                
                <td align="right">'||d.BALANCE_QTY||'</td>
                
                </tr>
                
                ');
                
                END LOOP;
                
                HTP.P('
                
                </table>
                
                <table class="totalbox">
                
                <tr>
                
                <td>
                <b>Total Delivery Qty</b>
                </td>
                
                <td align="right">
                <b>'||v_total||'</b>
                </td>
                
                </tr>
                
                </table>
                
                <div style="clear:both"></div>
                
                <br><br>
                
                <div>
                
                <b>Remarks :</b>
                Goods delivered in good condition.
                
                </div>
                
                <div class="footer">
                
                <div class="sign">
                <hr>
                Prepared By
                </div>
                
                <div class="sign">
                <hr>
                Delivered By
                </div>
                
                <div class="sign">
                <hr>
                Received By
                </div>
                
                <div class="sign">
                <hr>
                Authorized By
                </div>
                
                </div>
                
                ');
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P20_DELIVERY_NO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @delivery-challan-print
            slot: regionBody
        }
    )

)

