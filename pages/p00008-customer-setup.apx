                jsCode:
                    ```javascript-browser
                     let due = $v('P8_DUE_AMOUNT')
                     let customer = $v('P8_CUSTOMER_NO')
                      
                       if (due > 0) {
                            $("#PAYMENT_BTN").show();
                        } else {
                            $("#PAYMENT_BTN").hide();
                        }
                    
                           if (customer) {
                            $("#SALES_ORDER").show();
                        } else {
                            $("#SALES_ORDER").hide();
                        }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM MST_CUSTOMER
                     WHERE CUSTOMER_NO = :P8_CUSTOMER_NO;
                
                    apex_application.g_print_success_message :=
                        'Customer information has been deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8106662397174274161
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P8_CUSTOMER_NO IS NULL THEN
                
                        INSERT INTO MST_CUSTOMER
                        (
                            CUSTOMER_NO,
                            CUSTOMER_CODE,
                            CUSTOMER_NAME,
                            CONTACT_PERSON,
                            MOBILE_NO,
                            EMAIL_ADDRESS,
                            ADDRESS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_CUSTOMER_NO.NEXTVAL,
                               'CUS' || LPAD(SEQ_CUSTOMER_NO.NEXTVAL,4,'0'),
                            :P8_CUSTOMER_NAME,
                            :P8_CONTACT_PERSON,
                            :P8_MOBILE_NO,
                            :P8_EMAIL_ADDRESS,
                            :P8_ADDRESS,
                            NVL(:P8_ACTIVE_FLAG,'Y'),
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Customer information has been saved successfully.';
                
                    ELSE
                
                        UPDATE MST_CUSTOMER
                           SET 
                               CUSTOMER_NAME  = :P8_CUSTOMER_NAME,
                               CONTACT_PERSON = :P8_CONTACT_PERSON,
                               MOBILE_NO      = :P8_MOBILE_NO,
                               EMAIL_ADDRESS  = :P8_EMAIL_ADDRESS,
                               ADDRESS        = :P8_ADDRESS,
                               ACTIVE_FLAG    = :P8_ACTIVE_FLAG,
                               UPDATED_BY     = :APP_USER,
                               UPDATED_DATE   = SYSDATE
                         WHERE CUSTOMER_NO = :P8_CUSTOMER_NO;
                
                        apex_application.g_print_success_message :=
                            'Customer information has been updated successfully.';
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8106661993832274161
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

