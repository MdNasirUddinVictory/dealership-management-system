    dynamicAction new_2 (
        name: DA_GET_CUSTOMER_DUE_AMOUNT
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .customer-select
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var el = $(this.triggeringElement);
                    
                    var customerNo = el.attr("data-customer-no");
                    var dueAmount  = el.attr("data-due-amount");
                    var active  = el.attr("data-active-flag");
                    
                    console.log("HTML:", el[0].outerHTML);
                    console.log("Customer No:", customerNo);
                    console.log("Due Amount:", dueAmount);
                    
                    if (customerNo) {
                    
                        apex.item("P8_CUSTOMER_NO").setValue(customerNo);
                        apex.item("P8_ACTIVE_FLAG").setValue(active);
                    
                        dueAmount = dueAmount || "0";
                        dueAmount = dueAmount.replace(/,/g, "");
                    
                        apex.item("P8_DUE_AMOUNT").setValue(dueAmount);
                    
                        // PAYMENT button show / hide
                        var due = parseFloat(dueAmount) || 0;
                    
                        if (due > 0) {
                            $("#PAYMENT_BTN").show();
                        } else {
                            $("#PAYMENT_BTN").hide();
                        }
                    
                          if (customerNo) {
                            $("#SALES_ORDER").show();
                        } else {
                            $("#SALES_ORDER").hide();
                        }
                    
                    
                        apex.region("CUSTOMER_DETAILS").refresh();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new_3 (
        name: DA_DUE_BUTTON_TOGGLE_AND_COLOR
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @DUE_FILTER_BTN
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var btn = $("#DUE_FILTER_BTN");
                    
                    if ($v("P8_DUE_FILTER") === "DUE") {
                    
                        $s("P8_DUE_FILTER", "");
                    
                        btn.find(".t-Button-label").text("Show Due Customer");
                    
                        btn.css({
                            "background": "#dc3545",
                            "border-color": "#dc3545",
                            "color": "#fff",
                            "font-weight": "600",
                            "box-shadow": "0 2px 5px rgba(0,0,0,0.15)"
                        });
                    
                    } else {
                    
                        $s("P8_DUE_FILTER", "DUE");
                    
                        btn.find(".t-Button-label").text("Show All Customers");
                    
                        btn.css({
                            "background": "#198754",
                            "border-color": "#198754",
                            "color": "#fff",
                            "font-weight": "600",
                            "box-shadow": "0 2px 5px rgba(0,0,0,0.15)"
                        });
                    }
                    
                    apex.region("CUSTOMER_REPORT").refresh();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

