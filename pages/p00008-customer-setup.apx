    button payment-now_1 (
        buttonName: Received_Now
        label: Received Due Tk
        layout {
            sequence: 10
            region: @customer-details-summery
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--primary
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-money-bag
        }
        behavior {
            action: triggerAction
        }
        advanced {
            htmlDomId: PAYMENT_BTN
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var customerNo = $v("P8_CUSTOMER_NO");
                    var active     = $v("P8_ACTIVE_FLAG");
                    
                    if (active == "1") {
                    
                        apex.navigation.redirect(
                            "f?p=" +
                            $v("pFlowId") +
                            ":304:" +
                            $v("pInstance") +
                            "::NO:RP,304:P304_PARTY_NO:" +
                            encodeURIComponent(customerNo)
                        );
                    
                    } else {
                    
                        apex.message.alert(
                            "This customer is inactive. You cannot Payment Now."
                        );
                    
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

