                select CUSTOMER_NO,
                       CUSTOMER_CODE,
                       CUSTOMER_NAME,
                       CONTACT_PERSON,
                       MOBILE_NO,
                       EMAIL_ADDRESS,
                       ADDRESS,
                       DECODE(ACTIVE_FLAG,1,'Active',0,'Inactive')Status,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from MST_CUSTOMER
