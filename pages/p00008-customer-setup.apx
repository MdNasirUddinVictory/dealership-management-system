page 8 (
    name: Customer Setup
    alias: CUSTOMER-SETUP
    title: Customer Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            var btn = $("#DUE_FILTER_BTN");
            
            // Default = Show Due Customer
            $s("P8_DUE_FILTER", "");
            
            btn.css({
                "background-color": "#dc3545",
                "border-color": "#dc3545",
                "color": "#ffffff",
                "font-weight": "600",
                "box-shadow": "0 2px 5px rgba(0,0,0,0.15)"
            });
            
            btn.find(".t-Button-label").text("Show Due Customer");
            ```
    }
    css {
        inline:
            ```css
            #DUE_FILTER_BTN {
                border-radius: 6px !important;
                font-weight: 600 !important;
                padding: 8px 16px !important;
                transition: all .2s ease !important;
                box-shadow: 0 2px 5px rgba(0,0,0,.15) !important;
            }
            
            #DUE_FILTER_BTN:hover {
                opacity: .9;
                transform: translateY(-1px);
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region CUSTOMER_REPORT (
        name: Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       C.CUSTOMER_NO,
                       C.CUSTOMER_CODE,
                       C.CUSTOMER_NAME,
                       C.CONTACT_PERSON,
                       C.MOBILE_NO,
                       C.EMAIL_ADDRESS,
                       C.ADDRESS,
                       C.ACTIVE_FLAG,
                       DECODE(
                           C.ACTIVE_FLAG,
                           1, 'Active',
                           0, 'Inactive'
                       ) AS STATUS,
                
                       NVL(D.DUE_AMOUNT, 0) AS DUE_AMOUNT,
                
                       CASE
                           WHEN NVL(D.DUE_AMOUNT, 0) > 0
                           THEN '⚠ Due'
                           ELSE '✓ Clear'
                       END AS DUE_STATUS,
                
                       C.CREATED_BY,
                       C.CREATED_DATE,
                       C.UPDATED_BY,
                       C.UPDATED_DATE
                
                  FROM MST_CUSTOMER C
                
                  LEFT JOIN
                  (
                      SELECT
                             CUSTOMER_NO,
                             SUM(NVL(DUE_AMOUNT, 0)) AS DUE_AMOUNT
                        FROM TRN_SALES_INVOICE_MST
                       GROUP BY CUSTOMER_NO
                  ) D
                    ON D.CUSTOMER_NO = C.CUSTOMER_NO
                
                 WHERE
                       (
                           :P8_DUE_FILTER IS NULL
                           OR :P8_DUE_FILTER = ''
                           OR
                           (
                               :P8_DUE_FILTER = 'DUE'
                               AND NVL(D.DUE_AMOUNT, 0) > 0
                           )
                       )
                
                 ORDER BY
                       C.CUSTOMER_NAME
                ```
            pageItemsToSubmit: P8_DUE_FILTER
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: CUSTOMER_REPORT
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 11709082934629516
        }

        column ACTIVE_FLAG (
            type: plainText
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column ADDRESS (
            type: plainText
            heading {
                heading: Address
            }
