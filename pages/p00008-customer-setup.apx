    validation duplicate-mobile-number-check (
        name: DUPLICATE MOBILE NUMBER CHECK
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM MST_CUSTOMER
                WHERE MOBILE_NO = :P8_MOBILE_NO
                  AND NVL(CUSTOMER_NO,0) <> NVL(:P8_CUSTOMER_NO,0)
                ```
        }
        error {
            errorMessage: Mobile Number already exists.
            associatedItem: @P8_MOBILE_NO
        }
    )

    validation validation-mobile-number (
        name: VALIDATION MOBILE NUMBER
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: "REGEXP_LIKE(:P8_MOBILE_NO,'^01[3-9][0-9]{8}$')"
        }
        error {
            errorMessage: Please enter a valid mobile number.
            associatedItem: @P8_MOBILE_NO
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM MST_CUSTOMER
                     WHERE CUSTOMER_NO = :P8_CUSTOMER_NO;
                
                    apex_application.g_print_success_message :=
                        'Customer information has been deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8106662397174274161
        }
    )

    process initialize-form-supplier-setup (
        name: Initialize form Supplier Setup
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8106653134229274133
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P8_CUSTOMER_NO IS NULL THEN
                
                        INSERT INTO MST_CUSTOMER
                        (
                            CUSTOMER_NO,
                            CUSTOMER_CODE,
                            CUSTOMER_NAME,
                            CONTACT_PERSON,
                            MOBILE_NO,
                            EMAIL_ADDRESS,
                            ADDRESS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_CUSTOMER_NO.NEXTVAL,
                               'CUS' || LPAD(SEQ_CUSTOMER_NO.NEXTVAL,4,'0'),
                            :P8_CUSTOMER_NAME,
                            :P8_CONTACT_PERSON,
                            :P8_MOBILE_NO,
                            :P8_EMAIL_ADDRESS,
                            :P8_ADDRESS,
                            NVL(:P8_ACTIVE_FLAG,'Y'),
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Customer information has been saved successfully.';
                
                    ELSE
                
                        UPDATE MST_CUSTOMER
                           SET 
                               CUSTOMER_NAME  = :P8_CUSTOMER_NAME,
                               CONTACT_PERSON = :P8_CONTACT_PERSON,
                               MOBILE_NO      = :P8_MOBILE_NO,
                               EMAIL_ADDRESS  = :P8_EMAIL_ADDRESS,
                               ADDRESS        = :P8_ADDRESS,
                               ACTIVE_FLAG    = :P8_ACTIVE_FLAG,
                               UPDATED_BY     = :APP_USER,
                               UPDATED_DATE   = SYSDATE
                         WHERE CUSTOMER_NO = :P8_CUSTOMER_NO;
                
                        apex_application.g_print_success_message :=
                            'Customer information has been updated successfully.';
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8106661993832274161
        }
    )

)

