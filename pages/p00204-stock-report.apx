    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: Stock Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/6/2026 12:00:22 PM (QP5 v5.388) */
                WITH
                    STOCK_SUMMARY
                    AS
                        (  SELECT P.PRODUCT_NO,
                                  P.PRODUCT_CODE,
                                  P.PRODUCT_NAME,
                                  C.CATEGORY_NAME,
                                  NVL (P.PURCHASE_RATE, 0)
                                      AS PURCHASE_RATE,
                                  NVL (P.SALES_RATE, 0)
                                      AS SALES_RATE,
                                  NVL (P.MIN_STOCK_QTY, 0)
                                      AS MINIMUM_STOCK,
                                  NVL (SUM (L.QTY_IN), 0)
                                      AS STOCK_RECEIVED,
                                  NVL (SUM (L.QTY_OUT), 0)
                                      AS STOCK_SOLD,
                                  NVL (SUM (L.QTY_IN), 0) - NVL (SUM (L.QTY_OUT), 0)
                                      AS CURRENT_STOCK,
                                  ROUND (
                                        (NVL (SUM (L.QTY_IN), 0) - NVL (SUM (L.QTY_OUT), 0))
                                      * NVL (P.PURCHASE_RATE, 0),
                                      2)
                                      AS STOCK_VALUE
                             FROM MST_PRODUCT P
                                  LEFT JOIN MST_PRODUCT_CATEGORY C
                                      ON C.CATEGORY_NO = P.CATEGORY_NO
                                  LEFT JOIN TRN_STOCK_LEDGER L ON L.PRODUCT_NO = P.PRODUCT_NO
                            WHERE     (   :P204_CATEGORY_NO IS NULL
                                       OR P.CATEGORY_NO = :P204_CATEGORY_NO)
                                  AND ( :P204_PRODUCT_NO IS NULL OR P.PRODUCT_NO = :P204_PRODUCT_NO)
                         GROUP BY P.PRODUCT_NO,
                                  P.PRODUCT_CODE,
                                  P.PRODUCT_NAME,
                                  C.CATEGORY_NAME,
                                  P.PURCHASE_RATE,
                                  P.SALES_RATE,
                                  P.MIN_STOCK_QTY)
                  SELECT PRODUCT_CODE      AS "Product Code",
                         PRODUCT_NAME      AS "Product Name",
                         CATEGORY_NAME     AS "Category",
                         PURCHASE_RATE     AS "Purchase Rate",
                         SALES_RATE        AS "Sales Rate",
                         MINIMUM_STOCK     AS "Minimum Stock",
                         STOCK_RECEIVED    AS "Stock Received",
                         STOCK_SOLD        AS "Stock Sold",
                         CURRENT_STOCK     AS "Available Stock",
                         STOCK_VALUE       AS "Stock Value",
                         CASE
                             WHEN CURRENT_STOCK <= 0 THEN 'Out of Stock'
                             WHEN CURRENT_STOCK < MINIMUM_STOCK THEN 'Low Stock'
                             ELSE 'Available'
                         END               AS "Stock Status"
                    FROM STOCK_SUMMARY
                   WHERE (   :P204_STATUS IS NULL
                          OR :P204_STATUS = 'ALL'
                          OR ( :P204_STATUS = 'A' AND CURRENT_STOCK >= MINIMUM_STOCK)
                          OR (    :P204_STATUS = 'L'
                              AND CURRENT_STOCK > 0
                              AND CURRENT_STOCK < MINIMUM_STOCK)
                          OR ( :P204_STATUS = 'O' AND CURRENT_STOCK <= 0))
                ORDER BY PRODUCT_NAME;
                ```
            pageItemsToSubmit: [
                P204_CATEGORY_NO
                P204_PRODUCT_NO
                P204_STATUS
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
