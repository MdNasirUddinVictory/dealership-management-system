    pageItem P204_CATEGORY_NO (
        type: selectList
        label {
            label: Category No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       category_name AS display_value,
                       category_no AS return_value
                FROM mst_product_category
                
                ORDER BY category_name;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
    )

    pageItem P204_PRODUCT_NO (
        type: selectList
        label {
            label: "Product "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       p.product_code || ' - ' || p.product_name AS display_value,
                       p.product_no AS return_value
                FROM mst_product p
                WHERE p.category_no = :P204_CATEGORY_NO
                ORDER BY p.product_name;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P204_CATEGORY_NO
            itemsToSubmit: P204_CATEGORY_NO
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
    )

    pageItem P204_STATUS (
