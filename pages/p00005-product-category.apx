                }
                linkText: &CATEGORY_CODE.
            }
            source {
                databaseColumn: CATEGORY_CODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CATEGORY_NAME (
            type: textField
            heading {
                heading: Category Name
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: CATEGORY_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CATEGORY_NO (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: CATEGORY_NO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column CREATED_BY (
            type: textField
            heading {
                heading: Created By
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREATED_DATE (
            type: datePicker
            heading {
                heading: Created Date
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: CREATED_DATE
                dataType: date
            }
        )

        column UPDATED_BY (
            type: textField
            heading {
                heading: Updated By
            }
            layout {
                sequence: 70
            }
            validation {
