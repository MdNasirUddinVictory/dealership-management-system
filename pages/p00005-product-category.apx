                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
            customAttributes: disabled
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
            customAttributes: disabled
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM MST_PRODUCT_CATEGORY
                     WHERE CATEGORY_NO = :P5_CATEGORY_NO;
                
                    apex_application.g_print_success_message :=
                        'Product Category has been deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8111272996881426324
        }
    )

    process initialize-form-supplier-setup (
        name: Initialize form Supplier Setup
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8111264929230426309
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                BEGIN
                    IF :P5_CATEGORY_NO IS NULL
                    THEN
                        INSERT INTO MST_PRODUCT_CATEGORY (CATEGORY_NO,
                                                          CATEGORY_CODE,
                                                          CATEGORY_NAME,
                                                          ACTIVE_FLAG,
                                                          CREATED_BY,
                                                          CREATED_DATE)
                             VALUES (SEQ_CATEGORY_NO.NEXTVAL,
                                     'CAT' || LPAD (SEQ_CATEGORY_NO.NEXTVAL, 4, '0'),
                                     :P5_CATEGORY_NAME,
                                     NVL ( :P5_ACTIVE_FLAG, 'Y'),
                                     :APP_USER,
                                     SYSDATE);
                
                        APEX_APPLICATION.g_print_success_message :=
                            'Product Category has been saved successfully.';
                    ELSE
                        UPDATE MST_PRODUCT_CATEGORY
                           SET CATEGORY_NAME = :P5_CATEGORY_NAME,
                               ACTIVE_FLAG = :P5_ACTIVE_FLAG,
                               UPDATED_BY = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE CATEGORY_NO = :P5_CATEGORY_NO;
                
                        APEX_APPLICATION.g_print_success_message :=
                            'Product Category has been updated successfully.';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8111272596661426323
        }
    )

)

