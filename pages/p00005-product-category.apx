        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P5_ACTIVE_FLAG (
        type: radioGroup
        label {
            label: Active Flag
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Active;1,Inactive;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @entry
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @entry
            column: ACTIVE_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: 1
        }
