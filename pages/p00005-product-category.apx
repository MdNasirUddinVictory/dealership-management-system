    )

    pageItem P5_CATEGORY_NO (
        type: hidden
        layout {
            sequence: 10
            region: @entry
            slot: regionBody
        }
        source {
            formRegion: @entry
            column: CATEGORY_NO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
