page 203 (
    name: "Sales Return Report "
    alias: SALES-RETURN-REPORT
    title: "Sales Return Report "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: Sales Return
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/6/2026 11:53:29 AM (QP5 v5.388) */
                  SELECT M.RETURN_NO        AS "Return No",
                         M.RETURN_CODE      AS "Return Code",
                         M.RETURN_DATE      AS "Return Date",
                         I.INVOICE_NO       AS "Invoice No",
                         I.INVOICE_CODE     AS "Invoice Code",
                         I.INVOICE_DATE     AS "Invoice Date",
                         M.CUSTOMER_NO      AS "Customer No",
                         C.CUSTOMER_NAME    AS "Customer Name",
                         C.MOBILE_NO        AS "Mobile No",
                         M.RETURN_REASON    AS "Return Reason",
                         NVL ( (SELECT SUM (D.RETURN_QTY)
                                  FROM TRN_CUSTOMER_RETURN_DTL D
                                 WHERE D.RETURN_NO = M.RETURN_NO),
                              0)            AS "Returned Quantity",
                         NVL ( (SELECT SUM (D.TOTAL_AMOUNT)
                                  FROM TRN_CUSTOMER_RETURN_DTL D
                                 WHERE D.RETURN_NO = M.RETURN_NO),
                              0)            AS "Return Amount",
                         CASE M.APPROVAL_STATUS
                             WHEN 'P' THEN 'Pending'
                             WHEN 'A' THEN 'Approved'
                             WHEN 'R' THEN 'Rejected'
                         END                AS "Approval Status",
                         M.CREATED_BY       AS "Created By",
                         M.CREATED_DATE     AS "Created Date",
                         M.APPROVED_BY      AS "Approved By",
                         M.APPROVED_DATE    AS "Approved Date"
                    FROM TRN_CUSTOMER_RETURN_MST M
                         JOIN TRN_SALES_INVOICE_MST I ON I.INVOICE_NO = M.INVOICE_NO
                         JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = M.CUSTOMER_NO
                   WHERE     ( :P203_CUSTOMER IS NULL OR M.CUSTOMER_NO = :P203_CUSTOMER)
                         AND (   :P203_STATUS IS NULL
                              OR :P203_STATUS = 'ALL'
                              OR M.APPROVAL_STATUS = :P203_STATUS)
                         AND (   :P203_FROM_DATE IS NULL
                              OR M.RETURN_DATE >= TO_DATE ( :P203_FROM_DATE, 'MM/DD/YYYY'))
                         AND (   :P203_T0_DATE IS NULL
                              OR M.RETURN_DATE < TO_DATE ( :P203_T0_DATE, 'MM/DD/YYYY') + 1)
                ORDER BY M.RETURN_DATE DESC, M.RETURN_NO DESC;
                ```
            pageItemsToSubmit: [
                P203_FROM_DATE
                P203_T0_DATE
                P203_CUSTOMER
                P203_STATUS
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 48843942208186915
        }

