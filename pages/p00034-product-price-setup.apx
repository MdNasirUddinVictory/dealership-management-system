page 34 (
    name: Product Price Setup
    alias: PRODUCT-PRICE-SETUP
    title: Product Price Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region register (
        name: PRICE SETUP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SP.SALES_PRICE_NO,
                       SP.PRODUCT_NO,
                       P.PRODUCT_NAME,
                       SP.CUSTOMER_NO,
                       C.CUSTOMER_NAME,
                       SP.UOM_NO,
                       U.UOM_NAME,
                       SP.SALES_RATE,
                       SP.EFFECTIVE_DATE,
                       SP.ACTIVE_FLAG,
                       SP.CREATED_BY,
                       SP.CREATED_DATE,
                       SP.UPDATED_BY,
                       SP.UPDATED_DATE
                  FROM MST_SALES_PRICE SP
                  LEFT JOIN MST_PRODUCT P
                    ON P.PRODUCT_NO = SP.PRODUCT_NO
                  LEFT JOIN MST_CUSTOMER C
                    ON C.CUSTOMER_NO = SP.CUSTOMER_NO
                  LEFT JOIN MST_UOM U
                    ON U.UOM_NO = SP.UOM_NO
                 ORDER BY SP.EFFECTIVE_DATE DESC,
                          SP.SALES_PRICE_NO DESC;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: purchase-register
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 15162377693336143
        }

        column ACTIVE_FLAG (
            type: plainText
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREATED_DATE (
            type: plainText
            heading {
                heading: Created Date
            }
            layout {
                sequence: 110
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer Name
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CUSTOMER_NO (
            type: plainText
            heading {
                heading: Customer No
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column EFFECTIVE_DATE (
            type: plainText
            heading {
                heading: Effective Date
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column PRODUCT_NAME (
            type: link
            heading {
                heading: Product Name
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 35
                    items: {
                        P35_SALES_PRICE_NO: #SALES_PRICE_NO#
                    }
                }
                linkText: #PRODUCT_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column PRODUCT_NO (
            type: plainText
            heading {
                heading: Product No
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column SALES_PRICE_NO (
            type: plainText
            heading {
                heading: Sales Price No
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column SALES_RATE (
            type: plainText
            heading {
                heading: Sales Rate
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column UOM_NAME (
            type: plainText
            heading {
                heading: Uom Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column UOM_NO (
            type: plainText
            heading {
                heading: Uom No
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column UPDATED_DATE (
            type: plainText
            heading {
                heading: Updated Date
            }
            layout {
                sequence: 130
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVE_FLAG (
                sequence: 5
            )

            displayColumn CREATED_BY (
                sequence: 6
            )

            displayColumn CREATED_DATE (
                sequence: 7
            )

            displayColumn EFFECTIVE_DATE (
                sequence: 4
            )

            displayColumn PRODUCT_NAME (
                sequence: 1
            )

            displayColumn SALES_RATE (
                sequence: 3
            )

            displayColumn UOM_NAME (
                sequence: 2
            )

            displayColumn UPDATED_BY (
                sequence: 8
            )

            displayColumn UPDATED_DATE (
                sequence: 9
            )

        )

    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
            customAttributes: disabled
        }
    )

    button new (
        buttonName: New
        label: Add Price
        layout {
            sequence: 10
            region: @register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 35
                clearCache: 35
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
            customAttributes: disabled
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
            customAttributes: disabled
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @register
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

