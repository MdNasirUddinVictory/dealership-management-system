page 3 (
    name: PURCHASE PRINT REPORT
    alias: PURCHASE-PRINT-REPORT
    title: PURCHASE PRINT REPORT
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-PageBody--verticalMiddle
        ]
    }
    dialog {
        width: 60%
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: PRINT_REPORT
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_total        NUMBER := 0;
                    v_purchase_no  NUMBER;
                
                BEGIN
                
                    -------------------------------------------------
                    -- Purchase No Validation
                    -------------------------------------------------
                    BEGIN
                        v_purchase_no := TO_NUMBER(:P3_PURCHASE_NO);
                    EXCEPTION
                        WHEN OTHERS THEN
                            HTP.P('
                            <div style="
                                padding:50px;
                                text-align:center;
                                color:red;
                                font-size:24px;
                                font-family:Segoe UI;">
                                Invalid Purchase Number.
                            </div>');
                            RETURN;
                    END;
                
                    HTP.P('
                
                <style>
                
                body{
                    font-family:Segoe UI,Arial;
                    font-size:13px;
                    margin:25px;
                    color:#222;
                }
                
                .toolbar{
                    text-align:right;
                    margin-bottom:20px;
                }
                
                .btn{
                    border:none;
                    padding:10px 20px;
                    border-radius:5px;
                    color:#fff;
                    cursor:pointer;
                    font-size:14px;
                    font-weight:600;
                    margin-left:5px;
                }
                
                .print-btn{
                    background:#1f4e79;
                }
                
                .close-btn{
                    background:#6b7280;
                }
                
                .company{
                    text-align:center;
                    border-bottom:3px solid #1f4e79;
                    padding-bottom:10px;
                }
                
                .company h1{
                    margin:0;
                    color:#1f4e79;
                    font-size:30px;
                }
                
                .company p{
                    margin:3px;
                }
                
                .title{
                    text-align:center;
                    margin:20px 0;
                }
                
                .title span{
                    border:2px solid #1f4e79;
                    padding:8px 30px;
                    color:#1f4e79;
                    font-size:22px;
                    font-weight:bold;
                }
                
                .info{
                    width:100%;
                    border-collapse:collapse;
                    margin-bottom:20px;
                }
                
                .info td{
                    border:1px solid #ddd;
                    padding:8px;
                }
                
                .detail{
                    width:100%;
                    border-collapse:collapse;
                }
                
                .detail th{
                    background:#1f4e79;
                    color:white;
                    padding:10px;
                    border:1px solid #ddd;
                }
                
                .detail td{
                    border:1px solid #ddd;
                    padding:8px;
                }
                
                .totalbox{
                    width:300px;
                    float:right;
                    margin-top:20px;
                    border-collapse:collapse;
                }
                
                .totalbox td{
                    border:1px solid #ccc;
                    padding:10px;
                }
                
                .footer{
                    margin-top:100px;
                }
                
                .sign{
                    width:30%;
                    display:inline-block;
                    text-align:center;
                }
                
                .sign hr{
                    border:1px solid black;
                }
                
                .watermark{
                    position:fixed;
                    top:45%;
                    left:20%;
                    font-size:90px;
                    color:#f1f1f1;
                    transform:rotate(-30deg);
                    z-index:-1;
                }
                
                @media print{
                
                    .toolbar{
                        display:none;
                    }
                
                    body{
                        margin:0;
                    }
                
                }
                
                </style>
                
                <div class="toolbar">
                
                    <button class="btn print-btn"
                            onclick="window.print();">
                        🖨 Print
                    </button>
                
                    <button class="btn close-btn"
                            onclick="apex.navigation.dialog.close(true);">
                        ✖ Close
                    </button>
                
                </div>
                
                <div class="watermark">
                PURCHASE
                </div>
                
                <div class="company">
                    <h1>YOUR COMPANY NAME</h1>
                    <p>Dhaka, Bangladesh</p>
                    <p>Phone: 017XXXXXXXX</p>
                </div>
                
                <div class="title">
                    <span>PURCHASE VOUCHER</span>
                </div>
                
                ');
                
                    FOR h IN
                    (
                        SELECT P.PURCHASE_CODE,
                               TO_CHAR(P.PURCHASE_DATE,'DD-MON-YYYY') PURCHASE_DATE,
                               S.SUPPLIER_NAME,
                               S.MOBILE_NO,
                               S.ADDRESS,
                               P.REMARKS
                          FROM TRN_PURCHASE_MST P
                          JOIN MST_SUPPLIER S
                            ON S.SUPPLIER_NO = P.SUPPLIER_NO
                         WHERE P.PURCHASE_NO = v_purchase_no
                    )
                    LOOP
                
                        HTP.P('
                
                <table class="info">
                
                <tr>
                    <td><b>Purchase No</b></td>
                    <td>'||h.PURCHASE_CODE||'</td>
                
                    <td><b>Date</b></td>
                    <td>'||h.PURCHASE_DATE||'</td>
                </tr>
                
                <tr>
                    <td><b>Supplier</b></td>
                    <td>'||h.SUPPLIER_NAME||'</td>
                
                    <td><b>Mobile</b></td>
                    <td>'||NVL(h.MOBILE_NO,'')||'</td>
                </tr>
                
                <tr>
                    <td><b>Address</b></td>
                    <td colspan="3">'||NVL(h.ADDRESS,'')||'</td>
                </tr>
                
                </table>
                
                <table class="detail">
                
                <tr>
                    <th>SL</th>
                    <th>Product Code</th>
                    <th>Product Name</th>
                    <th>Qty</th>
                    <th>Rate</th>
                    <th>Amount</th>
                </tr>
                
                ');
                
                    END LOOP;
                
                
                    FOR d IN
                    (
                        SELECT ROW_NUMBER() OVER
                               (
                                   ORDER BY D.PURCHASE_DTL_NO
                               ) SL,
                
                               P.PRODUCT_CODE,
                               P.PRODUCT_NAME,
                               D.PURCHASE_QTY,
                               D.PURCHASE_RATE,
                               D.TOTAL_AMOUNT
                
                          FROM TRN_PURCHASE_DTL D
                          JOIN MST_PRODUCT P
                            ON P.PRODUCT_NO = D.PRODUCT_NO
                         WHERE D.PURCHASE_NO = v_purchase_no
                    )
                    LOOP
                
                        v_total := v_total + NVL(d.TOTAL_AMOUNT,0);
                
                        HTP.P('
                
                <tr>
                
                    <td align="center">'||d.SL||'</td>
                
                    <td>'||d.PRODUCT_CODE||'</td>
                
                    <td>'||d.PRODUCT_NAME||'</td>
                
                    <td align="right">'||d.PURCHASE_QTY||'</td>
                
                    <td align="right">'||d.PURCHASE_RATE||'</td>
                
                    <td align="right">'||
                        TO_CHAR(
                            d.TOTAL_AMOUNT,
                            '999G999G999D99'
                        )||
                    '</td>
                
                </tr>
                
                ');
                
                    END LOOP;
                
                
                    HTP.P('
                
                </table>
                
                <table class="totalbox">
                
                <tr>
                    <td>
                        <b>Grand Total</b>
                    </td>
                
                    <td align="right">
                        <b>'||
                        TO_CHAR(
                            v_total,
                            '999G999G999D99'
                        )||
                        '</b>
                    </td>
                
                </tr>
                
                </table>
                
                <div style="clear:both"></div>
                
                <br><br>
                
                <div>
                    <b>Remarks :</b>
                    Goods received in good condition.
                </div>
                
                <div class="footer">
                
                    <div class="sign">
                        <hr>
                        Prepared By
                    </div>
                
                    <div class="sign">
                        <hr>
                        Checked By
                    </div>
                
                    <div class="sign">
                        <hr>
                        Approved By
                    </div>
                
                </div>
                
                ');
                
                END;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_PURCHASE_NO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

