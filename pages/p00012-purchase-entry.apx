        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: Supplier Payment SUmmery
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/24/2026 8:16:35 PM (QP5 v5.388) */
                DECLARE
                    v_html   CLOB;
                BEGIN
                    SELECT    '<div id="supplier_summary" style="
                            width:100%;
                            max-width:240px;
                            box-sizing:border-box;
                            padding:6px 9px;
                            border:1px solid #e1e5e9;
                            border-radius:5px;
                            background:#fff;
                            font-size:11px;
                            line-height:1.55;
                        ">
                
                        <!-- Supplier -->
                        <div style="
                            font-size:12px;
                            font-weight:600;
                            color:#333;
                            margin-bottom:5px;
                            white-space:nowrap;
                            overflow:hidden;
                            text-overflow:ellipsis;
                        ">
                            Supplier: '
                           || NVL (S.SUPPLIER_NAME, 'N/A')
                           || '
                        </div>
                
                
                        <!-- ================= PREVIOUS ================= -->
                
                        <div style="
                            margin-top:2px;
                            margin-bottom:4px;
                            padding:3px 6px;
                            border-left:3px solid #7b8794;
                            background:#f4f6f8;
                            color:#5f6b76;
                            font-size:10px;
                            font-weight:700;
                            text-transform:uppercase;
                            letter-spacing:.5px;
                        ">
                            Previous
                        </div>
                
                
                        <!-- Purchase -->
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Purchase</span>
                
                            <b>
                                ৳ '
                           || TO_CHAR (NVL (X.PURCHASE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                
                        <!-- Paid -->
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Paid</span>
                
                            <b>
                                ৳ '
                           || TO_CHAR (NVL (X.PAID_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                
                        <!-- Due -->
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                            border-top:1px solid #eee;
                            margin-top:2px;
                            padding-top:2px;
                        ">
                            <span>Due</span>
                
                            <b style="
                                color:#c0392b;
                                font-weight:700;
                            ">
                                ৳ '
                           || TO_CHAR (NVL (X.DUE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                
                        <!-- Payment Status -->
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Status</span>
                
                            <b style="
                                color:'
                           || CASE X.PAYMENT_STATUS
                                  WHEN 'Paid' THEN '#27ae60'
                                  WHEN 'Unpaid' THEN '#c0392b'
                                  ELSE '#e67e22'
                              END
                           || ';
                            ">
                                '
                           || NVL (X.PAYMENT_STATUS, 'Unpaid')
                           || '
                            </b>
                        </div>
                
                        </div>'
                      INTO v_html
                      FROM MST_SUPPLIER  S
                           /* ================= PREVIOUS ================= */
                
                           LEFT JOIN
                           (  SELECT M.SUPPLIER_NO,
                                     SUM (NVL (M.TOTAL_AMOUNT, 0))    AS PURCHASE_AMOUNT,
                                     SUM (NVL (M.PAID_AMOUNT, 0))     AS PAID_AMOUNT,
                                     SUM (NVL (M.DUE_AMOUNT, 0))      AS DUE_AMOUNT,
                                     CASE
                                         WHEN SUM (NVL (M.DUE_AMOUNT, 0)) = 0 THEN 'Paid'
                                         WHEN SUM (NVL (M.PAID_AMOUNT, 0)) = 0 THEN 'Unpaid'
                                         ELSE 'Partially Paid'
                                     END                              AS PAYMENT_STATUS
                                FROM TRN_PURCHASE_MST M
                               WHERE     M.APPROVAL_STATUS = 'A'
                                     AND NVL (PURCHASE_NO, -1) != NVL ( :P12_PURCHASE_NO, -1)
                            GROUP BY M.SUPPLIER_NO) X
                               ON X.SUPPLIER_NO = S.SUPPLIER_NO
                          
                     WHERE S.SUPPLIER_NO = :P12_SUPPLIER_NO;
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                                font-size:11px;
                                color:#777;
                                padding:6px;
                            ">
                                Supplier summary unavailable.
                             </div>';
                END;
                ```
            pageItemsToSubmit: [
                P12_SUPPLIER_NO
                P12_PURCHASE_NO
            ]
        }
        layout {
            sequence: 40
            parentRegion: @main
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region purchaseDtl (
        name: DETAILS ENTRY
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                    SELECT
                           D.PURCHASE_DTL_NO,
                           D.PURCHASE_NO,
                           D.PRODUCT_NO,
                
                           --P.PRODUCT_CODE,
                          -- P.PRODUCT_NAME,
                           P.DESCRIPTION,
                           P.BRAND_NO,
                
                           D.UOM_NO,
                           U.UOM_NAME,
                
                           D.PACK_QTY,
                           D.PURCHASE_QTY,
                           D.PURCHASE_RATE,
                           D.BASE_QTY,
                           D.BASE_RATE,
                           D.TOTAL_AMOUNT,
                
                           D.RECEIVED_QTY,
                           D.BALANCE_QTY,
                
                           D.REMARKS
                
                      FROM TRN_PURCHASE_DTL D
                
                      JOIN MST_PRODUCT P
                        ON P.PRODUCT_NO = D.PRODUCT_NO
                
                 LEFT JOIN MST_UOM U
                        ON U.UOM_NO = D.UOM_NO
                
                     WHERE D.PURCHASE_NO = :P12_PURCHASE_NO
                
                  ORDER BY D.PURCHASE_DTL_NO
                );
                ```
            pageItemsToSubmit: P12_PURCHASE_NO
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
