page 12 (
    name: Purchase Entry
    alias: PURCHASE-ENTRY
    title: Purchase Entry
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function purchaseCalculate(){
            var qty    = Number($v("PURCHASE_QTY")) || 0;
            var rate   = Number($v("PURCHASE_RATE")) || 0;
            var factor = Number($v("PACK_QTY")) || 1;
            
            $s("BASE_QTY", qty * factor);
            $s("BASE_RATE", (rate / factor).toFixed(2));
            $s("TOTAL_AMOUNT", (qty * rate).toFixed(2));
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
