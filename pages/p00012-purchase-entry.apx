page 12 (
    name: Purchase Entry
    alias: PURCHASE-ENTRY
    title: Purchase Entry
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function purchaseCalculate(){
            var qty    = Number($v("PURCHASE_QTY")) || 0;
            var rate   = Number($v("PURCHASE_RATE")) || 0;
            var factor = Number($v("PACK_QTY")) || 1;
            
            $s("BASE_QTY", qty * factor);
            $s("BASE_RATE", (rate / factor).toFixed(2));
            $s("TOTAL_AMOUNT", (qty * rate).toFixed(2));
            }
            
            
            
            function f_purchase_summary() {
            
                let itemCount = 0;
                let totalQty = 0;
                let totalAmount = 0;
            
                let widget = apex.region("purchaseDtl").widget();
                let grid = widget.interactiveGrid("getViews", "grid");
                let model = grid.model;
            
                grid.view$.grid("finishEditing");
            
                setTimeout(function () {
            
                    model.forEach(function (record) {
            
                        let meta = model.getRecordMetadata(model.getRecordId(record));
            
                        if (!meta.agg) {
            
                            // Product Count
                            let product = model.getValue(record, "PRODUCT_NO");
            
                            if (product !== null && product !== undefined && product !== "") {
                                itemCount++;
                            }
            
                            // Total Quantity
                            let qty = model.getValue(record, "PURCHASE_QTY");
            
                            if (qty !== null && qty !== undefined && qty !== "") {
                                totalQty += Number(String(qty).replace(/,/g, ""));
                            }
            
                            // Total Amount
                            let amount = model.getValue(record, "TOTAL_AMOUNT");
            
                            if (amount !== null && amount !== undefined && amount !== "") {
                                totalAmount += Number(String(amount).replace(/,/g, ""));
                            }
                        }
                    });
            
                    // Set APEX Items
                    $s("current_purchase_Count", itemCount);
                    $s("current_Total_Quantity", totalQty);
                    $s("current_purchase_amount", totalAmount);
            
                }, 50);
            }
            ```
    }
    security {
        formAutoComplete: false
    }

