    dynamicAction new (
        name: New
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @purchaseDtl
            columns: UOM_NO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        BEGIN
                            SELECT C.CONVERSION_FACTOR
                              INTO :PACK_QTY
                              FROM MST_UOM_CONVERSION C
                             WHERE C.PRODUCT_NO = :PRODUCT_NO
                               AND C.CONVERT_UOM_NO = :UOM_NO
                               AND C.ACTIVE_FLAG = 'Y';
                    
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                :PACK_QTY := 1;
                        END;
                    END;
                    ```
                itemsToSubmit: [
                    UOM_NO
                    PRODUCT_NO
                ]
                itemsToReturn: PACK_QTY
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P12_SUPPLIER_NO
