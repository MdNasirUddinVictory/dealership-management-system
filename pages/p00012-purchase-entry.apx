    validation purchase-rate-cannot-be-less-than-the-standard-purchase-rate (
        name: Purchase rate cannot be less than the standard purchase rate.
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @purchaseDtl
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM MST_PRODUCT
                WHERE PRODUCT_NO = :PRODUCT_NO
                AND :PURCHASE_RATE < PURCHASE_RATE
                ```
        }
        error {
            errorMessage: Purchase rate cannot be less than the standard purchase rate.
            associatedColumn: PURCHASE_RATE
        }
    )

    validation purchase-rate-must-be-greater-than-zero (
        name: Purchase rate must be greater than zero.
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @purchaseDtl
            plsqlExpression: NVL(:PURCHASE_QTY,0) > 0
        }
        error {
            errorMessage: Purchase quantity must be greater than zero.
            associatedColumn: PURCHASE_QTY
        }
    )

    validation purchase-rate-must-be-greater-than-zero_1 (
        name: Purchase rate must be greater than zero.
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @purchaseDtl
            plsqlExpression: NVL(:PURCHASE_RATE,0) > 0
        }
        error {
            errorMessage: Purchase rate must be greater than zero.
            associatedColumn: PURCHASE_RATE
        }
    )

    validation this-product-already-exists-in-the-purchase-details (
        name: This product already exists in the purchase details.
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @purchaseDtl
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM TRN_PURCHASE_DTL
                WHERE PURCHASE_NO = :P12_PURCHASE_NO
                  AND PRODUCT_NO  = :PRODUCT_NO
                  AND NVL(PURCHASE_DTL_NO,0) <> NVL(:PURCHASE_DTL_NO,0)
                ```
        }
        error {
            errorMessage: This product already exists in the purchase details.
            associatedColumn: PURCHASE_RATE
        }
    )

    process details-entry-save-interactive-grid-data (
        name: DETAILS ENTRY - Save Interactive Grid Data
        type: executeCode
        editableRegion: @purchaseDtl
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    V_STATUS VARCHAR2(1);
                
                BEGIN
                
                    ----------------------------------------------------
                    -- Approval Validation
                    ----------------------------------------------------
                    BEGIN
                        SELECT APPROVAL_STATUS
                          INTO V_STATUS
                          FROM TRN_PURCHASE_MST
                         WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            V_STATUS := 'P';
                    END;
                
                    IF V_STATUS = 'A' THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Approved purchase cannot be modified or deleted.'
                        );
                    END IF;
                
                    ----------------------------------------------------
                    -- INSERT
                    ----------------------------------------------------
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        INSERT INTO TRN_PURCHASE_DTL
                        (
                            PURCHASE_DTL_NO,
                            PURCHASE_NO,
                            PRODUCT_NO,
                            UOM_NO,
                            PURCHASE_QTY,
                            PURCHASE_RATE,
                            PACK_QTY,
                            BASE_QTY,
                            BASE_RATE,
                            TOTAL_AMOUNT,
                            RECEIVED_QTY,
                            BALANCE_QTY,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_PURCHASE_DTL_NO.NEXTVAL,
                            :P12_PURCHASE_NO,
                            :PRODUCT_NO,
                            :UOM_NO,
                            :PURCHASE_QTY,
                            :PURCHASE_RATE,
                            :PACK_QTY,
                            :BASE_QTY,
                            :BASE_RATE,
                            :TOTAL_AMOUNT,
                            0,
                            :BASE_QTY,
                            :REMARKS,
                            :APP_USER,
                            SYSDATE
                        )
                        RETURNING PURCHASE_DTL_NO
                             INTO :PURCHASE_DTL_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase detail saved successfully.';
                
                    ----------------------------------------------------
                    -- UPDATE
                    ----------------------------------------------------
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        UPDATE TRN_PURCHASE_DTL
                           SET PRODUCT_NO    = :PRODUCT_NO,
                               UOM_NO        = :UOM_NO,
                               PURCHASE_QTY  = :PURCHASE_QTY,
                               PURCHASE_RATE = :PURCHASE_RATE,
                               PACK_QTY      = :PACK_QTY,
                               BASE_QTY      = :BASE_QTY,
                               BASE_RATE     = :BASE_RATE,
                               TOTAL_AMOUNT  = :TOTAL_AMOUNT,
                               BALANCE_QTY   = :BASE_QTY - NVL(RECEIVED_QTY,0),
                               REMARKS       = :REMARKS,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE PURCHASE_DTL_NO = :PURCHASE_DTL_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase detail updated successfully.';
                
                    ----------------------------------------------------
                    -- DELETE
                    ----------------------------------------------------
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        DELETE
                          FROM TRN_PURCHASE_DTL
                         WHERE PURCHASE_DTL_NO = :PURCHASE_DTL_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase detail deleted successfully.';
                
                    END IF;
                
                    ----------------------------------------------------
                    -- Update Header Total
                    ----------------------------------------------------
                    PKG_PURCHASE.UPDATE_TOTAL(:P12_PURCHASE_NO);
                
                EXCEPTION
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20001, SQLERRM);
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 8293111900604552013
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process get-pack-factor (
        name: GET_PACK_FACTOR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    V_FACTOR NUMBER := 1;
                
                BEGIN
                
                    BEGIN
                
                        SELECT C.CONVERSION_FACTOR
                          INTO V_FACTOR
                          FROM MST_UOM_CONVERSION C
                         WHERE C.PRODUCT_NO     = TO_NUMBER(APEX_APPLICATION.G_X01)
                           AND C.CONVERT_UOM_NO = TO_NUMBER(APEX_APPLICATION.G_X02)
                           AND C.ACTIVE_FLAG = 'Y';
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                
                            V_FACTOR := 1;
                
                    END;
                
                    HTP.P(V_FACTOR);
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 18574585735790404015
        }
    )

    process get-supplier-info (
        name: GET SUPPLIER INFO
        type: executeCode
