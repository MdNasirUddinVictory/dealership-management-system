    process process-form-entry (
        name: Process form ENTRY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_TOTAL_AMOUNT NUMBER;
                BEGIN
                
                    ----------------------------------------------------
                    -- Insert
                    ----------------------------------------------------
                
                    IF :P12_PURCHASE_NO IS NULL THEN
                
                        :P12_PURCHASE_NO := SEQ_PURCHASE_NO.NEXTVAL;
                
                        INSERT INTO TRN_PURCHASE_MST
                        (
                            PURCHASE_NO,
                            PURCHASE_CODE,
                            PURCHASE_DATE,
                            SUPPLIER_NO,
                            REMARKS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE,
                
                            TOTAL_AMOUNT,
                            PAID_AMOUNT,
                            DUE_AMOUNT,
                            PAYMENT_STATUS
                        )
                        VALUES
                        (
                            :P12_PURCHASE_NO,
                            'PUR-' || LPAD(:P12_PURCHASE_NO,4,'0'),
                            :P12_PURCHASE_DATE,
                            :P12_SUPPLIER_NO,
                            :P12_REMARKS,
                            :P12_ACTIVE_FLAG,
                            :APP_USER,
                            SYSDATE,
                
                            0,
                            0,
                            0,
                            'UP'
                        );
                
                        apex_application.g_print_success_message :=
                            'Purchase information saved successfully.';
                
                    ----------------------------------------------------
                    -- Update
                    ----------------------------------------------------
                
                    ELSE
                
                        UPDATE TRN_PURCHASE_MST
                           SET PURCHASE_DATE = :P12_PURCHASE_DATE,
                               SUPPLIER_NO   = :P12_SUPPLIER_NO,
                               REMARKS       = :P12_REMARKS,
                               ACTIVE_FLAG   = :P12_ACTIVE_FLAG,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                
                         WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase information updated successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 8293111583625552009
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process purches-delete (
        name: PURCHES DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_status TRN_PURCHASE_MST.APPROVAL_STATUS%TYPE;
                BEGIN
                
                    SELECT APPROVAL_STATUS
                      INTO l_status
                      FROM TRN_PURCHASE_MST
                     WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                
                    IF l_status = 'A' THEN
                        raise_application_error(
                            -20001,
                            'Approved purchase cannot be deleted.'
                        );
                    END IF;
                
                
                    /* Delete Detail First */
                
                    DELETE FROM TRN_PURCHASE_DTL
                     WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                
                    /* Delete Master */
                
                    DELETE FROM TRN_PURCHASE_MST
                     WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                
                    apex_application.g_print_success_message :=
                        'Purchase information deleted successfully.';
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        raise_application_error(
                            -20002,
                            'Purchase information not found.'
                        );
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 8293111692319552010
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

