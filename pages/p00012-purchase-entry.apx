    region entry (
        name: ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select M.PURCHASE_NO,
                       M.PURCHASE_CODE,
                       M.PURCHASE_DATE,
                       M.SUPPLIER_NO,
                       M.REMARKS,
                       M.ACTIVE_FLAG,
                       M.APPROVAL_STATUS,
                       DECODE(M.APPROVAL_STATUS,'A','Approved','P','Pending')APPROVAL,
                       M.APPROVED_BY,
                       M.APPROVED_DATE,
                       M.PURCHASE_STATUS,
                       M.RECEIVED_BY,
                       M.RECEIVED_DATE,
                       V.VOUCHER_CODE VOUCHER_NO,
                       M.PAID_AMOUNT,
                       M.DUE_AMOUNT,
                       M.PAYMENT_STATUS,
                       M.TOTAL_AMOUNT,
                       S.MOBILE_NO,
                       S.ADDRESS
                  from TRN_PURCHASE_MST M,ACC_VOUCHER_MST V ,MST_SUPPLIER S   
                  WHERE M.VOUCHER_NO = V.VOUCHER_NO(+)
                  AND M.SUPPLIER_NO = S.SUPPLIER_NO(+)
                ```
        }
        layout {
            sequence: 20
            parentRegion: @main
            slot: regionBody
            startNewRow: false
            columnSpan: 9
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

