            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region entry (
        name: ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PURCHASE_NO,
                       PURCHASE_CODE,
                       PURCHASE_DATE,
                       SUPPLIER_NO,
                       REMARKS,
                       ACTIVE_FLAG,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE,
                       APPROVAL_STATUS,
                       APPROVED_BY,
                       APPROVED_DATE,
                       PURCHASE_STATUS,
                       RECEIVED_BY,
                       RECEIVED_DATE,
                       VOUCHER_NO,
                       PAID_AMOUNT,
                       DUE_AMOUNT,
                       PAYMENT_STATUS,
                       TOTAL_AMOUNT
                  from TRN_PURCHASE_MST
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region purchaseDtl (
        name: DETAILS ENTRY
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                    SELECT
                           D.PURCHASE_DTL_NO,
                           D.PURCHASE_NO,
                           D.PRODUCT_NO,
                
                           --P.PRODUCT_CODE,
                          -- P.PRODUCT_NAME,
                           P.DESCRIPTION,
                           P.BRAND_NO,
                
                           D.UOM_NO,
                           U.UOM_NAME,
                
                           D.PACK_QTY,
                           D.PURCHASE_QTY,
                           D.PURCHASE_RATE,
                           D.BASE_QTY,
                           D.BASE_RATE,
                           D.TOTAL_AMOUNT,
                
                           D.RECEIVED_QTY,
                           D.BALANCE_QTY,
                
                           D.REMARKS
                
                      FROM TRN_PURCHASE_DTL D
                
                      JOIN MST_PRODUCT P
                        ON P.PRODUCT_NO = D.PRODUCT_NO
                
                 LEFT JOIN MST_UOM U
                        ON U.UOM_NO = D.UOM_NO
                
                     WHERE D.PURCHASE_NO = :P12_PURCHASE_NO
                
                  ORDER BY D.PURCHASE_DTL_NO
                );
                ```
            pageItemsToSubmit: P12_PURCHASE_NO
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: purchaseDtl
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
