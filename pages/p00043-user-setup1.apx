page 43 (
    name: User Setup
    alias: USER-SETUP1
    title: User Setup
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // var dgsSessionStorage = apex.storage.getScopedSessionStorage({
            // 	prefix: "CAMERA",
            // 	useAppId: true
            // });
            // dgsSessionStorage.removeItem("U_IMG_C");
