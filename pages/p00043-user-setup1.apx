    button capture (
        buttonName: Capture
        label: Capture
        layout {
            sequence: 10
            region: @photo-upload
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-image-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 45
                items: {
                    P45_IMG_TYPE: U_IMG_C
                }
            }
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P43_USER_NO
        }
    )

    button new-3 (
        buttonName: New
        label: New
        layout {
            sequence: 10
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
                clearCache: 43
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
        }
        serverSideCondition {
            type: itemIsNull
            item: P43_USER_NO
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P43_USER_NO
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression:
                    ```javascript-browser
                    
                    (function () {
                    
                        const dgsSessionStorage = apex.storage.getScopedSessionStorage({
                            prefix: "CAMERA",
                            useAppId: true
                        });
                    
                        const srcImg = dgsSessionStorage.getItem("U_IMG_C");
                        const img = document.getElementById("img");
                    
                        if (img && srcImg) {
                            img.src = "data:image/png;base64," + srcImg;
                        }
                    
                    })();
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    DELETE FROM SA_GRANTOBJECT
                     WHERE USER_NO = :P43_USER_NO;
                
                    DELETE FROM SA_USER
                     WHERE USER_NO = :P43_USER_NO;
                 :P43_USER_NO := NULL;
                    apex_application.g_print_success_message :=
                        'User deleted successfully.';
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 14492342521780249
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-user-setup (
        name: Initialize form User Setup
        type: formInitialization
        formRegion: @user-entyr
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14489604816780222
        }
    )

    process save (
        name: SAVE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_photo BLOB;
                BEGIN
                
                    /* Convert Base64 → BLOB */
                    -- IF :P43_PHOTO IS NOT NULL THEN
                    --     l_photo := apex_web_service.clobbase642blob(
                    --         :P43_PHOTO
                    --     );
                    -- END IF;
                
                
                    /* Save User */
                    INSERT INTO SA_USER (
                        USER_NO,
                        USER_ID,
                        USER_NAME,
                        MOBILE_NO,
                        DOB,
                        USER_TYPE,
                        EMAIL,
                        PHOTO,
                        USER_PWD,
                        ACTIVE_STAT,
                        AUTH_TYPE,
                        ROLE_NO
                    )
                    VALUES (
                        S_SA_USER.NEXTVAL,
                        :P43_USER_ID,
                        :P43_USER_NAME,
                        :P43_MOBILE_NO,
                        :P43_DOB,
                        NVL(:P43_USER_TYPE, 'U'),
                        :P43_EMAIL,
                        :P43_PHOTO,--  l_photo,
                        :P43_USER_PWD,
                        NVL(:P43_ACTIVE_STAT, 1),
                        :P43_AUTH_TYPE,
                        :P43_ROLE_NO
                    );
                
                
                    apex_application.g_print_success_message :=
                        'User created successfully.';
                
                
                EXCEPTION
                
                    WHEN DUP_VAL_ON_INDEX THEN
                        raise_application_error(
                            -20001,
                            'User ID or User No already exists.'
                        );
                
                END;
                
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14492194024780247
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process update (
        name: UPDATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    UPDATE SA_USER
                       SET USER_ID      = :P43_USER_ID,
                           USER_NAME    = :P43_USER_NAME,
                           MOBILE_NO    = :P43_MOBILE_NO,
                           DOB          = :P43_DOB,
                           USER_TYPE    = NVL(:P43_USER_TYPE, 'USER'),
                           EMAIL        = :P43_EMAIL,
                           PHOTO        = :P43_PHOTO,
                           USER_PWD     = :P43_USER_PWD,
                           ACTIVE_STAT  = NVL(:P43_ACTIVE_STAT, 1),
                           AUTH_TYPE    = :P43_AUTH_TYPE,
                           ROLE_NO     = :P43_ROLE_NO
                     WHERE USER_NO = :P43_USER_NO;
                
                    apex_application.g_print_success_message :=
                        'User updated successfully.';
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14492291216780248
        }
        serverSideCondition {
            whenButtonPressed: @update
        }
    )

)

