    pageItem P43_ROLE_NO (
        type: selectList
        label {
            label: Role Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  ROLE_CODE || ' - ' || ROLE_NAME ROLE_NAME , ROLE_NO
                  FROM SA_ROLE
                 WHERE ACTIVE_FLAG = 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 90
            region: @user-entyr
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        source {
            formRegion: @user-entyr
            column: ROLE_NO
            dataType: number
        }
