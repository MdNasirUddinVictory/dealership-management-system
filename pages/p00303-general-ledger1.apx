        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       ACCOUNT_NAME || ' - ' || ACCOUNT_CODE AS DISPLAY_VALUE,
                       ACCOUNT_NO AS RETURN_VALUE
                FROM MST_ACCOUNT_HEAD
                WHERE IS_POSTING = 'Y'
                  AND ACTIVE_STATUS = 'Y'
                ORDER BY ACCOUNT_CODE
                ```
