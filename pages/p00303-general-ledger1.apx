    region voucher-mst_1 (
        name: General Ledger
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 8/27/2026 3:01:31 PM (QP5 v5.388) */
                WITH
                    TXN
                    AS
                        (SELECT D.VOUCHER_DTL_NO,
                                D.ACCOUNT_NO,
                                H.ACCOUNT_CODE,
                                H.ACCOUNT_NAME,
                                H.ACCOUNT_TYPE,
                                M.VOUCHER_NO,
                                M.VOUCHER_DATE,
                                M.VOUCHER_CODE,
                                M.VOUCHER_TYPE,
                                D.REF_TYPE,
                                D.REF_NO,
                                D.PARTICULARS,
                                NVL (D.DEBIT_AMOUNT, 0)      AS DEBIT_AMOUNT,
                                NVL (D.CREDIT_AMOUNT, 0)     AS CREDIT_AMOUNT
                           FROM ACC_VOUCHER_MST  M
                                JOIN ACC_VOUCHER_DTL D ON D.VOUCHER_NO = M.VOUCHER_NO
                                JOIN MST_ACCOUNT_HEAD H ON H.ACCOUNT_NO = D.ACCOUNT_NO
                          WHERE     M.APPROVAL_STATUS = 'A'
                                AND (   :P303_ACCOUNT_NO IS NULL
                                     OR D.ACCOUNT_NO = :P303_ACCOUNT_NO)
                                AND (   :P303_FROM_DATE IS NULL
                                     OR M.VOUCHER_DATE >=
                                        TO_DATE ( :P303_FROM_DATE, 'DD-MON-YYYY'))
                                AND (   :P303_TO_DATE IS NULL
                                     OR M.VOUCHER_DATE <
                                        TO_DATE ( :P303_TO_DATE, 'DD-MON-YYYY') + 1)
                                AND (   :P303_VOUCHER_TYPE IS NULL
                                     OR M.VOUCHER_TYPE = :P303_VOUCHER_TYPE)),
                    /* Opening balance = entered opening balance
                       + approved transactions before From Date */
                    OPENING
                    AS
                        (  SELECT ACCOUNT_NO,
                                  ACCOUNT_TYPE,
                                  SUM (OPENING_BALANCE)     AS OPENING_BALANCE
                             FROM (/* Account opening balance */
                                   SELECT O.ACCOUNT_NO,
                                          H.ACCOUNT_TYPE,
                                          CASE
                                              WHEN H.ACCOUNT_TYPE IN ('A', 'E')
                                              THEN
                                                    NVL (O.OPENING_DEBIT, 0)
                                                  - NVL (O.OPENING_CREDIT, 0)
                                              WHEN H.ACCOUNT_TYPE IN ('L', 'C', 'I')
                                              THEN
                                                    NVL (O.OPENING_CREDIT, 0)
                                                  - NVL (O.OPENING_DEBIT, 0)
                                              ELSE
                                                  0
                                          END    AS OPENING_BALANCE
                                     FROM ACC_OPENING_BALANCE O
                                          JOIN MST_ACCOUNT_HEAD H
                                              ON H.ACCOUNT_NO = O.ACCOUNT_NO
                                    WHERE     O.APPROVAL_STATUS = 'A'
                                          AND (   :P303_ACCOUNT_NO IS NULL
                                               OR O.ACCOUNT_NO = :P303_ACCOUNT_NO)
                                   UNION ALL
                                   /* Previous approved transactions */
                                   SELECT D.ACCOUNT_NO,
                                          H.ACCOUNT_TYPE,
                                          CASE
                                              WHEN H.ACCOUNT_TYPE IN ('A', 'E')
                                              THEN
                                                    NVL (D.DEBIT_AMOUNT, 0)
                                                  - NVL (D.CREDIT_AMOUNT, 0)
                                              WHEN H.ACCOUNT_TYPE IN ('L', 'C', 'I')
                                              THEN
                                                    NVL (D.CREDIT_AMOUNT, 0)
                                                  - NVL (D.DEBIT_AMOUNT, 0)
                                              ELSE
                                                  0
                                          END    AS OPENING_BALANCE
                                     FROM ACC_VOUCHER_MST M
                                          JOIN ACC_VOUCHER_DTL D ON D.VOUCHER_NO = M.VOUCHER_NO
                                          JOIN MST_ACCOUNT_HEAD H
                                              ON H.ACCOUNT_NO = D.ACCOUNT_NO
                                    WHERE     M.APPROVAL_STATUS = 'A'
                                          AND :P303_FROM_DATE IS NOT NULL
                                          AND M.VOUCHER_DATE <
                                              TO_DATE ( :P303_FROM_DATE, 'DD-MON-YYYY')
                                          AND (   :P303_ACCOUNT_NO IS NULL
                                               OR D.ACCOUNT_NO = :P303_ACCOUNT_NO))
                         GROUP BY ACCOUNT_NO, ACCOUNT_TYPE),
                    RUNNING
                    AS
                        (SELECT T.*,
                                NVL (O.OPENING_BALANCE, 0)                                   AS OPENING_BALANCE,
                                SUM (
                                    CASE
                                        WHEN T.ACCOUNT_TYPE IN ('A', 'E')
                                        THEN
                                            T.DEBIT_AMOUNT - T.CREDIT_AMOUNT
                                        WHEN T.ACCOUNT_TYPE IN ('L', 'C', 'I')
                                        THEN
                                            T.CREDIT_AMOUNT - T.DEBIT_AMOUNT
                                        ELSE
                                            0
                                    END)
                                    OVER (
                                        PARTITION BY T.ACCOUNT_NO
                                        ORDER BY
                                            T.VOUCHER_DATE, T.VOUCHER_NO, T.VOUCHER_DTL_NO
                                        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)    AS MOVEMENT_BALANCE
                           FROM TXN T LEFT JOIN OPENING O ON O.ACCOUNT_NO = T.ACCOUNT_NO)
                  SELECT ROW_NUMBER () OVER (ORDER BY VOUCHER_DATE, VOUCHER_NO, VOUCHER_DTL_NO)
                             AS SL,
                         VOUCHER_NO,
                         VOUCHER_CODE,
                         VOUCHER_DATE,
                         VOUCHER_TYPE,
                         ACCOUNT_NO,
                         ACCOUNT_CODE,
                         ACCOUNT_NAME,
                         ACCOUNT_TYPE,
                         REF_TYPE,
                         REF_NO,
                         PARTICULARS,
                         DEBIT_AMOUNT,
                         CREDIT_AMOUNT,
                         OPENING_BALANCE,
                         OPENING_BALANCE + MOVEMENT_BALANCE
                             AS RUNNING_BALANCE,
                         CASE
                             WHEN OPENING_BALANCE + MOVEMENT_BALANCE >= 0
                             THEN
                                 CASE WHEN ACCOUNT_TYPE IN ('A', 'E') THEN 'DR' ELSE 'CR' END
                             ELSE
                                 CASE WHEN ACCOUNT_TYPE IN ('A', 'E') THEN 'CR' ELSE 'DR' END
                         END
                             AS BALANCE_TYPE
                    FROM RUNNING
                ORDER BY VOUCHER_DATE, VOUCHER_NO, VOUCHER_DTL_NO;
                ```
            pageItemsToSubmit: [
                P303_FROM_DATE
                P303_TO_DATE
                P303_ACCOUNT_NO
                P303_VOUCHER_TYPE
            ]
        }
