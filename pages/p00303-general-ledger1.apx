page 303 (
    name: General Ledger
    alias: GENERAL-LEDGER1
    title: General Ledger
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
