    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function openVoucher(pVoucherNo, pvoucherCode, pVoucherType, pVoucherDate, pNarattion) {
                $s('P304_VOUCHER_NO', pVoucherNo);
                $s('P303_VOUCHER_CODE_DISPLAY', pvoucherCode);
                $s('P303_VOUCHER_TYPE_DISPLAY', pVoucherType);
                $s('P303_VOUCHER_DATE_DISPLAY', pVoucherDate);
                $s('P303_NARRATION_DISPLAY', pNarattion);
                apex.region('vioucherViewDtl').refresh();
                openModal('vioucherView');
            
            
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

