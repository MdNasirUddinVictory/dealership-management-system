    validation duplicate-mobile-number-check (
        name: DUPLICATE MOBILE NUMBER CHECK
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM MST_CUSTOMER
                WHERE MOBILE_NO = :P25_MOBILE_NO
                  AND NVL(CUSTOMER_NO,0) <> NVL(:P25_CUSTOMER_NO,0)
                ```
        }
        error {
            errorMessage: Mobile Number already exists.
            associatedItem: @P25_MOBILE_NO
        }
    )

    validation validation-mobile-number (
        name: VALIDATION MOBILE NUMBER
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: "REGEXP_LIKE(:P25_MOBILE_NO,'^01[3-9][0-9]{8}$')"
        }
        error {
            errorMessage: Please enter a valid mobile number.
            associatedItem: @P25_MOBILE_NO
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/29/2026 3:47:44 PM (QP5 v5.388) */
                BEGIN
                    DECLARE
                        l_due_count   NUMBER := 0;
                        l_dep_count   NUMBER := 0;
                    BEGIN
                        SELECT COUNT (*)
                          INTO l_due_count
                          FROM TRN_SALES_INVOICE_MST
                         WHERE CUSTOMER_NO = :P25_CUSTOMER_NO AND NVL (DUE_AMOUNT, 0) > 0;
                
                        IF l_due_count > 0
                        THEN
                            RAISE_APPLICATION_ERROR (
                                -20001,
                                'Customer cannot be deleted because an outstanding due amount exists.');
                        END IF;
                
                        SELECT COUNT (*)
                          INTO l_dep_count
                          FROM (SELECT 1
                                  FROM TRN_SALES_ORDER_MST
                                 WHERE CUSTOMER_NO = :P25_CUSTOMER_NO
                                UNION ALL
                                SELECT 1
                                  FROM TRN_SALES_INVOICE_MST
                                 WHERE CUSTOMER_NO = :P25_CUSTOMER_NO
                                UNION ALL
                                SELECT 1
                                  FROM TRN_CUSTOMER_RETURN_MST
                                 WHERE CUSTOMER_NO = :P25_CUSTOMER_NO);
                
                        IF l_dep_count > 0
                        THEN
                            RAISE_APPLICATION_ERROR (
                                -20002,
                                'Customer cannot be deleted because related sales/return data exists.');
                        END IF;
                
                        DELETE FROM MST_CUSTOMER
                              WHERE CUSTOMER_NO = :P25_CUSTOMER_NO;
                
                        APEX_APPLICATION.g_print_success_message :=
                            'Customer information has been deleted successfully.';
                
                        :P25_CUSTOMER_NO := NULL;
                    END;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 11768569861204325
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-supplier-setup (
        name: Initialize form Supplier Setup
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11760515692204298
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/29/2026 3:49:40 PM (QP5 v5.388) */
                BEGIN
                    IF :P25_CUSTOMER_NO IS NULL
                    THEN
                        INSERT INTO MST_CUSTOMER (CUSTOMER_NO,
                                                  CUSTOMER_CODE,
                                                  CUSTOMER_NAME,
                                                  CONTACT_PERSON,
                                                  MOBILE_NO,
                                                  EMAIL_ADDRESS,
                                                  ADDRESS,
                                                  ACTIVE_FLAG,
                                                  CREATED_BY,
                                                  CREATED_DATE)
                             VALUES (SEQ_CUSTOMER_NO.NEXTVAL,
                                     'CUS' || LPAD (SEQ_CUSTOMER_NO.NEXTVAL, 4, '0'),
                                     :P25_CUSTOMER_NAME,
                                     :P25_CONTACT_PERSON,
                                     :P25_MOBILE_NO,
                                     :P25_EMAIL_ADDRESS,
                                     :P25_ADDRESS,
                                     NVL ( :P25_ACTIVE_FLAG, 'Y'),
                                     :APP_USER,
                                     SYSDATE);
                
                        APEX_APPLICATION.g_print_success_message :=
                            'Customer information has been saved successfully.';
                    ELSE
                        DECLARE
                            l_due_count   NUMBER := 0;
                            l_dep_count   NUMBER := 0;
                        BEGIN
                            -- Prevent inactive if customer still has due or dependent records
                            IF NVL ( :P25_ACTIVE_FLAG, '1') ='0'
                            THEN
                                SELECT COUNT (*)
                                  INTO l_due_count
                                  FROM TRN_SALES_INVOICE_MST
                                 WHERE     CUSTOMER_NO = :P25_CUSTOMER_NO
                                       AND NVL (DUE_AMOUNT, 0) > 0;
                
                                IF l_due_count > 0
                                THEN
                                    RAISE_APPLICATION_ERROR (
                                        -20001,
                                        'Customer cannot be made inactive because an outstanding due amount exists.');
                                END IF;
                
                                SELECT COUNT (*)
                                  INTO l_dep_count
                                  FROM (SELECT 1
                                          FROM TRN_SALES_ORDER_MST
                                         WHERE CUSTOMER_NO = :P25_CUSTOMER_NO
                                        UNION ALL
                                        SELECT 1
                                          FROM TRN_SALES_INVOICE_MST
                                         WHERE CUSTOMER_NO = :P25_CUSTOMER_NO
                                        UNION ALL
                                        SELECT 1
                                          FROM TRN_CUSTOMER_RETURN_MST
                                         WHERE CUSTOMER_NO = :P25_CUSTOMER_NO);
                
                                IF l_dep_count > 0
                                THEN
                                    RAISE_APPLICATION_ERROR (
                                        -20002,
                                        'Customer cannot be made inactive because related sales/return records exist.');
                                END IF;
                            END IF;
                
                            UPDATE MST_CUSTOMER
                               SET CUSTOMER_NAME = :P25_CUSTOMER_NAME,
                                   CONTACT_PERSON = :P25_CONTACT_PERSON,
                                   MOBILE_NO = :P25_MOBILE_NO,
                                   EMAIL_ADDRESS = :P25_EMAIL_ADDRESS,
                                   ADDRESS = :P25_ADDRESS,
                                   ACTIVE_FLAG = :P25_ACTIVE_FLAG,
                                   UPDATED_BY = :APP_USER,
                                   UPDATED_DATE = SYSDATE
                             WHERE CUSTOMER_NO = :P25_CUSTOMER_NO;
                
                            APEX_APPLICATION.g_print_success_message :=
                                'Customer information has been updated successfully.';
                        END;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11768145005204325
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

