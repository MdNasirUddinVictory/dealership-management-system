page 33 (
    name: Discount Entry
    alias: DISCOUNT-ENTRY
    title: Discount Entry
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 50
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region product-entrey (
        name: DISCOUNT SETUP
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT DISCOUNT_CONFIG_NO,
                       CONFIG_CODE,
                       CONFIG_NAME,
                       PRODUCT_NO,
                       CATEGORY_NO,
                       CUSTOMER_NO,
                       DISCOUNT_PERCENT,
                       PRIORITY,
                       EFFECTIVE_FROM,
                       EFFECTIVE_TO,
                       ACTIVE_FLAG
                  FROM MST_DISCOUNT_CONFIG
                 ORDER BY PRIORITY DESC, CONFIG_NAME)
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P33_ACTIVE_FLAG (
        type: radioGroup
        label {
            label: Active Flag
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Active;1,Inactive;0
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @product-entrey
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @product-entrey
            column: ACTIVE_FLAG
            dataType: number
        }
        default {
            type: static
            staticValue: 1
        }
    )

    pageItem P33_CATEGORY_NO (
        type: popupLov
        label {
            label: "Category "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CATEGORY_CODE || ' - ' || CATEGORY_NAME AS DISPLAY_VALUE,
                       CATEGORY_NO AS RETURN_VALUE
                  FROM MST_PRODUCT_CATEGORY
                 WHERE ACTIVE_FLAG = 1
                 ORDER BY CATEGORY_NAME
                ```
        }
        layout {
            sequence: 20
            region: @product-entrey
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        source {
            formRegion: @product-entrey
            column: CATEGORY_NO
            dataType: number
        }
        serverSideCondition {
            type: item=value
            item: P33_HIDE_CATEGORY
            value: C
        }
    )

    pageItem P33_CONFIG_CODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @product-entrey
            slot: regionBody
        }
        source {
            formRegion: @product-entrey
            column: CONFIG_CODE
            dataType: varchar2
        }
    )

    pageItem P33_CONFIG_NAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @product-entrey
            slot: regionBody
        }
        source {
            formRegion: @product-entrey
            column: CONFIG_NAME
            dataType: varchar2
        }
    )

    pageItem P33_CUSTOMER_NO (
        type: popupLov
        label {
            label: "Customer "
            alignment: left
        }
        settings {
            popupWidth: 500
        }
        lov {
            type: sharedComponent
            lov: @lov-17-customer-lov
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @product-entrey
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        source {
            formRegion: @product-entrey
            column: CUSTOMER_NO
            dataType: number
        }
        serverSideCondition {
            type: item=value
            item: P33_HIDE_CUSTOMER
            value: CU
        }
    )

    pageItem P33_DISCOUNT_CONFIG_NO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @product-entrey
            slot: regionBody
        }
        source {
            formRegion: @product-entrey
            column: DISCOUNT_CONFIG_NO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P33_DISCOUNT_PERCENT (
        type: numberField
        label {
            label: Discount %
            alignment: left
        }
        layout {
            sequence: 60
            region: @product-entrey
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @product-entrey
            column: DISCOUNT_PERCENT
            dataType: number
        }
    )

    pageItem P33_EFFECTIVE_FROM (
        type: datePicker
        label {
            label: Effective From
            alignment: left
        }
        layout {
            sequence: 70
            region: @product-entrey
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @product-entrey
            column: EFFECTIVE_FROM
            dataType: date
        }
    )

    pageItem P33_EFFECTIVE_TO (
        type: datePicker
        label {
            label: Effective To
            alignment: left
        }
        layout {
            sequence: 80
            region: @product-entrey
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        source {
            formRegion: @product-entrey
            column: EFFECTIVE_TO
            dataType: date
        }
    )

    pageItem P33_HIDE_CATEGORY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @product-entrey
            slot: regionBody
        }
    )

    pageItem P33_HIDE_CUSTOMER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @product-entrey
            slot: regionBody
        }
    )

    pageItem P33_HIDE_PRODUCT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @product-entrey
            slot: regionBody
        }
    )

    pageItem P33_PRIORITY (
        type: numberField
        label {
            label: Priority
            alignment: left
        }
        layout {
            sequence: 90
            region: @product-entrey
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @product-entrey
            column: PRIORITY
            dataType: number
        }
    )

    pageItem P33_PRODUCT_NO (
        type: popupLov
        label {
            label: "Product "
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT P.PRODUCT_CODE || ' - ' || P.PRODUCT_NAME AS DISPLAY_VALUE,
                       P.PRODUCT_NO AS RETURN_VALUE
                  FROM MST_PRODUCT P
                 WHERE P.ACTIVE_FLAG = 1
                   AND (
                        :P33_CATEGORY_NO IS NULL
                        OR P.CATEGORY_NO = :P33_CATEGORY_NO
                   )
                 ORDER BY P.PRODUCT_NAME
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P33_CATEGORY_NO
            itemsToSubmit: P33_CATEGORY_NO
        }
        layout {
            sequence: 30
            region: @product-entrey
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        source {
            formRegion: @product-entrey
            column: PRODUCT_NO
            dataType: number
        }
        serverSideCondition {
            type: item=value
            item: P33_HIDE_PRODUCT
            value: P
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P33_DISCOUNT_CONFIG_NO
        }
    )

    button new-3 (
        buttonName: New
        label: New
        layout {
            sequence: 10
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
                clearCache: 33
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
        }
        serverSideCondition {
            type: itemIsNull
            item: P33_DISCOUNT_CONFIG_NO
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P33_DISCOUNT_CONFIG_NO
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    DELETE FROM MST_DISCOUNT_CONFIG
                     WHERE DISCOUNT_CONFIG_NO = :P33_DISCOUNT_CONFIG_NO;
                    :P33_DISCOUNT_CONFIG_NO := NULL;
                    apex_application.g_print_success_message :=
                        'Discount deleted successfully.';
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 15159670942336116
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-discount-entry (
        name: Initialize form Discount Entry
        type: formInitialization
        formRegion: @product-entrey
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15158254057336102
        }
    )

    process process-form-discount-setup (
        name: Process form DISCOUNT SETUP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    INSERT INTO MST_DISCOUNT_CONFIG
                    (
                        PRODUCT_NO,
                        CATEGORY_NO,
                        CUSTOMER_NO,
                        DISCOUNT_PERCENT,
                        PRIORITY,
                        EFFECTIVE_FROM,
                        EFFECTIVE_TO,
                        ACTIVE_FLAG,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    VALUES
                    (
                        :P33_PRODUCT_NO,
                        :P33_CATEGORY_NO,
                        :P33_CUSTOMER_NO,
                        :P33_DISCOUNT_PERCENT,
                        NVL(:P33_PRIORITY, 1),
                        NVL(:P33_EFFECTIVE_FROM, SYSDATE),
                        :P33_EFFECTIVE_TO,
                        NVL(:P33_ACTIVE_FLAG, 1),
                        :APP_USER,
                        SYSDATE
                    )
                    RETURNING DISCOUNT_CONFIG_NO
                         INTO :P33_DISCOUNT_CONFIG_NO;
                
                    apex_application.g_print_success_message :=
                        'Discount saved successfully.';
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15159409519336114
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process update (
        name: "update "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    UPDATE MST_DISCOUNT_CONFIG
                       SET PRODUCT_NO       = :P33_PRODUCT_NO,
                           CATEGORY_NO      = :P33_CATEGORY_NO,
                           CUSTOMER_NO      = :P33_CUSTOMER_NO,
                           DISCOUNT_PERCENT = :P33_DISCOUNT_PERCENT,
                           PRIORITY         = NVL(:P33_PRIORITY, 1),
                           EFFECTIVE_FROM   = NVL(:P33_EFFECTIVE_FROM, SYSDATE),
                           EFFECTIVE_TO     = :P33_EFFECTIVE_TO,
                           ACTIVE_FLAG      = NVL(:P33_ACTIVE_FLAG, 1),
                           UPDATED_BY       = :APP_USER,
                           UPDATED_DATE     = SYSDATE
                     WHERE DISCOUNT_CONFIG_NO = :P33_DISCOUNT_CONFIG_NO;
                
                    apex_application.g_print_success_message :=
                        'Discount updated successfully.';
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15159520120336115
        }
        serverSideCondition {
            whenButtonPressed: @update
        }
    )

)

