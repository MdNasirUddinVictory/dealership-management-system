    region purchase-details (
        name: PURCHASE DETAILS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT D.INVOICE_DTL_NO,
                       P.PRODUCT_CODE,
                       P.PRODUCT_NAME,
                       D.UOM_NO,
                       D.PACK_QTY,
                       D.ORDER_QTY,
                       D.SALES_QTY,
                       D.BASE_QTY,
                       D.SALES_RATE,
                       D.BASE_RATE,
                       D.TOTAL_AMOUNT
                FROM TRN_SALES_INVOICE_DTL D
                JOIN MST_PRODUCT P
                  ON P.PRODUCT_NO = D.PRODUCT_NO
                WHERE D.INVOICE_NO = :P30_INVOICE_NO
                ORDER BY D.INVOICE_DTL_NO);
                ```
            pageItemsToSubmit: P30_INVOICE_NO
        }
