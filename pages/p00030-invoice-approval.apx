    process approve-purchase (
        name: APPROVE_INVOICE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_status NUMBER;
                    v_exists NUMBER;
                BEGIN
                
                    ------------------------------------------------
                    -- Already Approved
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_status
                      FROM TRN_SALES_INVOICE_MST
                     WHERE INVOICE_NO = APEX_APPLICATION.G_X01
                       AND APPROVAL_STATUS = 'A';
                
                    IF v_status > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Invoice already approved.'
                        );
                    END IF;
                
                
                    ------------------------------------------------
                    -- Detail Exists
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_SALES_INVOICE_DTL
                     WHERE INVOICE_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Invoice details not found.'
                        );
                    END IF;
                
                
                    ------------------------------------------------
                    -- Stock Already Posted
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_STOCK_LEDGER
                     WHERE TRAN_TYPE = 'SALES'
                       AND REF_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Stock already posted.'
                        );
                    END IF;
                
                
                    ------------------------------------------------
                    -- Approve Sales Invoice
                    ------------------------------------------------
                    UPDATE TRN_SALES_INVOICE_MST
                       SET APPROVAL_STATUS = 'A',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE,
                           UPDATED_BY      = :APP_USER,
                           UPDATED_DATE    = SYSDATE
                     WHERE INVOICE_NO = APEX_APPLICATION.G_X01;
                
                
                    ------------------------------------------------
                    -- Stock Ledger Posting
                    -- SALES = Stock OUT
                    ------------------------------------------------
                    -- INSERT INTO TRN_STOCK_LEDGER
                    -- (
                    --     LEDGER_NO,
                    --     TRAN_DATE,
                    --     TRAN_TYPE,
                    --     REF_NO,
                    --     PRODUCT_NO,
                    --     QTY_IN,
                    --     QTY_OUT,
                    --     CREATED_BY,
                    --     CREATED_DATE
                    -- )
                    -- SELECT
                    --     SEQ_LEDGER_NO.NEXTVAL,
                    --     M.INVOICE_DATE,
                    --     'SALES',
                    --     D.INVOICE_NO,
                    --     D.PRODUCT_NO,
                    --     0,
                    --     D.BASE_QTY,
                    --     :APP_USER,
                    --     SYSDATE
                    -- FROM TRN_SALES_INVOICE_DTL D
                    -- JOIN TRN_SALES_INVOICE_MST M
                    --   ON M.INVOICE_NO = D.INVOICE_NO
                    -- WHERE D.INVOICE_NO = APEX_APPLICATION.G_X01;
                
                
                    ------------------------------------------------
                    -- Finance Voucher Posting
                    ------------------------------------------------
                    PKG_FINANCE.POST_SALES(
                        P_INVOICE_NO => APEX_APPLICATION.G_X01
                    );
                
                
                    ------------------------------------------------
                    -- Commit
                    ------------------------------------------------
                    COMMIT;
                
                    HTP.P('Sales invoice approved successfully.');
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            SQLERRM
                        );
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 12361468142946451
        }
    )

    process reject-purchase (
        name: REJECT_INVOICE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    UPDATE TRN_SALES_INVOICE_MST
                       SET APPROVAL_STATUS = 'R',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE,
                           UPDATED_BY      = :APP_USER,
