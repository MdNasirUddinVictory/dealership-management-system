    region register (
        name: SALES-REGISTER
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT M.INVOICE_NO,
                       M.INVOICE_CODE,
                       M.INVOICE_DATE,
                       C.CUSTOMER_NAME,
                       NVL(
                           (SELECT SUM(D.TOTAL_AMOUNT)
                              FROM TRN_SALES_INVOICE_DTL D
                             WHERE D.INVOICE_NO = M.INVOICE_NO),
                           0
                       ) AS TOTAL_AMOUNT,
                
                       CASE M.APPROVAL_STATUS
                            WHEN 'P' THEN 'Pending'
                            WHEN 'A' THEN 'Approved'
                            WHEN 'R' THEN 'Rejected'
                       END AS APPROVAL_STATUS,
                
                       M.CREATED_BY,
                       M.CREATED_DATE
                
                FROM TRN_SALES_INVOICE_MST M
                
                JOIN MST_CUSTOMER C
                  ON C.CUSTOMER_NO = M.CUSTOMER_NO
                
                WHERE M.APPROVAL_STATUS = 'P'
                
                ORDER BY M.INVOICE_NO DESC);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: purchase-register
        }
