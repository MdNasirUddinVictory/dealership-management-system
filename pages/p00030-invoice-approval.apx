page 30 (
    name: Invoice Approval
    alias: INVOICE-APPROVAL
    title: Invoice Approval
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function f_openModal(purchaseNo){
            
                apex.item("P30_INVOICE_NO").setValue(purchaseNo);
            
                openModal('purchase_approve');
            
                apex.region('purchase-detail').refresh();
            
            }
            
            function approvePurchase(pPurchaseNo) {
            
                apex.message.confirm(
                    "Are you sure you want to approve this Invoice?",
                    function(okPressed) {
            
                        if (!okPressed) {
                            return;
                        }
            
                        apex.server.process(
                            "APPROVE_INVOICE",
                            {
                                x01: pPurchaseNo
                            },
                            {
                                dataType: "text",
            
                                success: function(pData) {
            
                                    if (pData.trim() === "SUCCESS") {
            
                                        /* Close Approval Modal */
                                        closeModal("purchase_approve");
            
                                        /* Refresh Base Page Register */
                                        apex.region("purchase-register").refresh();
            
                                    } else {
            
                                        apex.message.alert(pData);
            
                                    }
                                },
            
                                error: function() {
            
                                    apex.message.alert(
                                        "Unable to process request."
                                    );
            
                                }
                            }
                        );
                    }
                );
            }
            
            function rejectPurchase(pPurchaseNo){
            
                if(!confirm('Are you sure you want to reject this purchase?')){
                    return;
                }
            
                apex.server.process(
                    "REJECT_INVOICE",
                    {
                        x01: pPurchaseNo
                    },
                    {
                        dataType: "text",
                        success: function(pData){
            
                            if(pData === "SUCCESS"){
            
                                apex.message.showPageSuccess(
                                    "Purchase rejected successfully."
                                );
            
                                 apex.region('purchase-detail').refresh();
                                apex.region('purchase-register').refresh();
            
                            }else{
            
                                apex.message.alert(pData);
            
                            }
                        },
                        error: function(){
            
                            apex.message.alert(
                                "Unable to process request."
                            );
            
                        }
                    }
                );
            
            }
            ```
    }
