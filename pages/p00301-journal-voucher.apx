    dynamicAction new_1 (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @voucher-mst
            columns: [
                DEBIT_AMOUNT
                CREDIT_AMOUNT
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var debit = Number($v("DEBIT_AMOUNT")) || 0;
                    var credit = Number($v("CREDIT_AMOUNT")) || 0;
                    
                    if (debit > 0 && credit > 0) {
                        apex.message.alert(
                            "Enter either Debit or Credit."
                        );
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process debit-and-credit-amount-must-be-equal (
        name: Debit and Credit amount must be equal.
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_dr NUMBER;
                    v_cr NUMBER;
                
                BEGIN
                
                    SELECT NVL(SUM(DEBIT_AMOUNT),0),
                           NVL(SUM(CREDIT_AMOUNT),0)
                      INTO v_dr,
                           v_cr
                      FROM ACC_VOUCHER_DTL
                     WHERE VOUCHER_NO =
                           :P301_VOUCHER_NO;
                
                    IF v_dr <> v_cr THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Debit and Credit amount must be equal.'
                        );
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 13145828894849698131
        }
    )

    process initialize-form-journal-voucher (
        name: Initialize form Journal Voucher
        type: formInitialization
        formRegion: @register
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12958455397206850831
        }
    )

    process process-form-voucher-mst (
        name: Process form VOUCHER MST
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_code VARCHAR2(30);
                
                BEGIN
                
                    IF :P301_VOUCHER_DATE IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please enter voucher date.'
                        );
                    END IF;
                
                    IF :P301_VOUCHER_TYPE IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select voucher type.'
                        );
                    END IF;
                
                    --------------------------------------------------
                    -- INSERT
                    --------------------------------------------------
                
                    IF :P301_VOUCHER_NO IS NULL THEN
                
                        :P301_VOUCHER_NO :=
                            SEQ_VOUCHER_NO.NEXTVAL;
                
                        v_code :=
                            :P301_VOUCHER_TYPE
                            || '-'
                            || LPAD(:P301_VOUCHER_NO,6,'0');
                
                        INSERT INTO ACC_VOUCHER_MST
                        (
                            VOUCHER_NO,
                            VOUCHER_CODE,
                            VOUCHER_DATE,
                            VOUCHER_TYPE,
                            NARRATION,
                            APPROVAL_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            :P301_VOUCHER_NO,
                            v_code,
                            :P301_VOUCHER_DATE,
                            :P301_VOUCHER_TYPE,
                            :P301_NARRATION,
                            'P',
                            :APP_USER,
                            SYSDATE
                        ) RETURNING VOUCHER_NO INTO :P301_VOUCHER_NO ;
                
                    --------------------------------------------------
                    -- UPDATE
                    --------------------------------------------------
                
                    ELSE
                
                        UPDATE ACC_VOUCHER_MST
                           SET VOUCHER_DATE = :P301_VOUCHER_DATE,
                               VOUCHER_TYPE = :P301_VOUCHER_TYPE,
                               NARRATION    = :P301_NARRATION,
                               UPDATED_BY   = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE VOUCHER_NO = :P301_VOUCHER_NO;
                
                    END IF;
                
                    apex_application.g_print_success_message :=
                        'Voucher saved successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13145828349600698126
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process voucher-mst-save-interactive-grid-data (
        name: VOUCHER MST - Save Interactive Grid Data
        type: executeCode
        editableRegion: @voucher-mst
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_status VARCHAR2(1);
                
                BEGIN
                
                    -------------------------------------------------
                    -- Approved Check
                    -------------------------------------------------
                
                    SELECT APPROVAL_STATUS
                      INTO v_status
                      FROM ACC_VOUCHER_MST
                     WHERE VOUCHER_NO = :P301_VOUCHER_NO;
                
                    IF v_status = 'A' THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Approved voucher cannot be modified.'
                        );
                
                    END IF;
                
                    -------------------------------------------------
                    -- Validation
                    -------------------------------------------------
                
                    IF NVL(:DEBIT_AMOUNT,0) = 0
                       AND NVL(:CREDIT_AMOUNT,0) = 0
                    THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please enter debit or credit amount.'
                        );
                
                    END IF;
                
                    IF NVL(:DEBIT_AMOUNT,0) > 0
                       AND NVL(:CREDIT_AMOUNT,0) > 0
                    THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Both debit and credit are not allowed.'
                        );
                
                    END IF;
                
                    -------------------------------------------------
                    -- INSERT
                    -------------------------------------------------
                
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        INSERT INTO ACC_VOUCHER_DTL
                        (
                            VOUCHER_DTL_NO,
                            VOUCHER_NO,
                            ACCOUNT_NO,
                            PARTICULARS,
                            DEBIT_AMOUNT,
                            CREDIT_AMOUNT
                        )
                        VALUES
                        (
                            SEQ_VOUCHER_DTL_NO.NEXTVAL,
                            :P301_VOUCHER_NO,
                            :ACCOUNT_NO,
                            :PARTICULARS,
                            NVL(:DEBIT_AMOUNT,0),
                            NVL(:CREDIT_AMOUNT,0)
                        );
                
                    -------------------------------------------------
                    -- UPDATE
                    -------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        UPDATE ACC_VOUCHER_DTL
                           SET ACCOUNT_NO   = :ACCOUNT_NO,
                               PARTICULARS  = :PARTICULARS,
                               DEBIT_AMOUNT = NVL(:DEBIT_AMOUNT,0),
                               CREDIT_AMOUNT= NVL(:CREDIT_AMOUNT,0)
                         WHERE VOUCHER_DTL_NO =
                               :VOUCHER_DTL_NO;
                
                    -------------------------------------------------
                    -- DELETE
                    -------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        DELETE
                          FROM ACC_VOUCHER_DTL
                         WHERE VOUCHER_DTL_NO =
                               :VOUCHER_DTL_NO;
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 13145828678709698129
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

