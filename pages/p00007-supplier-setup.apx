                       SUPPLIER_CODE,
                       SUPPLIER_NAME,
                       CONTACT_PERSON,
                       MOBILE_NO,
                       EMAIL_ADDRESS,
                       ADDRESS,
                       DECODE(ACTIVE_FLAG,1,'Active',0,'Inactive')STATUS,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
