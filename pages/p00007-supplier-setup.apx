    dynamicAction da-due-button-toggle-and-color (
        name: DA_DUE_BUTTON_TOGGLE_AND_COLOR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @due
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var btn = $("#DUE_FILTER_BTN");
                    
                    if ($v("P7_DUE_FILTER") === "DUE") {
                    
                        $s("P7_DUE_FILTER", "");
                    
                        btn.find(".t-Button-label").text("Show Due Supplier");
                    
                        btn.css({
                            "background": "#dc3545",
                            "border-color": "#dc3545",
                            "color": "#fff",
                            "font-weight": "600",
                            "box-shadow": "0 2px 5px rgba(0,0,0,0.15)"
                        });
                    
                    } else {
                    
                        $s("P7_DUE_FILTER", "DUE");
                    
                        btn.find(".t-Button-label").text("Show All Supplier");
                    
                        btn.css({
                            "background": "#198754",
                            "border-color": "#198754",
                            "color": "#fff",
                            "font-weight": "600",
                            "box-shadow": "0 2px 5px rgba(0,0,0,0.15)"
                        });
                    }
                    
                    apex.region("SUPPLIER_REPORT").refresh();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     let due = $v('P8_DUE_AMOUNT')
                     let customer = $v('P8_CUSTOMER_NO')
                      
                       if (due > 0) {
                            $("#PAYMENT_BTN").show();
                        } else {
                            $("#PAYMENT_BTN").hide();
                        }
                    
                           if (customer) {
                            $("#SALES_ORDER").show();
                        } else {
                            $("#SALES_ORDER").hide();
                        }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new_1 (
        name: DA_GET_SUPPLIER_DUE_AMOUNT
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .supplier-select
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var el = $(this.triggeringElement);
                    
                    var supplierNo = el.attr("data-supplier-no");
                    var dueAmount  = el.attr("data-due-amount");
                    var active  = el.attr("data-active-flag");
                    
                    console.log("HTML:", el[0].outerHTML);
                    console.log("supplier No:", supplierNo);
                    console.log("Due Amount:", dueAmount);
                    
                    if (supplierNo) {
                    
                        apex.item("P7_SUPPLIER_NO").setValue(supplierNo);
                        apex.item("P7_ACTIVE_FLAG").setValue(active);
                    
                        dueAmount = dueAmount || "0";
                        dueAmount = dueAmount.replace(/,/g, "");
                    
                        apex.item("P7_DUE_AMOUNT").setValue(dueAmount);
                    
                        // PAYMENT button show / hide
                        var due = parseFloat(dueAmount) || 0;
                    
                        if (due > 0) {
                            $("#PAYMENT_BTN").show();
                        } else {
                            $("#PAYMENT_BTN").hide();
                        }
                    
                          if (supplierNo) {
                            $("#SALES_ORDER").show();
                        } else {
                            $("#SALES_ORDER").hide();
                        }
                    
                    
                        apex.region("SUPPLIER_DETAILS").refresh();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DELETE FROM MST_SUPPLIER
                WHERE SUPPLIER_NO = :P7_SUPPLIER_NO;
                
                apex_application.g_print_success_message :=
                    'Supplier deleted successfully.';
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8068831701540255942
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P7_SUPPLIER_NO IS NULL THEN
                
                        INSERT INTO MST_SUPPLIER
                        (
                            SUPPLIER_NO,
                            SUPPLIER_CODE,
                            SUPPLIER_NAME,
                            CONTACT_PERSON,
                            MOBILE_NO,
                            EMAIL_ADDRESS,
                            ADDRESS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_SUPPLIER_NO.NEXTVAL,
                           'SUP' || LPAD(SEQ_SUPPLIER_NO.NEXTVAL,4,'0'),
                            :P7_SUPPLIER_NAME,
                            :P7_CONTACT_PERSON,
                            :P7_MOBILE_NO,
                            :P7_EMAIL_ADDRESS,
                            :P7_ADDRESS,
                            NVL(:P7_ACTIVE_FLAG,'Y'),
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Supplier saved successfully.';
                
                    ELSE
                
                        UPDATE MST_SUPPLIER
                           SET 
                               SUPPLIER_NAME  = :P7_SUPPLIER_NAME,
                               CONTACT_PERSON = :P7_CONTACT_PERSON,
                               MOBILE_NO      = :P7_MOBILE_NO,
                               EMAIL_ADDRESS  = :P7_EMAIL_ADDRESS,
                               ADDRESS        = :P7_ADDRESS,
                               ACTIVE_FLAG    = :P7_ACTIVE_FLAG,
                               UPDATED_BY     = :APP_USER,
                               UPDATED_DATE   = SYSDATE
                         WHERE SUPPLIER_NO = :P7_SUPPLIER_NO;
                
                        apex_application.g_print_success_message :=
                            'Supplier updated successfully.';
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8068831674916255941
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

