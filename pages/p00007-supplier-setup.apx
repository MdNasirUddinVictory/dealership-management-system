                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--large
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
