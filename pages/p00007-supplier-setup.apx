        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SUPPLIER_NO,
                       SUPPLIER_CODE,
                       SUPPLIER_NAME,
                       CONTACT_PERSON,
                       MOBILE_NO,
                       EMAIL_ADDRESS,
                       ADDRESS,
                       ACTIVE_FLAG,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from MST_SUPPLIER
                ```
        }
        layout {
