    validation email-format-validation (
        name: EMAIL Format Validation
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression:
                ```plsql
                REGEXP_LIKE(
                :P7_EMAIL_ADDRESS,
                '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
                )
                ```
        }
        error {
            errorMessage: Please enter a valid email address.
            associatedItem: @P7_EMAIL_ADDRESS
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_EMAIL_ADDRESS
        }
    )

    validation mobile-number-validation (
        name: Mobile Number Validation
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: "REGEXP_LIKE(:P7_MOBILE_NO,'^01[3-9][0-9]{8}$')"
        }
        error {
            errorMessage: Please enter a valid mobile number.
            associatedItem: @P7_MOBILE_NO
        }
    )

    validation new (
        name: Duplicate Mobile Number Check
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM MST_SUPPLIER
                WHERE MOBILE_NO = :P7_MOBILE_NO
                AND NVL(SUPPLIER_NO,0) <> NVL(:P7_SUPPLIER_NO,0)
                ```
        }
        error {
            errorMessage: Mobile Number already exists.
            associatedItem: @P7_MOBILE_NO
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DELETE FROM MST_SUPPLIER
                WHERE SUPPLIER_NO = :P7_SUPPLIER_NO;
                
                apex_application.g_print_success_message :=
                    'Supplier deleted successfully.';
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8068831701540255942
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-supplier-setup (
        name: Initialize form Supplier Setup
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8068830374569255928
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P7_SUPPLIER_NO IS NULL THEN
                
                        INSERT INTO MST_SUPPLIER
                        (
                            SUPPLIER_NO,
                            SUPPLIER_CODE,
                            SUPPLIER_NAME,
                            CONTACT_PERSON,
                            MOBILE_NO,
                            EMAIL_ADDRESS,
                            ADDRESS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_SUPPLIER_NO.NEXTVAL,
                           'SUP' || LPAD(SEQ_SUPPLIER_NO.NEXTVAL,4,'0'),
                            :P7_SUPPLIER_NAME,
                            :P7_CONTACT_PERSON,
                            :P7_MOBILE_NO,
                            :P7_EMAIL_ADDRESS,
                            :P7_ADDRESS,
                            NVL(:P7_ACTIVE_FLAG,'Y'),
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Supplier saved successfully.';
                
                    ELSE
                
                        UPDATE MST_SUPPLIER
                           SET 
                               SUPPLIER_NAME  = :P7_SUPPLIER_NAME,
                               CONTACT_PERSON = :P7_CONTACT_PERSON,
                               MOBILE_NO      = :P7_MOBILE_NO,
                               EMAIL_ADDRESS  = :P7_EMAIL_ADDRESS,
                               ADDRESS        = :P7_ADDRESS,
                               ACTIVE_FLAG    = :P7_ACTIVE_FLAG,
                               UPDATED_BY     = :APP_USER,
                               UPDATED_DATE   = SYSDATE
                         WHERE SUPPLIER_NO = :P7_SUPPLIER_NO;
                
                        apex_application.g_print_success_message :=
                            'Supplier updated successfully.';
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8068831674916255941
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

