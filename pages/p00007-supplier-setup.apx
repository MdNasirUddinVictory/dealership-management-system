page 7 (
    name: Supplier Setup
    alias: SUPPLIER-SETUP
    title: Supplier Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            var btn = $("#DUE_FILTER_BTN");
            
            // Default = Show Due Supplier
            $s("P7_DUE_FILTER", "");
            
            btn.css({
                "background-color": "#dc3545",
                "border-color": "#dc3545",
                "color": "#ffffff",
                "font-weight": "600",
                "box-shadow": "0 2px 5px rgba(0,0,0,0.15)"
            });
            
            btn.find(".t-Button-label").text("Show Due Supplier");
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region entry (
        name: SUPPLIER SUMMERY
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 9/1/2026 4:19:12 PM (QP5 v5.388) */
                DECLARE
                    v_html                CLOB;
                
                    v_total_supplier      NUMBER := 0;
                    v_active_supplier     NUMBER := 0;
                    v_inactive_supplier   NUMBER := 0;
                    v_total_due           NUMBER := 0;
                    v_total_payment       NUMBER := 0;
                BEGIN
                    /* ============================================================
                       SUPPLIER COUNT
                       ============================================================ */
                
                    SELECT COUNT (*),
                           NVL (SUM (CASE WHEN ACTIVE_FLAG = 1 THEN 1 ELSE 0 END), 0),
                           NVL (SUM (CASE WHEN ACTIVE_FLAG = 0 THEN 1 ELSE 0 END), 0)
                      INTO v_total_supplier, v_active_supplier, v_inactive_supplier
                      FROM MST_SUPPLIER;
                
                
                    /* ============================================================
                       TOTAL DUE & TOTAL PAYMENT
                       ============================================================ */
                
                    SELECT NVL (SUM (DUE_AMOUNT), 0), NVL (SUM (PAID_AMOUNT), 0)
                      INTO v_total_due, v_total_payment
                      FROM TRN_PURCHASE_MST;
                
                
                    /* ============================================================
                       HTML
                       ============================================================ */
                
                    v_html :=
                           '<style>
                
                        .cust-kpi-wrapper {
                            display:grid;
                            grid-template-columns:repeat(5,1fr);
                            gap:12px;
                            width:100%;
                            box-sizing:border-box;
                        }
                
                        .cust-kpi-card {
                            height:64px;
                            min-height:64px;
                            border:1px solid #dfe5eb;
                            border-radius:8px;
                            padding:8px 13px;
                            box-sizing:border-box;
                
                            display:flex;
                            align-items:center;
                            gap:11px;
                
                            background:#fff;
                        }
                
                        .cust-kpi-icon {
                            width:34px;
                            height:34px;
                            min-width:34px;
                
                            border-radius:7px;
                
                            display:flex;
                            align-items:center;
                            justify-content:center;
                
                            font-size:15px;
                        }
                
                        .cust-kpi-content {
                            min-width:0;
                        }
                
                        .cust-kpi-title {
                            font-size:12px;
                            line-height:15px;
                            color:#6b7a8c;
                            margin:0 0 2px 0;
                            font-weight:400;
                        }
                
                        .cust-kpi-value {
                            font-size:19px;
                            line-height:21px;
                            font-weight:700;
                            margin:0;
                        }
                
                
                        /* TOTAL SUPPLIERS */
                
                        .cust-total {
                            background:#f7fafc;
                        }
                
                        .cust-total .cust-kpi-icon {
                            background:#e8f1fa;
                            color:#286596;
                        }
                
                        .cust-total .cust-kpi-value {
                            color:#286596;
                        }
                
                
                        /* ACTIVE SUPPLIERS */
                
                        .cust-active {
                            background:#f7fbf8;
                        }
                
                        .cust-active .cust-kpi-icon {
                            background:#e8f6ec;
                            color:#21894d;
                        }
                
                        .cust-active .cust-kpi-value {
                            color:#21894d;
                        }
                
                
                        /* INACTIVE SUPPLIERS */
                
                        .cust-inactive {
                            background:#fff8f8;
                        }
                
                        .cust-inactive .cust-kpi-icon {
                            background:#fdeaea;
                            color:#d03930;
                        }
                
                        .cust-inactive .cust-kpi-value {
                            color:#d03930;
                        }
                
                
                        /* TOTAL DUE */
                
                        .cust-due {
                            background:#fffdf7;
                        }
                
                        .cust-due .cust-kpi-icon {
                            background:#fff3d6;
                            color:#bd7b16;
                        }
                
                        .cust-due .cust-kpi-value {
                            color:#bd7b16;
                        }
                
                
                        /* TOTAL PAYMENT */
                
                        .cust-payment {
                            background:#f7f9ff;
                        }
                
                        .cust-payment .cust-kpi-icon {
                            background:#e9edff;
                            color:#4b5fc4;
                        }
                
                        .cust-payment .cust-kpi-value {
                            color:#4b5fc4;
                        }
                
                
                        /* RESPONSIVE */
                
                        @media(max-width:1100px) {
                
                            .cust-kpi-wrapper {
                                grid-template-columns:repeat(3,1fr);
                            }
                
                        }
                
                        @media(max-width:700px) {
                
                            .cust-kpi-wrapper {
                                grid-template-columns:repeat(2,1fr);
                            }
                
                        }
                
                        @media(max-width:550px) {
                
                            .cust-kpi-wrapper {
                                grid-template-columns:1fr;
                            }
                
                        }
                
                    </style>
                
                
                    <div class="cust-kpi-wrapper">
                
                
                        <!-- TOTAL SUPPLIERS -->
                
                        <div class="cust-kpi-card cust-total">
                
                            <div class="cust-kpi-icon">
                                <i class="fa fa-users"></i>
                            </div>
                
                            <div class="cust-kpi-content">
                
                                <div class="cust-kpi-title">
                                    Total Suppliers
                                </div>
                
                                <div class="cust-kpi-value">'
                        || TO_CHAR (v_total_supplier, 'FM999999999999990')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- ACTIVE SUPPLIERS -->
                
                        <div class="cust-kpi-card cust-active">
                
                            <div class="cust-kpi-icon">
                                <i class="fa fa-user"></i>
                            </div>
                
                            <div class="cust-kpi-content">
                
                                <div class="cust-kpi-title">
                                    Active Suppliers
                                </div>
                
                                <div class="cust-kpi-value">'
                        || TO_CHAR (v_active_supplier, 'FM999999999999990')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- INACTIVE SUPPLIERS -->
                
                        <div class="cust-kpi-card cust-inactive">
                
                            <div class="cust-kpi-icon">
                                <i class="fa fa-user-times"></i>
                            </div>
                
                            <div class="cust-kpi-content">
                
                                <div class="cust-kpi-title">
                                    Inactive Suppliers
                                </div>
                
                                <div class="cust-kpi-value">'
                        || TO_CHAR (v_inactive_supplier, 'FM999999999999990')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- TOTAL DUE -->
                
                        <div class="cust-kpi-card cust-due">
                
                            <div class="cust-kpi-icon">
                                <i class="fa fa-money"></i>
                            </div>
                
                            <div class="cust-kpi-content">
                
                                <div class="cust-kpi-title">
                                    Total Due
                                </div>
                
                                <div class="cust-kpi-value">
                                    ৳ '
                        || TO_CHAR (v_total_due,
                                    'FM999999999999990D00',
                                    'NLS_NUMERIC_CHARACTERS=''.,''')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                        <!-- TOTAL PAYMENT -->
                
                        <div class="cust-kpi-card cust-payment">
                
                            <div class="cust-kpi-icon">
                                <i class="fa fa-credit-card"></i>
                            </div>
                
                            <div class="cust-kpi-content">
                
                                <div class="cust-kpi-title">
                                    Total Payment
                                </div>
                
                                <div class="cust-kpi-value">
                                    ৳ '
                        || TO_CHAR (v_total_payment,
                                    'FM999999999999990D00',
                                    'NLS_NUMERIC_CHARACTERS=''.,''')
                        || '</div>
                
                            </div>
                
                        </div>
                
                
                    </div>';
                
                    RETURN v_html;
                END;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: SUPPLIER SUMMERY
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 9/1/2026 4:32:11 PM (QP5 v5.388) */
                /* ============================================================
                   SUPPLIER DETAILS CARD
                   ============================================================ */
                
                DECLARE
                    v_html             CLOB;
                
                    v_supplier_name    VARCHAR2 (300);
                    v_supplier_code    VARCHAR2 (50);
                    v_mobile           VARCHAR2 (50);
                    v_email            VARCHAR2 (200);
                    v_address          VARCHAR2 (500);
                    v_status           VARCHAR2 (20);
                    v_since            VARCHAR2 (30);
                
                    v_orders           NUMBER := 0;
                    v_total_purchase   NUMBER := 0;
                    v_due_amount       NUMBER := 0;
                BEGIN
                    /* ============================================================
                       NO SUPPLIER SELECTED
                       ============================================================ */
                
                    IF :P7_SUPPLIER_NO IS NULL
                    THEN
                        RETURN '
                        <style>
                
                            .cust-empty{
                                height:150px;
                                display:flex;
                                flex-direction:column;
                                align-items:center;
                                justify-content:center;
                                color:#9aa5b1;
                                font-size:13px;
                                text-align:center;
                            }
                
                            .cust-empty i{
                                font-size:30px;
                                margin-bottom:8px;
                                color:#cbd2da;
                            }
                
                        </style>
                
                        <div class="cust-empty">
                
                            <i class="fa fa-user"></i>
                
                            <div>Select a Supplier to view details</div>
                
                        </div>';
                    END IF;
                
                
                    /* ============================================================
                       SUPPLIER INFORMATION
                       ============================================================ */
                
                    SELECT SUPPLIER_NAME,
                           SUPPLIER_CODE,
                           MOBILE_NO,
                           EMAIL_ADDRESS,
                           ADDRESS,
                           CASE WHEN ACTIVE_FLAG = 1 THEN 'ACTIVE' ELSE 'INACTIVE' END,
                           TO_CHAR (CREATED_DATE, 'DD-Mon-YYYY')
                      INTO v_supplier_name,
                           v_supplier_code,
                           v_mobile,
                           v_email,
                           v_address,
                           v_status,
                           v_since
                      FROM MST_SUPPLIER
                     WHERE SUPPLIER_NO = :P7_SUPPLIER_NO;
                
                
                    /* ============================================================
                       PURCHASE SUMMARY
                       ============================================================ */
                
                    SELECT COUNT (*), NVL (SUM (TOTAL_AMOUNT), 0), NVL (SUM (DUE_AMOUNT), 0)
                      INTO v_orders, v_total_purchase, v_due_amount
                      FROM TRN_PURCHASE_MST
                     WHERE SUPPLIER_NO = :P7_SUPPLIER_NO;
                
                
                    /* ============================================================
                       HTML
                       ============================================================ */
                
                    v_html :=
                           '<style>
                
                        .customer-mini-card{
                            width:100%;
                            background:#ffffff;
                            border:1px solid #e3e7ec;
                            border-radius:9px;
                            overflow:hidden;
                            box-sizing:border-box;
                            font-family:Arial,sans-serif;
                        }
                
                
                        /* EMPTY */
                
                        .cust-empty{
                            height:150px;
                            display:flex;
                            flex-direction:column;
                            align-items:center;
                            justify-content:center;
                            color:#9aa5b1;
                            font-size:13px;
                            text-align:center;
                        }
                
                        .cust-empty i{
                            font-size:30px;
                            margin-bottom:8px;
                            color:#cbd2da;
                        }
                
                
                        /* HEADER */
                
                        .cust-head{
                            padding:10px 12px;
                            border-bottom:1px solid #edf0f3;
                            display:flex;
                            align-items:center;
                            justify-content:space-between;
                            gap:8px;
                        }
                
                
                        .cust-profile{
                            display:flex;
                            align-items:center;
                            min-width:0;
                        }
                
                
                        .cust-avatar{
                            width:38px;
                            height:38px;
                            min-width:38px;
                            border-radius:50%;
                            background:#e5f7f4;
                            color:#14877f;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            font-size:14px;
                            font-weight:700;
                            margin-right:9px;
                        }
                
                
                        .cust-name{
                            font-size:14px;
                            font-weight:700;
                            color:#172033;
                            white-space:nowrap;
                            overflow:hidden;
                            text-overflow:ellipsis;
                        }
                
                
                        .cust-code{
                            font-size:10px;
                            color:#8a94a3;
                            margin-top:2px;
                        }
                
                
                        /* STATUS */
                
                        .cust-status{
                            font-size:9px;
                            font-weight:700;
                            padding:4px 8px;
                            border-radius:10px;
                            white-space:nowrap;
                        }
                
                
                        .cust-active{
                            background:#e5f8ee;
                            color:#16834b;
                        }
                
                
                        .cust-inactive{
                            background:#fdecec;
                            color:#c93636;
                        }
                
                
                        /* INFORMATION */
                
                        .cust-info{
                            padding:7px 12px;
                            border-bottom:1px solid #edf0f3;
                        }
                
                
                        .cust-info-row{
                            display:flex;
                            align-items:center;
                            gap:8px;
                            margin:6px 0;
                            color:#5f6b79;
                            font-size:11px;
                        }
                
                
                        .cust-info-row i{
                            width:15px;
                            text-align:center;
                            color:#8c98a7;
                            font-size:11px;
                        }
                
                
                        .cust-info-text{
                            overflow:hidden;
                            text-overflow:ellipsis;
                            white-space:nowrap;
                        }
                
                
                        /* SUMMARY */
                
                        .cust-summary{
                            display:grid;
                            grid-template-columns:1fr 1fr 1fr;
                            gap:7px;
                            padding:8px 12px;
                        }
                
                
                        .cust-stat{
                            background:#f7f9fc;
                            border-radius:6px;
                            padding:7px 9px;
                        }
                
                
                        .cust-stat-label{
                            font-size:8px;
                            color:#7b8796;
                            font-weight:700;
                            text-transform:uppercase;
                            letter-spacing:.3px;
                        }
                
                
                        .cust-stat-value{
                            margin-top:3px;
                            font-size:12px;
                            font-weight:700;
                            color:#172033;
                        }
                
                
                        /* PURCHASE */
                
                        .cust-purchase{
                            color:#286596;
                        }
                
                
                        /* DUE */
                
                        .cust-due{
                            color:#bd7b16;
                        }
                
                
                        /* ORDERS */
                
                        .cust-orders{
                            color:#14877f;
                        }
                
                
                        @media(max-width:600px){
                
                            .cust-name{
                                max-width:140px;
                            }
                
                            .cust-summary{
                                grid-template-columns:1fr 1fr;
                            }
                
                            .cust-stat:last-child{
                                grid-column:span 2;
                            }
                
                        }
                
                    </style>
                
                
                    <div class="customer-mini-card">
                
                
                        <!-- HEADER -->
                
                        <div class="cust-head">
                
                            <div class="cust-profile">
                
                                <div class="cust-avatar">'
                        || UPPER (SUBSTR (v_supplier_name, 1, 1))
                        || '</div>
                
                                <div>
                
                                    <div class="cust-name">'
                        || APEX_ESCAPE.HTML (v_supplier_name)
                        || '</div>
                
                                    <div class="cust-code">'
                        || APEX_ESCAPE.HTML (v_supplier_code)
                        || ' &bull; Since '
                        || v_since
                        || '</div>
                
                                </div>
                
                            </div>
                
                
                            <div class="cust-status '
                        || CASE
                               WHEN v_status = 'ACTIVE' THEN 'cust-active'
                               ELSE 'cust-inactive'
                           END
                        || '">'
                        || v_status
                        || '</div>
                
                        </div>
                
                
                        <!-- SUPPLIER INFORMATION -->
                
                        <div class="cust-info">
                
                
                            <div class="cust-info-row">
                
                                <i class="fa fa-phone"></i>
                
                                <span class="cust-info-text">'
                        || APEX_ESCAPE.HTML (NVL (v_mobile, '-'))
                        || '</span>
                
                            </div>
                
                
                            <div class="cust-info-row">
                
                                <i class="fa fa-envelope"></i>
                
                                <span class="cust-info-text">'
                        || APEX_ESCAPE.HTML (NVL (v_email, '-'))
                        || '</span>
                
                            </div>
                
                
                            <div class="cust-info-row">
                
                                <i class="fa fa-map-marker"></i>
                
                                <span class="cust-info-text">'
                        || APEX_ESCAPE.HTML (NVL (v_address, '-'))
                        || '</span>
                
                            </div>
                
                
                        </div>
                
                
                        <!-- SUMMARY -->
                
                        <div class="cust-summary">
                
                
                            <!-- PURCHASE -->
                
                            <div class="cust-stat">
                
                                <div class="cust-stat-label">
                                    Total Purchase
                                </div>
                
                                <div class="cust-stat-value cust-purchase">
                
                                    ৳ '
                        || TO_CHAR (v_total_purchase,
                                    'FM999999999999990D00',
                                    'NLS_NUMERIC_CHARACTERS=''.,''')
                        || '
                
                                </div>
                
                            </div>
                
                
                            <!-- DUE -->
                
                            <div class="cust-stat">
                
                                <div class="cust-stat-label">
                                    Due Amount
                                </div>
                
                                <div class="cust-stat-value cust-due">
                
                                    ৳ '
                        || TO_CHAR (v_due_amount,
                                    'FM999999999999990D00',
                                    'NLS_NUMERIC_CHARACTERS=''.,''')
                        || '
                
                                </div>
                
                            </div>
                
                
                            <!-- ORDERS -->
                
                            <div class="cust-stat">
                
                                <div class="cust-stat-label">
                                    Total Purchases
                                </div>
                
                                <div class="cust-stat-value cust-orders">
                
                                    '
                        || TO_CHAR (v_orders, 'FM999999999999990')
                        || '
                
                                </div>
                
                            </div>
                
                
                        </div>
                
                
                    </div>';
                
                
                    RETURN v_html;
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        RETURN '
                        <div class="cust-empty">
                
                            <i class="fa fa-user-times"></i>
                
                            <div>Supplier not found</div>
                
                        </div>';
                    WHEN OTHERS
                    THEN
                        RETURN '
                        <div class="cust-empty">
                
                            <i class="fa fa-exclamation-circle"></i>
                
                            <div>Unable to load supplier details</div>
                
                        </div>';
                END;
                ```
            pageItemsToSubmit: P7_SUPPLIER_NO
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: SUPPLIER_DETAILS
        }
    )

    region register (
        name: Supplier Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 8/31/2026 11:29:04 AM (QP5 v5.388) */
                  SELECT s.SUPPLIER_NO,
                         s.SUPPLIER_CODE,
                         s.SUPPLIER_NAME,
                         s.CONTACT_PERSON,
                         s.MOBILE_NO,
                         s.EMAIL_ADDRESS,
                         s.ADDRESS,
                         S.ACTIVE_FLAG,
                         DECODE (s.ACTIVE_FLAG,  1, 'Active',  0, 'Inactive')     STATUS,
                         s.CREATED_BY,
                         s.CREATED_DATE,
                         s.UPDATED_BY,
                         s.UPDATED_DATE,
                         NVL(D.DUE_AMOUNT, 0) AS DUE_AMOUNT,
                
                       CASE
                           WHEN NVL(D.DUE_AMOUNT, 0) > 0
                           THEN '⚠ Due'
                           ELSE '✓ Clear'
                       END AS DUE_STATUS
                    FROM MST_SUPPLIER s
                         LEFT JOIN (  SELECT SUPPLIER_NO, SUM (NVL (DUE_AMOUNT, 0)) AS DUE_AMOUNT
                                        FROM TRN_PURCHASE_MST
                                    GROUP BY SUPPLIER_NO) D
                             ON D.SUPPLIER_NO = S.SUPPLIER_NO
                   WHERE (   :P7_DUE_FILTER IS NULL
                          OR :P7_DUE_FILTER = ''
                          OR ( :P7_DUE_FILTER = 'DUE' AND NVL (D.DUE_AMOUNT, 0) > 0))
                ORDER BY S.SUPPLIER_NAME
                ```
            pageItemsToSubmit: P7_DUE_FILTER
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
                margin-top-none
                margin-bottom-sm
            ]
        }
        advanced {
            htmlDomId: SUPPLIER_REPORT
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 12001286850732030
        }

        column ACTIVE_FLAG (
            type: plainText
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column ADDRESS (
            type: plainText
            heading {
                heading: Address
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CONTACT_PERSON (
            type: plainText
            heading {
                heading: Contact Person
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 90
            }
            source {
