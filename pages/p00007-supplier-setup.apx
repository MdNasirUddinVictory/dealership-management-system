    button add-product (
        buttonName: Add_Supplier
        label: Add Supplier
        layout {
            sequence: 10
            region: @register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 29
                clearCache: 29
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button add-to-cart (
        buttonName: ADD_TO_CART
        label: Add To Cart
        layout {
            sequence: 20
            region: @new
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-cart-plus
        }
        behavior {
            action: triggerAction
        }
        advanced {
            htmlDomId: SALES_ORDER
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var supplierNo = $v("P7_SUPPLIER_NO");
                    var active     = $v("P7_ACTIVE_FLAG");
                    
                    if (active == "1") {
                        apex.navigation.redirect(
                            "f?p=" +
                            $v("pFlowId") +
                            ":12:" +
                            $v("pInstance") +
                            "::NO:RP,12:P12_SUPPLIER_NO:" +
                            encodeURIComponent(supplierNo)
                        );
                    
                    } else {
                        apex.message.alert(
                            "This Supplier is inactive. You cannot add products to the cart."
                        );
                    
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

