    region register (
        name: PURCHASE_MST
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                    SELECT
                           M.PURCHASE_NO,
                           M.PURCHASE_CODE,
                           M.PURCHASE_DATE,
                
                           S.SUPPLIER_NAME,
                
                           M.TOTAL_AMOUNT,
                           M.PAID_AMOUNT,
                           M.DUE_AMOUNT,
                
                           CASE M.PAYMENT_STATUS
                                WHEN 'UP' THEN 'Unpaid'
                                WHEN 'PP' THEN 'Partially Paid'
                                WHEN 'P'  THEN 'Paid'
                           END AS PAYMENT_STATUS,
                
                           V.VOUCHER_CODE,
                
                           CASE M.APPROVAL_STATUS
                                WHEN 'P' THEN 'Pending'
                                WHEN 'A' THEN 'Approved'
                                WHEN 'R' THEN 'Rejected'
                           END AS APPROVAL_STATUS,
                
                           M.CREATED_BY,
                           M.CREATED_DATE,
                           M.APPROVED_BY,
                           M.APPROVED_DATE
                
                      FROM TRN_PURCHASE_MST M
                
                      JOIN MST_SUPPLIER S
                        ON S.SUPPLIER_NO = M.SUPPLIER_NO
                
                 LEFT JOIN ACC_VOUCHER_MST V
                        ON V.VOUCHER_NO = M.VOUCHER_NO
                
                     WHERE ( :P13_STATUS = 'ALL'
                          OR M.APPROVAL_STATUS = :P13_STATUS )
                
                     ORDER BY M.PURCHASE_NO DESC
                );
                ```
            pageItemsToSubmit: P13_STATUS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
