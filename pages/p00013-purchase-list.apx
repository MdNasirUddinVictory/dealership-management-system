    region purchase-details (
        name: Purchase Details
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT D.PURCHASE_DTL_NO,
                       P.PRODUCT_CODE,
                       P.PRODUCT_NAME,
                       D.PURCHASE_QTY,
                       D.PURCHASE_RATE,
                       D.TOTAL_AMOUNT
                FROM TRN_PURCHASE_DTL D
                JOIN MST_PRODUCT P
                ON P.PRODUCT_NO = D.PRODUCT_NO
                WHERE D.PURCHASE_NO = :P13_PURCHASE_NO
                ```
            pageItemsToSubmit: P13_PURCHASE_NO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: purchase-detail
        }
