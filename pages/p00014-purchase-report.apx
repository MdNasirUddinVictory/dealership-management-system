    pageItem P14_PRODUCT_NO (
        type: popupLov
        label {
            label: "Product "
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       p.product_code || ' - ' || p.product_name AS display_value,
                       p.product_no AS return_value
                FROM mst_product p
                WHERE p.category_no = :P14_CATEGORY_NO
                ORDER BY p.product_name;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P14_CATEGORY_NO
            itemsToSubmit: P14_CATEGORY_NO
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
            startNewRow: false
