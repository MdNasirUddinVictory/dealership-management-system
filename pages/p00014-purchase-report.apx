page 14 (
    name: Purchase  Report
    alias: PURCHASE-REPORT
    title: Purchase  Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: purchase report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT M.PURCHASE_CODE AS "Purchase No",
                       M.PURCHASE_DATE AS "Date",
                       S.SUPPLIER_NAME AS "Supplier",
                       S.MOBILE_NO AS "Mobile No",
                       P.PRODUCT_NAME AS "Product",
                       U.UOM_NAME AS "UOM",
                       D.PURCHASE_QTY AS "Qty",
                       D.PURCHASE_RATE AS "Rate",
                       NVL(D.TOTAL_AMOUNT,0) AS "Purchase Amount",
                       NVL(M.PAID_AMOUNT,0) AS "Paid",
                       NVL(M.DUE_AMOUNT,0) AS "Due",
                       CASE M.PAYMENT_STATUS
                           WHEN 'UP' THEN 'Unpaid'
                           WHEN 'PP' THEN 'Partial'
                           WHEN 'P'  THEN 'Paid'
                       END AS "Payment",
                       CASE M.APPROVAL_STATUS
                           WHEN 'P' THEN 'Pending'
                           WHEN 'A' THEN 'Approved'
                           WHEN 'R' THEN 'Rejected'
                       END AS "Status"
                  FROM TRN_PURCHASE_MST M
                       JOIN MST_SUPPLIER S
                         ON S.SUPPLIER_NO = M.SUPPLIER_NO
                       JOIN TRN_PURCHASE_DTL D
                         ON D.PURCHASE_NO = M.PURCHASE_NO
                       JOIN MST_PRODUCT P
                         ON P.PRODUCT_NO = D.PRODUCT_NO
                       LEFT JOIN MST_UOM U
                         ON U.UOM_NO = D.UOM_NO
                 WHERE M.APPROVAL_STATUS = 'A'
                   AND (:P14_FROM_DATE IS NULL
                        OR M.PURCHASE_DATE >= TO_DATE(:P14_FROM_DATE,'MM/DD/YYYY'))
                   AND (:P14_TO_DATE IS NULL
                        OR M.PURCHASE_DATE < TO_DATE(:P14_TO_DATE,'MM/DD/YYYY') + 1)
                --    AND (:P14_SUPPLIER_NO IS NULL
                --         OR M.SUPPLIER_NO = :P14_SUPPLIER_NO)
                --    AND (:P14_PRODUCT_NO IS NULL
                --         OR D.PRODUCT_NO = :P14_PRODUCT_NO)
                --    AND (:P14_CATEGORY_NO IS NULL
                --         OR P.CATEGORY_NO = :P14_CATEGORY_NO)
                ORDER BY M.PURCHASE_DATE DESC,
                         M.PURCHASE_NO DESC,
                         D.PURCHASE_DTL_NO;
                ```
            pageItemsToSubmit: [
                P14_CATEGORY_NO
                P14_PRODUCT_NO
                P14_STATUS
                P14_SUPPLIER_NO
                P14_FROM_DATE
                P14_TO_DATE
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 87014365061519423
        }

        column Date (
            type: plainText
