        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: purchase report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/6/2026 12:44:23 PM (QP5 v5.388) */
                  SELECT M.PURCHASE_NO              AS "Purchase No",
                         M.PURCHASE_CODE            AS "Purchase Code",
                         M.PURCHASE_DATE            AS "Purchase Date",
                         M.SUPPLIER_NO              AS "Supplier No",
                         S.SUPPLIER_NAME            AS "Supplier Name",
                         S.MOBILE_NO                AS "Mobile No",
                         P.PRODUCT_CODE             AS "Product Code",
                         P.PRODUCT_NAME             AS "Product Name",
                         PC.CATEGORY_NAME           AS "Category",
                         D.PURCHASE_QTY             AS "Purchase Quantity",
                         D.RECEIVED_QTY             AS "Received Quantity",
                         D.BALANCE_QTY              AS "Remaining Quantity",
                         D.PURCHASE_RATE            AS "Purchase Rate",
                         NVL (D.TOTAL_AMOUNT, 0)    AS "Item Total",
                         NVL (M.TOTAL_AMOUNT, 0)    AS "Purchase Total",
                         NVL (M.PAID_AMOUNT, 0)     AS "Paid Amount",
                         NVL (M.DUE_AMOUNT, 0)      AS "Due Amount",
                         CASE M.PAYMENT_STATUS
                             WHEN 'UP' THEN 'Unpaid'
                             WHEN 'PP' THEN 'Partially Paid'
                             WHEN 'P' THEN 'Paid'
                         END                        AS "Payment Status",
                         CASE M.APPROVAL_STATUS
                             WHEN 'P' THEN 'Pending'
                             WHEN 'A' THEN 'Approved'
                             WHEN 'R' THEN 'Rejected'
                         END                        AS "Approval Status",
                         M.REMARKS                  AS "Remarks",
                         M.CREATED_BY               AS "Created By",
                         M.CREATED_DATE             AS "Created Date",
                         M.APPROVED_BY              AS "Approved By",
                         M.APPROVED_DATE            AS "Approved Date"
                    FROM TRN_PURCHASE_MST M
                         JOIN MST_SUPPLIER S ON S.SUPPLIER_NO = M.SUPPLIER_NO
                         JOIN TRN_PURCHASE_DTL D ON D.PURCHASE_NO = M.PURCHASE_NO
                         JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         LEFT JOIN MST_PRODUCT_CATEGORY PC ON PC.CATEGORY_NO = P.CATEGORY_NO
                   WHERE     M.APPROVAL_STATUS = 'A'
                         AND (   :P14_FROM_DATE IS NULL
                              OR M.PURCHASE_DATE >= TO_DATE ( :P14_FROM_DATE, 'MM/DD/YYYY'))
                         AND (   :P14_TO_DATE IS NULL
                              OR M.PURCHASE_DATE < TO_DATE ( :P14_TO_DATE, 'MM/DD/YYYY') + 1)
                         AND ( :P14_SUPPLIER_NO IS NULL OR M.SUPPLIER_NO = :P14_SUPPLIER_NO)
                         AND ( :P14_PRODUCT_NO IS NULL OR D.PRODUCT_NO = :P14_PRODUCT_NO)
                         AND ( :P14_CATEGORY_NO IS NULL OR P.CATEGORY_NO = :P14_CATEGORY_NO)
                ORDER BY M.PURCHASE_DATE DESC, M.PURCHASE_NO DESC, D.PURCHASE_DTL_NO;
                ```
            pageItemsToSubmit: [
                P14_CATEGORY_NO
                P14_PRODUCT_NO
                P14_STATUS
                P14_SUPPLIER_NO
                P14_FROM_DATE
                P14_TO_DATE
            ]
        }
