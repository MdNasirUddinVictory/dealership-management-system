    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P14_CATEGORY_NO
                P14_PRODUCT_NO
                P14_STATUS
                P14_SUPPLIER_NO
                P14_FROM_DATE
                P14_TO_DATE
