    pageItem P14_CATEGORY_NO (
        type: popupLov
        label {
            label: Category No
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       category_name AS display_value,
                       category_no AS return_value
                FROM mst_product_category
                
                ORDER BY category_name;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P14_FROM_DATE (
        type: datePicker
        label {
