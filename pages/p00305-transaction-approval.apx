    region register (
        name: TRANSACTION-REGISTER
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT
                       T.TRANSACTION_NO,
                       T.TRANSACTION_CODE,
                       T.TRANSACTION_DATE,
                       TRANSACTION_TYPE,
                
                       CASE
                            WHEN T.TRANSACTION_TYPE='R' THEN 'Receive'
                            WHEN T.TRANSACTION_TYPE='P' THEN 'Payment'
                       END TRAN_TYPE,
                
                       T.PARTY_NO,
                
                       CASE
                            WHEN T.TRANSACTION_TYPE='R'
                                 THEN C.CUSTOMER_NAME
                            WHEN T.TRANSACTION_TYPE='P'
                                 THEN S.SUPPLIER_NAME
                       END PARTY_NAME,
                
                        CASE
                            WHEN T.PAY_MODE='C' THEN 'Cash'
                            WHEN T.PAY_MODE='B' THEN 'Bank'
                       END PAYMENT_MODE,
                
                       T.TOTAL_AMOUNT,
                
                       T.APPROVAL_STATUS,
                
                       CASE
                            WHEN T.APPROVAL_STATUS='P' THEN 'Pending'
                            WHEN T.APPROVAL_STATUS='A' THEN 'Approved'
                       END STATUS_NAME,
                
                       T.VOUCHER_NO,
                
                       V.VOUCHER_CODE,
                
                       T.CREATED_BY,
                       T.CREATED_DATE,
                
                       T.APPROVED_BY,
                       T.APPROVED_DATE,
                       NULL DETAILS
                
                FROM TRN_TRANSACTION_MST T
                
                LEFT JOIN MST_CUSTOMER C
                       ON C.CUSTOMER_NO=T.PARTY_NO
                      AND T.TRANSACTION_TYPE='R'
                
                LEFT JOIN MST_SUPPLIER S
                       ON S.SUPPLIER_NO=T.PARTY_NO
                      AND T.TRANSACTION_TYPE='P'
                
                LEFT JOIN ACC_VOUCHER_MST V
                       ON V.VOUCHER_NO=T.VOUCHER_NO
                
                ORDER BY T.TRANSACTION_NO DESC);
                ```
        }
