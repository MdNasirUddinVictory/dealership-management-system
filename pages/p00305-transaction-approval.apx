            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-reset
            customAttributes: disabled
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @approval-process
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--danger
                t-Button--iconLeft
            ]
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: rejectPurchase($v('P305_TRANSACTION_NO'))
            }
            execution {
                sequence: 10
            }
        )

    )

