page 305 (
    name: Transaction Approval
    alias: TRANSACTION-APPROVAL
    title: Transaction Approval
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function f_openModal(transactionNo,transactionType,approvalStatus){
              apex.item("P305_TRANSACTION_NO").setValue(transactionNo); 
              apex.item("P305_TRANSACTION_TYPE").setValue(transactionType);  
              apex.item("P305_APPROVAL_STATUS").setValue(transactionType);  
            
                openModal('trnsaction_approve');
            
                apex.region('transaction-detail').refresh();
            
            }
            
            function approveTransaction(pTransactionNo) {
            
                apex.message.confirm(
                    "Are you sure you want to approve this transaction?",
                    function (okPressed) {
            
                        if (!okPressed) {
                            return;
                        }
            
                        apex.server.process(
                            "APPROVE_TRANSACTION", 
                            {
                                x01: pTransactionNo,
                                x02: $v("P305_TRANSACTION_TYPE")
                            },
                            {
                                dataType: "json",
            
                                loadingIndicator: "body",
            
                                success: function (pData) {
            
                                    if (pData.status === "SUCCESS") {
            
                                        apex.message.showPageSuccess(
                                            pData.message
                                        );
            
                                        apex.region("transaction-register").refresh();
                                        apex.region("transaction-detail").refresh();
            
                                    } else {
            
                                        apex.message.showErrors([
                                            {
                                                type: "error",
                                                location: ["page"],
                                                message: pData.message,
                                                unsafe: false
                                            }
                                        ]);
            
                                    }
            
                                },
            
                                // error: function (jqXHR, textStatus, errorThrown) {
            
                                //     apex.message.showErrors([
                                //         {
                                //             type: "error",
                                //             location: ["page"],
                                //             message:
                                //                 "Unexpected error occurred.<br>" +
                                //                 errorThrown,
                                //             unsafe: true
                                //         }
                                //     ]);
            
                                // }
            
                            }
                        );
            
                    }
                );
            
            }
            
            function rejectPurchase(ptransactionNo){
            
                if(!confirm('Are you sure you want to reject this purchase?')){
                    return;
                }
            
                apex.server.process(
                    "REJECT_PURCHASE",
                    {
                        x01: ptransactionNo
                    },
                    {
                        dataType: "text",
                        success: function(pData){
            
                            if(pData === "SUCCESS"){
            
                                apex.message.showPageSuccess(
                                    "Purchase rejected successfully."
                                );
            
                                 apex.region('purchase-detail').refresh();
                                apex.region('purchase-register').refresh();
            
                            }else{
            
                                apex.message.alert(pData);
            
                            }
                        },
                        error: function(){
            
                            apex.message.alert(
                                "Unable to process request."
                            );
            
                        }
                    }
                );
            
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

