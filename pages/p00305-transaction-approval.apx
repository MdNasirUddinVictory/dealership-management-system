    process approve-purchase (
        name: APPROVE_TRANSACTION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    V_TRANSACTION_NO   NUMBER      := APEX_APPLICATION.G_X01;
                    V_TRANSACTION_TYPE VARCHAR2(1) := APEX_APPLICATION.G_X02;
                
                BEGIN
                
                    PKG_FINANCE.POST_TRANSACTION
                    (
                        P_TRANSACTION_NO   => V_TRANSACTION_NO,
                        P_TRANSACTION_TYPE => V_TRANSACTION_TYPE
                    );
                
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('status','SUCCESS');
                    APEX_JSON.WRITE('message','Transaction approved successfully.');
                    APEX_JSON.CLOSE_OBJECT;
                
                EXCEPTION
                    WHEN OTHERS THEN
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('status','ERROR');
                        APEX_JSON.WRITE('message',SQLERRM);
                        APEX_JSON.CLOSE_OBJECT;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14788224143006350212
        }
    )

    process reject-purchase (
        name: REJECT_PURCHASE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    UPDATE TRN_PURCHASE_MST
                       SET APPROVAL_STATUS = 'R',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE
                     WHERE PURCHASE_NO = APEX_APPLICATION.G_X01;
                
                    COMMIT;
                
                    HTP.P('SUCCESS');
                
                EXCEPTION
                    WHEN OTHERS THEN
                        HTP.P(SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 14788224563551350213
        }
    )

)

