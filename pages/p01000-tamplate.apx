    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM TRN_PURCHASE_MST
                     WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                    apex_application.g_print_success_message :=
                        'Purchase information deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8293113768372552031
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-tamplate (
        name: Initialize form Tamplate
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8268556261211693428
        }
    )

    process process-form-entry (
        name: Process form ENTRY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    IF :P12_PURCHASE_NO IS NULL THEN
                
                        INSERT INTO TRN_PURCHASE_MST
                        (
                            PURCHASE_NO,
                            PURCHASE_CODE,
                            PURCHASE_DATE,
                            SUPPLIER_NO,
                            REMARKS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_PURCHASE_NO.NEXTVAL,
                           'PUR-'||LPAD(SEQ_PURCHASE_NO.NEXTVAL,4,'0'),
                            :P12_PURCHASE_DATE,
                            :P12_SUPPLIER_NO,
                            :P12_REMARKS,
                            :P12_ACTIVE_FLAG,
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Purchase information saved successfully.';
                
                    ELSE
                
                        UPDATE TRN_PURCHASE_MST
                           SET
                               PURCHASE_DATE = :P12_PURCHASE_DATE,
                               SUPPLIER_NO   = :P12_SUPPLIER_NO,
                               REMARKS       = :P12_REMARKS,
                               ACTIVE_FLAG   = :P12_ACTIVE_FLAG,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE PURCHASE_NO = :P12_PURCHASE_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase information updated successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8293113625135552030
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process register-save-interactive-grid-data (
        name: REGISTER - Save Interactive Grid Data
        type: executeCode
        editableRegion: @register_1
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        INSERT INTO TRN_PURCHASE_DTL
                        (
                            PURCHASE_DTL_NO,
                            PURCHASE_NO,
                            PRODUCT_NO,
                            PURCHASE_QTY,
                            PURCHASE_RATE,
                            TOTAL_AMOUNT,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_PURCHASE_DTL_NO.NEXTVAL,
                            :P12_PURCHASE_NO,
                            :PRODUCT_NO,
                            :PURCHASE_QTY,
                            :PURCHASE_RATE,
                            NVL(:PURCHASE_QTY,0) * NVL(:PURCHASE_RATE,0),
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Purchase detail saved successfully.';
                
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        UPDATE TRN_PURCHASE_DTL
                           SET PRODUCT_NO    = :PRODUCT_NO,
                               PURCHASE_QTY  = :PURCHASE_QTY,
                               PURCHASE_RATE = :PURCHASE_RATE,
                               TOTAL_AMOUNT  = NVL(:PURCHASE_QTY,0) * NVL(:PURCHASE_RATE,0)--,
                               --UPDATED_BY    = :APP_USER,
                           --    UPDATED_DATE  = SYSDATE
                         WHERE PURCHASE_DTL_NO = :PURCHASE_DTL_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase detail updated successfully.';
                
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        DELETE
                          FROM TRN_PURCHASE_DTL
                         WHERE PURCHASE_DTL_NO = :PURCHASE_DTL_NO;
                
                        apex_application.g_print_success_message :=
                            'Purchase detail deleted successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 8293113448145552028
        }
    )

)

