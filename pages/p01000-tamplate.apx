page 1000 (
    name: Cash and Bank Book
    alias: CASH-AND-BANK-BOOK
    title: Cash and Bank Book
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region book-register (
        name: Cash and Bank Book Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH BOOK_ACCOUNT AS
                (
                    SELECT S.ACCOUNT_KEY,
                           S.ACCOUNT_NO,
                           NVL(H.ACCOUNT_CODE, TO_CHAR(S.ACCOUNT_NO)) ACCOUNT_CODE,
                           NVL(H.ACCOUNT_NAME, S.REMARKS) ACCOUNT_NAME
                    FROM ACC_SYSTEM_ACCOUNT S
                    LEFT JOIN MST_ACCOUNT_HEAD H
                      ON H.ACCOUNT_NO = S.ACCOUNT_NO
                    WHERE S.ACTIVE_STATUS = 'Y'
                                            AND S.ACCOUNT_KEY IN ('CASH', 'BANK')
                      AND (:P1000_BOOK_TYPE = 'ALL' OR S.ACCOUNT_KEY = :P1000_BOOK_TYPE)
                ),
                OPENING AS
                (
                    SELECT B.ACCOUNT_KEY,
                           B.ACCOUNT_NO,
                           B.ACCOUNT_CODE,
                           B.ACCOUNT_NAME,
                           NVL((
                               SELECT SUM(NVL(O.OPENING_DEBIT, 0) - NVL(O.OPENING_CREDIT, 0))
                               FROM ACC_OPENING_BALANCE O
                               WHERE O.ACCOUNT_NO = B.ACCOUNT_NO
                                 AND O.APPROVAL_STATUS = 'A'
                           ), 0)
                           + NVL((
                               SELECT SUM(NVL(D.DEBIT_AMOUNT, 0) - NVL(D.CREDIT_AMOUNT, 0))
                               FROM ACC_VOUCHER_MST M
                               JOIN ACC_VOUCHER_DTL D ON D.VOUCHER_NO = M.VOUCHER_NO
                               WHERE D.ACCOUNT_NO = B.ACCOUNT_NO
                                 AND M.APPROVAL_STATUS = 'A'
                                 AND :P1000_FROM_DATE IS NOT NULL
                                 AND M.VOUCHER_DATE < TRUNC(:P1000_FROM_DATE)
                           ), 0) OPENING_BALANCE
                    FROM BOOK_ACCOUNT B
                ),
                TRANSACTIONS AS
                (
                    SELECT O.ACCOUNT_KEY,
                           O.ACCOUNT_NO,
                              O.ACCOUNT_CODE,
                              O.ACCOUNT_NAME,
                           M.VOUCHER_DATE,
                           M.VOUCHER_NO,
                           M.VOUCHER_CODE,
                           M.VOUCHER_TYPE,
                           M.NARRATION,
                           D.VOUCHER_DTL_NO,
                           D.PARTICULARS,
                           NVL(D.DEBIT_AMOUNT, 0) DEBIT_AMOUNT,
                           NVL(D.CREDIT_AMOUNT, 0) CREDIT_AMOUNT,
                           O.OPENING_BALANCE
                    FROM OPENING O
                    JOIN ACC_VOUCHER_DTL D ON D.ACCOUNT_NO = O.ACCOUNT_NO
                    JOIN ACC_VOUCHER_MST M ON M.VOUCHER_NO = D.VOUCHER_NO
                    WHERE M.APPROVAL_STATUS = 'A'
                      AND (:P1000_FROM_DATE IS NULL OR M.VOUCHER_DATE >= TRUNC(:P1000_FROM_DATE))
                      AND (:P1000_TO_DATE IS NULL OR M.VOUCHER_DATE < TRUNC(:P1000_TO_DATE) + 1)
                ),
                BOOK_ROWS AS
                (
                    SELECT O.ACCOUNT_KEY,
                           O.ACCOUNT_NO,
                           O.ACCOUNT_CODE,
                           O.ACCOUNT_NAME,
                           CAST(NULL AS DATE) VOUCHER_DATE,
                           CAST(NULL AS VARCHAR2(100)) VOUCHER_CODE,
                           CAST(NULL AS VARCHAR2(30)) VOUCHER_TYPE,
                           'Opening Balance' PARTICULARS,
                           0 DEBIT_AMOUNT,
                           0 CREDIT_AMOUNT,
                           O.OPENING_BALANCE,
                           0 ROW_ORDER,
                           0 VOUCHER_NO,
                           0 VOUCHER_DTL_NO
                    FROM OPENING O
                    UNION ALL
                    SELECT T.ACCOUNT_KEY,
                           T.ACCOUNT_NO,
                              T.ACCOUNT_CODE,
                              T.ACCOUNT_NAME,
                           T.VOUCHER_DATE,
                           T.VOUCHER_CODE,
                           T.VOUCHER_TYPE,
                           NVL(T.PARTICULARS, T.NARRATION) PARTICULARS,
                           T.DEBIT_AMOUNT,
                           T.CREDIT_AMOUNT,
                           T.OPENING_BALANCE,
                           1 ROW_ORDER,
                           T.VOUCHER_NO,
                           T.VOUCHER_DTL_NO
                    FROM TRANSACTIONS T
                )
                SELECT ACCOUNT_KEY,
                       ACCOUNT_CODE,
                       ACCOUNT_NAME,
                       VOUCHER_DATE,
                       VOUCHER_CODE,
                       VOUCHER_TYPE,
                       PARTICULARS,
                       DEBIT_AMOUNT,
                       CREDIT_AMOUNT,
                       OPENING_BALANCE
                         + SUM(DEBIT_AMOUNT - CREDIT_AMOUNT) OVER (
                               PARTITION BY ACCOUNT_NO
                               ORDER BY ROW_ORDER, VOUCHER_DATE, VOUCHER_NO, VOUCHER_DTL_NO
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                           ) RUNNING_BALANCE
                FROM BOOK_ROWS
                ORDER BY ACCOUNT_KEY, ACCOUNT_NO, ROW_ORDER, VOUCHER_DATE, VOUCHER_NO, VOUCHER_DTL_NO
                ```
            pageItemsToSubmit: [
                P1000_BOOK_TYPE
                P1000_FROM_DATE
                P1000_TO_DATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 72610425023819735010
        }

        column ACCOUNT_KEY (
            type: plainText
            heading {
                heading: Book
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CODE (
            type: plainText
            heading {
                heading: Account Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_NAME (
            type: plainText
            heading {
                heading: Account Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column VOUCHER_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
        )

        column VOUCHER_CODE (
            type: plainText
            heading {
                heading: Voucher No
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column VOUCHER_TYPE (
            type: plainText
            heading {
                heading: Voucher Type
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column PARTICULARS (
            type: plainText
            heading {
                heading: Particulars
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column DEBIT_AMOUNT (
            type: plainText
            heading {
                heading: Debit
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column CREDIT_AMOUNT (
            type: plainText
            heading {
                heading: Credit
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column RUNNING_BALANCE (
            type: plainText
            heading {
                heading: Running Balance
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNT_KEY (
                sequence: 1
            )

            displayColumn ACCOUNT_CODE (
                sequence: 2
            )

            displayColumn ACCOUNT_NAME (
                sequence: 3
            )

            displayColumn VOUCHER_DATE (
                sequence: 4
            )

            displayColumn VOUCHER_CODE (
                sequence: 5
            )

            displayColumn VOUCHER_TYPE (
                sequence: 6
            )

            displayColumn PARTICULARS (
                sequence: 7
            )

            displayColumn DEBIT_AMOUNT (
                sequence: 8
            )

            displayColumn CREDIT_AMOUNT (
                sequence: 9
            )

            displayColumn RUNNING_BALANCE (
                sequence: 10
            )
        )
    )

    pageItem P1000_BOOK_TYPE (
        type: selectList
        label {
            label: Book Type
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC3:All Books;ALL,Cash Book;CASH,Bank Book;BANK
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
    )

    pageItem P1000_FROM_DATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
    )

    pageItem P1000_TO_DATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
    )

    dynamicAction refresh-book-report (
        name: Refresh Book Report
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P1000_BOOK_TYPE
                P1000_FROM_DATE
                P1000_TO_DATE
            ]
        }

        action refresh-book-region (
            action: refresh
            affectedElements {
                selectionType: region
                region: @book-register
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)