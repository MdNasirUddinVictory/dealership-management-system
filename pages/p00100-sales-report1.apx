    pageItem P100_CATEGORY_NO (
        type: selectList
        label {
            label: Category No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       category_name AS display_value,
                       category_no AS return_value
                FROM mst_product_category
                
                ORDER BY category_name;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
    )

