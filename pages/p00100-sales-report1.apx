    pageItem P100_CATEGORY_NO (
        type: selectList
        label {
            label: Category No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       category_name AS display_value,
                       category_no AS return_value
                FROM mst_product_category
                
                ORDER BY category_name;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P100_CUSTOMER_NO (
        type: selectList
        label {
            label: Customer Name
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-17-customer-lov
            displayExtraValues: false
        }
        layout {
            sequence: 50
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
