    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P100_CATEGORY_NO
                P100_PRODUCT_NO
                P100_STATUS
                P100_CUSTOMER_NO
                P100_FROM_DATE
                P100_TO_DATE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

