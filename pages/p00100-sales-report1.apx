            sequence: 10
            slot: body
            alignment: left
            startNewRow: false
            column: 3
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
    )

    pageItem P100_PRODUCT_NO (
        type: selectList
        label {
            label: "Product "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       p.product_code || ' - ' || p.product_name AS display_value,
                       p.product_no AS return_value
                FROM mst_product p
                WHERE p.category_no = :P100_CATEGORY_NO
                ORDER BY p.product_name;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P100_CATEGORY_NO
            itemsToSubmit: P100_CATEGORY_NO
        }
        layout {
            sequence: 40
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
            height: 1
        }
        config {
            buildOption: @commented-out
        }
    )

