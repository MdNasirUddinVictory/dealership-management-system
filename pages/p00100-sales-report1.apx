page 100 (
    name: Sales Report
    alias: SALES-REPORT1
    title: Sales Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: Stock Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       i.invoice_no AS "Invoice No",
                       i.invoice_code AS "Invoice Code",
                       i.invoice_date AS "Invoice Date",
                
                       o.order_code AS "Order No",
                
                       c.customer_code AS "Customer Code",
                       c.customer_name AS "Customer Name",
                       c.mobile_no AS "Mobile No",
                
                       p.product_code AS "Product Code",
                       p.product_name AS "Product Name",
                       pc.category_name AS "Category",
                
                       d.sales_qty AS "Sales Quantity",
                       d.delivered_qty AS "Delivered Quantity",
                       NVL(d.sales_qty, 0)
                       - NVL(d.delivered_qty, 0) AS "Remaining Quantity",
                
                       d.sales_rate AS "Sales Rate",
                       NVL(d.total_amount, 0) AS "Item-wise Total",
                
                       NVL(i.total_amount, 0) AS "Invoice Amount",
                       NVL(i.received_amount, 0) AS "Received Amount",
                       NVL(i.due_amount, 0) AS "Due Amount",
                
                       CASE i.payment_status
                           WHEN 'UP' THEN 'Unpaid'
                           WHEN 'PP' THEN 'Partially Paid'
                           WHEN 'P'  THEN 'Paid'
                       END AS "Payment Status",
                
                       CASE i.delivery_status
                           WHEN 'P' THEN 'Pending'
                           WHEN 'D' THEN 'Delivered'
                       END AS "Delivery Status",
                
                       NVL(r.return_qty, 0) AS "Returned Quantity",
                
                       i.delivery_by AS "Delivery By",
                       i.delivery_date AS "Delivery Date",
                       i.created_by AS "Created By",
                       i.created_date AS "Created Date"
                
                FROM trn_sales_invoice_mst i
                
                LEFT JOIN trn_sales_invoice_dtl d
                  ON d.invoice_no = i.invoice_no
                
                LEFT JOIN mst_customer c
                  ON c.customer_no = i.customer_no
                
                LEFT JOIN mst_product p
                  ON p.product_no = d.product_no
                
                LEFT JOIN mst_product_category pc
                  ON pc.category_no = p.category_no
                
                LEFT JOIN trn_sales_order_mst o
                  ON o.order_no = i.order_no
                
                LEFT JOIN (
                    SELECT
                           d.invoice_dtl_no,
                           SUM(NVL(d.return_qty, 0)) AS return_qty
                    FROM trn_customer_return_dtl d
                    JOIN trn_customer_return_mst m
                      ON m.return_no = d.return_no
                    WHERE m.approval_status = 'A'
                    GROUP BY d.invoice_dtl_no
                ) r
                  ON r.invoice_dtl_no = d.invoice_dtl_no
                
                WHERE (:P100_FROM_DATE IS NULL
                       OR i.invoice_date >= TO_DATE(:P100_FROM_DATE, 'MM/DD/YYYY'))
                  AND (:P100_TO_DATE IS NULL
                       OR i.invoice_date < TO_DATE(:P100_TO_DATE, 'MM/DD/YYYY') + 1)
                  AND (:P100_CUSTOMER_NO IS NULL
                       OR i.customer_no = :P100_CUSTOMER_NO)
                  AND (:P100_PRODUCT_NO IS NULL
                       OR d.product_no = :P100_PRODUCT_NO)
                  AND (:P100_CATEGORY_NO IS NULL
                       OR p.category_no = :P100_CATEGORY_NO)
                
                ORDER BY
                       i.invoice_date DESC,
                       i.invoice_no DESC,
                       d.invoice_dtl_no;
                ```
            pageItemsToSubmit: [
                P100_CATEGORY_NO
                P100_PRODUCT_NO
                P100_STATUS
                P100_CUSTOMER_NO
                P100_FROM_DATE
                P100_TO_DATE
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 87045619453565135
        }

