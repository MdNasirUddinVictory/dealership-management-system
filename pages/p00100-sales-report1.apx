page 100 (
    name: Sales Report
    alias: SALES-REPORT1
    title: Sales Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sales-report (
        name: Stock Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH PRODUCT_COST AS (
                    SELECT PRODUCT_NO,
                           NVL(
                               SUM(NVL(BASE_QTY,0) * NVL(BASE_RATE,0))
                               / NULLIF(SUM(NVL(BASE_QTY,0)),0),
                               0
                           ) AS BASE_COST
                      FROM TRN_PURCHASE_DTL
                     WHERE NVL(BASE_QTY,0) > 0
                       AND NVL(BASE_RATE,0) > 0
                     GROUP BY PRODUCT_NO
                ),
                RETURN_QTY AS (
                    SELECT D.INVOICE_DTL_NO,
                           SUM(NVL(D.RETURN_QTY,0)) AS RETURN_QTY
                      FROM TRN_CUSTOMER_RETURN_DTL D
                           JOIN TRN_CUSTOMER_RETURN_MST M
                             ON M.RETURN_NO = D.RETURN_NO
                     WHERE M.APPROVAL_STATUS = 'A'
                     GROUP BY D.INVOICE_DTL_NO
                )
                SELECT I.INVOICE_CODE AS "Invoice No",
                       I.INVOICE_DATE AS "Date",
                       C.CUSTOMER_NAME AS "Customer",
                       C.MOBILE_NO AS "Mobile No",
                       P.PRODUCT_NAME AS "Product",
                       D.SALES_QTY AS "Qty",
                       D.SALES_RATE AS "Rate",
                       NVL(D.TOTAL_AMOUNT,0) AS "Sales Amount",
                       ROUND(
                           NVL(D.BASE_QTY,0) * NVL(PCST.BASE_COST,0),
                           2
                       ) AS "Cost Amount",
                       ROUND(
                           NVL(D.TOTAL_AMOUNT,0)
                           - (NVL(D.BASE_QTY,0) * NVL(PCST.BASE_COST,0)),
                           2
                       ) AS "Profit",
                       CASE
                           WHEN NVL(D.TOTAL_AMOUNT,0) > 0 THEN
                               ROUND(
                                   (
                                       NVL(D.TOTAL_AMOUNT,0)
                                       - (NVL(D.BASE_QTY,0) * NVL(PCST.BASE_COST,0))
                                   )
                                   / NVL(D.TOTAL_AMOUNT,0) * 100,
                                   2
                               )
                           ELSE 0
                       END AS "Profit %",
                       NVL(R.RETURN_QTY,0) AS "Return Qty",
                       NVL(I.RECEIVED_AMOUNT,0) AS "Received",
                       NVL(I.DUE_AMOUNT,0) AS "Due",
                       CASE I.PAYMENT_STATUS
                           WHEN 'UP' THEN 'Unpaid'
                           WHEN 'PP' THEN 'Partial'
                           WHEN 'P'  THEN 'Paid'
                       END AS "Payment",
                       CASE I.DELIVERY_STATUS
                           WHEN 'P' THEN 'Pending'
                           WHEN 'D' THEN 'Delivered'
                       END AS "Delivery"
                  FROM TRN_SALES_INVOICE_MST I
                       LEFT JOIN TRN_SALES_INVOICE_DTL D
                         ON D.INVOICE_NO = I.INVOICE_NO
                       LEFT JOIN MST_CUSTOMER C
                         ON C.CUSTOMER_NO = I.CUSTOMER_NO
                       LEFT JOIN MST_PRODUCT P
                         ON P.PRODUCT_NO = D.PRODUCT_NO
                       LEFT JOIN PRODUCT_COST PCST
                         ON PCST.PRODUCT_NO = D.PRODUCT_NO
                       LEFT JOIN RETURN_QTY R
                         ON R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                 WHERE (:P100_FROM_DATE IS NULL
                        OR I.INVOICE_DATE >= TO_DATE(:P100_FROM_DATE,'MM/DD/YYYY'))
                   AND (:P100_TO_DATE IS NULL
                        OR I.INVOICE_DATE < TO_DATE(:P100_TO_DATE,'MM/DD/YYYY') + 1)
                --    AND (:P100_CUSTOMER_NO IS NULL
                --         OR I.CUSTOMER_NO = :P100_CUSTOMER_NO)
                --    AND (:P100_PRODUCT_NO IS NULL
                --         OR D.PRODUCT_NO = :P100_PRODUCT_NO)
                --    AND (:P100_CATEGORY_NO IS NULL
                --         OR P.CATEGORY_NO = :P100_CATEGORY_NO)
                ORDER BY I.INVOICE_DATE DESC,
                         I.INVOICE_NO DESC,
                         D.INVOICE_DTL_NO;
                ```
            pageItemsToSubmit: [
                P100_CATEGORY_NO
                P100_PRODUCT_NO
                P100_STATUS
                P100_CUSTOMER_NO
                P100_FROM_DATE
                P100_TO_DATE
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 87045619453565135
        }

