page 32 (
    name: Discount Setup
    alias: DISCOUNT-SETUP
    title: Discount Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 50
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region category-wise-discount (
        name: Category Wise Discount
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/7/2026 1:27:02 PM (QP5 v5.388) */
                  SELECT D.DISCOUNT_CONFIG_NO,
                         D.CONFIG_CODE,
                         D.CONFIG_NAME,
                         P.PRODUCT_CODE || ' - ' || P.PRODUCT_NAME         AS PRODUCT_NAME,
                         C.CATEGORY_CODE || ' - ' || C.CATEGORY_NAME       AS CATEGORY_NAME,
                         CU.CUSTOMER_CODE || ' - ' || CU.CUSTOMER_NAME     AS CUSTOMER_NAME,
                         D.DISCOUNT_PERCENT,
                         D.PRIORITY,
                         D.EFFECTIVE_FROM,
                         D.EFFECTIVE_TO,
                         D.ACTIVE_FLAG
                    FROM MST_DISCOUNT_CONFIG D
                         LEFT JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         LEFT JOIN MST_PRODUCT_CATEGORY C ON C.CATEGORY_NO = D.CATEGORY_NO
                         LEFT JOIN MST_CUSTOMER CU ON CU.CUSTOMER_NO = D.CUSTOMER_NO
                         WHERE CATEGORY_NAME IS NOT NULL
                ORDER BY D.PRIORITY DESC, D.CONFIG_NAME
                ```
        }
        layout {
            sequence: 60
            parentRegion: @tab-container
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 14663805102080240
        }

        column ACTIVE_FLAG (
            type: plainText
            heading {
                heading: Active Flag
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

