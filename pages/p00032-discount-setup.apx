page 32 (
    name: Discount Setup
    alias: DISCOUNT-SETUP
    title: Discount Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 50
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region product-entrey (
        name: DISCOUNT SETUP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/7/2026 1:27:02 PM (QP5 v5.388) */
                  SELECT D.DISCOUNT_CONFIG_NO,
                         D.CONFIG_CODE,
                         D.CONFIG_NAME,
                         P.PRODUCT_CODE || ' - ' || P.PRODUCT_NAME         AS PRODUCT_NAME,
                         C.CATEGORY_CODE || ' - ' || C.CATEGORY_NAME       AS CATEGORY_NAME,
                         CU.CUSTOMER_CODE || ' - ' || CU.CUSTOMER_NAME     AS CUSTOMER_NAME,
                         D.DISCOUNT_PERCENT,
                         D.PRIORITY,
                         D.EFFECTIVE_FROM,
                         D.EFFECTIVE_TO,
                         D.ACTIVE_FLAG
                    FROM MST_DISCOUNT_CONFIG D
                         LEFT JOIN MST_PRODUCT P ON P.PRODUCT_NO = D.PRODUCT_NO
                         LEFT JOIN MST_PRODUCT_CATEGORY C ON C.CATEGORY_NO = D.CATEGORY_NO
                         LEFT JOIN MST_CUSTOMER CU ON CU.CUSTOMER_NO = D.CUSTOMER_NO
                ORDER BY D.PRIORITY DESC, D.CONFIG_NAME
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 14663805102080240
        }

        column ACTIVE_FLAG (
            type: plainText
            heading {
                heading: Active Flag
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category Name
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CONFIG_CODE (
            type: link
            heading {
                heading: Config Code
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 33
                    items: {
                        P33_DISCOUNT_CONFIG_NO: #DISCOUNT_CONFIG_NO#
                    }
                }
                linkText: #CONFIG_CODE#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CONFIG_NAME (
            type: plainText
            heading {
                heading: Config Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer Name
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column DISCOUNT_CONFIG_NO (
            type: plainText
            heading {
                heading: Discount Config No
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column DISCOUNT_PERCENT (
            type: plainText
            heading {
                heading: Discount Percent
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column EFFECTIVE_FROM (
            type: plainText
            heading {
                heading: Effective From
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column EFFECTIVE_TO (
            type: plainText
            heading {
                heading: Effective To
            }
            layout {
                sequence: 100
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column PRIORITY (
            type: plainText
            heading {
                heading: Priority
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column PRODUCT_NAME (
            type: plainText
            heading {
                heading: Product Name
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVE_FLAG (
                sequence: 10
            )

            displayColumn CATEGORY_NAME (
                sequence: 4
            )

            displayColumn CONFIG_CODE (
                sequence: 1
            )

            displayColumn CONFIG_NAME (
                sequence: 2
            )

            displayColumn CUSTOMER_NAME (
                sequence: 3
            )

            displayColumn DISCOUNT_PERCENT (
                sequence: 6
            )

            displayColumn EFFECTIVE_FROM (
                sequence: 8
            )

            displayColumn EFFECTIVE_TO (
                sequence: 9
            )

            displayColumn PRIORITY (
                sequence: 7
            )

            displayColumn PRODUCT_NAME (
                sequence: 5
            )

        )

    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
            customAttributes: disabled
        }
    )

    button new-3 (
        buttonName: New
        label: Add Discount
        layout {
            sequence: 10
            region: @product-entrey
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
                clearCache: 33
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
            customAttributes: disabled
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
            customAttributes: disabled
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P32_PRODUCT_NO
        }
    )

)

