    region heading (
        name: HEADING
        type: staticContent
        source {
            htmlCode:
                ```html
                
                <div class="discount-header">
                    <div class="discount-title">
                        <span class="discount-icon fa fa-tags"></span>
                
                        <h1>Discount Register</h1>
                
                        <span class="discount-badge">
                            DISCOUNT SETUP
                        </span>
                    </div>
                
                    <div class="discount-subtitle">
                        <span>
                            <i class="fa fa-plus-circle"></i>
                            Discount Entry
                        </span>
                
                        <b>•</b>
                
                        <span>
                            <i class="fa fa-cube"></i>
                            Product Wise Discount
                        </span>
                
                        <b>•</b>
                
                        <span>
                            <i class="fa fa-users"></i>
                            Customer Wise Discount
                        </span>
                
                        <b>•</b>
                
                        <span>
                            <i class="fa fa-tags"></i>
                            Category Wise Discount
                        </span>
                
                        <b>---</b>
                
                        <span>
                            <i class="fa fa-list-alt"></i>
                            Discount Configuration &amp; Register
                        </span>
                    </div>
                </div>
                
                <style>
                /* ===============================
                   DISCOUNT REGISTER HEADER
                ================================ */
                
                .discount-header {
                    padding: 9px 12px 10px;
                    margin-bottom: 8px;
                
                    background: linear-gradient(
                        100deg,
                        #eef2ff 0%,
                        #f8fafc 60%,
                        #eff6ff 100%
                    );
                
                    border-left: 4px solid #6366f1;
                    border-radius: 5px;
                
                    box-shadow: 0 2px 7px rgba(51, 65, 85, 0.08);
                    box-sizing: border-box;
                }
                
                /* ===============================
                   TITLE & ICON
                ================================ */
                
                .discount-title {
                    display: flex;
                    align-items: center;
                    gap: 9px;
                    flex-wrap: wrap;
                }
                
                .discount-icon {
                    width: 35px;
                    height: 35px;
                
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                
                    flex-shrink: 0;
                
                    border-radius: 8px;
                
                    color: #ffffff;
                
                    background: linear-gradient(
                        135deg,
                        #4f46e5,
                        #7c3aed
                    );
                
                    font-size: 18px;
                
                    box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);
                }
                
                .discount-title h1 {
                    margin: 0;
                
                    font-size: 22px;
                    line-height: 1.2;
                    font-weight: 700;
                
                    color: #1e293b;
                }
                
                /* ===============================
                   BADGE
                ================================ */
                
                .discount-badge {
                    display: inline-block;
                
                    padding: 4px 9px;
                
                    border-radius: 12px;
                
                    background: #e0e7ff;
                    border: 1px solid #c7d2fe;
                
                    color: #4338ca;
                
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                }
                
                /* ===============================
                   SUBTITLE
                ================================ */
                
                .discount-subtitle {
                    margin: 5px 0 0 44px;
                
                    display: flex;
                    align-items: center;
                    flex-wrap: wrap;
                
                    gap: 5px;
                
                    font-size: 11px;
                    line-height: 1.5;
                
                    color: #64748b;
                }
                
                .discount-subtitle span {
                    color: #475569;
                    font-weight: 500;
                }
                
                .discount-subtitle span:first-child {
                    color: #4f46e5;
                    font-weight: 700;
                }
                
                .discount-subtitle i {
                    margin-right: 3px;
                    color: #6366f1;
                    font-size: 11px;
                }
                
                .discount-subtitle b {
                    margin: 0 2px;
                
                    color: #c4b5fd;
                    font-weight: 400;
                }
                
                /* ===============================
                   HOVER EFFECT
                ================================ */
                
                .discount-subtitle span:hover {
                    color: #4338ca;
                    transition: color 0.2s ease;
                }
                
                /* ===============================
                   MOBILE RESPONSIVE
                ================================ */
                
                @media (max-width: 600px) {
                
                    .discount-header {
                        padding: 8px;
                        margin-bottom: 6px;
                    }
                
                    .discount-title {
                        gap: 7px;
                    }
                
                    .discount-title h1 {
                        font-size: 19px;
                    }
                
                    .discount-icon {
                        width: 30px;
                        height: 30px;
                        font-size: 15px;
                    }
                
                    .discount-badge {
                        padding: 3px 7px;
                        font-size: 8px;
                    }
                
                    .discount-subtitle {
                        margin: 5px 0 0 37px;
                        gap: 4px;
                        font-size: 10px;
                    }
                
                    .discount-subtitle i {
                        font-size: 10px;
                    }
                }
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

