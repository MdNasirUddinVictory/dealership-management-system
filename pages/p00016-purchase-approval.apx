    process approve-purchase (
        name: APPROVE_PURCHASE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_status NUMBER;
                    v_exists NUMBER;
                
                BEGIN
                
                    ------------------------------------------------
                    -- Already Approved
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_status
                      FROM TRN_PURCHASE_MST
                     WHERE PURCHASE_NO = APEX_APPLICATION.G_X01
                       AND APPROVAL_STATUS = 'A';
                
                    IF v_status > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Purchase already approved.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Detail Exists
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_PURCHASE_DTL
                     WHERE PURCHASE_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Purchase details not found.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Stock Already Posted
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_STOCK_LEDGER
                     WHERE TRAN_TYPE = 'PURCHASE'
                       AND REF_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Stock already posted.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Approve Purchase
                    ------------------------------------------------
                    UPDATE TRN_PURCHASE_MST
                       SET APPROVAL_STATUS = 'A',
                           PURCHASE_STATUS = 'R',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE
                     WHERE PURCHASE_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Stock Ledger Posting
                    ------------------------------------------------
                    INSERT INTO TRN_STOCK_LEDGER
                    (
                        LEDGER_NO,
                        TRAN_DATE,
                        TRAN_TYPE,
                        REF_NO,
                        PRODUCT_NO,
                        QTY_IN,
                        QTY_OUT,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    SELECT
                        SEQ_LEDGER_NO.NEXTVAL,
                        M.PURCHASE_DATE,
                        'PURCHASE',
                        D.PURCHASE_NO,
                        D.PRODUCT_NO,
                        D.BASE_QTY,
                        0,
                        :APP_USER,
                        SYSDATE
                    FROM TRN_PURCHASE_DTL D
                    JOIN TRN_PURCHASE_MST M
                      ON M.PURCHASE_NO = D.PURCHASE_NO
                    WHERE D.PURCHASE_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Finance Voucher Posting
                    ------------------------------------------------
                    PKG_FINANCE.POST_PURCHASE
                    (
                        P_PURCHASE_NO => APEX_APPLICATION.G_X01
                    );
                
                    COMMIT;
                
                    HTP.P('Purchase approved successfully.');
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            SQLERRM
                        );
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 8427741593348207846
        }
    )

    process reject-purchase (
        name: REJECT_PURCHASE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    UPDATE TRN_PURCHASE_MST
                       SET APPROVAL_STATUS = 'R',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE
                     WHERE PURCHASE_NO = APEX_APPLICATION.G_X01;
                
                    COMMIT;
                
                    HTP.P('SUCCESS');
                
                EXCEPTION
                    WHEN OTHERS THEN
                        HTP.P(SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 8427741704912207848
        }
    )

)

