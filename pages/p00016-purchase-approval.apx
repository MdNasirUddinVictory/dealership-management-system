page 16 (
    name: Purchase Approval
    alias: PURCHASE-APPROVAL
    title: Purchase Approval
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function f_openModal(purchaseNo){
            
                apex.item("P16_PURCHASE_NO").setValue(purchaseNo);
            
                openModal('purchase_approve');
            
                apex.region('purchase-detail').refresh();
            
            }
            
            
            function approvePurchase(pPurchaseNo){
            
                if(!confirm('Are you sure you want to approve this purchase?')){
                    return;
                }
            
                apex.server.process(
                    "APPROVE_PURCHASE",
                    {
                        x01: pPurchaseNo
                    },
                    {
                        dataType: "text",
                        success: function(pData){
            
                            if(pData === "SUCCESS"){
            
                                apex.message.showPageSuccess(
                                    "Purchase approved successfully."
                                );
            
                                apex.region('purchase-detail').refresh();
                                apex.region('purchase-register').refresh();
            
                            }else{
            
                                apex.message.alert(pData);
            
                            }
                        },
                        error: function(){
            
                            apex.message.alert(
                                "Unable to process request."
                            );
            
                        }
                    }
                );
            
            }
            
            
            function rejectPurchase(pPurchaseNo){
            
                if(!confirm('Are you sure you want to reject this purchase?')){
                    return;
                }
            
                apex.server.process(
                    "REJECT_PURCHASE",
                    {
                        x01: pPurchaseNo
                    },
                    {
                        dataType: "text",
                        success: function(pData){
            
                            if(pData === "SUCCESS"){
            
                                apex.message.showPageSuccess(
                                    "Purchase rejected successfully."
                                );
            
                                 apex.region('purchase-detail').refresh();
                                apex.region('purchase-register').refresh();
            
                            }else{
            
                                apex.message.alert(pData);
            
                            }
                        },
                        error: function(){
            
                            apex.message.alert(
                                "Unable to process request."
                            );
            
                        }
                    }
                );
            
            }
            ```
    }
