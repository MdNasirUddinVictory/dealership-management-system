            sqlQuery:
                ```sql
                SELECT D.PURCHASE_DTL_NO,
                       P.PRODUCT_CODE,
                       P.PRODUCT_NAME,
                       D.PURCHASE_QTY,
                       D.PURCHASE_RATE,
                       D.TOTAL_AMOUNT
                FROM TRN_PURCHASE_DTL D
                JOIN MST_PRODUCT P
                ON P.PRODUCT_NO = D.PRODUCT_NO
                WHERE D.PURCHASE_NO = :P16_PURCHASE_NO
