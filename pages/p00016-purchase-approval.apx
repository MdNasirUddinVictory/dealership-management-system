    region register (
        name: PURCHASE-REGISTER
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT M.PURCHASE_NO,
                       M.PURCHASE_CODE,
                       M.PURCHASE_DATE,
                       S.SUPPLIER_NAME,
                       (
                           SELECT SUM(D.TOTAL_AMOUNT)
                             FROM TRN_PURCHASE_DTL D
                            WHERE D.PURCHASE_NO = M.PURCHASE_NO
                       ) TOTAL_AMOUNT,
                       CASE M.APPROVAL_STATUS
                            WHEN 'P' THEN 'Pending'
                            WHEN 'A' THEN 'Approved'
                            WHEN 'R' THEN 'Rejected'
                       END APPROVAL_STATUS,
                       M.CREATED_BY,
                       M.CREATED_DATE
                FROM TRN_PURCHASE_MST M
                JOIN MST_SUPPLIER S
                  ON S.SUPPLIER_NO = M.SUPPLIER_NO
                  WHERE APPROVAL_STATUS  = 'P'
                ORDER BY M.PURCHASE_NO DESC);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
