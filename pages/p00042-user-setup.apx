    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P42_PRODUCT_NO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uom-conversion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM MST_PRODUCT_CATEGORY
                     WHERE CATEGORY_NO = :P42_CATEGORY_NO;
                
                    apex_application.g_print_success_message :=
                        'Product Category has been deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14461004415757132
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P42_PRODUCT_NO IS NULL THEN
                        INSERT INTO MST_PRODUCT (
                            PRODUCT_NO,
                            CATEGORY_NO,
                            PRODUCT_CODE,
                            PRODUCT_NAME,
                            PURCHASE_RATE,
                            SALES_RATE,
                            MIN_STOCK_QTY,
                            ACTIVE_FLAG,
                            UOM_NO,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES (
                            SEQ_PRODUCT_NO.NEXTVAL,
                            :P42_CATEGORY_NO,
                           'PRD' || LPAD(SEQ_PRODUCT_NO.NEXTVAL,4,'0'),
                            :P42_PRODUCT_NAME,
                            :P42_PURCHASE_RATE,
                            :P42_SALES_RATE,
                            :P42_MIN_STOCK_QTY,
                            :P42_ACTIVE_FLAG,
                            :P42_UOM_NO,
                            :APP_USER,
                            SYSDATE
                        );
                
                          APEX_APPLICATION.g_print_success_message :=
                            'Product has been saved successfully.';
                    ELSE
                        UPDATE MST_PRODUCT
                           SET CATEGORY_NO   = :P42_CATEGORY_NO,
                               PRODUCT_NAME  = :P42_PRODUCT_NAME,
                               PURCHASE_RATE = :P42_PURCHASE_RATE,
                               SALES_RATE    = :P42_SALES_RATE,
                               MIN_STOCK_QTY = :P42_MIN_STOCK_QTY,
                               ACTIVE_FLAG   = :P42_ACTIVE_FLAG,
                               UOM_NO        = :P42_UOM_NO,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE PRODUCT_NO    = :P42_PRODUCT_NO;
                
                         
                        APEX_APPLICATION.g_print_success_message :=
                            'Product has been updated successfully.';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14460675969757131
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process uom-conversion-save-interactive-grid-data (
        name: UOM Conversion - Save Interactive Grid Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/2/2026 11:53:28 AM (QP5 v5.388) */
                BEGIN
                    ---------------------------------------------------
                    -- PRODUCT VALIDATION
                    ---------------------------------------------------
                
                    IF :P42_PRODUCT_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001,
                                                 'Please save product information first.');
                    END IF;
                
                
                    ---------------------------------------------------
                    -- DELETE
                    ---------------------------------------------------
                    -- Delete করার সময় অন্য validation করার দরকার নেই.
                    ---------------------------------------------------
                
                    IF :APEX$ROW_STATUS = 'D'
                    THEN
                        DELETE FROM MST_UOM_CONVERSION
                              WHERE CONVERSION_NO = :CONVERSION_NO;
                
                        RETURN;
                    END IF;
                
                
                    ---------------------------------------------------
                    -- UOM VALIDATION
                    ---------------------------------------------------
                
                    IF :CONVERT_UOM_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001, 'Please select UOM.');
                    END IF;
                
                
                    ---------------------------------------------------
                    -- CONVERSION FACTOR VALIDATION
                    ---------------------------------------------------
                
                    IF NVL ( :CONVERSION_FACTOR, 0) <= 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20001,
                            'Conversion factor must be greater than zero.');
                    END IF;
                
                
                    ---------------------------------------------------
                    -- GET BASE UOM
                    ---------------------------------------------------
                
                    DECLARE
                        V_BASE_UOM   NUMBER;
                    BEGIN
                        SELECT UOM_NO
                          INTO V_BASE_UOM
                          FROM MST_PRODUCT
                         WHERE PRODUCT_NO = :P42_PRODUCT_NO;
                
                
                        ---------------------------------------------------
                        -- BASE UOM CANNOT BE CONVERSION UOM
                        ---------------------------------------------------
                
                        IF :CONVERT_UOM_NO = V_BASE_UOM
                        THEN
                            RAISE_APPLICATION_ERROR (
                                -20001,
                                'Base UOM cannot be added as conversion UOM.');
                        END IF;
                
                
                        ---------------------------------------------------
                        -- INSERT
                        ---------------------------------------------------
                
                        IF :APEX$ROW_STATUS = 'C'
                        THEN
                            DECLARE
                                V_CNT   NUMBER;
                            BEGIN
                                SELECT COUNT (*)
                                  INTO V_CNT
                                  FROM MST_UOM_CONVERSION
                                 WHERE     PRODUCT_NO = :P42_PRODUCT_NO
                                       AND CONVERT_UOM_NO = :CONVERT_UOM_NO;
                
                                IF V_CNT > 0
                                THEN
                                    RAISE_APPLICATION_ERROR (
                                        -20001,
                                        'This UOM already exists for the selected product.');
                                END IF;
                            END;
                
                
                            INSERT INTO MST_UOM_CONVERSION (CONVERSION_NO,
                                                            PRODUCT_NO,
                                                            BASE_UOM_NO,
                                                            CONVERT_UOM_NO,
                                                            CONVERSION_FACTOR,
                                                            ACTIVE_FLAG,
                                                            CREATED_BY,
                                                            CREATED_DATE)
                                 VALUES (SEQ_UOM_CONVERSION_NO.NEXTVAL,
                                         :P42_PRODUCT_NO,
                                         V_BASE_UOM,
                                         :CONVERT_UOM_NO,
                                         :CONVERSION_FACTOR,
                                         '1',
                                         :APP_USER,
                                         SYSDATE)
                              RETURNING CONVERSION_NO
                                   INTO :CONVERSION_NO;
                        ---------------------------------------------------
                        -- UPDATE
                        ---------------------------------------------------
                
                        ELSIF :APEX$ROW_STATUS = 'U'
                        THEN
                            DECLARE
                                V_CNT   NUMBER;
                            BEGIN
                                /*
                                   Check duplicate UOM excluding
                                   the current row being updated.
                                */
                
                                SELECT COUNT (*)
                                  INTO V_CNT
                                  FROM MST_UOM_CONVERSION
                                 WHERE     PRODUCT_NO = :P42_PRODUCT_NO
                                       AND CONVERT_UOM_NO = :CONVERT_UOM_NO
                                       AND CONVERSION_NO <> :CONVERSION_NO;
                
                
                                IF V_CNT > 0
                                THEN
                                    RAISE_APPLICATION_ERROR (
                                        -20001,
                                        'This UOM already exists for the selected product.');
                                END IF;
                            END;
                
                
                            UPDATE MST_UOM_CONVERSION
                               SET BASE_UOM_NO = V_BASE_UOM,
                                   CONVERT_UOM_NO = :CONVERT_UOM_NO,
                                   CONVERSION_FACTOR = :CONVERSION_FACTOR,
                                   UPDATED_BY = :APP_USER,
                                   UPDATED_DATE = SYSDATE
                             WHERE CONVERSION_NO = :CONVERSION_NO;
                        END IF;
                    EXCEPTION
                        WHEN NO_DATA_FOUND
                        THEN
                            RAISE_APPLICATION_ERROR (-20001,
                                                     'Product information not found.');
                    END;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 14460158018757128
        }
    )

)

