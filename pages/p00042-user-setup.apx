                ```sql
                select USER_NO,
                       USER_ID,
                       USER_NAME,
                       USER_PWD,
                       AUTH_TYPE,
                       ACTIVE_STAT,
                       PHOTO,
                       DONOR_NO,
                       EMAIL,
                       USER_TYPE,
                       MOBILE_NO,
                       DOB
