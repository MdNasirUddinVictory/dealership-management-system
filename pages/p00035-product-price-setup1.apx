    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    DELETE FROM MST_SALES_PRICE
                     WHERE SALES_PRICE_NO = :P35_SALES_PRICE_NO;
                
                    apex_application.g_print_success_message :=
                        'Sales price deleted successfully.';
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 15308738227803518
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-product-price-setup (
        name: Initialize form Product Price Setup
        type: formInitialization
        formRegion: @register
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15307498817803505
        }
    )

    process process-form-price-setup (
        name: Process form PRICE SETUP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_purchase_rate MST_PRODUCT.PURCHASE_RATE%TYPE;
                BEGIN
                    SELECT PURCHASE_RATE
                      INTO l_purchase_rate
                      FROM MST_PRODUCT
                     WHERE PRODUCT_NO = :P35_PRODUCT_NO;
                
                    IF :P35_SALES_RATE < l_purchase_rate THEN
                        raise_application_error(
                            -20001,
                            'Sales rate cannot be less than purchase rate.'
                        );
                    END IF;
                
                    INSERT INTO MST_SALES_PRICE (
                        SALES_PRICE_NO,
                        PRODUCT_NO,
                        UOM_NO,
                        SALES_RATE,
                        EFFECTIVE_DATE,
                        ACTIVE_FLAG,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    VALUES (
                        SEQ_SALES_PRICE.NEXTVAL,
                        :P35_PRODUCT_NO,
                        :P35_UOM_NO,
                        :P35_SALES_RATE,
                        NVL(:P35_EFFECTIVE_DATE, SYSDATE),
                        '1',
                        :APP_USER,
                        SYSDATE
                    );
                
                    apex_application.g_print_success_message :=
                        'New sales price saved successfully.';
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage:
                ```
                
                
                ```
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 15308618574803517
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process update (
        name: UPDATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  DECLARE
                    l_purchase_rate NUMBER;
                BEGIN
                    SELECT PURCHASE_RATE
                      INTO l_purchase_rate
                      FROM MST_PRODUCT
                     WHERE PRODUCT_NO = :P35_PRODUCT_NO;
                
                    IF :P35_SALES_RATE < l_purchase_rate THEN
                        raise_application_error(
                            -20001,
                            'Sales rate cannot be less than purchase rate.'
                        );
                    END IF;
                
                    
                    UPDATE MST_SALES_PRICE
                           SET PRODUCT_NO     = :P35_PRODUCT_NO,
                               UOM_NO         = :P35_UOM_NO,
                               SALES_RATE     = :P35_SALES_RATE,
                               EFFECTIVE_DATE = :P35_EFFECTIVE_DATE,
                               ACTIVE_FLAG    = :P35_ACTIVE_FLAG,
                               UPDATED_BY     = :APP_USER,
                               UPDATED_DATE   = SYSDATE
                         WHERE SALES_PRICE_NO = :P35_SALES_PRICE_NO;
                
                        apex_application.g_print_success_message :=
                            'Sales price updated successfully.';
                
                END;
                  
                  
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15308949070803520
        }
    )

)

