    pageItem P35_UOM_NO (
        type: selectList
        label {
            label: UOM
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT U.UOM_NAME AS DISPLAY_VALUE, U.UOM_NO AS RETURN_VALUE
                  FROM MST_PRODUCT P JOIN MST_UOM U ON U.UOM_NO = P.UOM_NO
                 WHERE     P.PRODUCT_NO = :P35_PRODUCT_NO
                       AND P.ACTIVE_FLAG = '1'
                       AND U.ACTIVE_FLAG = '1'
                UNION
                SELECT U.UOM_NAME AS DISPLAY_VALUE, U.UOM_NO AS RETURN_VALUE
                  FROM MST_UOM_CONVERSION C JOIN MST_UOM U ON U.UOM_NO = C.CONVERT_UOM_NO
                 WHERE     C.PRODUCT_NO = :P35_PRODUCT_NO
                       AND C.ACTIVE_FLAG = '1'
                       AND U.ACTIVE_FLAG = '1'
                ORDER BY DISPLAY_VALUE;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P35_PRODUCT_NO
            itemsToSubmit: P35_PRODUCT_NO
        }
        layout {
            sequence: 10
            region: @register
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
