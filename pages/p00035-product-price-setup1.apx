    region register (
        name: PRICE SETUP
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT sp.SALES_PRICE_NO,
                       sp.PRODUCT_NO,
                       p.PURCHASE_RATE,
                       sp.UOM_NO,
                       sp.SALES_RATE,
                       sp.EFFECTIVE_DATE,
                       sp.ACTIVE_FLAG,
                       sp.CREATED_BY,
                       sp.CREATED_DATE,
                       sp.UPDATED_BY,
                       sp.UPDATED_DATE
                  FROM MST_SALES_PRICE sp
                  JOIN MST_PRODUCT p
                    ON p.PRODUCT_NO = sp.PRODUCT_NO;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: purchase-register
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

