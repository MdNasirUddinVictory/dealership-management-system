    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function generateInvoice(orderNo){
            
                if(confirm('Generate Invoice?')){
            
                    apex.server.process(
                        'GENERATE_INVOICE',
                        {
                            x01: orderNo
                        },
                        {
                            success:function(pData){
            
                                apex.message.showPageSuccess(pData);
            
                                apex.region('sales_order_list').refresh();
            
                            }
                        }
                    );
            
                }
            }
            
