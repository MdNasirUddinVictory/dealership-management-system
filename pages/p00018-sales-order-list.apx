            // }
            
            function createGenerateInvoice(orderNo){
            
                apex.navigation.redirect(
                    'f?p=' + $v('pFlowId') +
                    ':21:' +
                    $v('pInstance') +
                    '::NO::P21_ORDER_NO:' +
