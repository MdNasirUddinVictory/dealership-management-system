    region register_1 (
        name: SALES ORDER  LIST
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    T.*,
                
                    -----------------------------------------
                    -- Invoice Status
                    -----------------------------------------
                    CASE
                        WHEN T.TOTAL_INVOICE_QTY = 0 THEN
                            '<span class="t-Badge t-Badge--warning">Pending</span>'
                
                        WHEN T.TOTAL_INVOICE_QTY < T.TOTAL_ORDER_QTY THEN
                            '<span class="t-Badge t-Badge--info">Partial Invoice</span>'
                
                        ELSE
                            '<span class="t-Badge t-Badge--success">Fully Invoiced</span>'
                    END AS INVOICE_STATUS,
                
                    -----------------------------------------
                    -- Delivery Status
                    -----------------------------------------
                    CASE
                        WHEN T.TOTAL_DELIVERY_QTY = 0 THEN
                            '<span class="t-Badge t-Badge--primary">Waiting Delivery</span>'
                
                        WHEN T.TOTAL_DELIVERY_QTY < T.TOTAL_INVOICE_QTY THEN
                            '<span class="t-Badge t-Badge--warning">Partial Delivery</span>'
                
                        ELSE
                            '<span class="t-Badge t-Badge--success">Delivered</span>'
                    END AS DELIVERY_STATUS,
                
                    -----------------------------------------
                    -- Action
                    -----------------------------------------
                    CASE
                
                        WHEN T.TOTAL_INVOICE_QTY < T.TOTAL_ORDER_QTY THEN
                
                        '<a href="f?p=&APP_ID.:21:&SESSION.::NO::'||
                        'P21_ORDER_NO,P21_INVOICE_DATE,P21_CUSTOMER_NO,P21_MOBILE_NO,P21_TOTAL_AMOUNT,P21_CUSTOMER_NAME,P21_ADDRESS:'||
                        T.ORDER_NO||','||
                        TO_CHAR(SYSDATE,'DD-MON-YYYY')||','||
                        T.CUSTOMER_NO||','||
                        T.MOBILE_NO||','||
                        T.TOTAL_AMOUNT||','||
                        T.CUSTOMER_NAME||','||
                        T.ADDRESS||
                        '" class="t-Button t-Button--success t-Button--small">
                        Create Invoice
                        </a>'
                
                        ELSE
                
                        '<a href="f?p=&APP_ID.:21:&SESSION.::NO::P21_ORDER_NO:'||
                        T.ORDER_NO||
                        '" class="t-Button t-Button--primary t-Button--small">
                        View Invoice
                        </a>'
                
                    END ACTIONS
                
                FROM
                (
                    SELECT
                
                        M.ORDER_NO,
                        M.ORDER_CODE,
                        M.ORDER_DATE,
                
                        C.CUSTOMER_NO,
                        C.CUSTOMER_NAME,
                        C.MOBILE_NO,
                        C.ADDRESS,
                
                        ---------------------------------
                        -- Order Qty
                        ---------------------------------
                        NVL
                        (
                            (
                                SELECT SUM(D.ORDER_QTY)
                                FROM TRN_SALES_ORDER_DTL D
                                WHERE D.ORDER_NO=M.ORDER_NO
                            ),
                            0
                        ) TOTAL_ORDER_QTY,
                
                        ---------------------------------
                        -- Invoice Qty
                        ---------------------------------
                        NVL
                        (
                            (
                                SELECT SUM(I.SALES_QTY)
                                FROM TRN_SALES_INVOICE_DTL I
                                JOIN TRN_SALES_INVOICE_MST IM
                                  ON IM.INVOICE_NO=I.INVOICE_NO
                                WHERE IM.ORDER_NO=M.ORDER_NO
                            ),
                            0
                        ) TOTAL_INVOICE_QTY,
                
                        ---------------------------------
                        -- Invoice Balance
                        ---------------------------------
                        NVL
                        (
                            (
                                SELECT SUM(D.ORDER_QTY)
                                FROM TRN_SALES_ORDER_DTL D
                                WHERE D.ORDER_NO=M.ORDER_NO
                            ),
                            0
                        )
                        -
                        NVL
                        (
                            (
                                SELECT SUM(I.SALES_QTY)
                                FROM TRN_SALES_INVOICE_DTL I
                                JOIN TRN_SALES_INVOICE_MST IM
                                  ON IM.INVOICE_NO=I.INVOICE_NO
                                WHERE IM.ORDER_NO=M.ORDER_NO
                            ),
                            0
                        ) INVOICE_BALANCE_QTY,
                
                        ---------------------------------
                        -- Delivery Qty
                        ---------------------------------
                        NVL
                        (
                            (
                                SELECT SUM(DD.DELIVERY_QTY)
                                FROM TRN_DELIVERY_DTL DD
                                JOIN TRN_DELIVERY_MST DM
                                  ON DM.DELIVERY_NO=DD.DELIVERY_NO
                                JOIN TRN_SALES_INVOICE_MST IM
                                  ON IM.INVOICE_NO=DM.INVOICE_NO
                                WHERE IM.ORDER_NO=M.ORDER_NO
                                AND DM.APPROVAL_STATUS='A'
                            ),
                            0
                        ) TOTAL_DELIVERY_QTY,
                
                        ---------------------------------
                        -- Delivery Balance
                        ---------------------------------
                        NVL
                        (
                            (
                                SELECT SUM(D.ORDER_QTY)
                                FROM TRN_SALES_ORDER_DTL D
                                WHERE D.ORDER_NO=M.ORDER_NO
                            ),
                            0
                        )
                        -
                        NVL
                        (
                            (
                                SELECT SUM(DD.DELIVERY_QTY)
                                FROM TRN_DELIVERY_DTL DD
                                JOIN TRN_DELIVERY_MST DM
                                  ON DM.DELIVERY_NO=DD.DELIVERY_NO
                                JOIN TRN_SALES_INVOICE_MST IM
                                  ON IM.INVOICE_NO=DM.INVOICE_NO
                                WHERE IM.ORDER_NO=M.ORDER_NO
                                AND DM.APPROVAL_STATUS='A'
                            ),
                            0
                        ) DELIVERY_BALANCE_QTY,
                
                        ---------------------------------
                        -- Amount
                        ---------------------------------
                        NVL
                        (
                            (
                                SELECT SUM(D.TOTAL_AMOUNT)
                                FROM TRN_SALES_ORDER_DTL D
                                WHERE D.ORDER_NO=M.ORDER_NO
                            ),
                            0
                        ) TOTAL_AMOUNT,
                
                        ---------------------------------
                        -- Invoice Count
                        ---------------------------------
                        (
                            SELECT COUNT(*)
                            FROM TRN_SALES_INVOICE_MST I
                            WHERE I.ORDER_NO=M.ORDER_NO
                        ) TOTAL_INVOICE,
                
                        M.CREATED_BY,
                        M.CREATED_DATE
                
                    FROM TRN_SALES_ORDER_MST M
                
                    JOIN MST_CUSTOMER C
                      ON C.CUSTOMER_NO=M.CUSTOMER_NO
                
                    
                
                ) T
                WHERE
                (
                    :P18_STATUS IS NULL
                    OR :P18_STATUS = 'ALL'
                
                    ---------------------------------------------------
                    -- Pending Invoice
                    ---------------------------------------------------
                    OR (
                        :P18_STATUS = 'P'
                        AND T.TOTAL_INVOICE_QTY = 0
                    )
                
                    ---------------------------------------------------
                    -- Partial Invoice
                    ---------------------------------------------------
                    OR (
                        :P18_STATUS = 'PI'
                        AND T.TOTAL_INVOICE_QTY > 0
                        AND T.TOTAL_INVOICE_QTY < T.TOTAL_ORDER_QTY
                    )
                
                    ---------------------------------------------------
                    -- Fully Invoiced
                    ---------------------------------------------------
                    OR (
                        :P18_STATUS = 'I'
                        AND T.TOTAL_INVOICE_QTY = T.TOTAL_ORDER_QTY
                    )
                
                    ---------------------------------------------------
                    -- Waiting Delivery
                    ---------------------------------------------------
                    -- OR (
                    --     :P18_STATUS = 'WD'
                    --     AND T.TOTAL_INVOICE_QTY > 0
                    --     AND T.TOTAL_DELIVERY_QTY = 0
                    -- )
                
                    ---------------------------------------------------
                    -- Partial Delivery
                    ---------------------------------------------------
                    OR (
                        :P18_STATUS = 'PD'
                        AND T.TOTAL_DELIVERY_QTY > 0
                        AND T.TOTAL_DELIVERY_QTY < T.TOTAL_INVOICE_QTY
                    )
                
                    ---------------------------------------------------
                    -- Delivered
                    ---------------------------------------------------
                    OR (
                        :P18_STATUS = 'D'
                        AND T.TOTAL_INVOICE_QTY > 0
                        AND T.TOTAL_DELIVERY_QTY = T.TOTAL_INVOICE_QTY
                    )
                )
                ORDER BY T.ORDER_NO DESC;
                ```
            pageItemsToSubmit: P18_STATUS
        }
