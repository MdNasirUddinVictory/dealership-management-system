    process generate-invoice (
        name: GENERATE_INVOICE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_invoice_no      NUMBER;
                    v_invoice_code    VARCHAR2(30);
                
                    v_exists          NUMBER;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Already Invoiced Check
                    --------------------------------------------------
                
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_SALES_INVOICE_MST
                     WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists > 0 THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Invoice already generated for this order.'
                        );
                
                    END IF;
                
                    --------------------------------------------------
                    -- Generate Invoice No
                    --------------------------------------------------
                
                    SELECT SEQ_INVOICE_NO.NEXTVAL
                      INTO v_invoice_no
                      FROM DUAL;
                
                    v_invoice_code :=
                        'INV-' || LPAD(v_invoice_no,6,'0');
                
                    --------------------------------------------------
                    -- Invoice Master
                    --------------------------------------------------
                
                    INSERT INTO TRN_SALES_INVOICE_MST
                    (
                        INVOICE_NO,
                        INVOICE_CODE,
                        INVOICE_DATE,
                        ORDER_NO,
                        CUSTOMER_NO,
                        TOTAL_AMOUNT,
                        DELIVERY_STATUS,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    SELECT
                        v_invoice_no,
                        v_invoice_code,
                        SYSDATE,
                        M.ORDER_NO,
                        M.CUSTOMER_NO,
                        (
                            SELECT NVL(SUM(TOTAL_AMOUNT),0)
                              FROM TRN_SALES_ORDER_DTL
                             WHERE ORDER_NO = M.ORDER_NO
                        ),
                        'P',
                        :APP_USER,
                        SYSDATE
                    FROM TRN_SALES_ORDER_MST M
                    WHERE M.ORDER_NO = APEX_APPLICATION.G_X01;
                
                    --------------------------------------------------
                    -- Invoice Detail
                    --------------------------------------------------
                
                    INSERT INTO TRN_SALES_INVOICE_DTL
                    (
                        INVOICE_DTL_NO,
                        INVOICE_NO,
                        ORDER_DTL_NO,
                        PRODUCT_NO,
                        ORDER_QTY,
                        SALES_QTY,
                        SALES_RATE,
                        TOTAL_AMOUNT
                    )
                    SELECT
                        SEQ_INVOICE_DTL_NO.NEXTVAL,
                        v_invoice_no,
                        ORDER_DTL_NO,
                        PRODUCT_NO,
                        ORDER_QTY,
                        ORDER_QTY,
                        SALES_RATE,
                        TOTAL_AMOUNT
                    FROM TRN_SALES_ORDER_DTL
                    WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    --------------------------------------------------
                    -- Update Order Detail
                    --------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_DTL
                       SET INVOICED_QTY =
                               NVL(INVOICED_QTY,0)
                               + ORDER_QTY,
                
                           BALANCE_QTY =
                               ORDER_QTY -
                               (
                                   NVL(INVOICED_QTY,0)
                                   + ORDER_QTY
                               ),
                
                           UPDATED_BY = :APP_USER,
                           UPDATED_DATE = SYSDATE
                
                     WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    --------------------------------------------------
                    -- Update Order Master
                    --------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_MST
                       SET ORDER_STATUS = 'I',
                           UPDATED_BY   = :APP_USER,
                           UPDATED_DATE = SYSDATE
                     WHERE ORDER_NO = APEX_APPLICATION.G_X01;
                
                    COMMIT;
                
                    HTP.P(
                        'Invoice generated successfully. Invoice No: '
                        || v_invoice_code
                    );
                
                EXCEPTION
                    WHEN OTHERS THEN
                
                        ROLLBACK;
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            SQLERRM
                        );
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 8748510857168297125
        }
    )

)

