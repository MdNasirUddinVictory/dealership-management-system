    region customer-return-detail (
        name: CUSTOMER RETURN DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                    SELECT
                
                           D.RETURN_DTL_NO,
                
                           D.INVOICE_DTL_NO,
                
                           D.ORDER_DTL_NO,
                
                           D.PRODUCT_NO,
                
                           P.PRODUCT_CODE,
                
                           P.PRODUCT_NAME,
                
                           P.DESCRIPTION,
                
                           P.BRAND_NO,
                
                           D.UOM_NO,
                
                           U.UOM_NAME,
                
                           D.PACK_QTY,
                
                           D.BASE_QTY,
                
                           D.BASE_RATE,
                
                           D.INVOICE_QTY,
                
                           D.PREVIOUS_RETURN_QTY,
                
                           D.BALANCE_QTY,
                
                           D.RETURN_QTY,
                
                           D.SALES_RATE,
                
                           D.TOTAL_AMOUNT,
                
                           D.REMARKS,
                
                           CASE
                               WHEN M.APPROVAL_STATUS = 'A'
                               THEN 'X'
                               ELSE 'U'
                           END ROW_STATUS
                
                    FROM TRN_CUSTOMER_RETURN_DTL D
                
                         JOIN TRN_CUSTOMER_RETURN_MST M
                           ON M.RETURN_NO = D.RETURN_NO
                
                         JOIN MST_PRODUCT P
                           ON P.PRODUCT_NO = D.PRODUCT_NO
                
                         LEFT JOIN MST_UOM U
                           ON U.UOM_NO = D.UOM_NO
                
                    WHERE D.RETURN_NO = :P102_RETURN_NO
                    
                ORDER BY RETURN_DTL_NO
                );
                ```
            pageItemsToSubmit: [
                P102_RETURN_NO
                P102_INVOICE_NO
            ]
        }
