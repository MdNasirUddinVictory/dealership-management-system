    region register_1 (
        name: CUSTOMER RETURN MST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RETURN_NO,
                       RETURN_CODE,
                       RETURN_DATE,
                       INVOICE_NO,
                       CUSTOMER_NO,
                       RETURN_REASON,
                       APPROVAL_STATUS,
                       APPROVED_BY,
                       APPROVED_DATE,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE,
                       VOUCHER_NO
                  from TRN_CUSTOMER_RETURN_MST
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
