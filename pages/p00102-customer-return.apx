    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P102_INVOICE_NO
        }

        action native-set-value (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT I.CUSTOMER_NO ,
                           C.CUSTOMER_NAME,
                           C.MOBILE_NO,
                           I.INVOICE_DATE,
                           I.CREATED_DATE,
                           I.TOTAL_AMOUNT into :P102_CUSTOMER_NO,:P102_CUSTOMER_NAME,:P102_MOBILE_NO,:P102_DELIVERY_DATE,:P102_INVOICE_DATE,:P102_INVOICE_AMOUNT
                    FROM TRN_SALES_INVOICE_MST I
                    JOIN MST_CUSTOMER C
                      ON C.CUSTOMER_NO = I.CUSTOMER_NO
                    WHERE I.INVOICE_NO = :P102_INVOICE_NO;
                    ```
                itemsToSubmit: P102_INVOICE_NO
                itemsToReturn: [
                    P102_CUSTOMER_NAME
                    P102_MOBILE_NO
                    P102_INVOICE_DATE
                    P102_INVOICE_AMOUNT
                    P102_CUSTOMER_NO
                    P102_DELIVERY_DATE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new_1 (
        name: Return quantity exceeds balance quantity
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @customer-return-detail
            columns: RETURN_QTY
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.clearErrors();
                    
                    var returnQty  = parseFloat($v("RETURN_QTY")) || 0;
                    var balanceQty = parseFloat($v("BALANCE_QTY")) || 0;
                    var salesRate  = parseFloat($v("SALES_RATE")) || 0;
                    var packQty    = parseFloat($v("PACK_QTY")) || 1;
                    
                    if (packQty <= 0) {
                        packQty = 1;
                    }
                    
                    if (returnQty > balanceQty) {
                    
                        apex.message.alert("Return quantity exceeds balance quantity.");
                    
                        $s("RETURN_QTY", "");
                        $s("BASE_QTY", "");
                        $s("BASE_RATE", "");
                        $s("TOTAL_AMOUNT", "");
                    
                        return;
                    }
                    
                    /* Calculate */
                    
                    var baseQty  = returnQty * packQty;
                    var baseRate = salesRate / packQty;
                    var totalAmt = returnQty * salesRate;
                    
                    $s("BASE_QTY", baseQty.toFixed(3));
                    $s("BASE_RATE", baseRate.toFixed(6));
                    $s("TOTAL_AMOUNT", totalAmt.toFixed(2));
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

