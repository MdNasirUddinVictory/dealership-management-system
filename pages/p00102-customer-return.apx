        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    var $ = apex.jQuery;
                    var toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                
                    // actions2 remove করো
                    toolbarData.toolbarRemove("actions2");
                    toolbarData.toolbarRemove("actions3");
                
                    // actions1 group খুঁজে button add করো
                    var toolbarGroup = toolbarData.toolbarFind("actions1");
                
                    // Add button লুকাও
                    // toolbarGroup.controls = toolbarGroup.controls.filter(function(ctrl) {
                    //     return ctrl.id !== "add";  // Add Row button hide
                    // });
                
                    // Populate button যোগ করো
                    toolbarGroup.controls.push({
                        type: "BUTTON",
                        id: "btn_populate",
                        label: "Populate",
                        hot: true,
                        iconCss: "a-Icon icon-ig-download",
                        iconBeforeLabel: true,
                        action: "populate-action"
                    });
                
                    config.toolbarData = toolbarData;
                
                    var originalInitActions = config.initActions;
                    config.initActions = function(actions) {
                        if (originalInitActions) {
                            originalInitActions.call(this, actions);
                        }
                        actions.add({
                            name: "populate-action",
                            label: "Populate",
                            action: function() {
                                populate();
                            }
                        });
                    };
                
                    return config;
                }
                ```
        }
