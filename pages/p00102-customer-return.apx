    process process-form-customer-return-mst (
        name: Process form CUSTOMER RETURN MST
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_status VARCHAR2(1);
                
                BEGIN
                
                    --------------------------------------------------
                    -- Invoice Validation
                    --------------------------------------------------
                    IF :P102_INVOICE_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select an invoice.'
                        );
                    END IF;
                
                    --------------------------------------------------
                    -- Return Date Validation
                    --------------------------------------------------
                    IF :P102_RETURN_DATE IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please enter return date.'
                        );
                    END IF;
                
                    --------------------------------------------------
                    -- Update Validation
                    --------------------------------------------------
                    IF :P102_RETURN_NO IS NOT NULL THEN
                
                        SELECT APPROVAL_STATUS
                          INTO v_status
                          FROM TRN_CUSTOMER_RETURN_MST
                         WHERE RETURN_NO = :P102_RETURN_NO;
                
                        IF v_status <> 'P' THEN
                
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Only pending return can be modified.'
                            );
                
                        END IF;
                
                    END IF;
                
                    --------------------------------------------------
                    -- Insert
                    --------------------------------------------------
                    IF :P102_RETURN_NO IS NULL THEN
                
                        :P102_RETURN_NO := SEQ_RETURN_NO.NEXTVAL;
                
                        INSERT INTO TRN_CUSTOMER_RETURN_MST
                        (
                            RETURN_NO,
                            RETURN_CODE,
                            RETURN_DATE,
                            INVOICE_NO,
                            CUSTOMER_NO,
                            RETURN_REASON,
                            APPROVAL_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            :P102_RETURN_NO,
                            'RET-' || LPAD(:P102_RETURN_NO,6,'0'),
                            :P102_RETURN_DATE,
                            :P102_INVOICE_NO,
                            :P102_CUSTOMER_NO,
                            :P102_RETURN_REASON,
                            'P',
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Customer Return saved successfully.';
                
                    --------------------------------------------------
                    -- Update
                    --------------------------------------------------
                    ELSE
                
                        UPDATE TRN_CUSTOMER_RETURN_MST
                           SET RETURN_DATE   = :P102_RETURN_DATE,
                               INVOICE_NO    = :P102_INVOICE_NO,
                               CUSTOMER_NO   = :P102_CUSTOMER_NO,
                               RETURN_REASON = :P102_RETURN_REASON,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE RETURN_NO = :P102_RETURN_NO;
                
                        apex_application.g_print_success_message :=
                            'Customer Return updated successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9054123658283761037
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process return-populate (
        name: RETURN_POPULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_DATA CLOB;
                BEGIN
                
                    SELECT JSON_ARRAYAGG
                           (
                               JSON_OBJECT(
                
                                   'INVOICE_DTL_NO' VALUE D.INVOICE_DTL_NO,
                
                                   'ORDER_DTL_NO' VALUE D.ORDER_DTL_NO,
                
                                   'PRODUCT_NO' VALUE D.PRODUCT_NO,
                
                                   'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                
                                   'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                
                                   'DESCRIPTION' VALUE P.DESCRIPTION,
                
                                   'BRAND_NO' VALUE P.BRAND_NO,
                
                                   'UOM_NO' VALUE D.UOM_NO,
                
                                   'PACK_QTY' VALUE D.PACK_QTY,
                
                                   'BASE_QTY' VALUE D.BASE_QTY,
                
                                   'BASE_RATE' VALUE D.BASE_RATE,
                
                                   'INVOICE_QTY' VALUE D.SALES_QTY,
                
                                   'PREVIOUS_RETURN_QTY'
                                       VALUE NVL
                                       (
                                           (
                                               SELECT SUM(R.RETURN_QTY)
                                                 FROM TRN_CUSTOMER_RETURN_DTL R
                                                 JOIN TRN_CUSTOMER_RETURN_MST M
                                                   ON M.RETURN_NO = R.RETURN_NO
                                                WHERE R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                                                  AND M.APPROVAL_STATUS = 'A'
                                           ),
                                           0
                                       ),
                
                                   'BALANCE_QTY'
                                       VALUE
                                       D.SALES_QTY
                                       -
                                       NVL
                                       (
                                           (
                                               SELECT SUM(R.RETURN_QTY)
                                                 FROM TRN_CUSTOMER_RETURN_DTL R
                                                 JOIN TRN_CUSTOMER_RETURN_MST M
                                                   ON M.RETURN_NO = R.RETURN_NO
                                                WHERE R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                                                  AND M.APPROVAL_STATUS = 'A'
                                           ),
                                           0
                                       ),
                
                                   'RETURN_QTY'
                                       VALUE
                                       D.SALES_QTY
                                       -
                                       NVL
                                       (
                                           (
                                               SELECT SUM(R.RETURN_QTY)
                                                 FROM TRN_CUSTOMER_RETURN_DTL R
                                                 JOIN TRN_CUSTOMER_RETURN_MST M
                                                   ON M.RETURN_NO = R.RETURN_NO
                                                WHERE R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                                                  AND M.APPROVAL_STATUS = 'A'
                                           ),
                                           0
                                       ),
                
                                   'SALES_RATE' VALUE D.SALES_RATE,
                
                                   'TOTAL_AMOUNT'
                                       VALUE
                                       (
                                           D.SALES_QTY
                                           -
                                           NVL
                                           (
                                               (
                                                   SELECT SUM(R.RETURN_QTY)
                                                     FROM TRN_CUSTOMER_RETURN_DTL R
                                                     JOIN TRN_CUSTOMER_RETURN_MST M
                                                       ON M.RETURN_NO = R.RETURN_NO
                                                    WHERE R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                                                      AND M.APPROVAL_STATUS = 'A'
                                               ),
                                               0
                                           )
                                       )
                                       * D.SALES_RATE
                
                               )
                               RETURNING CLOB
                           )
                    INTO V_DATA
                    FROM TRN_SALES_INVOICE_DTL D
                         JOIN MST_PRODUCT P
                           ON P.PRODUCT_NO = D.PRODUCT_NO
                    WHERE D.INVOICE_NO = APEX_APPLICATION.G_X01
                      AND D.SALES_QTY >
                          NVL
                          (
                              (
                                  SELECT SUM(R.RETURN_QTY)
                                    FROM TRN_CUSTOMER_RETURN_DTL R
                                    JOIN TRN_CUSTOMER_RETURN_MST M
                                      ON M.RETURN_NO = R.RETURN_NO
                                   WHERE R.INVOICE_DTL_NO = D.INVOICE_DTL_NO
                                     AND M.APPROVAL_STATUS = 'A'
                              ),
                              0
                          );
                
                    HTP.PRN(NVL(V_DATA,'[]'));
                
                EXCEPTION
                    WHEN OTHERS THEN
                        HTP.PRN('[]');
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 11193744412514922921
        }
    )

)

