    process customer-return-detail-save-interactive-grid-data (
        name: CUSTOMER RETURN DETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @customer-return-detail
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_count NUMBER;
                BEGIN
                
                    -------------------------------------------------
                    -- Header Validation
                    -------------------------------------------------
                    IF :P102_RETURN_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please save Return Master first.'
                        );
                    END IF;
                
                    -------------------------------------------------
                    -- Product Validation
                    -------------------------------------------------
                    IF :PRODUCT_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Product is required.'
                        );
                    END IF;
                
                    -------------------------------------------------
                    -- Return Qty Validation
                    -------------------------------------------------
                    IF NVL(:RETURN_QTY,0) <= 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Return quantity must be greater than zero.'
                        );
                    END IF;
                
                    -------------------------------------------------
                    -- Balance Validation
                    -------------------------------------------------
                    IF NVL(:RETURN_QTY,0) > NVL(:BALANCE_QTY,0) THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Return quantity exceeds balance quantity.'
                        );
                    END IF;
                
                    -------------------------------------------------
                    -- Duplicate Product Validation
                    -------------------------------------------------
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        SELECT COUNT(*)
                          INTO v_count
                          FROM TRN_CUSTOMER_RETURN_DTL
                         WHERE RETURN_NO  = :P102_RETURN_NO
                           AND PRODUCT_NO = :PRODUCT_NO;
                
                        IF v_count > 0 THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Product already exists.'
                            );
                        END IF;
                
                    END IF;
                
                    -------------------------------------------------
                    -- Approved Return Validation
                    -------------------------------------------------
                    IF :APEX$ROW_STATUS IN ('U','D') THEN
                
                        SELECT COUNT(*)
                          INTO v_count
                          FROM TRN_CUSTOMER_RETURN_MST
                         WHERE RETURN_NO = :P102_RETURN_NO
                           AND APPROVAL_STATUS = 'A';
                
                        IF v_count > 0 THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Approved return cannot be modified.'
                            );
                        END IF;
                
                    END IF;
                
                    -------------------------------------------------
                    -- INSERT
                    -------------------------------------------------
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        INSERT INTO TRN_CUSTOMER_RETURN_DTL
                        (
                            RETURN_DTL_NO,
                            RETURN_NO,
                            PRODUCT_NO,
                            INVOICE_DTL_NO,
                            ORDER_DTL_NO,
                            UOM_NO,
                            PACK_QTY,
                            BASE_QTY,
                            BASE_RATE,
                            INVOICE_QTY,
                            PREVIOUS_RETURN_QTY,
                            BALANCE_QTY,
                            RETURN_QTY,
                            SALES_RATE,
                            TOTAL_AMOUNT,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_RETURN_DTL_NO.NEXTVAL,
                            :P102_RETURN_NO,
                            :PRODUCT_NO,
                            :INVOICE_DTL_NO,
                            :ORDER_DTL_NO,
                            :UOM_NO,
                            :PACK_QTY,
                            :BASE_QTY,
                            :BASE_RATE,
                            :INVOICE_QTY,
                            :PREVIOUS_RETURN_QTY,
                            :BALANCE_QTY,
                            :RETURN_QTY,
                            :SALES_RATE,
                            NVL(:RETURN_QTY,0) * NVL(:SALES_RATE,0),
                            :REMARKS,
                            :APP_USER,
                            SYSDATE
                        )
                        RETURNING RETURN_DTL_NO
                        INTO :RETURN_DTL_NO;
                
                    -------------------------------------------------
                    -- UPDATE
                    -------------------------------------------------
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        UPDATE TRN_CUSTOMER_RETURN_DTL
                           SET RETURN_QTY   = :RETURN_QTY,
                               SALES_RATE   = :SALES_RATE,
                               TOTAL_AMOUNT = NVL(:RETURN_QTY,0) * NVL(:SALES_RATE,0),
                               REMARKS      = :REMARKS,
                               UPDATED_BY   = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE RETURN_DTL_NO = :RETURN_DTL_NO;
                
                    -------------------------------------------------
                    -- DELETE
                    -------------------------------------------------
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        DELETE
                          FROM TRN_CUSTOMER_RETURN_DTL
                         WHERE RETURN_DTL_NO = :RETURN_DTL_NO;
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 9054124808534761049
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process delete-return (
        name: DELETE RETURN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_status VARCHAR2(1);
                BEGIN
                
                    SELECT APPROVAL_STATUS
                      INTO v_status
                      FROM TRN_CUSTOMER_RETURN_MST
                     WHERE RETURN_NO = :P102_RETURN_NO;
                
                    IF v_status <> 'P' THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Approved return cannot be deleted.'
                        );
                
                    END IF;
                
                    DELETE FROM TRN_CUSTOMER_RETURN_DTL
                     WHERE RETURN_NO = :P102_RETURN_NO;
                
                    DELETE FROM TRN_CUSTOMER_RETURN_MST
                     WHERE RETURN_NO = :P102_RETURN_NO;
                
                    apex_application.g_print_success_message :=
                        'Customer return deleted successfully.';
                
                        :P102_RETURN_NO := NULL;
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 11193746980423922946
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

