page 102 (
    name: Customer Return
    alias: CUSTOMER-RETURN
    title: Customer Return
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function populate() {
            
                if (!$v('P102_INVOICE_NO')) {
                    apex.message.alert('Please Select Invoice !');
                    return;
                }
            
                var model = apex.region("customer-return")
                    .widget()
                    .interactiveGrid("getViews", "grid")
                    .model;
            
                // Grid already contains data
                if (model.getTotalRecords() > 0) {
                    apex.message.alert('Return details already exist.');
                    return;
                }
            
                apex.server.process(
                    'RETURN_POPULATE',
                    {
                        x01: $v('P102_INVOICE_NO')
                    },
                    {
                        success: function (pData) {
            
                            var json = JSON.parse(pData);
            
                            if (!json || json.length === 0) {
                                apex.message.alert(
                                    'No balance quantity available for customer return.'
                                );
                                return;
                            }
            
                            for (var key in json) {
            
                                if (json.hasOwnProperty(key)) {
            
                                    var rec = model.insertNewRecord();
            
                                    if (json[key].INVOICE_DTL_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "INVOICE_DTL_NO",
                                            json[key].INVOICE_DTL_NO.toString()
                                        );
                                    }
            
                                    if (json[key].ORDER_DTL_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "ORDER_DTL_NO",
                                            json[key].ORDER_DTL_NO.toString()
                                        );
                                    }
            
                                    if (json[key].PRODUCT_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "PRODUCT_NO",
                                            json[key].PRODUCT_NO.toString()
                                        );
                                    }
            
                                    if (json[key].PRODUCT_CODE) {
                                        model.setRecordValue(
                                            rec,
                                            "PRODUCT_CODE",
                                            json[key].PRODUCT_CODE
                                        );
                                    }
            
                                    if (json[key].PRODUCT_NAME) {
                                        model.setRecordValue(
                                            rec,
                                            "PRODUCT_NAME",
                                            json[key].PRODUCT_NAME
                                        );
                                    }
            
                                    // -------- NEW COLUMN --------
            
                                    if (json[key].DESCRIPTION) {
                                        model.setRecordValue(
                                            rec,
                                            "DESCRIPTION",
                                            json[key].DESCRIPTION
                                        );
                                    }
            
                                    if (json[key].BRAND_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "BRAND_NO",
                                            json[key].BRAND_NO.toString()
                                        );
                                    }
            
                                    if (json[key].UOM_NO) {
                                        model.setRecordValue(
                                            rec,
                                            "UOM_NO",
                                            json[key].UOM_NO.toString()
                                        );
                                    }
            
                                    if (json[key].PACK_QTY !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "PACK_QTY",
                                            json[key].PACK_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].BASE_QTY !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "BASE_QTY",
                                            json[key].BASE_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].BASE_RATE !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "BASE_RATE",
                                            json[key].BASE_RATE.toString()
                                        );
                                    }
            
                                    // ----------------------------
            
                                    if (json[key].INVOICE_QTY !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "INVOICE_QTY",
                                            json[key].INVOICE_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].PREVIOUS_RETURN_QTY !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "PREVIOUS_RETURN_QTY",
                                            json[key].PREVIOUS_RETURN_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].BALANCE_QTY !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "BALANCE_QTY",
                                            json[key].BALANCE_QTY.toString()
                                        );
                                    }
            
                                    if (json[key].SALES_RATE !== undefined) {
                                        model.setRecordValue(
                                            rec,
                                            "SALES_RATE",
                                            json[key].SALES_RATE.toString()
                                        );
                                    }
            
                                    // Default Value
                                    model.setRecordValue(rec, "RETURN_QTY", "0");
                                    model.setRecordValue(rec, "TOTAL_AMOUNT", "0");
                                }
                            }
            
                            apex.message.showPageSuccess(
                                json.length + " item(s) loaded successfully."
                            );
                        },
            
                        error: function () {
                            apex.message.alert("Error while loading return data.");
                        },
            
                        dataType: "text"
                    }
                );
            }
            ```
    }
    css {
        inline:
            ```css
            .return-customer-card{
                background:#ffffff;
                border-radius:12px;
                overflow:hidden;
                box-shadow:0 2px 10px rgba(0,0,0,.08);
                border:1px solid #e5e7eb;
                margin-bottom:15px;
            }
            
            .return-customer-card .card-header{
                background:linear-gradient(135deg,#1e40af,#2563eb);
                color:#fff;
                padding:14px 20px;
                font-size:18px;
                font-weight:600;
            }
            
            .return-customer-card .card-body{
                padding:18px;
            }
            
            .return-customer-card .info-row{
                display:flex;
                gap:15px;
                margin-bottom:15px;
                flex-wrap:wrap;
            }
            
            .return-customer-card .info-box{
                flex:1;
                min-width:180px;
                background:#f8fafc;
                border:1px solid #e2e8f0;
                border-radius:8px;
                padding:12px;
            }
            
            .return-customer-card .info-box.large{
                flex:2;
            }
            
            .return-customer-card .info-box.full{
                width:100%;
            }
            
            .return-customer-card label{
                display:block;
                color:#64748b;
                font-size:11px;
                text-transform:uppercase;
                letter-spacing:.5px;
                margin-bottom:5px;
                font-weight:600;
            }
            
            .return-customer-card span{
                color:#0f172a;
                font-size:15px;
                font-weight:600;
            }
            
            .return-customer-card .amount{
                color:#16a34a;
                font-size:18px;
                font-weight:700;
            }
            ```
