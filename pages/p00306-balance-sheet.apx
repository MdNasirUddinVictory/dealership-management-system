    region voucher-mst_1 (
        name: Balance Sheet
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH ACCOUNT_TOTAL AS
                (
                    SELECT
                           H.ACCOUNT_TYPE,
                
                           SUM(
                               CASE
                                   WHEN H.ACCOUNT_TYPE = 'A'
                                   THEN NVL(D.DEBIT_AMOUNT,0)
                                      - NVL(D.CREDIT_AMOUNT,0)
                
                                   WHEN H.ACCOUNT_TYPE IN ('L','C')
                                   THEN NVL(D.CREDIT_AMOUNT,0)
                                      - NVL(D.DEBIT_AMOUNT,0)
                
                                   ELSE 0
                               END
                           ) AS AMOUNT
                
                    FROM MST_ACCOUNT_HEAD H
                    JOIN ACC_VOUCHER_DTL D
                      ON D.ACCOUNT_NO = H.ACCOUNT_NO
                    JOIN ACC_VOUCHER_MST M
                      ON M.VOUCHER_NO = D.VOUCHER_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                      AND M.APPROVAL_STATUS = 'A'
                      AND M.VOUCHER_DATE <= :P311_AS_OF_DATE
                
                    GROUP BY H.ACCOUNT_TYPE
                ),
                
                TOTALS AS
                (
                    SELECT
                        NVL(SUM(CASE WHEN ACCOUNT_TYPE = 'A'
                                     THEN AMOUNT ELSE 0 END),0) AS TOTAL_ASSETS,
                
                        NVL(SUM(CASE WHEN ACCOUNT_TYPE = 'L'
                                     THEN AMOUNT ELSE 0 END),0) AS TOTAL_LIABILITIES,
                
                        NVL(SUM(CASE WHEN ACCOUNT_TYPE = 'C'
                                     THEN AMOUNT ELSE 0 END),0) AS TOTAL_CAPITAL
                
                    FROM ACCOUNT_TOTAL
                ),
                
                PROFIT AS
                (
                    SELECT
                        NVL(
                            SUM(
                                CASE
                                    WHEN H.ACCOUNT_TYPE = 'I'
                                    THEN NVL(D.CREDIT_AMOUNT,0)
                                       - NVL(D.DEBIT_AMOUNT,0)
                
                                    WHEN H.ACCOUNT_TYPE = 'E'
                                    THEN NVL(D.DEBIT_AMOUNT,0)
                                       - NVL(D.CREDIT_AMOUNT,0)
                
                                    ELSE 0
                                END
                            ),
                            0
                        ) AS NET_PROFIT
                
                    FROM MST_ACCOUNT_HEAD H
                    JOIN ACC_VOUCHER_DTL D
                      ON D.ACCOUNT_NO = H.ACCOUNT_NO
                    JOIN ACC_VOUCHER_MST M
                      ON M.VOUCHER_NO = D.VOUCHER_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                      AND H.ACCOUNT_TYPE IN ('I','E')
                      AND M.APPROVAL_STATUS = 'A'
                      AND M.VOUCHER_DATE <= :P311_AS_OF_DATE
                )
                
                SELECT
                       'Total Assets' AS PARTICULARS,
                       T.TOTAL_ASSETS AS AMOUNT,
                       NULL AS BALANCE_STATUS
                FROM TOTALS T
                
                UNION ALL
                
                SELECT
                       'Total Liabilities',
                       T.TOTAL_LIABILITIES,
                       NULL
                FROM TOTALS T
                
                UNION ALL
                
                SELECT
                       'Capital',
                       T.TOTAL_CAPITAL,
                       NULL
                FROM TOTALS T
                
                UNION ALL
                
                SELECT
                       'Current Period Profit / (Loss)',
                       P.NET_PROFIT,
                       NULL
                FROM PROFIT P
                
                UNION ALL
                
                SELECT
                       'Total Liabilities + Equity',
                       T.TOTAL_LIABILITIES
                       + T.TOTAL_CAPITAL
                       + P.NET_PROFIT,
                       NULL
                FROM TOTALS T
                CROSS JOIN PROFIT P
                
                UNION ALL
                
                SELECT
                       'Balance Status',
                       NULL,
                       CASE
                           WHEN ROUND(T.TOTAL_ASSETS,2)
                              =
                                ROUND(
                                    T.TOTAL_LIABILITIES
                                  + T.TOTAL_CAPITAL
                                  + P.NET_PROFIT,
                                  2
                                )
                           THEN 'Balanced'
                           ELSE 'Not Balanced'
                       END
                FROM TOTALS T
                CROSS JOIN PROFIT P;
                ```
            pageItemsToSubmit: P311_AS_OF_DATE
        }
        layout {
            sequence: 70
            slot: body
