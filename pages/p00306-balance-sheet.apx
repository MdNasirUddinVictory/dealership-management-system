            ```javascript-browser
            function openVoucher(pVoucherNo, pvoucherCode, pVoucherType, pVoucherDate, pNarattion) {
                $s('P304_VOUCHER_NO', pVoucherNo);
                $s('P306_VOUCHER_CODE_DISPLAY', pvoucherCode);
                $s('P306_VOUCHER_TYPE_DISPLAY', pVoucherType);
                $s('P306_VOUCHER_DATE_DISPLAY', pVoucherDate);
                $s('P306_NARRATION_DISPLAY', pNarattion);
                apex.region('vioucherViewDtl').refresh();
                openModal('vioucherView');
            
            
            }
            ```
