    region voucher-mst (
        name: Balance Sheet
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH ACCOUNT_BALANCE AS
                (
                    SELECT
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE,
                
                           NVL(SUM(D.DEBIT_AMOUNT), 0)  AS DEBIT_AMOUNT,
                           NVL(SUM(D.CREDIT_AMOUNT), 0) AS CREDIT_AMOUNT
                
                    FROM MST_ACCOUNT_HEAD H
                
                    JOIN ACC_VOUCHER_DTL D
                      ON D.ACCOUNT_NO = H.ACCOUNT_NO
                
                    JOIN ACC_VOUCHER_MST M
                      ON M.VOUCHER_NO = D.VOUCHER_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                      AND M.APPROVAL_STATUS = 'A'
                      AND M.VOUCHER_DATE <= :P311_AS_OF_DATE
                
                    GROUP BY
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE
                ),
                
                BALANCE_SHEET AS
                (
                    SELECT
                           ACCOUNT_NO,
                           ACCOUNT_CODE,
                           ACCOUNT_NAME,
                           ACCOUNT_TYPE,
                
                           CASE
                               WHEN ACCOUNT_TYPE = 'A'
                               THEN DEBIT_AMOUNT - CREDIT_AMOUNT
                
                               WHEN ACCOUNT_TYPE IN ('L','C')
                               THEN CREDIT_AMOUNT - DEBIT_AMOUNT
                           END AS AMOUNT,
                
                           CASE
                               WHEN ACCOUNT_TYPE = 'A'
                               THEN 'Assets'
                
                               WHEN ACCOUNT_TYPE = 'L'
                               THEN 'Liabilities'
                
                               WHEN ACCOUNT_TYPE = 'C'
                               THEN 'Equity'
                           END AS ACCOUNT_GROUP
                
                    FROM ACCOUNT_BALANCE
                
                    WHERE ACCOUNT_TYPE IN ('A','L','C')
                ),
                
                PROFIT_LOSS AS
                (
                    SELECT
                           NVL(
                               SUM(
                                   CASE
                                       WHEN ACCOUNT_TYPE = 'I'
                                       THEN CREDIT_AMOUNT - DEBIT_AMOUNT
                
                                       WHEN ACCOUNT_TYPE = 'E'
                                       THEN -(DEBIT_AMOUNT - CREDIT_AMOUNT)
                
                                       ELSE 0
                                   END
                               ),
                               0
                           ) AS NET_PROFIT
                
                    FROM ACCOUNT_BALANCE
                
                    WHERE ACCOUNT_TYPE IN ('I','E')
                )
                
                SELECT
                       ACCOUNT_GROUP,
                       ACCOUNT_CODE,
                       ACCOUNT_NAME,
                       AMOUNT
                
                FROM
                (
                    --------------------------------------------------
                    -- Assets / Liabilities / Equity Accounts
                    --------------------------------------------------
                
                    SELECT
                           ACCOUNT_GROUP,
                           ACCOUNT_CODE,
                           ACCOUNT_NAME,
                           AMOUNT
                
                    FROM BALANCE_SHEET
                
                    WHERE NVL(AMOUNT,0) <> 0
                
                    UNION ALL
                
                    --------------------------------------------------
                    -- Current Period Profit
                    --------------------------------------------------
                
                    SELECT
                           'Equity'        AS ACCOUNT_GROUP,
                           NULL            AS ACCOUNT_CODE,
                           'Current Period Profit' AS ACCOUNT_NAME,
                           NET_PROFIT      AS AMOUNT
                
                    FROM PROFIT_LOSS
                
                    WHERE NET_PROFIT > 0
                
                    UNION ALL
                
                    --------------------------------------------------
                    -- Current Period Loss
                    --------------------------------------------------
                
                    SELECT
                           'Equity',
                           NULL,
                           'Current Period Loss',
                           ABS(NET_PROFIT)
                
                    FROM PROFIT_LOSS
                
                    WHERE NET_PROFIT < 0
                )
                
                ORDER BY
                       CASE ACCOUNT_GROUP
                           WHEN 'Assets'      THEN 1
                           WHEN 'Liabilities' THEN 2
                           WHEN 'Equity'      THEN 3
                       END,
                       ACCOUNT_CODE;
                ```
            pageItemsToSubmit: P311_AS_OF_DATE
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
