    process debit-and-credit-amount-must-be-equal (
        name: Debit and Credit amount must be equal.
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_dr NUMBER;
                    v_cr NUMBER;
                
                BEGIN
                
                    SELECT NVL(SUM(DEBIT_AMOUNT),0),
                           NVL(SUM(CREDIT_AMOUNT),0)
                      INTO v_dr,
                           v_cr
                      FROM ACC_VOUCHER_DTL
                     WHERE VOUCHER_NO =
                           :P306_VOUCHER_NO;
                
                    IF v_dr <> v_cr THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Debit and Credit amount must be equal.'
                        );
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 10931808232549085
        }
    )

    process process-form-voucher-mst (
        name: Process form VOUCHER MST
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_code VARCHAR2(30);
                
                BEGIN
                
                    IF :P306_VOUCHER_DATE IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please enter voucher date.'
                        );
                    END IF;
                
                    IF :P306_VOUCHER_TYPE IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select voucher type.'
                        );
                    END IF;
                
                    --------------------------------------------------
                    -- INSERT
                    --------------------------------------------------
                
                    IF :P306_VOUCHER_NO IS NULL THEN
                
                        :P306_VOUCHER_NO :=
                            SEQ_VOUCHER_NO.NEXTVAL;
                
                        v_code :=
                            :P306_VOUCHER_TYPE
                            || '-'
                            || LPAD(:P306_VOUCHER_NO,6,'0');
                
                        INSERT INTO ACC_VOUCHER_MST
                        (
                            VOUCHER_NO,
                            VOUCHER_CODE,
                            VOUCHER_DATE,
                            VOUCHER_TYPE,
                            NARRATION,
                            APPROVAL_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            :P306_VOUCHER_NO,
                            v_code,
                            :P306_VOUCHER_DATE,
                            :P306_VOUCHER_TYPE,
                            :P306_NARRATION,
                            'P',
                            :APP_USER,
                            SYSDATE
                        ) RETURNING VOUCHER_NO INTO :P306_VOUCHER_NO ;
                
                    --------------------------------------------------
                    -- UPDATE
                    --------------------------------------------------
                
                    ELSE
                
                        UPDATE ACC_VOUCHER_MST
                           SET VOUCHER_DATE = :P306_VOUCHER_DATE,
                               VOUCHER_TYPE = :P306_VOUCHER_TYPE,
                               NARRATION    = :P306_NARRATION,
                               UPDATED_BY   = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE VOUCHER_NO = :P306_VOUCHER_NO;
                
                    END IF;
                
                    apex_application.g_print_success_message :=
                        'Voucher saved successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10931455749549085
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

