        }
    )

    region order-summery (
        name: PURCHASE SUMMERY
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/30/2026 6:21:47 PM (QP5 v5.388) */
                DECLARE
                    l_html            CLOB := '';
                
                    l_purchase_code   VARCHAR2 (100);
                    l_purchase_date   DATE;
                    l_supplier_name   VARCHAR2 (300);
                
                    l_item_count      NUMBER := 0;
                    l_grand_total     NUMBER := 0;
                
                    l_paid_amount     NUMBER := 0;
                    l_due_amount      NUMBER := 0;
                BEGIN
                    /* =====================================================
                       NO PURCHASE SELECTED
                       ===================================================== */
                    IF :P27_INVOICE IS NULL
                    THEN
                        RETURN '
                        <div class="invoice-history-empty">
                            <i class="fa fa-file-text-o"></i>
                            <div>
                                Select a purchase invoice to view product history
                            </div>
                
                        </div>';
                    END IF;
                    /* =====================================================
                       PURCHASE HEADER
                       ===================================================== */
                    SELECT m.PURCHASE_CODE,
                           m.PURCHASE_DATE,
                           s.SUPPLIER_NAME,
                           NVL (m.PAID_AMOUNT, 0),
                           NVL (m.DUE_AMOUNT,
                                NVL (m.TOTAL_AMOUNT, 0) - NVL (m.PAID_AMOUNT, 0))
                      INTO l_purchase_code,
                           l_purchase_date,
                           l_supplier_name,
                           l_paid_amount,
                           l_due_amount
                      FROM TRN_PURCHASE_MST  m
                           JOIN MST_SUPPLIER s ON s.SUPPLIER_NO = m.SUPPLIER_NO
                     WHERE m.PURCHASE_NO = :P27_INVOICE;
                    /* =====================================================
                       PRODUCT SUMMARY
                       ===================================================== */
                    SELECT COUNT (*), NVL (SUM (NVL (d.TOTAL_AMOUNT, 0)), 0)
                      INTO l_item_count, l_grand_total
                      FROM TRN_PURCHASE_DTL d
                     WHERE d.PURCHASE_NO = :P27_INVOICE;
                    /* =====================================================
                       MAIN CARD
                       ===================================================== */
                    l_html :=
                           '<div class="invoice-history-card">
                            <div class="history-header">
                                <div class="history-title-area">
                                    <div class="history-title">
                                        Product History
                                    </div>
                                    <div class="history-subtitle">'
                        || apex_escape.html (NVL (l_purchase_code, '-'))
                        || ' &nbsp;•&nbsp; '
                        || apex_escape.html (NVL (l_supplier_name, '-'))
                        || '</div>
                                </div>
                                <div class="history-date">'
                        || TO_CHAR (l_purchase_date,
                                    'DD Mon YYYY',
                                    'NLS_DATE_LANGUAGE=English')
                        || '</div>
                            </div>
                            <!-- TABLE HEADER -->
                            <div class="product-head">
                                <div class="product-col">
                                    Product
                                </div>
                                <div class="qty-col">
                                    Qty
                                </div>
                                <div class="price-col">
                                    Rate
                                </div>
                                <div class="total-col">
                                    Total
                                </div>
                            </div>';
                    /* =====================================================
                       PRODUCT ROW
                       ===================================================== */
                    FOR r
                        IN (  SELECT d.PRODUCT_NO,
                                     p.PRODUCT_CODE,
                                     p.PRODUCT_NAME,
                                     d.PURCHASE_QTY,
                                     d.PURCHASE_RATE,
                                     d.TOTAL_AMOUNT
                               FROM TRN_PURCHASE_DTL d
                                    JOIN MST_PRODUCT p ON p.PRODUCT_NO = d.PRODUCT_NO
                              WHERE d.PURCHASE_NO = :P27_INVOICE
                           ORDER BY d.PURCHASE_DTL_NO)
                    LOOP
                        l_html :=
                               l_html
                            || '<div class="product-row">
                                <!-- PRODUCT -->
                                <div class="product-col">
                                    <div class="product-name">'
                            || apex_escape.html (NVL (r.PRODUCT_NAME, '-'))
                            || '</div>
                                    <div class="product-code">'
                            || apex_escape.html (NVL (r.PRODUCT_CODE, '-'))
                            || '</div>
                                </div>
                                <!-- QTY -->
                                <div class="qty-col">
                                    <span class="qty-value">'
                            || NVL (
                                   TO_CHAR (r.PURCHASE_QTY,
                                            'FM999999999990D999',
                                            'NLS_NUMERIC_CHARACTERS=''.,'''),
                                   '0')
                            || '</span>
                                </div>
                                <!-- RATE -->
                                <div class="price-col">
                                    <span class="price-value">
                                        ৳ '
                            || NVL (
                                   TO_CHAR (r.PURCHASE_RATE,
                                            'FM999999999990D00',
                                            'NLS_NUMERIC_CHARACTERS=''.,'''),
                                   '0.00')
                            || '</span>
                
                                </div>
                                <!-- TOTAL -->
                
                                <div class="total-col">
                
                                    <span class="total-value">
                                        ৳ '
                            || NVL (
                                   TO_CHAR (r.TOTAL_AMOUNT,
                                            'FM999999999990D00',
                                            'NLS_NUMERIC_CHARACTERS=''.,'''),
                                   '0.00')
                            || '</span>
                                </div>
                            </div>';
                    END LOOP;
                
                    /* =====================================================
                       FOOTER
                       ===================================================== */
                    l_html :=
                           l_html
                        || '<div class="history-footer">
                
                            <div class="item-count">'
                        || l_item_count
                        || ' Item(s)
                            </div>
                            <div class="history-total-label">
                                Total
                                <strong>
                                    ৳ '
                        || NVL (
                               TO_CHAR (l_grand_total,
                                        'FM999999999990D00',
                                        'NLS_NUMERIC_CHARACTERS=''.,'''),
                               '0.00')
                        || '</strong>
                           </div>
                        </div>
                    </div>';
                    /* =====================================================
                       PAYMENT SUMMARY
                       ===================================================== */
                    l_html :=
                           l_html
                        || '<div class="invoice-payment-summary">
                
                            <div class="payment-line">
                
                                <span class="payment-label">
                                    Payment
                                </span>
                
                                <span class="payment-value payment-received">
                                    ৳ '
                        || NVL (
                               TO_CHAR (l_paid_amount,
                                        'FM999999999990D00',
                                        'NLS_NUMERIC_CHARACTERS=''.,'''),
                               '0.00')
                        || '</span>
                
                            </div>
                            <div class="payment-line">
                
                                <span class="payment-label">
                                    Due
                                </span>
                
                                <span class="payment-value payment-due">
                                    ৳ '
                        || NVL (
                               TO_CHAR (l_due_amount,
                                        'FM999999999990D00',
                                        'NLS_NUMERIC_CHARACTERS=''.,'''),
                               '0.00')
                        || '</span>
                            </div>
                            <div class="payment-line payment-status-row">
                
                                <span class="payment-label">
                                    Status
                                </span>
                                <span class="payment-status '
                        || CASE
                               WHEN NVL (l_due_amount, 0) <= 0 THEN 'status-paid'
                               WHEN NVL (l_paid_amount, 0) > 0 THEN 'status-partial'
                               ELSE 'status-unpaid'
                           END
                        || '">'
                        || CASE
                               WHEN NVL (l_due_amount, 0) <= 0
                               THEN
                                   '<i class="fa fa-check-circle"></i> PAID'
                               WHEN NVL (l_paid_amount, 0) > 0
                               THEN
                                   '<i class="fa fa-adjust"></i> PARTIAL'
                               ELSE
                                   '<i class="fa fa-clock-o"></i> UNPAID'
                           END
                        || '</span>
                
                            </div>
                
                        </div>';
                    RETURN l_html;
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        RETURN '
                        <div class="invoice-history-empty">
                
                            <i class="fa fa-file-o"></i>
                
                            <div>
                                Purchase invoice information not found
                            </div>
                
                        </div>';
                    WHEN OTHERS
                    THEN
                        RETURN '
                        <div class="invoice-history-empty">
                            <i class="fa fa-exclamation-triangle"></i>
                            <div>
                                Unable to load purchase information
                            </div>
                        </div>';
                END;
                ```
            pageItemsToSubmit: P27_INVOICE
        }
        layout {
            sequence: 2
            parentRegion: @main
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region supplier-summery (
        name: SUPPLIER SUMMERY
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/25/2026 4:45:21 PM (QP5 v5.388) */
                DECLARE
                    v_html   CLOB;
                BEGIN
                    SELECT    '<div id="supplier_summary"
                                 style="
                                    width:100%;
                                    max-width:240px;
                                    box-sizing:border-box;
                                    padding:6px 9px;
                                    border:1px solid #e1e5e9;
                                    border-radius:5px;
                                    background:#fff;
                                    font-size:11px;
                                    line-height:1.55;
                                 ">
                
                                <!-- Supplier -->
                                <div style="
                                    font-size:12px;
                                    font-weight:600;
                                    color:#333;
                                    margin-bottom:5px;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    text-overflow:ellipsis;
                                ">
                                    Supplier:
                                    '
                           || NVL (S.SUPPLIER_NAME, 'N/A')
                           || '
                                </div>
                
                                <!-- PREVIOUS -->
                                <div style="
                                    margin-top:2px;
                                    margin-bottom:4px;
                                    padding:3px 6px;
                                    border-left:3px solid #7b8794;
                                    background:#f4f6f8;
                                    color:#5f6b76;
                                    font-size:10px;
                                    font-weight:700;
                                    text-transform:uppercase;
                                    letter-spacing:.5px;
                                ">
                                    Previous
                                </div>
                
                                <!-- Purchase -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                ">
                                    <span>Purchase</span>
                
                                    <b>
                                        ৳ '
                           || TO_CHAR (NVL (X.PURCHASE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                                </div>
                
                                <!-- Paid -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                ">
                                    <span>Paid</span>
                
                                    <b>
                                        ৳ '
                           || TO_CHAR (NVL (X.PAID_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                                </div>
                
                                <!-- Due -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                    border-top:1px solid #eee;
                                    margin-top:2px;
                                    padding-top:2px;
                                ">
                                    <span>Due</span>
                
                                    <b style="
                                        color:#c0392b;
                                        font-weight:700;
                                    ">
                                        ৳ '
                           || TO_CHAR (NVL (X.DUE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                                </div>
                
                                <!-- Payment Status -->
                                <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                ">
                                    <span>Status</span>
                
                                    <b style="
                                        color:'
                           || CASE X.PAYMENT_STATUS
                                  WHEN 'Paid' THEN '#27ae60'
                                  WHEN 'Unpaid' THEN '#c0392b'
                                  ELSE '#e67e22'
                              END
                           || ';
                                        font-weight:700;
                                    ">
                                        '
                           || NVL (X.PAYMENT_STATUS, 'Unpaid')
                           || '
                                    </b>
                                </div>
                
                           </div>'
                      INTO v_html
                      FROM MST_SUPPLIER  S
                           LEFT JOIN
                           (  SELECT M.SUPPLIER_NO,
                                     SUM (NVL (M.TOTAL_AMOUNT, 0))    AS PURCHASE_AMOUNT,
                                     SUM (NVL (M.PAID_AMOUNT, 0))     AS PAID_AMOUNT,
                                     SUM (NVL (M.DUE_AMOUNT, 0))      AS DUE_AMOUNT,
                                     CASE
                                         WHEN SUM (NVL (M.DUE_AMOUNT, 0)) = 0 THEN 'Paid'
                                         WHEN SUM (NVL (M.PAID_AMOUNT, 0)) = 0 THEN 'Unpaid'
                                         ELSE 'Partially Paid'
                                     END                              AS PAYMENT_STATUS
                                FROM TRN_PURCHASE_MST M
                            GROUP BY M.SUPPLIER_NO) X
                               ON X.SUPPLIER_NO = S.SUPPLIER_NO
                     WHERE S.SUPPLIER_NO = :P27_PARTY_NO;
                
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                            font-size:11px;
                            color:#777;
                            padding:6px;
                        ">
                            Supplier summary unavailable.
                         </div>';
                END;
                ```
            pageItemsToSubmit: P27_PARTY_NO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region trn-mst (
        name: TRN_MST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TRANSACTION_NO,
                       TRANSACTION_CODE,
                       TRANSACTION_DATE,
                       TRANSACTION_TYPE,
                       PARTY_TYPE,
                       PARTY_NO,
                       PAY_MODE,
                       BANK_ACCOUNT_NO,
                       TOTAL_AMOUNT,
                       REMARKS,
                       APPROVAL_STATUS,
                       DECODE(APPROVAL_STATUS,'A','Approved','Pending') STATUS,
                       VOUCHER_NO,
                       CREATED_BY,
                       CREATED_DATE,
                       APPROVED_BY,
                       APPROVED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from TRN_TRANSACTION_MST
                ```
        }
        layout {
            sequence: 20
            parentRegion: @main
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

