    dynamicAction new_6 (
        name: New
        execution {
            sequence: 80
        }
        when {
            event: custom
            customEvent: input
            selectionType: items
            items: P27_PAYMENT_AMOUNT
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var due = parseFloat($v("P27_DUE_AMOUNT")) || 0;
                    var payment = parseFloat($v("P27_PAYMENT_AMOUNT")) || 0;
                    
                    if (payment <= 0) {
                    
                        apex.message.showErrors([
                            {
                                type: "error",
                                location: ["inline"],
                                pageItem: "P27_PAYMENT_AMOUNT",
                                message: "Please enter a valid payment amount.",
                                unsafe: false
                            }
                        ]);
                    
                        apex.item("P27_PAYMENT_AMOUNT").setValue("");
                    
                        return false;
                    }
                    
                    if (payment > due) {
                    
                        apex.message.showErrors([
                            {
                                type: "error",
                                location: ["inline"],
                                pageItem: "P27_PAYMENT_AMOUNT",
                                message: "Payment cannot be greater than Due Amount.",
                                unsafe: false
                            }
                        ]);
                    
                        apex.item("P27_PAYMENT_AMOUNT").setValue("");
                    
                        return false;
                    }
                    
                    apex.message.clearErrors();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

