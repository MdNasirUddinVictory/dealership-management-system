page 27 (
    name: Transaction Request (Supplier)
    alias: TRANSACTION-REQUEST-SUPPLIER
    title: Transaction Request (Supplier)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* ================================
               CUSTOMER RECEIVED ITEMS
               ================================ */
            
            #P27_TOTAL_AMOUNT,
            #P27_PREVIOUS_PAYMNET,
            #P27_DUE_AMOUNT,
            #P27_PAYMENT_AMOUNT {
                height: 32PX;
                border: 1px solid #d9dee5;
                border-radius: 7px;
                background: #f8fafc;
                padding: 0 12px;
                font-size: 16px;
                font-weight: 700;
                text-align: right;
                box-sizing: border-box;
                transition: all 0.2s ease;
            }
            
            /* Label */
            /* label[for="P27_TOTAL_AMOUNT"],
            label[for="P27_PREVIOUS_PAYMNET"],
            label[for="P27_DUE_AMOUNT"],
            label[for="P27_PAYMENT_AMOUNT"] {
                font-size: 12px;
                font-weight: 600;
                color: #667085;
            } */
            
            /* Total */
            #P27_TOTAL_AMOUNT {
                color: #344054;
            }
            
            /* Previous Payment */
            #P27_PREVIOUS_PAYMNET {
                color: #475467;
            }
            
            /* Due */
            #P27_DUE_AMOUNT {
                color: #dc2626;
                background: #fff7f7;
                border-color: #fecaca;
            }
            
            /* Received */
            #P27_PAYMENT_AMOUNT {
                color: #15803d;
                background: #f0fdf4;
                border-color: #bbf7d0;
            }
            
            /* Focus */
            #P27_PAYMENT_AMOUNT:focus {
                border-color: #16a34a;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.10);
                outline: none;
            }
            
            /* Mobile */
            @media (max-width: 600px) {
                #P27_TOTAL_AMOUNT,
                #P27_PREVIOUS_PAYMNET,
                #P27_DUE_AMOUNT,
                #P27_PAYMENT_AMOUNT {
                    height: 40px;
                    font-size: 15px;
                }
            }
            /* =====================================================
               PAYMENT BUTTON COLOR
               ===================================================== */
            
            #payment_btn {
                width: 100%;
                height: 38px;
            
                border: none !important;
                border-radius: 25px !important;
            
                background: linear-gradient(
                    90deg,
                    #9b3db0,
                    #c21891,
                    #f0008c,
                    #c21891,
                    #9b3db0
                ) !important;
            
                background-size: 300% 100%;
            
                color: #fff !important;
            
                font-size: 18px !important;
                font-weight: 600 !important;
            
                cursor: pointer;
            
                box-shadow: 0 4px 10px rgba(194, 24, 145, 0.20) !important;
            
                transition:
                    transform 0.25s ease,
                    box-shadow 0.25s ease;
            
                animation: orderPayGradient 5s ease infinite;
            }
            
            
            /* Gradient movement */
            @keyframes orderPayGradient {
                0% {
                    background-position: 0% 50%;
                }
            
                50% {
                    background-position: 100% 50%;
                }
            
                100% {
                    background-position: 0% 50%;
                }
            }
            
            
            /* Hover Animation */
            #payment_btn:hover {
                transform: translateY(-2px) scale(1.01);
            
                box-shadow:
                    0 7px 18px rgba(194, 24, 145, 0.35) !important;
            }
            
            
            /* Click */
            #payment_btn:active {
                transform: translateY(0) scale(0.98);
            }
            
            
            
            
            /* =====================================================
               MAIN CARD
               ===================================================== */
            
            .receive-card {
                width: 100%;
            
                min-height: 88px;
            
                display: flex;
                align-items: center;
            
                box-sizing: border-box;
            
                padding: 12px 18px;
            
                background: #ffffff;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 6px;
            
                box-shadow: 0 1px 3px rgba(0,0,0,.05);
            
                overflow: hidden;
            }
            
            
            /* =====================================================
               LEFT CUSTOMER SECTION
               ===================================================== */
            
            .customer-section {
                flex: 1;
            
                min-width: 0;
            
                padding-right: 20px;
            
                border-right: 1px solid #eeeeee;
            }
            
            
            .customer-main {
                display: flex;
            
                align-items: center;
            
                gap: 10px;
            }
            
            
            /* =====================================================
               HOME BADGE
               ===================================================== */
            
            .home-badge {
                display: flex;
            
                align-items: center;
            
                justify-content: center;
            
                gap: 6px;
            
                width: 74px;
            
                height: 34px;
            
                flex-shrink: 0;
            
                background: #eaf7ed;
            
                color: #087f23;
            
                border-radius: 5px;
            
                font-size: 13px;
            
                font-weight: 500;
            }
            
            
            .home-badge i {
                font-size: 15px;
            }
            
            
            /* =====================================================
               CUSTOMER INFO
               ===================================================== */
            
            .customer-info {
                display: flex;
            
                flex-direction: column;
            
                min-width: 0;
            
                line-height: 1.25;
            }
            
            
            .customer-name {
                font-size: 14px;
            
                font-weight: 700;
            
                color: #17191c;
            
                white-space: nowrap;
            
                overflow: hidden;
            
                text-overflow: ellipsis;
            }
            
            
            .customer-phone {
                margin-top: 2px;
            
                font-size: 11px;
            
                color: #555b63;
            }
            
            
            /* =====================================================
               ADDRESS
               ===================================================== */
            
            .address-bottom {
                display: flex;
            
                align-items: center;
            
                gap: 8px;
            
                margin-top: 6px;
            
                font-size: 11px;
            
                color: #60656d;
            }
            
            
            .customer-address {
                min-width: 0;
            
                overflow: hidden;
            
                text-overflow: ellipsis;
            
                white-space: nowrap;
            }
            
            
            .change-address {
                flex-shrink: 0;
            
                color: #009acb;
            
                font-size: 11px;
            
                text-decoration: none;
            
                white-space: nowrap;
            }
            
            
            .change-address:hover {
                text-decoration: underline;
            }
            
            
            /* =====================================================
               MIDDLE : CUSTOMER RECEIVE
               ===================================================== */
            
            .receive-section {
                width: 260px;
            
                flex-shrink: 0;
            
                padding: 0 24px;
            
                box-sizing: border-box;
            
                display: flex;
            
                flex-direction: column;
            
                justify-content: center;
            
                align-items: center;
            
                text-align: center;
            }
            
            
            .receive-title {
                font-size: 18px;
            
                font-weight: 700;
            
                line-height: 1.2;
            
                color: #17191c;
            }
            
            
            .receive-subtitle {
                margin-top: 4px;
            
                font-size: 10px;
            
                line-height: 1.35;
            
                color: #858b94;
            
                max-width: 220px;
            }
            
            
            /* =====================================================
               RIGHT DELIVERY SECTION
               ===================================================== */
            
            .delivery-section {
                flex: 1;
            
                min-width: 0;
            
                padding-left: 20px;
            
                display: flex;
            
                align-items: center;
            
                justify-content: flex-end;
            
                gap: 18px;
            }
            
            
            /* =====================================================
               SELECT DELIVERY ADDRESS
               ===================================================== */
            
            .delivery-title {
                display: flex;
            
                align-items: center;
            
                gap: 6px;
            
                padding: 7px 11px;
            
                border-radius: 5px;
            
                background: #fff3f9;
            
                color: #e50078;
            
                font-size: 12px;
            
                font-weight: 600;
            
                white-space: nowrap;
            }
            
            
            .delivery-title i {
                font-size: 13px;
            }
            
            
            /* =====================================================
               ADD ADDRESS
               ===================================================== */
            
            .add-address-btn {
                display: inline-flex;
            
                align-items: center;
            
                gap: 3px;
            
                color: #ff0080;
            
                font-size: 13px;
            
                font-weight: 600;
            
                text-decoration: none;
            
                white-space: nowrap;
            
                cursor: pointer;
            }
            
            
            .add-address-btn:hover {
                color: #d9006d;
            
                text-decoration: none;
            }
            
            
            .add-address-btn.disabled {
                opacity: .5;
            
                cursor: default;
            }
            
            
            .add-icon {
                font-size: 19px;
            
                line-height: 1;
            }
            
            
            /* =====================================================
               TABLET
               ===================================================== */
            
            @media (max-width: 1000px) {
            
                .receive-card {
                    padding: 11px 13px;
                }
            
            
                .receive-section {
                    width: 220px;
            
                    padding: 0 15px;
                }
            
            
                .receive-title {
                    font-size: 16px;
                }
            
            
                .delivery-section {
                    padding-left: 12px;
            
                    gap: 10px;
                }
            
            
                .delivery-title {
                    font-size: 11px;
            
                    padding: 6px 8px;
                }
            
            
                .add-address-btn {
                    font-size: 12px;
                }
            
            }
            
            
            /* =====================================================
               MOBILE
               ===================================================== */
            
            @media (max-width: 700px) {
            
                .receive-card {
                    display: flex;
            
                    flex-direction: column;
            
                    align-items: stretch;
            
                    padding: 12px;
            
                    gap: 10px;
                }
            
            
                /* LEFT */
            
                .customer-section {
                    width: 100%;
            
                    padding-right: 0;
            
                    padding-bottom: 9px;
            
                    border-right: none;
            
                    border-bottom: 1px solid #eeeeee;
                }
            
            
                /* MIDDLE */
            
                .receive-section {
                    width: 100%;
            
                    padding: 0;
            
                    align-items: flex-start;
            
                    text-align: left;
                }
            
            
                .receive-title {
                    font-size: 16px;
                }
            
            
                .receive-subtitle {
                    font-size: 10px;
            
                    max-width: none;
                }
            
            
                /* RIGHT */
            
                .delivery-section {
                    width: 100%;
            
                    padding-left: 0;
            
                    justify-content: space-between;
            
                    gap: 8px;
                }
            
            
                .delivery-title {
                    font-size: 11px;
                }
            
            
                .add-address-btn {
                    font-size: 11px;
                }
            
            }
            
            
            
            /* ------------------------------------------------------------------------ */
            
            /* =====================================================
               INVOICE HISTORY CARD
               ===================================================== */
            
            .invoice-history-card {
                width: 100%;
                box-sizing: border-box;
            
                background: #ffffff;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 7px;
            
                overflow: hidden;
            
                box-shadow: 0 1px 3px rgba(0,0,0,.04);
            }
            
            
            /* =====================================================
               HEADER
               ===================================================== */
            
            .history-header {
                display: flex;
            
                align-items: center;
            
                justify-content: space-between;
            
                padding: 11px 14px;
            
                border-bottom: 1px solid #eeeeee;
            }
            
            
            .history-title {
                font-size: 16px;
                font-weight: 700;
            
                color: #17191c;
            }
            
            
            .history-subtitle {
                margin-top: 3px;
            
                font-size: 10px;
            
                color: #858b94;
            }
            
            
            .history-date {
                font-size: 11px;
            
                color: #6d737b;
            
                white-space: nowrap;
            }
            
            
            /* =====================================================
               TABLE HEADER
               ===================================================== */
            
            .product-head,
            .product-row {
                display: grid;
            
                grid-template-columns:
                    minmax(250px, 1fr)
                    80px
                    110px
                    120px;
            
                align-items: center;
            }
            
            
            .product-head {
                min-height: 34px;
            
                padding: 0 14px;
            
                box-sizing: border-box;
            
                background: #fff9e8;
            
                font-size: 11px;
            
                font-weight: 600;
            
                color: #33373c;
            }
            
            
            /* =====================================================
               PRODUCT ROW
               ===================================================== */
            
            .product-row {
                min-height: 46px;
            
                padding: 4px 14px;
            
                box-sizing: border-box;
            
                border-bottom: 1px solid #eeeeee;
            }
            
            
            .product-row:last-of-type {
                border-bottom: none;
            }
            
            
            /* =====================================================
               PRODUCT
               ===================================================== */
            
            .product-name {
                font-size: 12px;
            
                font-weight: 600;
            
                color: #25282d;
            
                line-height: 1.2;
            }
            
            
            .product-code {
                margin-top: 1px;
            
                font-size: 9px;
            
                color: #999fa7;
            }
            
            
            /* =====================================================
               QTY
               ===================================================== */
            
            .qty-col {
                text-align: center;
            }
            
            
            .qty-value {
                display: inline-flex;
            
                align-items: center;
            
                justify-content: center;
            
                min-width: 30px;
            
                height: 23px;
            
                padding: 0 7px;
            
                border: 1px solid #e0e3e7;
            
                border-radius: 4px;
            
                font-size: 11px;
            
                color: #33373c;
            
                background: #fafafa;
            }
            
            
            /* =====================================================
               PRICE
               ===================================================== */
            
            .price-col {
                text-align: right;
            
                font-size: 11px;
            
                color: #555b63;
            }
            
            
            /* =====================================================
               TOTAL
               ===================================================== */
            
            .total-col {
                text-align: right;
            
                font-size: 12px;
            
                font-weight: 700;
            
                color: #17191c;
            }
            
            
            /* =====================================================
               FOOTER
               ===================================================== */
            
            .history-footer {
                display: flex;
            
                align-items: center;
            
                justify-content: flex-end;
            
                gap: 20px;
            
                min-height: 38px;
            
                padding: 0 14px;
            
                background: #fafafa;
            
                border-top: 1px solid #eeeeee;
            }
            
            
            .item-count {
                font-size: 11px;
            
                color: #666d76;
            }
            
            
            .history-total-label {
                font-size: 11px;
            
                color: #666d76;
            }
            
            
            .history-total-label strong {
                margin-left: 6px;
            
                font-size: 14px;
            
                color: #17191c;
            }
            
            
            /* =====================================================
               EMPTY
               ===================================================== */
            
            .invoice-history-empty {
                min-height: 100px;
            
                display: flex;
            
                flex-direction: column;
            
                align-items: center;
            
                justify-content: center;
            
                gap: 7px;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 7px;
            
                background: #ffffff;
            
                color: #9298a1;
            
                font-size: 11px;
            }
            
            
            .invoice-history-empty i {
                font-size: 21px;
            
                color: #c1c6cc;
            }
            
            
            /* =====================================================
               MOBILE
               ===================================================== */
            
            @media (max-width: 700px) {
            
                .product-head,
                .product-row {
            
                    grid-template-columns:
                        minmax(140px, 1fr)
                        50px
                        75px
                        85px;
            
                    padding-left: 9px;
                    padding-right: 9px;
                }
            
            
                .product-head {
                    min-height: 31px;
            
                    font-size: 10px;
                }
            
            
                .product-row {
                    min-height: 42px;
            
                    padding-top: 3px;
                    padding-bottom: 3px;
                }
            
            
                .product-name {
                    font-size: 11px;
            
                    line-height: 1.15;
                }
            
            
                .product-code {
                    font-size: 8px;
                }
            
            
                .qty-value {
                    height: 21px;
            
                    font-size: 10px;
                }
            
            
                .price-col {
                    font-size: 10px;
                }
            
            
                .total-col {
                    font-size: 11px;
                }
            
            
                .history-header {
                    padding: 9px 10px;
                }
            
            
                .history-title {
                    font-size: 14px;
                }
            
            
                .history-subtitle {
                    font-size: 9px;
                }
            
            
                .history-date {
                    font-size: 10px;
                }
            
            
                .history-footer {
                    min-height: 36px;
            
                    padding: 0 10px;
                }
            
            
                .item-count,
                .history-total-label {
                    font-size: 10px;
                }
            
            
                .history-total-label strong {
                    font-size: 13px;
                }
            
            }
            
            /* =====================================================
               PAYMENT SUMMARY BLOCK
               ===================================================== */
            
            .invoice-payment-summary {
            
                width: 100%;
            
                box-sizing: border-box;
            
                margin-top: 0;              /* NO GAP */
            
                padding: 7px 14px;
            
                background: #ffffff;
            
                border: 1px solid #e1e4e8;
            
                border-radius: 0 0 7px 7px;
            
                overflow: hidden;
            
                box-shadow: none;
            }
            
            
            /* =====================================================
               PAYMENT LINE
               ===================================================== */
            
            .payment-line {
            
                display: flex;
            
                align-items: center;
            
                justify-content: space-between;
            
                min-height: 29px;
            
                border-bottom: 1px solid #f0f1f2;
            
            }
            
            
            .payment-line:last-child {
            
                border-bottom: none;
            
            }
            
            
            /* =====================================================
               LABEL
               ===================================================== */
            
            .payment-label {
            
                font-size: 10px;
            
                font-weight: 600;
            
                letter-spacing: .2px;
            
                color: #737981;
            
            }
            
            
            /* =====================================================
               VALUE
               ===================================================== */
            
            .payment-value {
            
                font-size: 13px;
            
                font-weight: 700;
            
                letter-spacing: .1px;
            
                color: #25282d;
            
            }
            
            
            /* =====================================================
               RECEIVED / PAYMENT
               ===================================================== */
            
            .payment-received {
            
                color: #348454;
            
            }
            
            
            /* =====================================================
               DUE
               ===================================================== */
            
            .payment-due {
            
                color: #c17800;
            
            }
            
            
            /* =====================================================
               STATUS
               ===================================================== */
            
            .payment-status-row {
            
                min-height: 32px;
            
            }
            
            
            .payment-status {
            
                display: inline-flex;
            
                align-items: center;
            
                justify-content: center;
            
                gap: 5px;
            
                min-width: 68px;
            
                padding: 4px 9px;
            
                box-sizing: border-box;
            
                border-radius: 5px;
            
                font-size: 9px;
            
                font-weight: 700;
            
                letter-spacing: .4px;
            
            }
            
            
            /* =====================================================
               PAID
               ===================================================== */
            
            .status-paid {
            
                background: #edf7f0;
            
                color: #348454;
            
            }
            
            
            /* =====================================================
               PARTIAL
               ===================================================== */
            
            .status-partial {
            
                background: #fff7df;
            
                color: #a66d00;
            
            }
            
            
            /* =====================================================
               UNPAID
               ===================================================== */
            
            .status-unpaid {
            
                background: #fff0f0;
            
                color: #b84d4d;
            
            }
            
            
            /* =====================================================
               MOBILE
               ===================================================== */
            
            @media (max-width: 700px) {
            
                .invoice-payment-summary {
            
                    margin-top: 0;
            
                    padding: 5px 10px;
            
                    border-radius: 0 0 7px 7px;
            
                }
            
            
                .payment-line {
            
                    min-height: 27px;
            
                }
            
            
                .payment-label {
            
                    font-size: 9px;
            
                    font-weight: 600;
            
                }
            
            
                .payment-value {
            
                    font-size: 12px;
            
                    font-weight: 700;
            
                }
            
            
                .payment-status-row {
            
                    min-height: 30px;
            
                }
            
            
                .payment-status {
            
                    min-width: 62px;
            
                    padding: 3px 7px;
            
                    font-size: 8px;
            
                }
            
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region address (
        name: ADDRESS
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_html CLOB := '';
                    l_url  VARCHAR2(4000);
                
                    l_customer_name MST_CUSTOMER.CUSTOMER_NAME%TYPE;
                    l_customer_code MST_CUSTOMER.CUSTOMER_CODE%TYPE;
                    l_mobile_no     MST_CUSTOMER.MOBILE_NO%TYPE;
                    l_address       MST_CUSTOMER.ADDRESS%TYPE;
                BEGIN
                
                    /* =====================================================
                       GET CUSTOMER INFORMATION
                       ===================================================== */
                
                    SELECT
                        SUPPLIER_NAME,
                        SUPPLIER_CODE,
                        MOBILE_NO,
                        ADDRESS
                    INTO
                        l_customer_name,
                        l_customer_code,
                        l_mobile_no,
                        l_address
                    FROM MST_SUPPLIER
                    WHERE SUPPLIER_NO = :P27_PARTY_NO
                      AND ACTIVE_FLAG = '1';
                
                
                    /* =====================================================
                       PAGE 25 URL
                       ===================================================== */
                
                    l_url := apex_page.get_url(
                        p_page   => 25,
                        p_items  => 'P25_CUSTOMER_NO',
                        p_values => :P27_PARTY_NO
                    );
                
                
                    /* =====================================================
                       HTML
                       ===================================================== */
                
                    l_html := '
                
                    <div class="receive-card">
                
                
                        <!-- =================================================
                             LEFT : SUPPLIER / ADDRESS
                             ================================================= -->
                
                        <div class="customer-section">
                
                            <div class="customer-main">
                
                
                                <!-- HOME -->
                
                                <div class="home-badge">
                
                                    <i class="fa fa-home"></i>
                
                                    <span>
                                        Home
                                    </span>
                
                                </div>
                
                
                                <!-- CUSTOMER INFO -->
                
                                <div class="customer-info">
                
                                    <div class="customer-name">
                                        ' ||
                                        apex_escape.html(l_customer_name) ||
                                        '
                                    </div>
                
                                    <div class="customer-phone">
                                        ' ||
                                        apex_escape.html(l_mobile_no) ||
                                        '
                                    </div>
                
                                </div>
                
                            </div>
                
                
                            <!-- ADDRESS -->
                
                            <div class="address-bottom">
                
                                <span class="customer-address">
                
                                    ' ||
                                    apex_escape.html(
                                        NVL(
                                            l_address,
                                            'No delivery address available'
                                        )
                                    ) ||
                                    '
                
                                </span>
                
                
                                <a href="' ||
                                    apex_escape.html_attribute(l_url) ||
                                    '"
                                   class="change-address">
                
                                    Change address &gt;
                
                                </a>
                
                            </div>
                
                        </div>
                
                
                
                        <!-- =================================================
                             MIDDLE : SUPPLIER RECEIVE
                             ================================================= -->
                
                        <div class="receive-section">
                
                            <div class="receive-title">
                                Supplier Payment
                            </div>
                
                            <div class="receive-subtitle">
                                Payment Supplier Against Purchase Invoice
                            </div>
                
                        </div>
                
                
                
                        <!-- =================================================
                             RIGHT : DELIVERY ADDRESS
                             ================================================= -->
                
                        <div class="delivery-section">
                
                
                            <div class="delivery-title">
                
                                <i class="fa fa-map-marker"></i>
                
                                <span>
                                    Select a delivery address
                                </span>
                
                            </div>
                
                
                            <a href="' ||
                                apex_escape.html_attribute(l_url) ||
                                '"
                               class="add-address-btn">
                
                                <span class="add-icon">+</span>
                
                                <span>
                                    Add address
                                </span>
                
                            </a>
                
                        </div>
                
                
                    </div>';
                
                
                
                    RETURN l_html;
                
                
                
                EXCEPTION
                
                    WHEN NO_DATA_FOUND THEN
                
                        RETURN '
                
                        <div class="receive-card">
                
                
                            <!-- LEFT -->
                
                            <div class="customer-section">
                
                                <div class="customer-main">
                
                                    <div class="home-badge">
                
                                        <i class="fa fa-home"></i>
                
                                        <span>
                                            Home
                                        </span>
                
                                    </div>
                
                                    <div class="customer-info">
                
                                        <div class="customer-name">
                                            No Supplier
                                        </div>
                
                                        <div class="customer-phone">
                                            -
                                        </div>
                
                                    </div>
                
                                </div>
                
                
                                <div class="address-bottom">
                
                                    <span class="customer-address">
                                        Please select a Supplier
                                    </span>
                
                                </div>
                
                            </div>
                
                
                
                            <!-- MIDDLE -->
                
                            <div class="receive-section">
                
                                <div class="receive-title">
                                   Supplier Payment
                                </div>
                
                                <div class="receive-subtitle">
                                    Payment Supplier Against Purchase Invoice
                                </div>
                
                            </div>
                
                
                
                            <!-- RIGHT -->
                
                            <div class="delivery-section">
                
                                <div class="delivery-title">
                
                                    <i class="fa fa-map-marker"></i>
                
                                    <span>
                                        Select a delivery address
                                    </span>
                
                                </div>
                
                                <span class="add-address-btn disabled">
                
                                    <span class="add-icon">+</span>
                
                                    Add address
                
                                </span>
                
                            </div>
                
                
                        </div>';
                
                END;
                ```
            pageItemsToSubmit: P27_PARTY_NO
        }
        layout {
            sequence: 1
            parentRegion: @main
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

