            sequence: 140
            region: @trn-mst
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
