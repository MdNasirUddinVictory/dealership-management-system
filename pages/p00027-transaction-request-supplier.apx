    process invoice-wise-total-amount (
        name: INVOICE_WISE_TOTAL_AMOUNT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 BEGIN
                  SELECT M.INVOICE_NO                                AS INVOICE_NO,
                         M.TOTAL_AMOUNT                              AS INVOICE_AMOUNT,
                         NVL (M.DUE_AMOUNT, 0)                       AS DUE_AMOUNT,
                         M.RECEIVED_AMOUNT                           AS RECEIVED_AMOUNT INTO :P27_INVOICE ,:P27_TOTAL_AMOUNT,:P27_DUE_AMOUNT,:P27_PREVIOUS_PAYMNET
                    FROM TRN_SALES_INVOICE_MST M
                   WHERE M.CUSTOMER_NO = :P27_PARTY_NO AND NVL (M.DUE_AMOUNT, 0) > 0
                ORDER BY M.INVOICE_DATE DESC;
                EXCEPTION 
                WHEN NO_DATA_FOUND
                THEN NULL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12166989474465764
        }
    )

    process new (
        name: TRANSACTION_PROCESS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 8/30/2026 6:29:40 PM (QP5 v5.388) */
                /* =====================================================
                   SUPPLIER PAYMENT - PAGE SUBMIT PROCESS
                   ===================================================== */
                
                DECLARE
                    l_txn_no            NUMBER;
                    l_previous_amount   NUMBER;
                    l_due_amount        NUMBER;
                    l_txn_code          VARCHAR2 (100);
                
                    l_pending_count     NUMBER;
                BEGIN
                    /* =====================================================
                       VALIDATION
                       ===================================================== */
                
                    /* Check existing pending payment request */
                    SELECT COUNT (*)
                      INTO l_pending_count
                      FROM TRN_TRANSACTION_DTL  d
                           JOIN TRN_TRANSACTION_MST m ON m.TRANSACTION_NO = d.TRANSACTION_NO
                     WHERE     d.REF_TYPE = 'PURCHASE'
                           AND d.REF_NO = :P27_INVOICE
                           AND m.PARTY_NO = :P27_PARTY_NO
                           AND m.TRANSACTION_TYPE = 'P'
                           AND m.APPROVAL_STATUS = 'P';
                
                
                    IF l_pending_count > 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20007,
                            'A payment request for this purchase invoice is already pending approval. Please wait until it is approved.');
                    END IF;
                
                
                    /* Supplier validation */
                    IF :P27_PARTY_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001, 'Please select supplier.');
                    END IF;
                
                
                    /* Purchase invoice validation */
                    IF :P27_INVOICE IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20002, 'Please select purchase invoice.');
                    END IF;
                
                
                    /* Payment amount validation */
                    IF NVL ( :P27_PAYMENT_AMOUNT, 0) <= 0
                    THEN
                        RAISE_APPLICATION_ERROR (-20003,
                                                 'Payment amount must be greater than zero.');
                    END IF;
                
                
                    /* =====================================================
                       GET PREVIOUS APPROVED PAYMENT
                       ===================================================== */
                
                    SELECT NVL (SUM (NVL (t.ALLOCATE_AMOUNT, 0)), 0)
                      INTO l_previous_amount
                      FROM TRN_TRANSACTION_DTL  t
                           JOIN TRN_TRANSACTION_MST h ON h.TRANSACTION_NO = t.TRANSACTION_NO
                     WHERE     t.REF_TYPE = 'PURCHASE'
                           AND t.REF_NO = :P27_INVOICE
                           AND h.PARTY_NO = :P27_PARTY_NO
                           AND h.TRANSACTION_TYPE = 'P'
                           AND h.APPROVAL_STATUS = 'A';
                
                
                    /* =====================================================
                       GET CURRENT PURCHASE DUE
                       ===================================================== */
                
                    SELECT NVL (TOTAL_AMOUNT, 0) - l_previous_amount
                      INTO l_due_amount
                      FROM TRN_PURCHASE_MST
                     WHERE PURCHASE_NO = :P27_INVOICE AND SUPPLIER_NO = :P27_PARTY_NO
                    FOR UPDATE;
                
                
                    /* =====================================================
                       VALIDATE PURCHASE DUE
                       ===================================================== */
                
                    IF l_due_amount <= 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20004,
                            'This purchase invoice is already fully paid.');
                    END IF;
                
                
                    /* =====================================================
                       PAYMENT CANNOT EXCEED DUE
                       ===================================================== */
                
                    IF :P27_PAYMENT_AMOUNT > l_due_amount
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20005,
                               'Payment amount cannot be greater than purchase due. '
                            || 'Current due: '
                            || TO_CHAR (l_due_amount, 'FM999999999990.00'));
                    END IF;
                
                
                    /* =====================================================
                       GENERATE TRANSACTION NUMBER
                       ===================================================== */
                
                    l_txn_no := SEQ_TRANSACTION_NO.NEXTVAL;
                
                    l_txn_code := 'TRN-' || LPAD (l_txn_no, 6, '0');
                
                    :P27_TRANSACTION_NO := l_txn_no;
                
                
                    /* =====================================================
                       TRANSACTION MASTER
                       ===================================================== */
                
                    INSERT INTO TRN_TRANSACTION_MST (TRANSACTION_NO,
                                                     TRANSACTION_CODE,
                                                     PARTY_NO,
                                                     PAY_MODE,
                                                     TRANSACTION_TYPE,
                                                     TRANSACTION_DATE,
                                                     TOTAL_AMOUNT,
                                                     APPROVAL_STATUS,
                                                     CREATED_BY,
                                                     CREATED_DATE)
                         VALUES (l_txn_no,
                                 l_txn_code,
                                 :P27_PARTY_NO,
                                 :P27_PAY_MODE,
                                 'P',
                                 :P27_TRANSACTION_DATE,
                                 :P27_PAYMENT_AMOUNT,
                                 'P',
                                 :APP_USER,
                                 SYSDATE);
                
                
                    /* =====================================================
                       TRANSACTION DETAIL
                       ONE ROW PER PURCHASE INVOICE
                       ===================================================== */
                
                    INSERT INTO TRN_TRANSACTION_DTL (TRANSACTION_DTL_NO,
                                                     TRANSACTION_NO,
                                                     REF_TYPE,
                                                     REF_NO,
                                                     DOC_NO,
                                                     DOC_CODE,
                                                     DOC_DATE,
                                                     PRODUCT_NO,
                                                     INVOICE_AMOUNT,
                                                     PREVIOUS_AMOUNT,
                                                     DUE_AMOUNT,
                                                     ALLOCATE_AMOUNT,
                                                     CREATED_BY,
                                                     CREATED_DATE)
                        SELECT SEQ_TRANSACTION_DTL_NO.NEXTVAL,
                               l_txn_no,
                               'PURCHASE',
                               m.PURCHASE_NO,
                               m.PURCHASE_NO,
                               m.PURCHASE_CODE,
                               m.PURCHASE_DATE,
                               NULL,
                               m.TOTAL_AMOUNT,
                               l_previous_amount,
                               l_due_amount,
                               :P27_PAYMENT_AMOUNT,
                               :APP_USER,
                               SYSDATE
                          FROM TRN_PURCHASE_MST m
                         WHERE     m.PURCHASE_NO = :P27_INVOICE
                               AND m.SUPPLIER_NO = :P27_PARTY_NO;
                
                
                    /* =====================================================
                       SUCCESS MESSAGE
                       ===================================================== */
                
                    APEX_APPLICATION.g_print_success_message :=
                           '<div class="payment-success-message">
                                <span class="payment-success-icon">
                                    <i class="fa fa-check-circle"></i>
                                </span>
                
                                <div class="payment-success-content">
                
                                    <div class="payment-success-title">
                                        Supplier Payment Transaction Created
                                    </div>
                
                                    <div class="payment-success-text">
                                        Transaction <strong>'
                        || apex_escape.html (l_txn_code)
                        || '</strong>
                                        created successfully and is
                                        <strong>Pending Approval</strong>.
                                    </div>
                
                                </div>
                            </div>';
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20006,
                            'Purchase invoice not found for selected supplier.');
                END;
                ```
        }
        execution {
            sequence: 40
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 12166121144465762
        }
        serverSideCondition {
            whenButtonPressed: @payment-now_1
        }
    )

)

