    pageItem P27_PARTY_NO (
        type: popupLov
        label {
            label: Supplier Shop Name
            alignment: left
        }
        settings {
            popupWidth: 400
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  SELECT PARTY_NAME AS D, PARTY_NO AS R
                    FROM (
                          
                          SELECT S.SUPPLIER_NAME AS PARTY_NAME, S.SUPPLIER_NO AS PARTY_NO
                            FROM MST_SUPPLIER S
                                 WHERE EXISTS
                                         (SELECT 1
                                            FROM TRN_PURCHASE_MST P
                                           WHERE     P.SUPPLIER_NO = S.SUPPLIER_NO
                                                 AND NVL (P.DUE_AMOUNT, 0) > 0))
                ORDER BY PARTY_NAME;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 130
            region: @trn-mst
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                margin-top-none
                margin-bottom-none
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        source {
            formRegion: @trn-mst
            column: PARTY_NO
            dataType: number
