    pageItem P27_INVOICE (
        type: popupLov
        label {
            label: Purchase Order
            alignment: left
        }
        settings {
            fetchOnSearch: true
            popupWidth: 500
            additionalOutputs: PAY_DUE_AMOUNT:P27_PAYMENT_AMOUNT,INVOICE_AMOUNT:P27_TOTAL_AMOUNT,PAYMENT_AMOUNT:P27_PREVIOUS_PAYMNET,DUE_AMOUNT:P27_DUE_AMOUNT
