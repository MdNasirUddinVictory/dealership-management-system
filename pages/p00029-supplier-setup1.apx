page 29 (
    name: Supplier Setup
    alias: SUPPLIER-SETUP1
    title: Supplier Setup
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region entry (
        name: Entry
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SUPPLIER_NO,
                       SUPPLIER_CODE,
                       SUPPLIER_NAME,
                       CONTACT_PERSON,
                       MOBILE_NO,
                       EMAIL_ADDRESS,
                       ADDRESS,
                       ACTIVE_FLAG,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE
                  from MST_SUPPLIER
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--large
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P29_ACTIVE_FLAG (
        type: checkbox
        label {
            label: Active Flag
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: 1
            uncheckedValue: 0
        }
        layout {
            sequence: 10
            region: @entry
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--slimPadding
            ]
        }
        source {
            formRegion: @entry
            column: ACTIVE_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: 1
        }
    )

