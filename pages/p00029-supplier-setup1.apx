        advanced {
            htmlDomId: pb-update
            customAttributes: disabled
        }
    )

    validation email-format-validation (
        name: EMAIL Format Validation
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression:
                ```plsql
                REGEXP_LIKE(
                :P29_EMAIL_ADDRESS,
                '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
                )
                ```
        }
        error {
            errorMessage: Please enter a valid email address.
            associatedItem: @P29_EMAIL_ADDRESS
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_EMAIL_ADDRESS
        }
    )

    validation mobile-number-validation (
        name: Mobile Number Validation
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: "REGEXP_LIKE(:P29_MOBILE_NO,'^01[3-9][0-9]{8}$')"
        }
        error {
            errorMessage: Please enter a valid mobile number.
            associatedItem: @P29_MOBILE_NO
        }
    )

    validation new (
        name: Duplicate Mobile Number Check
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM MST_SUPPLIER
                WHERE MOBILE_NO = :P29_MOBILE_NO
                AND NVL(SUPPLIER_NO,0) <> NVL(:P29_SUPPLIER_NO,0)
                ```
        }
        error {
            errorMessage: Mobile Number already exists.
            associatedItem: @P29_MOBILE_NO
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/1/2026 4:28:46 PM (QP5 v5.388) */
                BEGIN
                    DECLARE
                        l_due_count   NUMBER := 0;
                        l_dep_count   NUMBER := 0;
                    BEGIN
                        /* =====================================================
                           1. CHECK OUTSTANDING SUPPLIER DUE
                           ===================================================== */
                        SELECT COUNT (*)
                          INTO l_due_count
                          FROM TRN_PURCHASE_MST
                         WHERE SUPPLIER_NO = :P29_SUPPLIER_NO AND NVL (DUE_AMOUNT, 0) > 0;
                
                        IF l_due_count > 0
                        THEN
                            RAISE_APPLICATION_ERROR (
                                -20001,
                                'Supplier cannot be deleted because an outstanding due amount exists.');
                        END IF;
                
                        /* =====================================================
                           2. CHECK RELATED PURCHASE DATA
                           ===================================================== */
                        -- SELECT COUNT (*)
                        --   INTO l_dep_count
                        --   FROM (SELECT 1
                        --           FROM TRN_PURCHASE_MST
                        --          WHERE SUPPLIER_NO = :P29_SUPPLIER_NO
                        --         UNION ALL
                        --         SELECT 1
                        --           FROM TRN_SUPPLIER_RETURN_MST
                        --          WHERE SUPPLIER_NO = :P29_SUPPLIER_NO);
                
                        -- IF l_dep_count > 0
                        -- THEN
                        --     RAISE_APPLICATION_ERROR (
                        --         -20002,
                        --         'Supplier cannot be deleted because related purchase/return data exists.');
                        -- END IF;
                
                        /* =====================================================
                           3. DELETE SUPPLIER
                           ===================================================== */
                
                        DELETE FROM MST_SUPPLIER
                              WHERE SUPPLIER_NO = :P29_SUPPLIER_NO;
                
                        /* =====================================================
                           4. SUCCESS MESSAGE
                           ===================================================== */
                        APEX_APPLICATION.g_print_success_message :=
                            'Supplier information has been deleted successfully.';
                        :P29_SUPPLIER_NO := NULL;
                    END;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12206924004808789
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-supplier-setup (
        name: Initialize form Supplier Setup
        type: formInitialization
        formRegion: @entry
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12198629245808740
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P29_SUPPLIER_NO IS NULL THEN
                
                        INSERT INTO MST_SUPPLIER
                        (
                            SUPPLIER_NO,
                            SUPPLIER_CODE,
                            SUPPLIER_NAME,
                            CONTACT_PERSON,
                            MOBILE_NO,
                            EMAIL_ADDRESS,
                            ADDRESS,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_SUPPLIER_NO.NEXTVAL,
                           'SUP' || LPAD(SEQ_SUPPLIER_NO.NEXTVAL,4,'0'),
                            :P29_SUPPLIER_NAME,
                            :P29_CONTACT_PERSON,
                            :P29_MOBILE_NO,
                            :P29_EMAIL_ADDRESS,
                            :P29_ADDRESS,
                            NVL(:P29_ACTIVE_FLAG,'Y'),
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                            'Supplier saved successfully.';
                
                    ELSE
                
                        UPDATE MST_SUPPLIER
                           SET 
                               SUPPLIER_NAME  = :P29_SUPPLIER_NAME,
                               CONTACT_PERSON = :P29_CONTACT_PERSON,
                               MOBILE_NO      = :P29_MOBILE_NO,
                               EMAIL_ADDRESS  = :P29_EMAIL_ADDRESS,
                               ADDRESS        = :P29_ADDRESS,
                               ACTIVE_FLAG    = :P29_ACTIVE_FLAG,
                               UPDATED_BY     = :APP_USER,
                               UPDATED_DATE   = SYSDATE
                         WHERE SUPPLIER_NO = :P29_SUPPLIER_NO;
                
                        apex_application.g_print_success_message :=
                            'Supplier updated successfully.';
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12206537194808787
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

