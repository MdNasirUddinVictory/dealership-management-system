    button add-product (
        buttonName: Add_Supplier
        label: Add Supplier
        layout {
            sequence: 10
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 29
                clearCache: 29
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
            ]
            icon: fa-save
