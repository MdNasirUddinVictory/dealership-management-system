    region product-entrey (
        name: UOM Conversion
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region uom-conversion (
        name: UOM Conversion
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.CONVERSION_NO,
                       C.PRODUCT_NO,
                       P.PRODUCT_NAME,
                       C.BASE_UOM_NO,
                       B.UOM_NAME AS BASE_UOM_NAME,
                       C.CONVERT_UOM_NO,
                       V.UOM_NAME AS CONVERT_UOM_NAME,
                       C.CONVERSION_FACTOR,
                       C.ACTIVE_FLAG,
                       C.CREATED_BY,
                       C.CREATED_DATE,
                       C.UPDATED_BY,
                       C.UPDATED_DATE
                  FROM MST_UOM_CONVERSION C
                       JOIN MST_PRODUCT P
                         ON P.PRODUCT_NO = C.PRODUCT_NO
                       JOIN MST_UOM B
                         ON B.UOM_NO = C.BASE_UOM_NO
                       JOIN MST_UOM V
                         ON V.UOM_NO = C.CONVERT_UOM_NO
                 ORDER BY C.CONVERSION_NO DESC
                ```
        }
        layout {
            sequence: 30
            parentRegion: @product-entrey
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 15633819173708939
        }

