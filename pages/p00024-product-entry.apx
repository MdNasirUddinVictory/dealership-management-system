                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column CONVERT_UOM_NO (
            type: selectList
            heading {
                heading: Convert Uom No
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT U.UOM_NAME D,
                           U.UOM_NO   R
                    FROM MST_UOM U
                    WHERE U.ACTIVE_FLAG = 'Y'
                      AND U.UOM_NO <>
                          (
                              SELECT P.UOM_NO
                                FROM MST_PRODUCT P
                               WHERE P.PRODUCT_NO = :P24_PRODUCT_NO
                          )
                      AND NOT EXISTS
                          (
                              SELECT 1
                                FROM MST_UOM_CONVERSION C
                               WHERE C.PRODUCT_NO = :P24_PRODUCT_NO
                                 AND C.CONVERT_UOM_NO = U.UOM_NO
                                 AND C.CONVERSION_NO <> NVL(:CONVERSION_NO,0)
                          )
                    ORDER BY U.UOM_NAME;
                    ```
                displayExtraValues: false
                nullDisplayValue: --Select--
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: CONVERT_UOM_NO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

