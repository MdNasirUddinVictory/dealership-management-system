    process uom-conversion-save-interactive-grid-data (
        name: UOM Conversion - Save Interactive Grid Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/2/2026 11:53:28 AM (QP5 v5.388) */
                BEGIN
                    ---------------------------------------------------
                    -- PRODUCT VALIDATION
                    ---------------------------------------------------
                
                    IF :P24_PRODUCT_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001,
                                                 'Please save product information first.');
                    END IF;
                
                
                    ---------------------------------------------------
                    -- DELETE
                    ---------------------------------------------------
                    -- Delete করার সময় অন্য validation করার দরকার নেই.
                    ---------------------------------------------------
                
                    IF :APEX$ROW_STATUS = 'D'
                    THEN
                        DELETE FROM MST_UOM_CONVERSION
                              WHERE CONVERSION_NO = :CONVERSION_NO;
                
                        RETURN;
                    END IF;
                
                
                    ---------------------------------------------------
                    -- UOM VALIDATION
                    ---------------------------------------------------
                
                    IF :CONVERT_UOM_NO IS NULL
                    THEN
                        RAISE_APPLICATION_ERROR (-20001, 'Please select UOM.');
                    END IF;
                
                
                    ---------------------------------------------------
                    -- CONVERSION FACTOR VALIDATION
                    ---------------------------------------------------
                
                    IF NVL ( :CONVERSION_FACTOR, 0) <= 0
                    THEN
                        RAISE_APPLICATION_ERROR (
                            -20001,
                            'Conversion factor must be greater than zero.');
                    END IF;
                
                
                    ---------------------------------------------------
                    -- GET BASE UOM
                    ---------------------------------------------------
                
                    DECLARE
                        V_BASE_UOM   NUMBER;
                    BEGIN
                        SELECT UOM_NO
                          INTO V_BASE_UOM
                          FROM MST_PRODUCT
                         WHERE PRODUCT_NO = :P24_PRODUCT_NO;
                
                
                        ---------------------------------------------------
                        -- BASE UOM CANNOT BE CONVERSION UOM
                        ---------------------------------------------------
                
                        IF :CONVERT_UOM_NO = V_BASE_UOM
                        THEN
                            RAISE_APPLICATION_ERROR (
                                -20001,
                                'Base UOM cannot be added as conversion UOM.');
                        END IF;
                
                
                        ---------------------------------------------------
                        -- INSERT
                        ---------------------------------------------------
                
                        IF :APEX$ROW_STATUS = 'C'
                        THEN
                            DECLARE
                                V_CNT   NUMBER;
                            BEGIN
                                SELECT COUNT (*)
                                  INTO V_CNT
                                  FROM MST_UOM_CONVERSION
                                 WHERE     PRODUCT_NO = :P24_PRODUCT_NO
                                       AND CONVERT_UOM_NO = :CONVERT_UOM_NO;
                
                                IF V_CNT > 0
                                THEN
                                    RAISE_APPLICATION_ERROR (
                                        -20001,
                                        'This UOM already exists for the selected product.');
                                END IF;
                            END;
                
                
                            INSERT INTO MST_UOM_CONVERSION (CONVERSION_NO,
                                                            PRODUCT_NO,
                                                            BASE_UOM_NO,
                                                            CONVERT_UOM_NO,
                                                            CONVERSION_FACTOR,
                                                            ACTIVE_FLAG,
                                                            CREATED_BY,
                                                            CREATED_DATE)
                                 VALUES (SEQ_UOM_CONVERSION_NO.NEXTVAL,
                                         :P24_PRODUCT_NO,
                                         V_BASE_UOM,
                                         :CONVERT_UOM_NO,
                                         :CONVERSION_FACTOR,
                                         '1',
                                         :APP_USER,
                                         SYSDATE)
                              RETURNING CONVERSION_NO
                                   INTO :CONVERSION_NO;
                        ---------------------------------------------------
                        -- UPDATE
                        ---------------------------------------------------
                
                        ELSIF :APEX$ROW_STATUS = 'U'
                        THEN
                            DECLARE
                                V_CNT   NUMBER;
                            BEGIN
                                /*
                                   Check duplicate UOM excluding
                                   the current row being updated.
                                */
                
                                SELECT COUNT (*)
                                  INTO V_CNT
                                  FROM MST_UOM_CONVERSION
                                 WHERE     PRODUCT_NO = :P24_PRODUCT_NO
                                       AND CONVERT_UOM_NO = :CONVERT_UOM_NO
                                       AND CONVERSION_NO <> :CONVERSION_NO;
                
                
                                IF V_CNT > 0
                                THEN
                                    RAISE_APPLICATION_ERROR (
                                        -20001,
                                        'This UOM already exists for the selected product.');
                                END IF;
                            END;
                
                
                            UPDATE MST_UOM_CONVERSION
                               SET BASE_UOM_NO = V_BASE_UOM,
                                   CONVERT_UOM_NO = :CONVERT_UOM_NO,
                                   CONVERSION_FACTOR = :CONVERSION_FACTOR,
                                   UPDATED_BY = :APP_USER,
                                   UPDATED_DATE = SYSDATE
                             WHERE CONVERSION_NO = :CONVERSION_NO;
                        END IF;
                    EXCEPTION
                        WHEN NO_DATA_FOUND
                        THEN
                            RAISE_APPLICATION_ERROR (-20001,
                                                     'Product information not found.');
                    END;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 15523754958297431223
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

