    validation minimum-stock-quantity-cannot-be-negative (
        name: Minimum Stock Quantity cannot be negative.
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: :P24_MIN_STOCK_QTY >= 0
        }
        error {
            errorMessage: Minimum Stock Quantity cannot be negative.
            associatedItem: @P24_MIN_STOCK_QTY
        }
    )

    validation new (
        name: RATE VALIDATION
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P24_SALES_RATE >= :P24_PURCHASE_RATE
        }
        error {
            errorMessage: Sales Rate cannot be less than Purchase Rate.
            associatedItem: @P24_SALES_RATE
        }
    )

    validation product-name-duplicate-check (
        name: PRODUCT_NAME_DUPLICATE_CHECK
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM MST_PRODUCT
                WHERE UPPER(PRODUCT_NAME) = UPPER(:P24_PRODUCT_NAME)
                  AND NVL(PRODUCT_NO,0) <> NVL(:P24_PRODUCT_NO,0)
                ```
        }
        error {
            errorMessage: Product Name already exists.
            associatedItem: @P24_PRODUCT_NAME
        }
    )

    validation purchase-rate-must-be-greater-than-zero (
        name: Purchase Rate must be greater than zero.
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: :P24_PURCHASE_RATE > 0
        }
        error {
            errorMessage: Purchase Rate must be greater than zero.
            associatedItem: @P24_PURCHASE_RATE
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM MST_PRODUCT_CATEGORY
                     WHERE CATEGORY_NO = :P24_CATEGORY_NO;
                
                    apex_application.g_print_success_message :=
                        'Product Category has been deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 15523475822929392655
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-product-entry (
        name: Initialize form Product Entry
        type: formInitialization
        formRegion: @new
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15523757229384431246
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P24_PRODUCT_NO IS NULL THEN
                        INSERT INTO MST_PRODUCT (
                            PRODUCT_NO,
                            CATEGORY_NO,
                            PRODUCT_CODE,
                            PRODUCT_NAME,
                            PURCHASE_RATE,
                            SALES_RATE,
                            MIN_STOCK_QTY,
                            ACTIVE_FLAG,
                            UOM_NO,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES (
                            SEQ_PRODUCT_NO.NEXTVAL,
                            :P24_CATEGORY_NO,
                           'PRD' || LPAD(SEQ_PRODUCT_NO.NEXTVAL,4,'0'),
                            :P24_PRODUCT_NAME,
                            :P24_PURCHASE_RATE,
                            :P24_SALES_RATE,
                            :P24_MIN_STOCK_QTY,
                            :P24_ACTIVE_FLAG,
                            :P24_UOM_NO,
                            :APP_USER,
                            SYSDATE
                        );
                
                          APEX_APPLICATION.g_print_success_message :=
                            'Product has been saved successfully.';
                    ELSE
                        UPDATE MST_PRODUCT
                           SET CATEGORY_NO   = :P24_CATEGORY_NO,
                               PRODUCT_NAME  = :P24_PRODUCT_NAME,
                               PURCHASE_RATE = :P24_PURCHASE_RATE,
                               SALES_RATE    = :P24_SALES_RATE,
                               MIN_STOCK_QTY = :P24_MIN_STOCK_QTY,
                               ACTIVE_FLAG   = :P24_ACTIVE_FLAG,
                               UOM_NO        = :P24_UOM_NO,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE PRODUCT_NO    = :P24_PRODUCT_NO;
                
                         
                        APEX_APPLICATION.g_print_success_message :=
                            'Product has been updated successfully.';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 15523475483239392654
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process uom-conversion-save-interactive-grid-data (
        name: UOM Conversion - Save Interactive Grid Data
        type: executeCode
        editableRegion: @uom-conversion
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    ---------------------------------------------------
                    -- Product Saved?
                    ---------------------------------------------------
                
                    IF :P24_PRODUCT_NO IS NULL THEN
                
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            'Please save product information first.'
                        );
                
                    END IF;
                
                    ---------------------------------------------------
                    -- Validation
                    ---------------------------------------------------
                
                    IF :CONVERT_UOM_NO IS NULL THEN
                
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            'Please select UOM.'
                        );
                
                    END IF;
                
                    IF NVL(:CONVERSION_FACTOR,0) <= 0 THEN
                
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            'Conversion factor must be greater than zero.'
                        );
                
                    END IF;
                
                    ---------------------------------------------------
                    -- Base UOM Not Allowed
                    ---------------------------------------------------
                
                    DECLARE
                        V_BASE_UOM NUMBER;
                    BEGIN
                
                        SELECT UOM_NO
                          INTO V_BASE_UOM
                          FROM MST_PRODUCT
                         WHERE PRODUCT_NO = :P24_PRODUCT_NO;
                
                        IF :CONVERT_UOM_NO = V_BASE_UOM THEN
                
                            RAISE_APPLICATION_ERROR
                            (
                                -20001,
                                'Base UOM cannot be added as conversion UOM.'
                            );
                
                        END IF;
                
                    END;
                
                    ---------------------------------------------------
                    -- INSERT
                    ---------------------------------------------------
                
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        DECLARE
                            V_CNT NUMBER;
                        BEGIN
                
                            SELECT COUNT(*)
                              INTO V_CNT
                              FROM MST_UOM_CONVERSION
                             WHERE PRODUCT_NO      = :P24_PRODUCT_NO
                               AND CONVERT_UOM_NO  = :CONVERT_UOM_NO;
                
                            IF V_CNT > 0 THEN
                
                                RAISE_APPLICATION_ERROR
                                (
                                    -20001,
                                    'This UOM already exists for the selected product.'
                                );
                
                            END IF;
                
                        END;
                
                        INSERT INTO MST_UOM_CONVERSION
                        (
                            CONVERSION_NO,
                            PRODUCT_NO,
                            BASE_UOM_NO,
                            CONVERT_UOM_NO,
                            CONVERSION_FACTOR,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        SELECT
                            SEQ_UOM_CONVERSION_NO.NEXTVAL,
                            :P24_PRODUCT_NO,
                            UOM_NO,
                            :CONVERT_UOM_NO,
                            :CONVERSION_FACTOR,
                            'Y',
                            :APP_USER,
                            SYSDATE
                        FROM MST_PRODUCT
                        WHERE PRODUCT_NO = :P24_PRODUCT_NO;
                
                        -- RETURNING CONVERSION_NO
                        -- INTO :CONVERSION_NO;
                
                    ---------------------------------------------------
                    -- UPDATE
                    ---------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        UPDATE MST_UOM_CONVERSION
                           SET CONVERT_UOM_NO   = :CONVERT_UOM_NO,
                               CONVERSION_FACTOR= :CONVERSION_FACTOR,
                               UPDATED_BY       = :APP_USER,
                               UPDATED_DATE     = SYSDATE
                         WHERE CONVERSION_NO = :CONVERSION_NO;
                
                    ---------------------------------------------------
                    -- DELETE
                    ---------------------------------------------------
                
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        DELETE
                          FROM MST_UOM_CONVERSION
                         WHERE CONVERSION_NO = :CONVERSION_NO;
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
