            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: PRODUCT ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PRODUCT_NO,
                       CATEGORY_NO,
                       PRODUCT_CODE,
                       PRODUCT_NAME,
                       PURCHASE_RATE,
                       SALES_RATE,
                       MIN_STOCK_QTY,
                       ACTIVE_FLAG,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE,
                       UOM_NO,
                       DESCRIPTION,
                       BRAND_NO
                  from MST_PRODUCT
                ```
        }
        layout {
            sequence: 10
            parentRegion: @product-entrey
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region product-entrey (
        name: PRODUCT ENTREY
        type: staticContent
