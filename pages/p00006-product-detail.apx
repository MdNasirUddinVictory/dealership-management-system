    region register (
        name: Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                    SELECT
                           P.PRODUCT_NO,
                           C.CATEGORY_NAME,
                           P.PRODUCT_CODE,
                           P.PRODUCT_NAME,
                           U.UOM_CODE,
                           U.UOM_NAME,
                
                           P.PURCHASE_RATE,
                           P.SALES_RATE,
                
                           P.MIN_STOCK_QTY,
                
                           NVL(STK.CURRENT_STOCK,0) AS CURRENT_STOCK,
                
                           CASE
                               WHEN P.ACTIVE_FLAG = 1 THEN 'Active'
                               ELSE 'Inactive'
                           END AS STATUS,
                
                           P.CREATED_BY,
                           P.CREATED_DATE,
                           P.UPDATED_BY,
                           P.UPDATED_DATE
                
                      FROM MST_PRODUCT P
                
                 LEFT JOIN MST_PRODUCT_CATEGORY C
                        ON C.CATEGORY_NO = P.CATEGORY_NO
                
                 LEFT JOIN MST_UOM U
                        ON U.UOM_NO = P.UOM_NO
                
                 LEFT JOIN
                 (
                        SELECT PRODUCT_NO,
                               SUM(NVL(QTY_IN,0) - NVL(QTY_OUT,0)) CURRENT_STOCK
                          FROM TRN_STOCK_LEDGER
                         GROUP BY PRODUCT_NO
                 ) STK
                        ON STK.PRODUCT_NO = P.PRODUCT_NO
                
                     ORDER BY
                           P.PRODUCT_NAME
                );
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
