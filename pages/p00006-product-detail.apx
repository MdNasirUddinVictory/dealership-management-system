    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                    DELETE FROM MST_PRODUCT_CATEGORY
                     WHERE CATEGORY_NO = :P6_CATEGORY_NO;
                
                    apex_application.g_print_success_message :=
                        'Product Category has been deleted successfully.';
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8121371891415049861
        }
    )

    process process-form-entry (
        name: Process form Entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P6_PRODUCT_NO IS NULL THEN
                        INSERT INTO MST_PRODUCT (
                            PRODUCT_NO,
                            CATEGORY_NO,
                            PRODUCT_CODE,
                            PRODUCT_NAME,
                            PURCHASE_RATE,
                            SALES_RATE,
                            MIN_STOCK_QTY,
                            ACTIVE_FLAG,
                            UOM_NO,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES (
                            SEQ_PRODUCT_NO.NEXTVAL,
                            :P6_PRODUCT_CATEGORY,
                           'PRD' || LPAD(SEQ_PRODUCT_NO.NEXTVAL,4,'0'),
                            :P6_PRODUCT_NAME,
                            :P6_PURCHASE_RATE,
                            :P6_SALES_RATE,
                            :P6_MIN_STOCK_QTY,
                            :P6_ACTIVE_FLAG,
                            :P6_UOM_NO,
                            :APP_USER,
                            SYSDATE
                        );
                
                          APEX_APPLICATION.g_print_success_message :=
                            'Product has been saved successfully.';
                    ELSE
                        UPDATE MST_PRODUCT
                           SET CATEGORY_NO   = :P6_CATEGORY_NO,
                               PRODUCT_NAME  = :P6_PRODUCT_NAME,
                               PURCHASE_RATE = :P6_PURCHASE_RATE,
                               SALES_RATE    = :P6_SALES_RATE,
                               MIN_STOCK_QTY = :P6_MIN_STOCK_QTY,
                               ACTIVE_FLAG   = :P6_ACTIVE_FLAG,
                               UOM_NO        = :P6_UOM_NO,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE PRODUCT_NO    = :P6_PRODUCT_NO;
                
                         
                        APEX_APPLICATION.g_print_success_message :=
                            'Product has been updated successfully.';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8121371439552049860
        }
    )

)

