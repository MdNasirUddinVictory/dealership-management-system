    region register (
        name: Product Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    p.product_no,
                    p.product_code,
                    p.product_name,
                
                    /* CATEGORY */
                    c.category_name,
                
                    /* BRAND */
                    b.brand_name,
                
                    /* UOM */
                    u.uom_name,
                
                    /* PRODUCT DESCRIPTION */
                    p.description,
                
                    /* ACTIVE STATUS */
                    CASE
                        WHEN p.active_flag = 'Y' THEN 'Yes'
                        ELSE 'No'
                    END AS active_status,
                
                    /* PURCHASE RATE */
                    NVL(p.purchase_rate, 0) AS purchase_rate,
                
                    /* SALES RATE */
                    NVL(p.sales_rate, 0) AS sales_rate,
                
                    /* TOTAL SOLD QTY */
                    NVL(
                        (
                            SELECT SUM(NVL(d.sales_qty, 0))
                            FROM trn_sales_invoice_dtl d
                            WHERE d.product_no = p.product_no
                        ),
                        0
                    ) AS units,
                
                    /* TOTAL SALES */
                    NVL(
                        (
                            SELECT SUM(NVL(d.total_amount, 0))
                            FROM trn_sales_invoice_dtl d
                            WHERE d.product_no = p.product_no
                        ),
                        0
                    ) AS sales,
                
                    /* NUMBER OF CUSTOMERS */
                    NVL(
                        (
                            SELECT COUNT(DISTINCT m.customer_no)
                            FROM trn_sales_invoice_mst m
                                 JOIN trn_sales_invoice_dtl d
                                   ON d.invoice_no = m.invoice_no
                            WHERE d.product_no = p.product_no
                        ),
                        0
                    ) AS customers,
                
                    /* LAST SOLD DATE */
                    (
                        SELECT MAX(m.invoice_date)
                        FROM trn_sales_invoice_mst m
                             JOIN trn_sales_invoice_dtl d
                               ON d.invoice_no = m.invoice_no
                        WHERE d.product_no = p.product_no
                    ) AS last_date_sold,
                
                    /* IMAGE ID */
                    p.product_no AS img,
                
                    /* PRODUCT DETAIL LINK */
                    apex_util.prepare_url(
                        p_url =>
                              'f?p='
                           || :APP_ID
                           || ':31:'
                           || :APP_SESSION
                           || '::::P31_PRODUCT_NO:'
                           || p.product_no
                    ) AS icon_link,
                
                    /* IMAGE HTML */
                    CASE
                        WHEN NVL(DBMS_LOB.getlength(p.product_image), 0) = 0
                        THEN NULL
                
                        ELSE
                            '<img alt="'
                            || apex_escape.html(p.product_name)
                            || '" title="'
                            || apex_escape.html(p.product_name)
                            || '" '
                            || 'style="border:4px solid #CCC; '
                            || 'border-radius:4px;" '
                            || 'src="'
                            || apex_util.get_blob_file_src(
                                   'P31_PRODUCT_IMAGE',
                                   p.product_no
                               )
                            || '" '
                            || 'height="75" width="75" />'
                    END AS detail_img,
                
                    /* IMAGE URL ONLY */
                    CASE
                        WHEN NVL(DBMS_LOB.getlength(p.product_image), 0) = 0
                        THEN NULL
                
                        ELSE apex_util.get_blob_file_src(
                                 'P31_PRODUCT_IMAGE',
                                 p.product_no
                             )
                    END AS detail_img_no_style
                
                FROM mst_product p
                
                LEFT JOIN mst_product_category c
                       ON c.category_no = p.category_no
                
                LEFT JOIN mst_product_brand b
                       ON b.brand_no = p.brand_no
                
                LEFT JOIN mst_uom u
                       ON u.uom_no = p.uom_no
                
                ORDER BY p.product_name;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
