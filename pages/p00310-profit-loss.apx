page 310 (
    name: Profit & Loss
    alias: PROFIT-LOSS
    title: Profit & Loss
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function openVoucher(pVoucherNo, pvoucherCode, pVoucherType, pVoucherDate, pNarattion) {
                $s('P304_VOUCHER_NO', pVoucherNo);
                $s('P310_VOUCHER_CODE_DISPLAY', pvoucherCode);
                $s('P310_VOUCHER_TYPE_DISPLAY', pVoucherType);
                $s('P310_VOUCHER_DATE_DISPLAY', pVoucherDate);
                $s('P310_NARRATION_DISPLAY', pNarattion);
                apex.region('vioucherViewDtl').refresh();
                openModal('vioucherView');
            
            
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region voucher-mst (
        name: Profit & Loss
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH PL AS
                (
                    SELECT
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE,
                
                           NVL(SUM(D.DEBIT_AMOUNT),0)  DEBIT_AMOUNT,
                           NVL(SUM(D.CREDIT_AMOUNT),0) CREDIT_AMOUNT
                
                    FROM MST_ACCOUNT_HEAD H
                
                    JOIN ACC_VOUCHER_DTL D
                      ON D.ACCOUNT_NO = H.ACCOUNT_NO
                
                    JOIN ACC_VOUCHER_MST M
                      ON M.VOUCHER_NO = D.VOUCHER_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                      AND H.ACCOUNT_TYPE IN ('I','E')
                      AND M.APPROVAL_STATUS = 'A'
                
                    --  AND M.VOUCHER_DATE BETWEEN :P310_FROM_DATE
                    --                         AND :P310_TO_DATE
                
                    GROUP BY
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE
                )
                SELECT
                       ACCOUNT_CODE,
                       ACCOUNT_NAME,
                
                       CASE
                           WHEN ACCOUNT_TYPE = 'I'
                           THEN CREDIT_AMOUNT - DEBIT_AMOUNT
                
                           WHEN ACCOUNT_TYPE = 'E'
                           THEN DEBIT_AMOUNT - CREDIT_AMOUNT
                       END AMOUNT,
                
                       CASE
                           WHEN ACCOUNT_TYPE = 'I'
                           THEN 'Income'
                
                           WHEN ACCOUNT_TYPE = 'E'
                           THEN 'Expense'
                       END ACCOUNT_GROUP
                
                FROM PL
                
                ORDER BY
                       ACCOUNT_TYPE DESC,
                       ACCOUNT_CODE;
                ```
            pageItemsToSubmit: [
                P310_FROM_DATE
                P310_TO_DATE
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 13167483331276548236
        }

        column ACCOUNT_CODE (
            type: plainText
            heading {
                heading: Account Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ACCOUNT_GROUP (
            type: plainText
