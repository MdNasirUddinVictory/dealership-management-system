            ```javascript-browser
            function openVoucher(pVoucherNo, pvoucherCode, pVoucherType, pVoucherDate, pNarattion) {
                $s('P304_VOUCHER_NO', pVoucherNo);
                $s('P310_VOUCHER_CODE_DISPLAY', pvoucherCode);
                $s('P310_VOUCHER_TYPE_DISPLAY', pVoucherType);
                $s('P310_VOUCHER_DATE_DISPLAY', pVoucherDate);
                $s('P310_NARRATION_DISPLAY', pNarattion);
                apex.region('vioucherViewDtl').refresh();
                openModal('vioucherView');
            
            
            }
            ```
