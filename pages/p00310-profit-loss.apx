    region voucher-mst (
        name: Profit & Loss
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/25/2026 4:31:22 PM (QP5 v5.388) */
                DECLARE
                    v_html            CLOB;
                
                    v_total_income    NUMBER := 0;
                    v_total_expense   NUMBER := 0;
                    v_net_profit      NUMBER := 0;
                BEGIN
                    /* =========================================================
                       TOTAL INCOME / EXPENSE
                       ========================================================= */
                
                    WITH
                        PL
                        AS
                            (  SELECT H.ACCOUNT_NO,
                                      H.ACCOUNT_CODE,
                                      H.ACCOUNT_NAME,
                                      H.ACCOUNT_TYPE,
                                      NVL (SUM (D.DEBIT_AMOUNT), 0)      AS DEBIT_AMOUNT,
                                      NVL (SUM (D.CREDIT_AMOUNT), 0)     AS CREDIT_AMOUNT
                                 FROM MST_ACCOUNT_HEAD H
                                      JOIN ACC_VOUCHER_DTL D ON D.ACCOUNT_NO = H.ACCOUNT_NO
                                      JOIN ACC_VOUCHER_MST M ON M.VOUCHER_NO = D.VOUCHER_NO
                                WHERE     H.IS_POSTING = 'Y'
                                      AND H.ACTIVE_STATUS = 'Y'
                                      AND H.ACCOUNT_TYPE IN ('I', 'E')
                                      AND M.APPROVAL_STATUS = 'A'
                                      AND M.VOUCHER_DATE >=
                                          TO_DATE ( :P310_FROM_DATE, 'MM/DD/YYYY')
                                      AND M.VOUCHER_DATE <
                                          TO_DATE ( :P310_TO_DATE, 'MM/DD/YYYY') + 1
                             GROUP BY H.ACCOUNT_NO,
                                      H.ACCOUNT_CODE,
                                      H.ACCOUNT_NAME,
                                      H.ACCOUNT_TYPE),
                        PL_CALCULATION
                        AS
                            (SELECT ACCOUNT_NO,
                                    ACCOUNT_CODE,
                                    ACCOUNT_NAME,
                                    ACCOUNT_TYPE,
                                    CASE
                                        WHEN ACCOUNT_TYPE = 'I'
                                        THEN
                                            CREDIT_AMOUNT - DEBIT_AMOUNT
                                        WHEN ACCOUNT_TYPE = 'E'
                                        THEN
                                            DEBIT_AMOUNT - CREDIT_AMOUNT
                                    END    AS AMOUNT
                               FROM PL)
                    SELECT NVL (SUM (CASE WHEN ACCOUNT_TYPE = 'I' THEN AMOUNT ELSE 0 END), 0),
                           NVL (SUM (CASE WHEN ACCOUNT_TYPE = 'E' THEN AMOUNT ELSE 0 END), 0)
                      INTO v_total_income, v_total_expense
                      FROM PL_CALCULATION;
                
                
                    v_net_profit := v_total_income - v_total_expense;
                
                
                    /* =========================================================
                       HEADER
                       ========================================================= */
                
                    v_html :=
                           '<div style="
                        width:100%;
                        box-sizing:border-box;
                        background:#fff;
                        border:1px solid #e1e5e9;
                        border-radius:8px;
                        overflow:hidden;
                        font-family:Arial,sans-serif;
                    ">
                
                        <!-- HEADER -->
                
                        <div style="
                            padding:15px 16px;
                            background:#fafbfc;
                            border-bottom:1px solid #e4e8ec;
                        ">
                
                            <div style="
                                font-size:20px;
                                font-weight:700;
                                color:#26343f;
                            ">
                                Profit &amp; Loss Statement
                            </div>
                
                            <div style="
                                margin-top:5px;
                                font-size:11px;
                                color:#788692;
                            ">
                                Period:
                                '
                        || TO_CHAR (TO_DATE ( :P310_FROM_DATE, 'MM/DD/YYYY'), 'DD Mon YYYY')
                        || '
                                &nbsp; to &nbsp;
                                '
                        || TO_CHAR (TO_DATE ( :P310_TO_DATE, 'MM/DD/YYYY'), 'DD Mon YYYY')
                        || '
                            </div>
                
                        </div>
                
                
                        <!-- =====================================================
                             SUMMARY CARDS
                             ===================================================== -->
                
                        <div style="
                            display:flex;
                            gap:10px;
                            padding:12px;
                            flex-wrap:wrap;
                        ">
                
                
                            <!-- TOTAL INCOME -->
                
                            <div style="
                                flex:1;
                                min-width:180px;
                                padding:11px 13px;
                                border:1px solid #dce8df;
                                border-radius:6px;
                                background:#f6fbf8;
                            ">
                
                                <div style="
                                    font-size:11px;
                                    color:#71808d;
                                ">
                                    Total Income
                                </div>
                
                                <div style="
                                    margin-top:5px;
                                    font-size:18px;
                                    font-weight:700;
                                    color:#218c4b;
                                ">
                                    ৳ '
                        || TO_CHAR (v_total_income, 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                
                
                            <!-- TOTAL EXPENSE -->
                
                            <div style="
                                flex:1;
                                min-width:180px;
                                padding:11px 13px;
                                border:1px solid #eadede;
                                border-radius:6px;
                                background:#fff8f8;
                            ">
                
                                <div style="
                                    font-size:11px;
                                    color:#71808d;
                                ">
                                    Total Expense
                                </div>
                
                                <div style="
                                    margin-top:5px;
                                    font-size:18px;
                                    font-weight:700;
                                    color:#c0392b;
                                ">
                                    ৳ '
                        || TO_CHAR (v_total_expense, 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                
                
                            <!-- NET PROFIT / LOSS -->
                
                            <div style="
                                flex:1;
                                min-width:180px;
                                padding:11px 13px;
                                border:1px solid '
                        || CASE WHEN v_net_profit >= 0 THEN '#dce8df' ELSE '#eadede' END
                        || ';
                                border-radius:6px;
                                background:'
                        || CASE WHEN v_net_profit >= 0 THEN '#f6fbf8' ELSE '#fff8f8' END
                        || ';
                            ">
                
                                <div style="
                                    font-size:11px;
                                    color:#71808d;
                                ">
                                    '
                        || CASE WHEN v_net_profit >= 0 THEN 'Net Profit' ELSE 'Net Loss' END
                        || '
                                </div>
                
                                <div style="
                                    margin-top:5px;
                                    font-size:18px;
                                    font-weight:700;
                                    color:'
                        || CASE WHEN v_net_profit >= 0 THEN '#218c4b' ELSE '#c0392b' END
                        || ';
                                ">
                                    ৳ '
                        || TO_CHAR (ABS (v_net_profit), 'FM999G999G999G990D00')
                        || '
                                </div>
                
                            </div>
                
                        </div>
                
                
                        <!-- =====================================================
                             DETAIL HEADER
                             ===================================================== -->
                
                        <div style="
                            margin:0 12px;
                            border:1px solid #e1e5e9;
                            border-radius:6px;
                            overflow:hidden;
                        ">
                
                            <div style="
                                display:grid;
                                grid-template-columns:110px 1fr 160px;
                                padding:9px 10px;
                                background:#f1f4f7;
                                color:#526170;
                                font-size:11px;
                                font-weight:700;
                            ">
                
                                <div>
                                    Code
                                </div>
                
                                <div>
                                    Account Name
                                </div>
                
                                <div style="
                                    text-align:right;
                                ">
                                    Amount
                                </div>
                
                            </div>';
                
                
                    /* =========================================================
                       INCOME DETAILS
                       ========================================================= */
                
                    v_html := v_html || '<div style="
                        padding:7px 10px;
                        background:#f5fbf7;
                        border-top:1px solid #e1e8e4;
                        border-bottom:1px solid #e1e8e4;
                        color:#218c4b;
                        font-size:11px;
                        font-weight:700;
                    ">
                        INCOME
                    </div>';
                
                
                    FOR R
                        IN (WITH
                                PL
                                AS
                                    (  SELECT H.ACCOUNT_CODE,
                                              H.ACCOUNT_NAME,
                                              H.ACCOUNT_TYPE,
                                              NVL (SUM (D.DEBIT_AMOUNT), 0)     AS DEBIT_AMOUNT,
                                              NVL (SUM (D.CREDIT_AMOUNT), 0)    AS CREDIT_AMOUNT
                                         FROM MST_ACCOUNT_HEAD H
                                              JOIN ACC_VOUCHER_DTL D
                                                  ON D.ACCOUNT_NO = H.ACCOUNT_NO
                                              JOIN ACC_VOUCHER_MST M
                                                  ON M.VOUCHER_NO = D.VOUCHER_NO
                                        WHERE     H.IS_POSTING = 'Y'
                                              AND H.ACTIVE_STATUS = 'Y'
                                              AND H.ACCOUNT_TYPE = 'I'
                                              AND M.APPROVAL_STATUS = 'A'
                                              AND M.VOUCHER_DATE >=
                                                  TO_DATE ( :P310_FROM_DATE, 'MM/DD/YYYY')
                                              AND M.VOUCHER_DATE <
                                                  TO_DATE ( :P310_TO_DATE, 'MM/DD/YYYY') + 1
                                     GROUP BY H.ACCOUNT_CODE, H.ACCOUNT_NAME, H.ACCOUNT_TYPE)
                              SELECT ACCOUNT_CODE,
                                     ACCOUNT_NAME,
                                     CREDIT_AMOUNT - DEBIT_AMOUNT     AS AMOUNT
                                FROM PL
                               WHERE CREDIT_AMOUNT - DEBIT_AMOUNT <> 0
                            ORDER BY ACCOUNT_CODE)
                    LOOP
                        v_html :=
                               v_html
                            || '<div style="
                            display:grid;
                            grid-template-columns:110px 1fr 160px;
                            padding:8px 10px;
                            border-bottom:1px solid #f0f2f4;
                            font-size:11px;
                        ">
                
                            <div style="
                                color:#7a8793;
                            ">
                                '
                            || APEX_ESCAPE.HTML (R.ACCOUNT_CODE)
                            || '
                            </div>
                
                            <div style="
                                color:#34424d;
                            ">
                                '
                            || APEX_ESCAPE.HTML (R.ACCOUNT_NAME)
                            || '
                            </div>
                
                            <div style="
                                text-align:right;
                                color:#218c4b;
                                font-weight:600;
                            ">
                                ৳ '
                            || TO_CHAR (R.AMOUNT, 'FM999G999G999G990D00')
                            || '
                            </div>
                
                        </div>';
                    END LOOP;
                
                
                    /* =========================================================
                       EXPENSE HEADER
                       ========================================================= */
                
                    v_html := v_html || '<div style="
                        padding:7px 10px;
                        background:#fff7f7;
                        border-top:1px solid #e8dddd;
                        border-bottom:1px solid #e8dddd;
                        color:#c0392b;
                        font-size:11px;
                        font-weight:700;
                    ">
                        EXPENSE
                    </div>';
                
                
                    /* =========================================================
                       EXPENSE DETAILS
                       ========================================================= */
                
                    FOR R
                        IN (WITH
                                PL
                                AS
                                    (  SELECT H.ACCOUNT_CODE,
                                              H.ACCOUNT_NAME,
                                              NVL (SUM (D.DEBIT_AMOUNT), 0)     AS DEBIT_AMOUNT,
                                              NVL (SUM (D.CREDIT_AMOUNT), 0)    AS CREDIT_AMOUNT
                                         FROM MST_ACCOUNT_HEAD H
                                              JOIN ACC_VOUCHER_DTL D
                                                  ON D.ACCOUNT_NO = H.ACCOUNT_NO
                                              JOIN ACC_VOUCHER_MST M
                                                  ON M.VOUCHER_NO = D.VOUCHER_NO
                                        WHERE     H.IS_POSTING = 'Y'
                                              AND H.ACTIVE_STATUS = 'Y'
                                              AND H.ACCOUNT_TYPE = 'E'
                                              AND M.APPROVAL_STATUS = 'A'
                                              AND M.VOUCHER_DATE >=
                                                  TO_DATE ( :P310_FROM_DATE, 'MM/DD/YYYY')
                                              AND M.VOUCHER_DATE <
                                                  TO_DATE ( :P310_TO_DATE, 'MM/DD/YYYY') + 1
                                     GROUP BY H.ACCOUNT_CODE, H.ACCOUNT_NAME)
                              SELECT ACCOUNT_CODE,
                                     ACCOUNT_NAME,
                                     DEBIT_AMOUNT - CREDIT_AMOUNT     AS AMOUNT
                                FROM PL
                               WHERE DEBIT_AMOUNT - CREDIT_AMOUNT <> 0
                            ORDER BY ACCOUNT_CODE)
                    LOOP
                        v_html :=
                               v_html
                            || '<div style="
                            display:grid;
                            grid-template-columns:110px 1fr 160px;
                            padding:8px 10px;
                            border-bottom:1px solid #f0f2f4;
                            font-size:11px;
                        ">
                
                            <div style="
                                color:#7a8793;
                            ">
                                '
                            || APEX_ESCAPE.HTML (R.ACCOUNT_CODE)
                            || '
                            </div>
                
                            <div style="
                                color:#34424d;
                            ">
                                '
                            || APEX_ESCAPE.HTML (R.ACCOUNT_NAME)
                            || '
                            </div>
                
                            <div style="
                                text-align:right;
                                color:#c0392b;
                                font-weight:600;
                            ">
                                ৳ '
                            || TO_CHAR (R.AMOUNT, 'FM999G999G999G990D00')
                            || '
                            </div>
                
                        </div>';
                    END LOOP;
                    /* =========================================================
                       FINAL SUMMARY
                       ========================================================= */
                
                    v_html :=
                           v_html
                        || '<div style="
                        margin-top:12px;
                        padding:12px;
                        background:#fafbfc;
                        border-top:1px solid #dfe5ea;
                    ">
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            padding:5px 0;
                            font-size:12px;
                        ">
                
                            <span>
                                <b>Total Income</b>
                            </span>
                
                            <b style="color:#218c4b;">
                                ৳ '
                        || TO_CHAR (v_total_income, 'FM999G999G999G990D00')
                        || '
                            </b>
                
                        </div>
                
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            padding:5px 0;
                            font-size:12px;
                        ">
                
                            <span>
                                <b>Total Expense</b>
                            </span>
                
                            <b style="color:#c0392b;">
                                ৳ '
                        || TO_CHAR (v_total_expense, 'FM999G999G999G990D00')
                        || '
                            </b>
                
                        </div>
                
                
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            margin-top:5px;
                            padding:9px 0 2px 0;
                            border-top:1px solid #dfe5ea;
                            font-size:13px;
                        ">
                            <span>
                                <b>'
                        || CASE WHEN v_net_profit >= 0 THEN 'Net Profit' ELSE 'Net Loss' END
                        || '</b>
                            </span>
                
                            <b style="
                                color:'
                        || CASE WHEN v_net_profit >= 0 THEN '#218c4b' ELSE '#c0392b' END
                        || ';
                            ">
                                ৳ '
                        || TO_CHAR (ABS (v_net_profit), 'FM999G999G999G990D00')
                        || '
                            </b>
                        </div>
                
                        <div style="
                            margin-top:9px;
                            padding:8px;
                            border-radius:5px;
                            background:'
                        || CASE WHEN v_net_profit >= 0 THEN '#eaf8ef' ELSE '#fff1f1' END
                        || ';
                            color:'
                        || CASE WHEN v_net_profit >= 0 THEN '#218c4b' ELSE '#c0392b' END
                        || ';
                            text-align:center;
                            font-size:11px;
                            font-weight:700;
                        ">
                            '
                        || CASE
                               WHEN v_net_profit >= 0 THEN '✓ PROFITABLE'
                               ELSE '✕ LOSS'
                           END
                        || '</div>
                
                    </div>
                    </div>
                </div>';
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                            padding:12px;
                            border:1px solid #f1cccc;
                            border-radius:6px;
                            background:#fff5f5;
                            color:#c0392b;
                            font-size:12px;
                        ">
                            <b>Profit &amp; Loss Report Error</b>
                            <br><br>' || APEX_ESCAPE.HTML (SQLERRM) || '
                        </div>';
                END;
                ```
            pageItemsToSubmit: [
                P310_FROM_DATE
                P310_TO_DATE
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region voucher-mst_1 (
        name: Profit & Loss
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH PL AS
                (
                    SELECT
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE,
                
                           NVL(SUM(D.DEBIT_AMOUNT),0)  DEBIT_AMOUNT,
                           NVL(SUM(D.CREDIT_AMOUNT),0) CREDIT_AMOUNT
                
                    FROM MST_ACCOUNT_HEAD H
                
                    JOIN ACC_VOUCHER_DTL D
                      ON D.ACCOUNT_NO = H.ACCOUNT_NO
                
                    JOIN ACC_VOUCHER_MST M
                      ON M.VOUCHER_NO = D.VOUCHER_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                      AND H.ACCOUNT_TYPE IN ('I','E')
                      AND M.APPROVAL_STATUS = 'A'
                
                    --  AND M.VOUCHER_DATE BETWEEN :P310_FROM_DATE
                    --                         AND :P310_TO_DATE
                
                    GROUP BY
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE
                )
                SELECT
                       ACCOUNT_CODE,
                       ACCOUNT_NAME,
                
                       CASE
                           WHEN ACCOUNT_TYPE = 'I'
                           THEN CREDIT_AMOUNT - DEBIT_AMOUNT
                
                           WHEN ACCOUNT_TYPE = 'E'
                           THEN DEBIT_AMOUNT - CREDIT_AMOUNT
                       END AMOUNT,
                
                       CASE
                           WHEN ACCOUNT_TYPE = 'I'
                           THEN 'Income'
                
                           WHEN ACCOUNT_TYPE = 'E'
                           THEN 'Expense'
                       END ACCOUNT_GROUP
                
                FROM PL
                
                ORDER BY
                       ACCOUNT_TYPE DESC,
                       ACCOUNT_CODE;
                ```
            pageItemsToSubmit: [
                P310_FROM_DATE
                P310_TO_DATE
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        config {
            buildOption: @commented-out
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 13167483331276548236
        }

        column ACCOUNT_CODE (
            type: plainText
