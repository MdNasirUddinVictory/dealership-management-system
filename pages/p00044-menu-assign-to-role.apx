    process ajx-grant-obj (
        name: AJX_GRANT_OBJ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/6/2026 5:44:58 PM (QP5 v5.388) */
                DECLARE
                    V_MSG   VARCHAR2 (100);
                    V_PK    NUMBER;
                
                    CURSOR CUR_ROLE IS
                        SELECT ROLE_NO
                          FROM SA_ROLE
                         WHERE     INSTR (',' || APEX_APPLICATION.G_X01 || ',',
                                          ',' || ROLE_NO || ',') >
                                   0
                               AND ACTIVE_FLAG = 1;
                
                    CURSOR CUR_MENU IS
                        SELECT SUBMENU_NO
                          FROM SA_SUBMENU
                         WHERE INSTR (',' || APEX_APPLICATION.G_X02 || ',',
                                      ',' || SUBMENU_NO || ',') >
                               0;
                BEGIN
                    APEX_JSON.OPEN_OBJECT;
                
                    FOR I IN CUR_ROLE
                    LOOP
                        FOR K IN CUR_MENU
                        LOOP
                            SELECT NVL (MAX (TO_NUMBER (GR_OBJECT_NO)), 0) + 1
                              INTO V_PK
                              FROM SA_GRANTOBJECT;
                
                            INSERT INTO SA_GRANTOBJECT (GR_OBJECT_NO,
                                                        SUBMENU_NO,
                                                        ROLE_NO,
                                                        CAN_VIEW,
                                                        CAN_MODIFY,
                                                        CAN_REMOVE,
                                                        CAN_SHARE,
                                                        CAN_CREATE,
                                                        ACTIVE_FLAG,
                                                        USER_NO)
                                 VALUES (V_PK,
                                         K.SUBMENU_NO,
                                         I.ROLE_NO,
                                         1,
                                         1,
                                         1,
                                         1,
                                         1,
                                         1,
                                         -1);
                        END LOOP;
                    END LOOP;
                
                    V_MSG := 'Role Permission Granted Successfully';
                
                    APEX_JSON.WRITE ('stat', '200');
                    APEX_JSON.WRITE ('message', V_MSG);
                    APEX_JSON.CLOSE_ALL;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        APEX_JSON.WRITE ('stat', '400');
                        APEX_JSON.WRITE ('message', SQLERRM);
                        APEX_JSON.CLOSE_ALL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 14709690902244039
        }
    )

    process grand-object-save-interactive-grid-data (
        name: GRAND-OBJECT - Save Interactive Grid Data
        type: executeCode
        editableRegion: @grand-object
        source {
            plsqlCode:
                ```plsql
                CASE :APEX$ROW_STATUS WHEN 'C' THEN NULL;
                WHEN  'U' THEN NULL;
                WHEN 'D' THEN 
                DELETE SA_GRANTOBJECT
                WHERE GR_OBJECT_NO = :GR_OBJECT_NO;
                END CASE;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 14701980372243990
        }
    )

)

