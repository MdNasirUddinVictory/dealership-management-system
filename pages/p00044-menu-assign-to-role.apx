page 44 (
    name: Menu Assign To Role
    alias: MENU-ASSIGN-TO-ROLE
    title: Menu Assign To Role
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function grantObject() {
                var roleNo = $v('P44_ROLE_NO');
                var submenuNo = $v('P44_SUBMENU_NO');
            
                if (!roleNo) {
                    apex.message.alert('Please select a role.');
                    return;
                }
            
                if (!submenuNo) {
                    apex.message.alert('Please select at least one page.');
                    return;
                }
            
                apex.server.process(
                    'AJX_GRANT_OBJ',
                    {
                        x01: roleNo,       // ROLE_NO
                        x02: submenuNo     // SUBMENU_NO
                    },
                    {
                        success: function (pData) {
                            console.log(pData);
            
                            if (String(pData.stat) === '200') {
                                apex.message.showPageSuccess(
                                    pData.message || 'Role permission inserted successfully.'
                                );
            
                                apex.region('object').refresh();
                                apex.region('submenu').refresh();
                            } else {
                                apex.message.showErrors([
                                    {
                                        type: 'error',
                                        location: 'page',
                                        message: pData.message || 'Role permission insert failed.',
                                        unsafe: false
                                    }
                                ]);
                            }
                        },
            
                        error: function (jqXHR, textStatus, errorThrown) {
                            console.log(jqXHR.responseText);
            
                            apex.message.showErrors([
                                {
                                    type: 'error',
                                    location: 'page',
                                    message: errorThrown || 'Something went wrong.',
                                    unsafe: false
                                }
                            ]);
                        },
            
                        dataType: 'json'
                    }
                );
            }
            ```
    }
    css {
        inline:
            ```css
            div#userpermission .t-Region-header {
                height: 35px;
                /* line-height: 28px; */
            }
            
            #userpermission_heading{
                text-align: center;
                font-weight: 700;
            }
            
            #userperm{
              font-size: x-large;
                color: #b90b0b;
                font-weight: 700;
                font-synthesis-small-caps: revert-layer;
                font-synthesis-style: none;  
            }
            
            
            ```
    }
