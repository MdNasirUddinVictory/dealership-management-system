    region grand-object (
        name: GRAND-OBJECT
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select M.GR_OBJECT_NO,
                       M.SUBMENU_NO,
                       U.ROLE_NAME,
                       M.CAN_VIEW,
                       M.CAN_MODIFY,
                       M.CAN_REMOVE,
                       M.CAN_SHARE,
                       M.CAN_CREATE,
                       M.ROLE_NO,
                       SM.SUBMENU_NAME
                  from SA_GRANTOBJECT M,SA_ROLE U,SA_SUBMENU SM
                  WHERE M.ROLE_NO = U.ROLE_NO(+)
                  AND M.SUBMENU_NO = SM.SUBMENU_NO(+)
                  AND  M.ROLE_NO = :P44_ROLE_NO
                ```
            pageItemsToSubmit: P44_ROLE_NO
        }
        layout {
            sequence: 40
            parentRegion: @div-id-userperm-class-fa-fa-pencile-user-wise-menu-permission-div
            slot: subRegions
            startNewRow: false
        }
