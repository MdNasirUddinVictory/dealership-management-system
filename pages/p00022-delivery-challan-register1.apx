            ```javascript-browser
            function f_openModal(deliveryNo) {
            
                apex.item("P22_DELIVERY_NO").setValue(deliveryNo);
            
                openModal('challan_approve');
            
                apex.region('challan-detail').refresh();
            
            }
            
            ```
    }
    security {
