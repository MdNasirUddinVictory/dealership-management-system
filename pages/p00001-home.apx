page 1 (
    name: Home
    alias: HOME
    title: Dealer Inventory & Sales Management System
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        // formAutoComplete: false
    }

    region dealer-inventory-sales-management-system (
        name: Dealer Inventory & Sales Management System
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

)

