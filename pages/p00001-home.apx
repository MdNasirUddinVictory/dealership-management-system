                    </div>
                </div>
                
                <style>
                /* =================================
                   QUICK ACTIONS - COMPACT POS STYLE
                   ================================= */
                
                /* Region Body */
                #quick_actions .t-Region-body {
                    padding: 6px 8px !important;
                }
                
                /* Main Container */
                .quick-actions {
                    width: 100%;
                    font-family: inherit;
                    box-sizing: border-box;
                }
                
                /* Header */
                .qa-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    margin: 0 0 8px;
                }
                
                .qa-header h3 {
                    margin: 0;
                    font-size: 16px;
                    font-weight: 750;
                    color: #172033;
                    letter-spacing: -.3px;
                    line-height: 20px;
                }
                
                .qa-header p {
                    margin: 2px 0 0;
                    font-size: 10px;
                    line-height: 14px;
                    color: #8490a3;
                }
                
                .qa-bolt {
                    font-size: 17px;
                    color: #8b5cf6;
                    padding: 3px;
                }
                
                /* Grid */
                .qa-grid {
                    display: grid;
                    grid-template-columns: repeat(5, minmax(0, 1fr));
                    gap: 8px;
                    align-items: stretch;
                }
                
                /* Cards */
                .qa-card {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                
                    width: 100%;
                    min-width: 0;
                    min-height: 88px;
                
                    padding: 7px 5px;
                    box-sizing: border-box;
                
                    text-align: center;
                    text-decoration: none !important;
                
                    background: #ffffff;
                    border: 1px solid #edf0f5;
                    border-radius: 10px;
                
                    box-shadow: 0 2px 6px rgba(15, 23, 42, .035);
                
                    transition:
                        transform .18s ease,
                        box-shadow .18s ease,
                        border-color .18s ease;
                }
                
                /* Hover */
                .qa-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 12px rgba(15, 23, 42, .08);
                    border-color: #d8d7fe;
                    text-decoration: none !important;
                }
                
                /* Keyboard Focus */
                .qa-card:focus-visible {
                    outline: 2px solid #818cf6;
                    outline-offset: 2px;
                }
                
                /* Icon Box */
                .qa-icon {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                
                    width: 32px;
                    height: 32px;
                    min-height: 32px;
                
                    margin: 0 0 5px;
                    border-radius: 9px;
                
                    font-size: 15px;
                    flex-shrink: 0;
                }
                
                /* Purple Icons */
                .qa-purple .qa-icon,
                .qa-violet .qa-icon {
                    background: #f0eaff;
                    color: #7950d8;
                }
                
                /* Green Icon */
                .qa-green .qa-icon {
                    background: #e3f9ed;
                    color: #16a36a;
                }
                
                /* Orange Icon */
                .qa-orange .qa-icon {
                    background: #fff0dd;
                    color: #df8b22;
                }
                
                /* Card Title */
                .qa-title {
                    margin: 0 0 2px;
                    font-size: 11px;
                    font-weight: 750;
                    line-height: 14px;
                    color: #202b3c;
                }
                
                /* Card Description */
                .qa-desc {
                    margin: 0;
                    font-size: 9px;
                    font-weight: 400;
                    line-height: 12px;
                    color: #8490a3;
                }
                
                /* Remove unwanted link styling */
                .qa-card:visited,
                .qa-card:active {
                    text-decoration: none !important;
                }
                
                /* Tablet */
                @media (max-width: 900px) {
                    .qa-grid {
                        grid-template-columns: repeat(3, minmax(0, 1fr));
                        gap: 8px;
                    }
                }
                
                /* Mobile */
                @media (max-width: 520px) {
                    #quick_actions .t-Region-body {
                        padding: 6px !important;
                    }
                
                    .qa-header {
                        margin-bottom: 7px;
                    }
                
                    .qa-grid {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                        gap: 7px;
                    }
                
                    .qa-card {
                        min-height: 84px;
                        padding: 6px 4px;
                    }
                
                    .qa-icon {
                        width: 30px;
                        height: 30px;
                        min-height: 30px;
                        font-size: 14px;
                        margin-bottom: 4px;
                    }
                
                    .qa-title {
                        font-size: 11px;
                    }
                
                    .qa-desc {
                        font-size: 9px;
                    }
                }
                </style>
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region today-sales-return-trend (
        name: Today Sales & Return Trend
        type: chart
        layout {
            sequence: 30
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
            ]
        }
        chart {
            type: pie
        }
        title {
            title: Today Sales & Return Trend
        }
        chartLayout {
            height: 300
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new_1 (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH CHART_DATA AS
                    (
                        SELECT
                            'Sales' AS LABEL,
                            NVL(SUM(TOTAL_AMOUNT), 0) AS VALUE
                        FROM WKSP_WSPOS.TRN_SALES_INVOICE_MST
                        WHERE INVOICE_DATE >= TRUNC(SYSDATE)
                          AND INVOICE_DATE < TRUNC(SYSDATE) + 1
                    
                        UNION ALL
                    
                        SELECT
                            'Purchase' AS LABEL,
                            NVL(SUM(TOTAL_AMOUNT), 0) AS VALUE
                        FROM WKSP_WSPOS.TRN_PURCHASE_MST
                        WHERE PURCHASE_DATE >= TRUNC(SYSDATE)
                          AND PURCHASE_DATE < TRUNC(SYSDATE) + 1
                          AND APPROVAL_STATUS = 'A'
                    
                        UNION ALL
                    
                        SELECT
                            'Return' AS LABEL,
                            NVL(SUM(D.TOTAL_AMOUNT), 0) AS VALUE
                        FROM WKSP_WSPOS.TRN_CUSTOMER_RETURN_MST M
                        JOIN WKSP_WSPOS.TRN_CUSTOMER_RETURN_DTL D
                          ON D.RETURN_NO = M.RETURN_NO
                        WHERE M.RETURN_DATE >= TRUNC(SYSDATE)
                          AND M.RETURN_DATE < TRUNC(SYSDATE) + 1
                          AND M.APPROVAL_STATUS = 'A'
                    )
                    SELECT LABEL, VALUE
                    FROM CHART_DATA
                    ORDER BY VALUE DESC;
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
        )

    )

    region weekly-sales-overview (
        name: Weekly Sales & Return Trend
        type: chart
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
            ]
        }
        security {
            escapeSpecialChars: false
        }
        title {
            title: Weekly Sales & Return Trend
        }
        chartLayout {
            height: 300
        }

        series last-7-days-sales (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    
                    WITH DATE_LIST AS (
                        SELECT TRUNC(SYSDATE) - (LEVEL - 1) AS TRAN_DATE
                        FROM DUAL
                        CONNECT BY LEVEL <= 7
                    ),
                    SALES_DATA AS (
                        SELECT TRUNC(INVOICE_DATE) AS TRAN_DATE,
                               SUM(NVL(TOTAL_AMOUNT, 0)) AS AMOUNT
                        FROM WKSP_WSPOS.TRN_SALES_INVOICE_MST
                        WHERE INVOICE_DATE >= TRUNC(SYSDATE) - 6
                          AND INVOICE_DATE < TRUNC(SYSDATE) + 1
                        GROUP BY TRUNC(INVOICE_DATE)
                    ),
                    PURCHASE_DATA AS (
                        SELECT TRUNC(PURCHASE_DATE) AS TRAN_DATE,
                               SUM(NVL(TOTAL_AMOUNT, 0)) AS AMOUNT
                        FROM WKSP_WSPOS.TRN_PURCHASE_MST
                        WHERE PURCHASE_DATE >= TRUNC(SYSDATE) - 6
                          AND PURCHASE_DATE < TRUNC(SYSDATE) + 1
                          AND APPROVAL_STATUS = 'A'
                        GROUP BY TRUNC(PURCHASE_DATE)
                    ),
                    RETURN_DATA AS (
                        SELECT TRUNC(R.RETURN_DATE) AS TRAN_DATE,
                               SUM(NVL(D.TOTAL_AMOUNT, 0)) AS AMOUNT
                        FROM WKSP_WSPOS.TRN_CUSTOMER_RETURN_MST R
                        JOIN WKSP_WSPOS.TRN_CUSTOMER_RETURN_DTL D
                          ON D.RETURN_NO = R.RETURN_NO
                        WHERE R.RETURN_DATE >= TRUNC(SYSDATE) - 6
                          AND R.RETURN_DATE < TRUNC(SYSDATE) + 1
                          AND R.APPROVAL_STATUS = 'A'
                        GROUP BY TRUNC(R.RETURN_DATE)
                    )
                    SELECT TO_CHAR(D.TRAN_DATE, 'DD Mon') AS LABEL,
                           'Sales' AS SERIES_NAME,
                           NVL(S.AMOUNT, 0) AS VALUE
                    FROM DATE_LIST D
                    LEFT JOIN SALES_DATA S
                           ON S.TRAN_DATE = D.TRAN_DATE
                    
                    UNION ALL
                    
                    SELECT TO_CHAR(D.TRAN_DATE, 'DD Mon') AS LABEL,
                           'Purchase' AS SERIES_NAME,
                           NVL(P.AMOUNT, 0) AS VALUE
                    FROM DATE_LIST D
                    LEFT JOIN PURCHASE_DATA P
                           ON P.TRAN_DATE = D.TRAN_DATE
                    
                    UNION ALL
                    
                    SELECT TO_CHAR(D.TRAN_DATE, 'DD Mon') AS LABEL,
                           'Return' AS SERIES_NAME,
                           NVL(R.AMOUNT, 0) AS VALUE
                    FROM DATE_LIST D
                    LEFT JOIN RETURN_DATA R
                           ON R.TRAN_DATE = D.TRAN_DATE
                    
                    ORDER BY 1, 2
                    
                    ```
            }
            columnMapping {
                seriesName: SERIES_NAME
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
        )

    )

)

