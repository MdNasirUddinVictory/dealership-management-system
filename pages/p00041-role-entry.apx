page 41 (
    name: Role Entry
    alias: ROLE-ENTRY
    title: Role Entry
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 50
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region product-entrey (
        name: PRODUCT ENTREY
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region uom-conversion (
        name: ROLE ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROLE_NO,
                       ROLE_CODE,
                       ROLE_NAME,
                       ACTIVE_FLAG,
                       CREATED_BY,
                       CREATED_DATE
                  from SA_ROLE
                ```
        }
        layout {
            sequence: 30
            parentRegion: @product-entrey
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    pageItem P41_ACTIVE_FLAG (
        type: radioGroup
        label {
            label: Active Flag
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Active;1,Inactive;0
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @uom-conversion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @uom-conversion
            column: ACTIVE_FLAG
            dataType: number
        }
    )

    pageItem P41_CREATED_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @uom-conversion
            slot: regionBody
        }
        source {
            formRegion: @uom-conversion
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P41_CREATED_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @uom-conversion
            slot: regionBody
        }
        source {
            formRegion: @uom-conversion
            column: CREATED_DATE
            dataType: date
        }
    )

    pageItem P41_ROLE_CODE (
        type: textField
        label {
            label: Role Code
            alignment: left
        }
        layout {
            sequence: 10
            region: @uom-conversion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @uom-conversion
            column: ROLE_CODE
            dataType: varchar2
        }
    )

    pageItem P41_ROLE_NAME (
        type: textField
        label {
            label: Role Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @uom-conversion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
                t-Form-fieldContainer--slimPadding
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @uom-conversion
            column: ROLE_NAME
            dataType: varchar2
        }
    )

    pageItem P41_ROLE_NO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @uom-conversion
            slot: regionBody
        }
        source {
            formRegion: @uom-conversion
            column: ROLE_NO
            dataType: number
            primaryKey: true
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ROLE_NO
        }
    )

    button new-3 (
        buttonName: New
        label: New
        layout {
            sequence: 10
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                clearCache: 41
                action: clearRegions
            }
        }
        advanced {
            htmlDomId: pb-reset
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-save
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_ROLE_NO
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 30
            region: @breadcrumb-2
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: pb-update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ROLE_NO
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P41_PRODUCT_NO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uom-conversion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P41_ROLE_NO IS NOT NULL THEN
                
                        DELETE FROM SA_GRANTOBJECT
                         WHERE ROLE_NO = :P41_ROLE_NO;
                
                        DELETE FROM SA_ROLE
                         WHERE ROLE_NO = :P41_ROLE_NO;
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Delete Successful
        }
        advanced {
            executionMappingIdentifier: 13866969354460124
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-role-entry (
        name: Initialize form Role Entry
        type: formInitialization
        formRegion: @uom-conversion
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13866038660460115
        }
    )

    process save (
        name: SAVE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P41_ROLE_NO IS NOT NULL THEN
                
                        INSERT INTO SA_ROLE (
                            ROLE_NO,
                            ROLE_CODE,
                            ROLE_NAME,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES (
                            S_SA_ROLE.NEXTVAL,
                            :P41_ROLE_CODE,
                            :P41_ROLE_NAME,
                            NVL(:P41_ACTIVE_FLAG, 1),
                            :APP_USER,
                            SYSDATE
                        );
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Save Successful !
        }
        advanced {
            executionMappingIdentifier: 13866758499460122
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process update (
        name: UPDATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P41_ROLE_NO IS NOT NULL THEN
                
                        UPDATE SA_ROLE
                           SET ROLE_CODE    = :P41_ROLE_CODE,
                               ROLE_NAME    = :P41_ROLE_NAME,
                               ACTIVE_FLAG  = NVL(:P41_ACTIVE_FLAG, 1)
                              -- UPDATED_BY   = :APP_USER,
                            --   UPDATED_DATE = SYSDATE
                         WHERE ROLE_NO = :P41_ROLE_NO;
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Update Successful !
        }
        advanced {
            executionMappingIdentifier: 13866810633460123
        }
        serverSideCondition {
            whenButtonPressed: @update
        }
    )

)

