    process delte (
        name: DELTE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P36_CONVERSION_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Conversion record not found.'
                        );
                    END IF;
                
                    DELETE FROM MST_UOM_CONVERSION
                     WHERE CONVERSION_NO = :P36_CONVERSION_NO;
                
                     :P36_CONVERSION_NO:= NULL;
                
                
                
                
                    IF SQL%ROWCOUNT = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Conversion record not found.'
                        );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 16478967018293916
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-uom-conversion (
        name: "Initialize form UOM Conversion "
        type: formInitialization
        formRegion: @uom-conversion
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15634981674708950
        }
    )

    process process-form-uom-conversion (
        name: Process form UOM Conversion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_base_uom  NUMBER;
                    l_count     NUMBER;
                BEGIN
                    -- Product validation
                    IF :P36_PRODUCT_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please save product information first.'
                        );
                    END IF;
                
                    -- Get product base UOM
                    BEGIN
                        SELECT UOM_NO
                          INTO l_base_uom
                          FROM MST_PRODUCT
                         WHERE PRODUCT_NO = :P36_PRODUCT_NO;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Product information not found.'
                            );
                    END;
                
                    -- Conversion UOM validation
                    IF :P36_CONVERT_UOM_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select conversion UOM.'
                        );
                    END IF;
                
                    -- Base UOM cannot be conversion UOM
                    IF :P36_CONVERT_UOM_NO = l_base_uom THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Base UOM cannot be used as conversion UOM.'
                        );
                    END IF;
                
                    -- Conversion factor validation
                    IF NVL(:P36_CONVERSION_FACTOR, 0) <= 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Conversion factor must be greater than zero.'
                        );
                    END IF;
                
                    -- Duplicate conversion UOM check
                    SELECT COUNT(*)
                      INTO l_count
                      FROM MST_UOM_CONVERSION
                     WHERE PRODUCT_NO = :P36_PRODUCT_NO
                       AND CONVERT_UOM_NO = :P36_CONVERT_UOM_NO
                       AND CONVERSION_NO <> NVL(:P36_CONVERSION_NO, -1);
                
                    IF l_count > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'This UOM conversion already exists for this product.'
                        );
                    END IF;
                
                    -- Insert
                    IF :P36_CONVERSION_NO IS NULL THEN
                
                        INSERT INTO MST_UOM_CONVERSION
                        (
                            CONVERSION_NO,
                            PRODUCT_NO,
                            BASE_UOM_NO,
                            CONVERT_UOM_NO,
                            CONVERSION_FACTOR,
                            ACTIVE_FLAG,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_UOM_CONVERSION_NO.NEXTVAL,
                            :P36_PRODUCT_NO,
                            l_base_uom,
                            :P36_CONVERT_UOM_NO,
                            :P36_CONVERSION_FACTOR,
                            NVL(:P36_ACTIVE_FLAG, '1'),
                            :APP_USER,
                            SYSDATE
                        )
                        RETURNING CONVERSION_NO
                        INTO :P36_CONVERSION_NO;
                
                    -- Update
                    ELSE
                
                        UPDATE MST_UOM_CONVERSION
                           SET BASE_UOM_NO = l_base_uom,
                               CONVERT_UOM_NO = :P36_CONVERT_UOM_NO,
                               CONVERSION_FACTOR = :P36_CONVERSION_FACTOR,
                               ACTIVE_FLAG = NVL(:P36_ACTIVE_FLAG, '1'),
                               UPDATED_BY = :APP_USER,
                               UPDATED_DATE = SYSDATE
                         WHERE CONVERSION_NO = :P36_CONVERSION_NO;
                
                        IF SQL%ROWCOUNT = 0 THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Conversion record not found.'
                            );
                        END IF;
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16478428711293911
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,UPDATE
        }
    )

)

