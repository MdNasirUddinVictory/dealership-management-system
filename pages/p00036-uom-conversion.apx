    region uom-conversion (
        name: UOM Conversion
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.CONVERSION_NO,
                       C.PRODUCT_NO,
                       C.BASE_UOM_NO,
                       C.CONVERT_UOM_NO,
                       C.CONVERSION_FACTOR,
                       C.ACTIVE_FLAG,
                       C.CREATED_BY,
                       C.CREATED_DATE,
                       C.UPDATED_BY,
                       C.UPDATED_DATE
                  FROM MST_UOM_CONVERSION C
                ```
        }
        layout {
            sequence: 30
            parentRegion: @product-entrey
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

