    pageItem P36_BASE_UOM_NO (
        type: selectList
        label {
            label: Base UOM
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT UOM_NAME AS DISPLAY_VALUE,
                       UOM_NO   AS RETURN_VALUE
                  FROM MST_UOM
                 WHERE UOM_NO = (
                           SELECT UOM_NO
                             FROM MST_PRODUCT
                            WHERE PRODUCT_NO = :P36_PRODUCT_NO
                       )
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P36_PRODUCT_NO
            itemsToSubmit: P36_PRODUCT_NO
        }
        layout {
            sequence: 30
            region: @uom-conversion
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
