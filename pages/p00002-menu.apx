                       APEX_PAGE_NO,
                       SUBMENU_ID,
                       MENU_NO,
                       SUBMENU_NAME,
                       SUBMENU_TYPE,
                       ACTIVE_FLAG,
                       HIDE_FROM_MENU,
                       DESCROPTION,
                       SUBMENU_ICON,
                       SL_NO
                  from SA_SUBMENU
                  where MENU_NO = :P2_MENU_NO
