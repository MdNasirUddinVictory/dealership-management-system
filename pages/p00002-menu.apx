    process p-save-menu (
        name: P_SAVE_MENU
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 BEGIN
                
                    IF :P2_MENU_NO IS NULL
                    THEN
                        INSERT INTO SA_MENU (MENU_NO,
                                                    MENU_ID,
                                                    MENU_NAME,
                                                    DESCRIPTION,
                                                    PARENT_MENU_NO,
                                                    SL_NO,
                                                    APP_ID,
                                                    SS_CREATOR,
                                                    SS_CREATED_ON)
                             VALUES ( S_SA_MENU.NEXTVAL,
                                     :P2_MENU_ID,
                                     :P2_MENU_NAME,
                                     :P2_DESCRIPTION,
                                     :P2_PARENT_MENU_NO,
                                     :P2_SL_NO,
                                     :P2_APP_ID,
                                     :G_USER_NO,
                                     --to_date(TO_CHAR (SYSDATE, 'DD-MON-YYYY HH24:MI:SS'))
                                     SYSDATE
                                    )
                                      RETURNING MENU_NO into :P2_MENU_NO;
                                --   :P1011_GREYFABSEND_NO := V_GREYFABSEND_NO;
                    ELSE
                        UPDATE SA_MENU
                           SET MENU_ID = :P2_MENU_ID,
                               MENU_NAME = :P2_MENU_NAME,
                               DESCRIPTION = :P2_DESCRIPTION,
                               PARENT_MENU_NO =:P2_PARENT_MENU_NO,
                               SL_NO =:P2_SL_NO,
                               SS_MODIFIER = :G_USER_NO
                               WHERE MENU_NO =:P2_MENU_NO;
                              -- SS_UPLOADED_ON = TO_CHAR (SYSDATE, 'DD-MON-YYYY HH24:MI:SS');
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &MENU_ID. Is Created !
        }
        advanced {
            executionMappingIdentifier: 8034953009540538123
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process sub-menu-entry-save-interactive-grid-data (
        name: SUB-MENU-ENTRY - Save Interactive Grid Data
        type: executeCode
        editableRegion: @div-id-headtext-class-fa-fa-search-sub-menu-entry-div
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 7/3/2024 10:40:52 AM (QP5 v5.326) */
                DECLARE 
                V_PK_NO NUMBER ;
                
                BEGIN
                    CASE :APEX$ROW_STATUS
                        WHEN 'C'
                        THEN
                        SELECT MAX(NVL(SUBMENU_NO,0))+1 INTO V_PK_NO FROM SA_SUBMENU;
                            INSERT INTO SA_SUBMENU (SUBMENU_NO,
                                                    APEX_PAGE_NO,
                                                    SUBMENU_ID,
                                                    MENU_NO,
                                                    SUBMENU_NAME,
                                                    SUBMENU_TYPE,
                                                    ACTIVE_FLAG,
                                                    HIDE_FROM_MENU,
                                                    DESCROPTION,
                                                    SUBMENU_ICON,
                                                    SL_NO)
                                 VALUES (V_PK_NO,
                                         :APEX_PAGE_NO,
                                         :P2_MENU_ID ||'-'||:SUBMENU_TYPE || LPAD(:APEX_PAGE_NO, 4, '0'),
                                         :P2_MENU_NO,
                                         :SUBMENU_NAME,
                                         :SUBMENU_TYPE,
                                         :ACTIVE_FLAG,
                                         :HIDE_FROM_MENU,
                                         :DESCROPTION,
                                         :SUBMENU_ICON,
                                         :SL_NO)
                              RETURNING SUBMENU_NO
                                   INTO :SUBMENU_NO;
                        WHEN 'U'
                        THEN
                            UPDATE SA_SUBMENU
                               SET APEX_PAGE_NO = :APEX_PAGE_NO,
                                   SUBMENU_ID   = :P2_MENU_ID ||'-'||:SUBMENU_TYPE || LPAD(:APEX_PAGE_NO, 4, '0'),
                                   SUBMENU_NAME = :SUBMENU_NAME,
                                   SUBMENU_TYPE = :SUBMENU_TYPE,
                                   ACTIVE_FLAG = :ACTIVE_FLAG,
                                   HIDE_FROM_MENU = :HIDE_FROM_MENU,
                                   DESCROPTION = :DESCROPTION,
                                   SUBMENU_ICON = :SUBMENU_ICON,
                                   SL_NO        = :SL_NO
                             WHERE SUBMENU_NO = :SUBMENU_NO;
                        WHEN 'D'
                        THEN
                            DELETE SA_SUBMENU
                             WHERE SUBMENU_NO = :SUBMENU_NO;
                    END CASE;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8034944816752538105
        }
    )

)

