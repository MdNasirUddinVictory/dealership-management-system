    region product-details (
        name: Product Details
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PRODUCT_NO,
                       CATEGORY_NO,
                       PRODUCT_CODE,
                       PRODUCT_NAME,
                       PURCHASE_RATE,
                       SALES_RATE,
                       MIN_STOCK_QTY,
                       ACTIVE_FLAG,
                       CREATED_BY,
                       CREATED_DATE,
                       UPDATED_BY,
                       UPDATED_DATE,
                       UOM_NO,
                       DESCRIPTION,
                       BRAND_NO,
                       PRODUCT_IMAGE,
                       MIMETYPE,
                       FILENAME
                  from MST_PRODUCT
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region product-image (
        name: Product Image
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                begin
                if :P31_PRODUCT_NO is not null then
                for c1 in (select nvl(dbms_lob.getlength(product_image),0) A
                from MST_PRODUCT
                where product_NO = :P31_PRODUCT_NO)
                loop
                if c1.A > 0 then
                return true;
                end if;
                end loop;
                end if;
                return false;
                end;
                ```
        }
    )

