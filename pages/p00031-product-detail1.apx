    process delete-image (
        name: DELETE IMAGE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE MST_PRODUCT
                SET product_image=null,
                mimetype=null,
                filename=null
                WHERE product_NO = :P31_PRODUCT_NO;
                ```
        }
        execution {
            sequence: 40
