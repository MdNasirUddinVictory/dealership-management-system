            img {
            width: 100%;
            max-width: 100%;
            height: auto;
            }
            .imgItem::before
            {
            content: 'Nike';
            position: absolute;
            top: 30px;
            left: 20px;
            color: #000;
            opacity: 0.1;
            font-size: 8em;
