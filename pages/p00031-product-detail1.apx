    process initialize-form-product-detail (
        name: Initialize form Product Detail
        type: formInitialization
        formRegion: @product-details
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12464799639822408
        }
    )

    process process-form-product-details (
        name: Process form Product Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/3/2026 12:21:34 PM (QP5 v5.388) */
                DECLARE
                    l_count        NUMBER;
                    l_product_no   NUMBER;
                
                    l_blob         BLOB;
                    l_mimetype     VARCHAR2 (255);
                    l_filename     VARCHAR2 (400);
                
                    l_new_image    BOOLEAN := FALSE;
                BEGIN
                    --------------------------------------------------
                    -- VALIDATION
                    --------------------------------------------------
                    IF :P31_CATEGORY_NO IS NULL
                    THEN
                        raise_application_error (-20001, 'Please select Category.');
                    END IF;
                
                    IF :P31_PRODUCT_NAME IS NULL
                    THEN
                        raise_application_error (-20003, 'Product Name is required.');
                    END IF;
                
                
                    --------------------------------------------------
                    -- DUPLICATE PRODUCT NAME
                    --------------------------------------------------
                    SELECT COUNT (*)
                      INTO l_count
                      FROM mst_product
                     WHERE     UPPER (product_name) = UPPER (TRIM ( :P31_PRODUCT_NAME))
                           AND NVL (product_no, 0) <> NVL ( :P31_PRODUCT_NO, 0);
                
                    IF l_count > 0
                    THEN
                        raise_application_error (-20004, 'Product Name already exists.');
                    END IF;
                
                
                    --------------------------------------------------
                    -- NEW PRODUCT
                    --------------------------------------------------
                    IF :P31_PRODUCT_NO IS NULL
                    THEN
                        --------------------------------------------------
                        -- GET PRODUCT NUMBER
                        --------------------------------------------------
                        SELECT seq_product_no.NEXTVAL INTO l_product_no FROM DUAL;
                
                
                        --------------------------------------------------
                        -- GET NEW IMAGE
                        --------------------------------------------------
                        IF :P31_PRODUCT_IMAGE IS NOT NULL
                        THEN
                            BEGIN
                                SELECT blob_content, mime_type, filename
                                  INTO l_blob, l_mimetype, l_filename
                                  FROM apex_application_temp_files
                                 WHERE name = :P31_PRODUCT_IMAGE;
                
                                l_new_image := TRUE;
                            EXCEPTION
                                WHEN NO_DATA_FOUND
                                THEN
                                    l_blob := NULL;
                                    l_mimetype := NULL;
                                    l_filename := NULL;
                                    l_new_image := FALSE;
                            END;
                        END IF;
                
                
                        --------------------------------------------------
                        -- INSERT
                        --------------------------------------------------
                        INSERT INTO mst_product (product_no,
                                                 category_no,
                                                 product_code,
                                                 product_name,
                                                 purchase_rate,
                                                 sales_rate,
                                                 min_stock_qty,
                                                 active_flag,
                                                 created_by,
                                                 created_date,
                                                 uom_no,
                                                 description,
                                                 brand_no,
                                                 product_image,
                                                 mimetype,
                                                 filename)
                             VALUES (l_product_no,
                                     :P31_CATEGORY_NO,
                                     'PRD' || LPAD (l_product_no, 4, '0'),
                                     TRIM ( :P31_PRODUCT_NAME),
                                     NVL ( :P31_PURCHASE_RATE, 0),
                                     NVL ( :P31_SALES_RATE, 0),
                                     NVL ( :P31_MIN_STOCK_QTY, 0),
                                     NVL ( :P31_ACTIVE_FLAG, 'Y'),
                                     :APP_USER,
                                     SYSDATE,
                                     :P31_UOM_NO,
                                     :P31_DESCRIPTION,
                                     :P31_BRAND_NO,
                                     l_blob,
                                     l_mimetype,
                                     l_filename)
                          RETURNING product_no
                               INTO :P31_PRODUCT_NO;
                
                
                        APEX_APPLICATION.g_print_success_message :=
                            'Product saved successfully.';
                    --------------------------------------------------
                    -- EXISTING PRODUCT UPDATE
                    --------------------------------------------------
                    ELSE
                        --------------------------------------------------
                        -- CHECK WHETHER NEW IMAGE UPLOADED
                        --------------------------------------------------
                        IF :P31_PRODUCT_IMAGE IS NOT NULL
                        THEN
                            BEGIN
                                SELECT blob_content, mime_type, filename
                                  INTO l_blob, l_mimetype, l_filename
                                  FROM apex_application_temp_files
                                 WHERE name = :P31_PRODUCT_IMAGE;
                
                                l_new_image := TRUE;
                            EXCEPTION
                                WHEN NO_DATA_FOUND
                                THEN
                                    l_new_image := FALSE;
                            END;
                        END IF;
                
                
                        --------------------------------------------------
                        -- UPDATE PRODUCT
                        --------------------------------------------------
                        IF l_new_image
                        THEN
                            --------------------------------------------------
                            -- UPDATE WITH NEW IMAGE
                            --------------------------------------------------
                            UPDATE mst_product
                               SET category_no = :P31_CATEGORY_NO,
                                   product_name = TRIM ( :P31_PRODUCT_NAME),
                                   purchase_rate = NVL ( :P31_PURCHASE_RATE, 0),
                                   sales_rate = NVL ( :P31_SALES_RATE, 0),
                                   min_stock_qty = NVL ( :P31_MIN_STOCK_QTY, 0),
                                   active_flag = NVL ( :P31_ACTIVE_FLAG, 'Y'),
                                   uom_no = :P31_UOM_NO,
                                   description = :P31_DESCRIPTION,
                                   brand_no = :P31_BRAND_NO,
                                   product_image = l_blob,
                                   mimetype = l_mimetype,
                                   filename = l_filename,
                                   updated_by = :APP_USER,
                                   updated_date = SYSDATE
                             WHERE product_no = :P31_PRODUCT_NO;
                        ELSE
                            --------------------------------------------------
                            -- UPDATE WITHOUT CHANGING EXISTING IMAGE
                            --------------------------------------------------
                            UPDATE mst_product
                               SET category_no = :P31_CATEGORY_NO,
                                   product_name = TRIM ( :P31_PRODUCT_NAME),
                                   purchase_rate = NVL ( :P31_PURCHASE_RATE, 0),
                                   sales_rate = NVL ( :P31_SALES_RATE, 0),
                                   min_stock_qty = NVL ( :P31_MIN_STOCK_QTY, 0),
                                   active_flag = NVL ( :P31_ACTIVE_FLAG, 'Y'),
                                   uom_no = :P31_UOM_NO,
                                   description = :P31_DESCRIPTION,
                                   brand_no = :P31_BRAND_NO,
                                   updated_by = :APP_USER,
                                   updated_date = SYSDATE
                             WHERE product_no = :P31_PRODUCT_NO;
                        END IF;
                
                
                        --------------------------------------------------
                        -- CHECK UPDATE
                        --------------------------------------------------
                        IF SQL%ROWCOUNT = 0
                        THEN
                            raise_application_error (-20005, 'Product not found.');
                        END IF;
                
                
                        APEX_APPLICATION.g_print_success_message :=
                            'Product updated successfully.';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 12466665637822427
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,UPDATE
        }
    )

)

