    process generate-invoice (
        name: DELIVER_INVOICE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_order_no NUMBER;
                BEGIN
                
                    SELECT ORDER_NO
                      INTO v_order_no
                      FROM TRN_SALES_INVOICE_MST
                     WHERE INVOICE_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Stock Ledger Posting
                    ------------------------------------------------
                
                    INSERT INTO TRN_STOCK_LEDGER
                    (
                        LEDGER_NO,
                        TRAN_DATE,
                        TRAN_TYPE,
                        REF_NO,
                        PRODUCT_NO,
                        QTY_IN,
                        QTY_OUT,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    SELECT
                        SEQ_LEDGER_NO.NEXTVAL,
                        SYSDATE,
                        'SALES',
                        APEX_APPLICATION.G_X01,
                        PRODUCT_NO,
                        0,
                        SALES_QTY,
                        :APP_USER,
                        SYSDATE
                    FROM TRN_SALES_INVOICE_DTL
                    WHERE INVOICE_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Invoice Delivered
                    ------------------------------------------------
                
                    UPDATE TRN_SALES_INVOICE_MST
                       SET DELIVERY_STATUS = 'D',
                           DELIVERY_BY      = :APP_USER,
                           DELIVERY_DATE    = SYSDATE
                     WHERE INVOICE_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Order Delivered
                    ------------------------------------------------
                
                    UPDATE TRN_SALES_ORDER_MST
                       SET ORDER_STATUS = 'D',
                           DELIVERY_BY   = :APP_USER,
                           DELIVERY_DATE = SYSDATE
                     WHERE ORDER_NO = v_order_no;
                
                    COMMIT;
                
                    HTP.P('Invoice delivered successfully.');
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 9018175033799223954
        }
        config {
            buildOption: @commented-out
        }
    )

)

