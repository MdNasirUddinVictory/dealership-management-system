    region register_1 (
        name: SALES INVOICE LIST
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       ROWNUM SL,
                
                       I.INVOICE_NO,
                       I.INVOICE_CODE,
                       I.INVOICE_DATE,
                
                       O.ORDER_CODE,
                
                       C.CUSTOMER_NAME,
                       C.MOBILE_NO,
                
                       --------------------------------------------------
                       -- Invoice Qty
                       --------------------------------------------------
                       NVL(
                           (
                               SELECT SUM(D.SALES_QTY)
                                 FROM TRN_SALES_INVOICE_DTL D
                                WHERE D.INVOICE_NO = I.INVOICE_NO
                           ),
                           0
                       ) TOTAL_INVOICE_QTY,
                
                       --------------------------------------------------
                       -- Delivered Qty
                       --------------------------------------------------
                       NVL(
                           (
                               SELECT SUM(D.DELIVERY_QTY)
                                 FROM TRN_DELIVERY_DTL D
                                 JOIN TRN_DELIVERY_MST M
                                   ON M.DELIVERY_NO = D.DELIVERY_NO
                                WHERE M.INVOICE_NO = I.INVOICE_NO
                                  AND M.APPROVAL_STATUS = 'A'
                           ),
                           0
                       ) TOTAL_DELIVERY_QTY,
                
                       --------------------------------------------------
                       -- Delivery Balance
                       --------------------------------------------------
                       NVL(
                           (
                               SELECT SUM(D.SALES_QTY)
                                 FROM TRN_SALES_INVOICE_DTL D
                                WHERE D.INVOICE_NO = I.INVOICE_NO
                           ),
                           0
                       )
                       -
                       NVL(
                           (
                               SELECT SUM(D.DELIVERY_QTY)
                                 FROM TRN_DELIVERY_DTL D
                                 JOIN TRN_DELIVERY_MST M
                                   ON M.DELIVERY_NO = D.DELIVERY_NO
                                WHERE M.INVOICE_NO = I.INVOICE_NO
                                  AND M.APPROVAL_STATUS = 'A'
                           ),
                           0
                       ) DELIVERY_BALANCE_QTY,
                
                       --------------------------------------------------
                       -- Delivery Challan Count
                       --------------------------------------------------
                       (
                           SELECT COUNT(*)
                             FROM TRN_DELIVERY_MST D
                            WHERE D.INVOICE_NO = I.INVOICE_NO
                       ) DELIVERY_COUNT,
                
                       I.TOTAL_AMOUNT,
                
                       --------------------------------------------------
                       -- Delivery Status
                       --------------------------------------------------
                       CASE
                
                           WHEN
                               NVL(
                                   (
                                       SELECT SUM(D.DELIVERY_QTY)
                                         FROM TRN_DELIVERY_DTL D
                                         JOIN TRN_DELIVERY_MST M
                                           ON M.DELIVERY_NO = D.DELIVERY_NO
                                        WHERE M.INVOICE_NO = I.INVOICE_NO
                                          AND M.APPROVAL_STATUS='A'
                                   ),
                                   0
                               ) = 0
                
                           THEN
                
                               '<span class="t-Badge t-Badge--warning">
                               Waiting Delivery
                               </span>'
                
                           WHEN
                
                               NVL(
                                   (
                                       SELECT SUM(D.DELIVERY_QTY)
                                         FROM TRN_DELIVERY_DTL D
                                         JOIN TRN_DELIVERY_MST M
                                           ON M.DELIVERY_NO = D.DELIVERY_NO
                                        WHERE M.INVOICE_NO = I.INVOICE_NO
                                          AND M.APPROVAL_STATUS='A'
                                   ),
                                   0
                               )
                
                               <
                
                               NVL(
                                   (
                                       SELECT SUM(D.SALES_QTY)
                                         FROM TRN_SALES_INVOICE_DTL D
                                        WHERE D.INVOICE_NO = I.INVOICE_NO
                                   ),
                                   0
                               )
                
                           THEN
                
                               '<span class="t-Badge t-Badge--primary">
                               Partial Delivery
                               </span>'
                
                           ELSE
                
                               '<span class="t-Badge t-Badge--success">
                               Delivered
                               </span>'
                
                       END DELIVERY_STATUS,
                
                       --------------------------------------------------
                       -- Invoice Print
                       --------------------------------------------------
                    --    '<button class="t-Button t-Button--primary t-Button--tiny"
                    --        onclick="printInvoice('||I.INVOICE_NO||')">
                    --        Invoice
                    --    </button>' 
                    NULL
                       PRINT_BTN,
                
                       --------------------------------------------------
                       -- Create Delivery
                       --------------------------------------------------
                       CASE
                
                           WHEN
                               NVL(
                                   (
                                       SELECT SUM(D.DELIVERY_QTY)
                                         FROM TRN_DELIVERY_DTL D
                                         JOIN TRN_DELIVERY_MST M
                                           ON M.DELIVERY_NO=D.DELIVERY_NO
                                        WHERE M.INVOICE_NO=I.INVOICE_NO
                                          AND M.APPROVAL_STATUS='A'
                                   ),
                                   0
                               )
                
                               <
                
                               NVL(
                                   (
                                       SELECT SUM(D.SALES_QTY)
                                         FROM TRN_SALES_INVOICE_DTL D
                                        WHERE D.INVOICE_NO=I.INVOICE_NO
                                   ),
                                   0
                               )
                
                           THEN
                
                            --    '<a href="f?p=&APP_ID.:105:&SESSION.::NO::P105_INVOICE_NO:'
                            --    ||I.INVOICE_NO||
                            --    '" class="t-Button t-Button--success t-Button--tiny">
                            --    Delivery
                            --    </a>' 
                            NULL
                
                       END DELIVERY_BTN,
                
                       --------------------------------------------------
                       -- View Delivery
                       --------------------------------------------------
                       CASE
                
                           WHEN EXISTS
                           (
                               SELECT 1
                                 FROM TRN_DELIVERY_MST D
                                WHERE D.INVOICE_NO=I.INVOICE_NO
                           )
                
                           THEN
                
                               '<a href="f?p=&APP_ID.:106:&SESSION.::NO::P106_INVOICE_NO:'
                               ||I.INVOICE_NO||
                               '" class="t-Button t-Button--info t-Button--tiny">
                               View Delivery
                               </a>'
                
                       END DELIVERY_VIEW_BTN,
                
                       I.CREATED_BY,
                       I.CREATED_DATE
                
                FROM TRN_SALES_INVOICE_MST I
                
                JOIN MST_CUSTOMER C
                  ON C.CUSTOMER_NO = I.CUSTOMER_NO
                
                JOIN TRN_SALES_ORDER_MST O
                  ON O.ORDER_NO = I.ORDER_NO
                
                ORDER BY I.INVOICE_NO DESC;
                ```
            pageItemsToSubmit: P19_STATUS
        }
