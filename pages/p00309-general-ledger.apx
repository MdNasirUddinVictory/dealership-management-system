    region voucher-mst_1 (
        name: General Ledger
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH TB AS
                (
                    SELECT
                        H.ACCOUNT_NO,
                
                        NVL(O.OPENING_DEBIT,0)  OPENING_DEBIT,
                        NVL(O.OPENING_CREDIT,0) OPENING_CREDIT,
                
                        NVL(P.PERIOD_DEBIT,0)   PERIOD_DEBIT,
                        NVL(P.PERIOD_CREDIT,0)  PERIOD_CREDIT
                
                    FROM MST_ACCOUNT_HEAD H
                
                    LEFT JOIN
                    (
                        SELECT
                            ACCOUNT_NO,
                            SUM(OPENING_DEBIT)  OPENING_DEBIT,
                            SUM(OPENING_CREDIT) OPENING_CREDIT
                        FROM ACC_OPENING_BALANCE
                        WHERE APPROVAL_STATUS = 'A'
                        GROUP BY ACCOUNT_NO
                    ) O
                        ON O.ACCOUNT_NO = H.ACCOUNT_NO
                
                    LEFT JOIN
                    (
                        SELECT
                            D.ACCOUNT_NO,
                            SUM(NVL(D.DEBIT_AMOUNT,0))  PERIOD_DEBIT,
                            SUM(NVL(D.CREDIT_AMOUNT,0)) PERIOD_CREDIT
                        FROM ACC_VOUCHER_MST M
                        JOIN ACC_VOUCHER_DTL D
                          ON D.VOUCHER_NO = M.VOUCHER_NO
                        WHERE M.APPROVAL_STATUS = 'A'
                          AND M.VOUCHER_DATE BETWEEN :P309_FROM_DATE
                                                 AND :P309_TO_DATE
                        GROUP BY D.ACCOUNT_NO
                    ) P
                        ON P.ACCOUNT_NO = H.ACCOUNT_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                )
                SELECT
                    SUM(OPENING_DEBIT)  TOTAL_OPENING_DEBIT,
                    SUM(OPENING_CREDIT) TOTAL_OPENING_CREDIT,
                
                    SUM(PERIOD_DEBIT)   TOTAL_PERIOD_DEBIT,
                    SUM(PERIOD_CREDIT)  TOTAL_PERIOD_CREDIT,
                
                    SUM(
                        CASE
                            WHEN (OPENING_DEBIT - OPENING_CREDIT)
                               + (PERIOD_DEBIT - PERIOD_CREDIT) >= 0
                            THEN
                                (OPENING_DEBIT - OPENING_CREDIT)
                               + (PERIOD_DEBIT - PERIOD_CREDIT)
                            ELSE 0
                        END
                    ) TOTAL_CLOSING_DEBIT,
                
                    SUM(
                        CASE
                            WHEN (OPENING_DEBIT - OPENING_CREDIT)
                               + (PERIOD_DEBIT - PERIOD_CREDIT) < 0
                            THEN
                                ABS(
                                    (OPENING_DEBIT - OPENING_CREDIT)
                                   + (PERIOD_DEBIT - PERIOD_CREDIT)
                                )
                            ELSE 0
                        END
                    ) TOTAL_CLOSING_CREDIT
                
                FROM TB;
                ```
            pageItemsToSubmit: [
                P309_FROM_DATE
                P309_TO_DATE
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
