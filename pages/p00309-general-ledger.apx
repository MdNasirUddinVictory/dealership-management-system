    region voucher-mst (
        name: General Ledger
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH OPENING AS
                (
                    SELECT
                           ACCOUNT_NO,
                           NVL(SUM(OPENING_DEBIT),0)  OPENING_DEBIT,
                           NVL(SUM(OPENING_CREDIT),0) OPENING_CREDIT
                    FROM ACC_OPENING_BALANCE
                    WHERE APPROVAL_STATUS = 'A'
                    GROUP BY ACCOUNT_NO
                ),
                PERIOD AS
                (
                    SELECT
                           D.ACCOUNT_NO,
                           NVL(SUM(D.DEBIT_AMOUNT),0)  PERIOD_DEBIT,
                           NVL(SUM(D.CREDIT_AMOUNT),0) PERIOD_CREDIT
                    FROM ACC_VOUCHER_MST M
                         JOIN ACC_VOUCHER_DTL D
                           ON D.VOUCHER_NO = M.VOUCHER_NO
                    WHERE M.APPROVAL_STATUS = 'A'
                      AND M.VOUCHER_DATE BETWEEN :P309_FROM_DATE
                                             AND :P309_TO_DATE
                    GROUP BY D.ACCOUNT_NO
                ),
                TB AS
                (
                    SELECT
                           H.ACCOUNT_NO,
                           H.ACCOUNT_CODE,
                           H.ACCOUNT_NAME,
                           H.ACCOUNT_TYPE,
                
                           NVL(O.OPENING_DEBIT,0)  OPENING_DEBIT,
                           NVL(O.OPENING_CREDIT,0) OPENING_CREDIT,
                
                           NVL(P.PERIOD_DEBIT,0)   PERIOD_DEBIT,
                           NVL(P.PERIOD_CREDIT,0)  PERIOD_CREDIT
                
                    FROM MST_ACCOUNT_HEAD H
                
                         LEFT JOIN OPENING O
                           ON O.ACCOUNT_NO = H.ACCOUNT_NO
                
                         LEFT JOIN PERIOD P
                           ON P.ACCOUNT_NO = H.ACCOUNT_NO
                
                    WHERE H.IS_POSTING = 'Y'
                      AND H.ACTIVE_STATUS = 'Y'
                )
                SELECT
                       ACCOUNT_NO,
                       ACCOUNT_CODE,
                       ACCOUNT_NAME,
                
                       OPENING_DEBIT,
                       OPENING_CREDIT,
                
                       PERIOD_DEBIT,
                       PERIOD_CREDIT,
                
                       CASE
                           WHEN
                               (OPENING_DEBIT - OPENING_CREDIT)
                             + (PERIOD_DEBIT - PERIOD_CREDIT) >= 0
                           THEN
                               (OPENING_DEBIT - OPENING_CREDIT)
                             + (PERIOD_DEBIT - PERIOD_CREDIT)
                
                           ELSE 0
                       END CLOSING_DEBIT,
                
                       CASE
                           WHEN
                               (OPENING_DEBIT - OPENING_CREDIT)
                             + (PERIOD_DEBIT - PERIOD_CREDIT) < 0
                           THEN
                               ABS(
                                   (OPENING_DEBIT - OPENING_CREDIT)
                                 + (PERIOD_DEBIT - PERIOD_CREDIT)
                               )
                
                           ELSE 0
                       END CLOSING_CREDIT,
                
                       CASE
                           WHEN
                               (OPENING_DEBIT - OPENING_CREDIT)
                             + (PERIOD_DEBIT - PERIOD_CREDIT) >= 0
                           THEN 'DR'
                           ELSE 'CR'
                       END BALANCE_TYPE
                
                FROM TB
                
                WHERE
                       OPENING_DEBIT  <> 0
                    OR OPENING_CREDIT <> 0
                    OR PERIOD_DEBIT   <> 0
                    OR PERIOD_CREDIT  <> 0
                
                ORDER BY ACCOUNT_CODE;
                ```
            pageItemsToSubmit: [
                P309_FROM_DATE
                P309_TO_DATE
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
