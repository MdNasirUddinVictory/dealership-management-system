    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region customer-summery (
        name: Customer Summery
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/27/2026 1:52:26 PM (QP5 v5.388) */
                DECLARE
                    v_html   CLOB;
                BEGIN
                    SELECT    '<div id="customer_summary" style="
                            width:100%;
                            max-width:240px;
                            box-sizing:border-box;
                            padding:6px 9px;
                            border:1px solid #e1e5e9;
                            border-radius:5px;
                            background:#fff;
                            font-size:11px;
                            line-height:1.55;
                        ">
                
                        <!-- Customer -->
                        <div style="
                            font-size:12px;
                            font-weight:600;
                            color:#333;
                            margin-bottom:5px;
                            white-space:nowrap;
                            overflow:hidden;
                            text-overflow:ellipsis;
                        ">
                            Customer: '
                           || NVL (C.CUSTOMER_NAME, 'N/A')
                           || '
                        </div>
                
                        <!-- Previous -->
                        <div style="
                            margin-top:2px;
                            margin-bottom:4px;
                            padding:3px 6px;
                            border-left:3px solid #7b8794;
                            background:#f4f6f8;
                            color:#5f6b76;
                            font-size:10px;
                            font-weight:700;
                            text-transform:uppercase;
                            letter-spacing:.5px;
                        ">
                            Customer Due Summary
                        </div>
                
                        <!-- Total Sales -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Total Sales</span>
                            <b>
                                ৳ '
                           || TO_CHAR (NVL (X.SALES_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                        <!-- Received -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Received</span>
                            <b>
                                ৳ '
                           || TO_CHAR (NVL (X.RECEIVED_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                        <!-- Due -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                            border-top:1px solid #eee;
                            margin-top:2px;
                            padding-top:3px;
                        ">
                            <span>Due</span>
                            <b style="
                                color:#c0392b;
                                font-weight:700;
                            ">
                                ৳ '
                           || TO_CHAR (NVL (X.DUE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                        <!-- Payment Status -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Status</span>
                            <b style="
                                color:'
                           || CASE X.PAYMENT_STATUS
                                  WHEN 'Paid' THEN '#27ae60'
                                  WHEN 'Unpaid' THEN '#c0392b'
                                  ELSE '#e67e22'
                              END
                           || ';
                            ">
                                '
                           || NVL (X.PAYMENT_STATUS, 'Unpaid')
                           || '
                            </b>
                        </div>
                
                        </div>'
                      INTO v_html
                      FROM MST_CUSTOMER  C
                           LEFT JOIN
                           (  SELECT I.CUSTOMER_NO,
                                     SUM (NVL (I.TOTAL_AMOUNT, 0))       AS SALES_AMOUNT,
                                     SUM (NVL (I.RECEIVED_AMOUNT, 0))    AS RECEIVED_AMOUNT,
                                     SUM (NVL (I.DUE_AMOUNT, 0))         AS DUE_AMOUNT,
                                     CASE
                                         WHEN SUM (NVL (I.DUE_AMOUNT, 0)) = 0
                                         THEN
                                             'Paid'
                                         WHEN SUM (NVL (I.RECEIVED_AMOUNT, 0)) = 0
                                         THEN
                                             'Unpaid'
                                         ELSE
                                             'Partially Paid'
                                     END                                 AS PAYMENT_STATUS
                                FROM TRN_SALES_INVOICE_MST I
                            GROUP BY I.CUSTOMER_NO) X
                               ON X.CUSTOMER_NO = C.CUSTOMER_NO
                     WHERE C.CUSTOMER_NO = :P17_CUSTOMER_NO;
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                            font-size:11px;
                            color:#777;
                            padding:6px;
                        ">
                            Customer due summary unavailable.
                        </div>' ;
                END;
                ```
            pageItemsToSubmit: P17_CUSTOMER_NO
        }
        layout {
            sequence: 60
            parentRegion: @main
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region entry (
        name: SALES ORDER MST ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 9/9/2026 3:58:23 PM (QP5 v5.388) */
                  SELECT O.ORDER_NO,
                         O.ORDER_CODE,
                         O.ORDER_DATE,
                         O.CUSTOMER_NO,
                         C.CUSTOMER_CODE,
                         C.CUSTOMER_NAME,
                         C.MOBILE_NO,
                         C.ADDRESS,
                         O.ORDER_STATUS,
                         CASE O.ORDER_STATUS
                             WHEN 'P' THEN 'Pending'
                             WHEN 'PI' THEN 'Partially Invoiced'
                             WHEN 'I' THEN 'Invoiced'
                             WHEN 'PD' THEN 'Partially Delivered'
                             WHEN 'D' THEN 'Delivered'
                         END
                             ORDER_STATUS_NAME,
                         O.DELIVERY_ADDRESS,
                         O.CONTACT_NO,
                         O.EXPECTED_DATE,
                         O.REMARKS,
                         O.CREATED_BY,
                         O.CREATED_DATE,
                         O.UPDATED_BY,
                         O.UPDATED_DATE,
                         O.DELIVERY_BY,
                         O.DELIVERY_DATE,
                         NVL (O.TOTAL_AMOUNT, 0)
                             AS TOTAL_ORDER_AMOUNT,
                         NVL (SUM (NVL (D.DISCOUNT_AMOUNT, 0)), 0)
                             AS TOTAL_DISCOUNT,
                         NVL (ROUND (AVG (NVL (D.DISCOUNT_PERCENT, 0)), 2), 0)
                             AS DISCOUNT_PERCENT,
                         NVL (O.TOTAL_AMOUNT, 0) - NVL (SUM (NVL (D.DISCOUNT_AMOUNT, 0)), 0)
                             AS PAYABLE_AMOUNT,
                         O.TOTAL_QTY,
                         I.INVOICE_CNT,
                         I.INVOICE_NO,
                         I.INVOICE_CODE
                    FROM TRN_SALES_ORDER_MST O
                         JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = O.CUSTOMER_NO
                         LEFT JOIN TRN_SALES_ORDER_DTL D ON D.ORDER_NO = O.ORDER_NO
                         LEFT JOIN (  SELECT ORDER_NO,
                                             COUNT (*)              AS INVOICE_CNT,
                                             MAX (INVOICE_NO)       AS INVOICE_NO,
                                             MAX (INVOICE_CODE)     AS INVOICE_CODE
                                        FROM TRN_SALES_INVOICE_MST
                                    GROUP BY ORDER_NO) I
                             ON I.ORDER_NO = O.ORDER_NO
                   WHERE O.ORDER_NO = :P17_ORDER_NO
                GROUP BY O.ORDER_NO,
                         O.ORDER_CODE,
                         O.ORDER_DATE,
                         O.CUSTOMER_NO,
                         C.CUSTOMER_CODE,
                         C.CUSTOMER_NAME,
                         C.MOBILE_NO,
                         C.ADDRESS,
                         O.ORDER_STATUS,
                         O.DELIVERY_ADDRESS,
                         O.CONTACT_NO,
                         O.EXPECTED_DATE,
                         O.REMARKS,
                         O.CREATED_BY,
                         O.CREATED_DATE,
                         O.UPDATED_BY,
                         O.UPDATED_DATE,
                         O.DELIVERY_BY,
                         O.DELIVERY_DATE,
                         O.TOTAL_AMOUNT,
                         O.TOTAL_QTY,
                         I.INVOICE_CNT,
                         I.INVOICE_NO,
                         I.INVOICE_CODE;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

