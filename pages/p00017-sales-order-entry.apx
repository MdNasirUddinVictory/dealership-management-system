    process add-to-cart-product (
        name: ADD_TO_CART_PRODUCT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_DATA CLOB;
                BEGIN
                
                    SELECT JSON_ARRAYAGG(
                               JSON_OBJECT(
                                   'PRODUCT_NO' VALUE P.PRODUCT_NO,
                                   'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                                   'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                                   'DESCRIPTION' VALUE P.DESCRIPTION,
                
                                   /* =========================================
                                      PRODUCT BASE UOM
                                      Example: KG
                                      ========================================= */
                                   'UOM_NAME' VALUE BU.UOM_NAME,
                
                                   /* =========================================
                                      DEFAULT SALES UOM
                                      Product select করলে Base UOM আসবে
                                      Example: KG
                                      ========================================= */
                                   'UOM_NO' VALUE P.UOM_NO,
                
                                   /* =========================================
                                      DEFAULT QUANTITY
                                      ========================================= */
                                   'ORDER_QTY' VALUE 1,
                
                                   /* =========================================
                                      BASE UOM SELECTED
                                      তাই factor = 1
                                      Example: KG = 1
                                      ========================================= */
                                   'PACK_QTY' VALUE 1,
                
                                   /* =========================================
                                      BASE STOCK QUANTITY
                                      ========================================= */
                                   'BASE_QTY' VALUE 1,
                
                                   /* =========================================
                                      BASE UOM SALES PRICE
                                      Example: KG = 80
                                      ========================================= */
                                   'TOTAL_AMOUNT' VALUE NVL(CP.SALES_RATE,0),
                
                                   'SALES_RATE' VALUE NVL(CP.SALES_RATE,0),
                
                                   'BASE_RATE' VALUE NVL(CP.SALES_RATE,0),
                
                                   /* =========================================
                                      CURRENT STOCK
                                      Stock maintained in Base UOM
                                      Example: KG
                                      ========================================= */
                                   'STOCK_QTY' VALUE NVL(S.STOCK_QTY,0),
                
                                   /* =========================================
                                      DISCOUNT PERCENT
                                      ========================================= */
                                   'DISCOUNT_PERCENT' VALUE
                                       NVL(
                                           (
                                               SELECT DC.DISCOUNT_PERCENT
                                                 FROM MST_DISCOUNT_CONFIG DC
                                                WHERE DC.ACTIVE_FLAG = '1'
                                                  AND SYSDATE >= DC.EFFECTIVE_FROM
                                                  AND (
                                                         DC.EFFECTIVE_TO IS NULL
                                                         OR SYSDATE <= DC.EFFECTIVE_TO
                                                      )
                                                  AND (
                                                         DC.PRODUCT_NO = P.PRODUCT_NO
                                                         OR DC.PRODUCT_NO IS NULL
                                                      )
                                                  AND (
                                                         DC.CATEGORY_NO = P.CATEGORY_NO
                                                         OR DC.CATEGORY_NO IS NULL
                                                      )
                                                  AND (
                                                         DC.CUSTOMER_NO =
                                                             APEX_APPLICATION.G_X02
                                                         OR DC.CUSTOMER_NO IS NULL
                                                      )
                                                ORDER BY
                                                    CASE
                                                        WHEN DC.PRODUCT_NO IS NOT NULL THEN 3
                                                        WHEN DC.CATEGORY_NO IS NOT NULL THEN 2
                                                        WHEN DC.CUSTOMER_NO IS NOT NULL THEN 1
                                                        ELSE 0
                                                    END DESC,
                                                    DC.PRIORITY DESC,
                                                    DC.DISCOUNT_CONFIG_NO DESC
                                                FETCH FIRST 1 ROW ONLY
                                           ),
                                           0
                                       ),
                
                                   /* =========================================
                                      DISCOUNT AMOUNT
                                      ========================================= */
                                   'DISCOUNT_AMOUNT' VALUE
                                       ROUND(
                                           NVL(CP.SALES_RATE,0)
                                           *
                                           NVL(
                                               (
                                                   SELECT DC.DISCOUNT_PERCENT
                                                     FROM MST_DISCOUNT_CONFIG DC
                                                    WHERE DC.ACTIVE_FLAG = '1'
                                                      AND SYSDATE >= DC.EFFECTIVE_FROM
                                                      AND (
                                                             DC.EFFECTIVE_TO IS NULL
                                                             OR SYSDATE <= DC.EFFECTIVE_TO
                                                          )
                                                      AND (
                                                             DC.PRODUCT_NO = P.PRODUCT_NO
                                                             OR DC.PRODUCT_NO IS NULL
                                                          )
                                                      AND (
                                                             DC.CATEGORY_NO = P.CATEGORY_NO
                                                             OR DC.CATEGORY_NO IS NULL
                                                          )
                                                      AND (
                                                             DC.CUSTOMER_NO =
                                                                 APEX_APPLICATION.G_X02
                                                             OR DC.CUSTOMER_NO IS NULL
                                                          )
                                                    ORDER BY
                                                        CASE
                                                            WHEN DC.PRODUCT_NO IS NOT NULL THEN 3
                                                            WHEN DC.CATEGORY_NO IS NOT NULL THEN 2
                                                            WHEN DC.CUSTOMER_NO IS NOT NULL THEN 1
                                                            ELSE 0
                                                        END DESC,
                                                        DC.PRIORITY DESC,
                                                        DC.DISCOUNT_CONFIG_NO DESC
                                                    FETCH FIRST 1 ROW ONLY
                                               ),
                                               0
                                           ) / 100,
                                           2
                                       ),
                
                                   /* =========================================
                                      NET AMOUNT
                                      ========================================= */
                                   'NET_AMOUNT' VALUE
                                       ROUND(
                                           NVL(CP.SALES_RATE,0)
                                           -
                                           (
                                               NVL(CP.SALES_RATE,0)
                                               *
                                               NVL(
                                                   (
                                                       SELECT DC.DISCOUNT_PERCENT
                                                         FROM MST_DISCOUNT_CONFIG DC
                                                        WHERE DC.ACTIVE_FLAG = '1'
                                                          AND SYSDATE >= DC.EFFECTIVE_FROM
                                                          AND (
                                                                 DC.EFFECTIVE_TO IS NULL
                                                                 OR SYSDATE <= DC.EFFECTIVE_TO
                                                              )
                                                          AND (
                                                                 DC.PRODUCT_NO =
                                                                     P.PRODUCT_NO
                                                                 OR DC.PRODUCT_NO IS NULL
                                                              )
                                                          AND (
                                                                 DC.CATEGORY_NO =
                                                                     P.CATEGORY_NO
                                                                 OR DC.CATEGORY_NO IS NULL
                                                              )
                                                          AND (
                                                                 DC.CUSTOMER_NO =
                                                                     APEX_APPLICATION.G_X02
                                                                 OR DC.CUSTOMER_NO IS NULL
                                                              )
                                                        ORDER BY
                                                            CASE
                                                                WHEN DC.PRODUCT_NO IS NOT NULL THEN 3
                                                                WHEN DC.CATEGORY_NO IS NOT NULL THEN 2
                                                                WHEN DC.CUSTOMER_NO IS NOT NULL THEN 1
                                                                ELSE 0
                                                            END DESC,
                                                            DC.PRIORITY DESC,
                                                            DC.DISCOUNT_CONFIG_NO DESC
                                                        FETCH FIRST 1 ROW ONLY
                                                   ),
                                                   0
                                               ) / 100
                                           ),
                                           2
                                       )
                
                                   RETURNING CLOB
                               )
                               RETURNING CLOB
                           )
                      INTO V_DATA
                
                      FROM MST_PRODUCT P
                
                      /* =========================================
                         PRODUCT BASE UOM
                         Example: KG
                         ========================================= */
                      JOIN MST_UOM BU
                        ON BU.UOM_NO = P.UOM_NO
                       AND BU.ACTIVE_FLAG = '1'
                
                      /* =========================================
                         CURRENT SALES PRICE
                         
                         IMPORTANT:
                         Populate time Base UOM price নেওয়া হবে।
                         
                         Product Base UOM = KG
                         তাই KG price আসবে।
                         
                         Bag price এখানে আসবে না।
                         User পরে Bag select করলে
                         separate UOM change process
                         Bag price আনবে।
                         ========================================= */
                      LEFT JOIN
                      (
                          SELECT PRODUCT_NO,
                                 UOM_NO,
                                 SALES_RATE,
                                 ROW_NUMBER() OVER(
                                     PARTITION BY PRODUCT_NO, UOM_NO
                                     ORDER BY EFFECTIVE_DATE DESC,
                                              SALES_PRICE_NO DESC
                                 ) RN
                            FROM MST_SALES_PRICE
                           WHERE ACTIVE_FLAG = '1'
                             AND EFFECTIVE_DATE <= SYSDATE
                      ) CP
                        ON CP.PRODUCT_NO = P.PRODUCT_NO
                       AND CP.UOM_NO = P.UOM_NO
                       AND CP.RN = 1
                
                      /* =========================================
                         CURRENT STOCK
                         
                         Stock is always maintained in Base UOM.
                         Example: KG
                         ========================================= */
                      LEFT JOIN
                      (
                          SELECT PRODUCT_NO,
                                 SUM(NVL(QTY_IN,0))
                                 -
                                 SUM(NVL(QTY_OUT,0)) STOCK_QTY
                            FROM TRN_STOCK_LEDGER
                           GROUP BY PRODUCT_NO
                      ) S
                        ON S.PRODUCT_NO = P.PRODUCT_NO
                
                     WHERE P.PRODUCT_NO = APEX_APPLICATION.G_X01
                       AND P.ACTIVE_FLAG = 1;
                
                    /* =========================================
                       RETURN JSON
                       ========================================= */
                    HTP.PRN(
                        NVL(V_DATA,'[]')
                    );
                
                EXCEPTION
                
                    WHEN NO_DATA_FOUND THEN
                
                        HTP.PRN('[]');
                
                    WHEN OTHERS THEN
                
                        HTP.PRN(
                            '{"ERROR":"' ||
                            REPLACE(SQLERRM,'"','\"') ||
                            '"}'
                        );
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 15309683437803527
        }
    )

    process auto-invoice-delivery (
        name: AUTO_INVOICE_DELIVERY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_invoice_code VARCHAR2(100);
                    l_invoice_no   NUMBER;
                BEGIN
                    PROC_AUTO_SALES_ORDER_INVOICE_DELIVERY(
                        p_order_no    => :P17_ORDER_NO,
                        p_app_user    => :G_USER_NO,
                        p_invoice_code => l_invoice_code,
                        p_invoice_no   => l_invoice_no
                    );
                
                    :P17_INVOICE_CODE_HOLD := l_invoice_code;
                    :P17_INVOICE_NO_HOLD   := l_invoice_no;
                
                    :P17_ORDER_NO := NULL;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Sales Order processing failed: ' || SQLERRM
                        );
                END;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            errorMessage:
                ```
                #SQLERRM_TEXT#
                
                ```
        }
        advanced {
            executionMappingIdentifier: 15631123485708912
        }
        serverSideCondition {
            whenButtonPressed: @save
            type: expression
            plsqlExpression: :P17_AUTO_DELIVERY = 1 OR :P17_AUTO_DELIVERY = 1
        }
    )

    process get-product-discount (
        name: GET_PRODUCT_DISCOUNT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/7/2026 2:43:29 PM (QP5 v5.388) */
                DECLARE
                    V_DISCOUNT_PERCENT   NUMBER := 0;
                BEGIN
                    SELECT DISCOUNT_PERCENT
                      INTO V_DISCOUNT_PERCENT
                      FROM (  SELECT D.DISCOUNT_PERCENT
                                FROM MST_DISCOUNT_CONFIG D
                                     JOIN MST_PRODUCT P
                                         ON P.PRODUCT_NO = APEX_APPLICATION.G_X01
                               WHERE     D.ACTIVE_FLAG = 1
                                     AND SYSDATE >= D.EFFECTIVE_FROM
                                     AND (D.EFFECTIVE_TO IS NULL OR SYSDATE <= D.EFFECTIVE_TO)
                                     AND (   D.PRODUCT_NO IS NULL
                                          OR D.PRODUCT_NO = APEX_APPLICATION.G_X01)
                                     AND (   D.CATEGORY_NO IS NULL
                                          OR D.CATEGORY_NO = P.CATEGORY_NO)
                                     AND (   D.CUSTOMER_NO IS NULL
                                          OR D.CUSTOMER_NO = APEX_APPLICATION.G_X02)
                            ORDER BY D.PRIORITY DESC, D.DISCOUNT_CONFIG_NO DESC)
                     WHERE ROWNUM = 1;
                
                    HTP.P (V_DISCOUNT_PERCENT);
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        HTP.P ('0');
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 15160183944336121
        }
    )

    process get-sales-uom-price (
        name: GET_SALES_UOM_PRICE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    L_PRODUCT_NO  NUMBER := TO_NUMBER(APEX_APPLICATION.G_X01);
                    L_UOM_NO      NUMBER := TO_NUMBER(APEX_APPLICATION.G_X02);
                    L_RATE        NUMBER := 0;
                    L_FACTOR      NUMBER := 1;
                BEGIN
                
                    /* Get Sales Rate for Selected UOM */
                    BEGIN
                        SELECT SALES_RATE
                          INTO L_RATE
                          FROM (
                                SELECT SALES_RATE
                                  FROM MST_SALES_PRICE
                                 WHERE PRODUCT_NO = L_PRODUCT_NO
                                   AND UOM_NO = L_UOM_NO
                                   AND ACTIVE_FLAG = '1'
                                   AND EFFECTIVE_DATE <= SYSDATE
                                 ORDER BY EFFECTIVE_DATE DESC,
                                          SALES_PRICE_NO DESC
                               )
                         WHERE ROWNUM = 1;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            L_RATE := 0;
                    END;
                
                
                    /* Get Pack / Conversion Quantity */
                    BEGIN
                        SELECT CASE
                                   /* Base UOM = KG
                                      1 KG = 1 Base Qty */
                                   WHEN L_UOM_NO = C.BASE_UOM_NO
                                   THEN 1
                
                                   /* Convert UOM = BAG
                                      1 BAG = 25 KG */
                                   WHEN L_UOM_NO = C.CONVERT_UOM_NO
                                   THEN C.CONVERSION_FACTOR
                
                                   ELSE 1
                               END
                          INTO L_FACTOR
                          FROM MST_UOM_CONVERSION C
                         WHERE C.PRODUCT_NO = L_PRODUCT_NO
                           AND C.ACTIVE_FLAG = '1'
                           AND (
                                  C.BASE_UOM_NO = L_UOM_NO
                                  OR C.CONVERT_UOM_NO = L_UOM_NO
                               )
                           AND ROWNUM = 1;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            L_FACTOR := 1;
                    END;
                
                
                    /* Return JSON */
                    HTP.P(
                        '{"SALES_RATE":' || NVL(L_RATE, 0) ||
                        ',"PACK_QTY":' || NVL(L_FACTOR, 1) ||
                        '}'
                    );
                
                
                EXCEPTION
                    WHEN OTHERS THEN
                
                        HTP.P(
                            '{"SALES_RATE":0' ||
                            ',"PACK_QTY":1' ||
                            ',"ERROR":"' ||
                            REPLACE(SQLERRM, '"', '\"') ||
                            '"}'
                        );
                
                END;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 16479057007293917
        }
    )

