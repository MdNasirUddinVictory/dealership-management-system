    process new (
        name: CUSTOMER_VALUE_ASSING
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/10/2026 1:11:16 PM (QP5 v5.388) */
                BEGIN
                      SELECT MOBILE_NO, ADDRESS
                        INTO :P17_MOBILE_NO, :P17_ADDRESS
                        FROM MST_CUSTOMER
                       WHERE NVL (ACTIVE_FLAG, 1) = 1 AND CUSTOMER_NO = :P17_CUSTOMER_NO
                    ORDER BY CUSTOMER_NAME;
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        NULL;
                END;
                
