    region customer-summery (
        name: Customer Summery
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                /* Formatted on 8/27/2026 1:52:26 PM (QP5 v5.388) */
                DECLARE
                    v_html   CLOB;
                BEGIN
                    SELECT    '<div id="customer_summary" style="
                            width:100%;
                            max-width:240px;
                            box-sizing:border-box;
                            padding:6px 9px;
                            border:1px solid #e1e5e9;
                            border-radius:5px;
                            background:#fff;
                            font-size:11px;
                            line-height:1.55;
                        ">
                
                        <!-- Customer -->
                        <div style="
                            font-size:12px;
                            font-weight:600;
                            color:#333;
                            margin-bottom:5px;
                            white-space:nowrap;
                            overflow:hidden;
                            text-overflow:ellipsis;
                        ">
                            Customer: '
                           || NVL (C.CUSTOMER_NAME, 'N/A')
                           || '
                        </div>
                
                        <!-- Previous -->
                        <div style="
                            margin-top:2px;
                            margin-bottom:4px;
                            padding:3px 6px;
                            border-left:3px solid #7b8794;
                            background:#f4f6f8;
                            color:#5f6b76;
                            font-size:10px;
                            font-weight:700;
                            text-transform:uppercase;
                            letter-spacing:.5px;
                        ">
                            Customer Due Summary
                        </div>
                
                        <!-- Total Sales -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Total Sales</span>
                            <b>
                                ৳ '
                           || TO_CHAR (NVL (X.SALES_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                        <!-- Received -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Received</span>
                            <b>
                                ৳ '
                           || TO_CHAR (NVL (X.RECEIVED_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                        <!-- Due -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                            border-top:1px solid #eee;
                            margin-top:2px;
                            padding-top:3px;
                        ">
                            <span>Due</span>
                            <b style="
                                color:#c0392b;
                                font-weight:700;
                            ">
                                ৳ '
                           || TO_CHAR (NVL (X.DUE_AMOUNT, 0), 'FM999G999G999G990D00')
                           || '</b>
                        </div>
                
                        <!-- Payment Status -->
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">
                            <span>Status</span>
                            <b style="
                                color:'
                           || CASE X.PAYMENT_STATUS
                                  WHEN 'Paid' THEN '#27ae60'
                                  WHEN 'Unpaid' THEN '#c0392b'
                                  ELSE '#e67e22'
                              END
                           || ';
                            ">
                                '
                           || NVL (X.PAYMENT_STATUS, 'Unpaid')
                           || '
                            </b>
                        </div>
                
                        </div>'
                      INTO v_html
                      FROM MST_CUSTOMER  C
                           LEFT JOIN
                           (  SELECT I.CUSTOMER_NO,
                                     SUM (NVL (I.TOTAL_AMOUNT, 0))       AS SALES_AMOUNT,
                                     SUM (NVL (I.RECEIVED_AMOUNT, 0))    AS RECEIVED_AMOUNT,
                                     SUM (NVL (I.DUE_AMOUNT, 0))         AS DUE_AMOUNT,
                                     CASE
                                         WHEN SUM (NVL (I.DUE_AMOUNT, 0)) = 0
                                         THEN
                                             'Paid'
                                         WHEN SUM (NVL (I.RECEIVED_AMOUNT, 0)) = 0
                                         THEN
                                             'Unpaid'
                                         ELSE
                                             'Partially Paid'
                                     END                                 AS PAYMENT_STATUS
                                FROM TRN_SALES_INVOICE_MST I
                            GROUP BY I.CUSTOMER_NO) X
                               ON X.CUSTOMER_NO = C.CUSTOMER_NO
                     WHERE C.CUSTOMER_NO = :P17_CUSTOMER_NO;
                
                    RETURN v_html;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        RETURN '<div style="
                            font-size:11px;
                            color:#777;
                            padding:6px;
                        ">
                            Customer due summary unavailable.
                        </div>' || sqlerrm;
                END;
                ```
            pageItemsToSubmit: P17_CUSTOMER_NO
        }
