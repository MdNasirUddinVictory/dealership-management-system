    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function addProductToSalesOrder() {
                var productNo = $v('P17_PRODUCT_NO');
                if (!productNo) { return; }
                var model = apex.region('sales_dtl').widget().interactiveGrid('getViews', 'grid').model;
                var duplicate = false;
                model.forEach(function (record) {
                    var existingProduct = model.getValue(record, 'PRODUCT_NO');
                    if (existingProduct != null && String(existingProduct) === String(productNo)) { duplicate = true; }
                });
                if (duplicate) {
                    apex.message.alert('This product is already added.');
                    return;
                }
                apex.server.process('ADD_TO_CART_PRODUCT', { x01: productNo, x02: $v('P17_CUSTOMER_NO') }, {
                    dataType: 'text',
                    success: function (pData) {
                        try {
                            var json = JSON.parse(pData);
                            if (!json || json.length === 0) {
                                apex.message.alert('Product information not found.');
                                return;
                            }
                            var item = json[0];
                            var rec = model.insertNewRecord();
                            model.setRecordValue(rec, 'PRODUCT_NO', item.PRODUCT_NO == null ? '' : String(item.PRODUCT_NO));
                            model.setRecordValue(rec, 'PRODUCT_CODE', item.PRODUCT_CODE == null ? '' : String(item.PRODUCT_CODE));
                            model.setRecordValue(rec, 'PRODUCT_NAME', item.PRODUCT_NAME == null ? '' : String(item.PRODUCT_NAME));
                            model.setRecordValue(rec, 'DESCRIPTION', item.DESCRIPTION == null ? '' : String(item.DESCRIPTION));
                            model.setRecordValue(rec, 'UOM_NO', item.UOM_NO == null ? '' : String(item.UOM_NO));
                            model.setRecordValue(rec, 'UOM_NAME', item.UOM_NAME == null ? '' : String(item.UOM_NAME));
                            model.setRecordValue(rec, 'ORDER_QTY', item.ORDER_QTY == null ? '0' : String(item.ORDER_QTY));
                            model.setRecordValue(rec, 'PACK_QTY', item.PACK_QTY == null ? '0' : String(item.PACK_QTY));
                            model.setRecordValue(rec, 'BASE_QTY', item.BASE_QTY == null ? '0' : String(item.BASE_QTY));
                            model.setRecordValue(rec, 'SALES_RATE', item.SALES_RATE == null ? '0' : String(item.SALES_RATE));
                            model.setRecordValue(rec, 'BASE_RATE', item.BASE_RATE == null ? '0' : String(item.BASE_RATE));
                            model.setRecordValue(rec, 'STOCK_QTY', item.STOCK_QTY == null ? '0' : String(item.STOCK_QTY));
                            model.setRecordValue(rec, 'DISCOUNT_PERCENT', item.DISCOUNT_PERCENT == null ? '0' : String(item.DISCOUNT_PERCENT));
                            model.setRecordValue(rec, 'DISCOUNT_AMOUNT', item.DISCOUNT_AMOUNT == null ? '0' : String(item.DISCOUNT_AMOUNT));
                            model.setRecordValue(rec, 'TOTAL_AMOUNT', item.TOTAL_AMOUNT == null ? '0' : String(item.TOTAL_AMOUNT));
                            var totalAmount = 0;
                            var totalDiscount = 0;
                            model.forEach(function (record) {
                                totalAmount += parseFloat(model.getValue(record, 'SALES_RATE')) || 0;
                                totalDiscount += parseFloat(model.getValue(record, 'DISCOUNT_AMOUNT')) || 0;
                            });
                            var payableAmount = totalAmount - totalDiscount;
                            $s('P17_TOTAL_ORDER_AMOUNT', totalAmount.toFixed(2));
                            $s('P17_TOTAL_DISCOUNT', totalDiscount.toFixed(2));
                            $s('P17_PAYABLE_AMOUNT', payableAmount.toFixed(2));
                            $s('P17_PRODUCT_NO', '');
                            apex.message.showPageSuccess((item.PRODUCT_NAME || 'Product') + ' added successfully.');
                        } catch (e) {
                            console.error('Product JSON Error:', e);
                            console.error('JSON DATA:', pData);
                            apex.message.alert(e.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('ADD_TO_CART_PRODUCT Error:', error);
                        apex.message.alert('Error loading product information.');
                    }
                });
            }
            
            
            
            
            
            
            
            function salesCalculate() {
                var qty = Number($v("ORDER_QTY")) || 0;
                var rate = Number($v("SALES_RATE")) || 0;
                var factor = Number($v("PACK_QTY")) || 1;
                var stock = Number($v("STOCK_QTY")) || 0;
                var customerNo = $v("P17_CUSTOMER_NO");
                var productNo = $v("PRODUCT_NO");
            
                if (factor <= 0) {
                    factor = 1;
                }
            
                var baseQty = qty * factor;
                var grossAmount = qty * rate;
            
                apex.server.process(
                    "GET_PRODUCT_DISCOUNT",
                    {
                        x01: productNo,
                        x02: customerNo
                    },
                    {
                        success: function (data) {
                            var discountPercent = Number(data) || 0;
                            var discountAmount =
                                grossAmount * discountPercent / 100;
            
                            var netAmount = grossAmount - discountAmount;
            
                            $s("BASE_QTY", baseQty);
                            $s("BASE_RATE", (rate / factor).toFixed(2));
                            $s("DISCOUNT_PERCENT", discountPercent.toFixed(2));
                            $s("DISCOUNT_AMOUNT", discountAmount.toFixed(2));
                            $s("TOTAL_AMOUNT", netAmount.toFixed(2));
                        },
                        dataType: "text"
                    }
                );
            
                if (baseQty > stock) {
                    $s("ORDER_QTY", "");
                    $s("BASE_QTY", "");
                    $s("TOTAL_AMOUNT", "");
            
                    apex.message.alert(
                        "Available Stock : " + stock +
                        " | Required : " + baseQty
                    );
                }
            }
            
            
            
            ```
    }
