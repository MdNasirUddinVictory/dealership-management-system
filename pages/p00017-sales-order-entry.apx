    region entry (
        name: SALES ORDER MST ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 7/17/2026 6:02:07 PM (QP5 v5.287) */
                SELECT O.ORDER_NO,
                       O.ORDER_CODE,
                       O.ORDER_DATE,
                       O.CUSTOMER_NO,
                       C.CUSTOMER_CODE,
                       C.CUSTOMER_NAME,
                       C.MOBILE_NO,
                       C.ADDRESS,
                       O.ORDER_STATUS,
                       CASE O.ORDER_STATUS
                          WHEN 'P' THEN 'Pending'
                          WHEN 'PI' THEN 'Partially Invoiced'
                          WHEN 'I' THEN 'Invoiced'
                          WHEN 'PD' THEN 'Partially Delivered'
                          WHEN 'D' THEN 'Delivered'
                       END
                          ORDER_STATUS_NAME,
                       O.DELIVERY_ADDRESS,
                       O.CONTACT_NO,
                       O.EXPECTED_DATE,
                       O.REMARKS,
                       O.CREATED_BY,
                       O.CREATED_DATE,
                       O.UPDATED_BY,
                       O.UPDATED_DATE,
                       O.DELIVERY_BY,
                       O.DELIVERY_DATE,
                       O.TOTAL_AMOUNT,
                       O.TOTAL_QTY,
                       (SELECT COUNT (*) INVOICE_CNT
                          FROM TRN_SALES_INVOICE_MST I
                         WHERE I.ORDER_NO = O.ORDER_NO)
                          INVOICE_CNT
                  FROM TRN_SALES_ORDER_MST O
                       JOIN MST_CUSTOMER C ON C.CUSTOMER_NO = O.CUSTOMER_NO
                 WHERE O.ORDER_NO = :P17_ORDER_NO;
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region register_1 (
        name: "SALES DTL "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                SELECT
                       D.ORDER_DTL_NO,
                       D.ORDER_NO,
                
                       D.PRODUCT_NO,
                       --P.PRODUCT_CODE,
                       --P.PRODUCT_NAME,
                       P.DESCRIPTION,
                       P.BRAND_NO,
                
                       D.UOM_NO,
                       U.UOM_NAME,
                
                       D.PACK_QTY,
                       D.ORDER_QTY,
                       D.BASE_QTY,
                
                       D.SALES_RATE,
                       D.BASE_RATE,
                
                       D.TOTAL_AMOUNT,
                
                       D.INVOICED_QTY,
                       D.DELIVERED_QTY,
                       D.BALANCE_QTY,
                
                       NVL(STK.STOCK_QTY,0) STOCK_QTY,
                
                       D.REMARKS,
                
                       CASE
                           WHEN M.ORDER_STATUS = 'P'
                           THEN 'UD'
                           ELSE 'X'
                       END ROW_STATUS
                
                FROM TRN_SALES_ORDER_DTL D
                
                JOIN TRN_SALES_ORDER_MST M
                  ON M.ORDER_NO = D.ORDER_NO
                
                JOIN MST_PRODUCT P
                  ON P.PRODUCT_NO = D.PRODUCT_NO
                
                LEFT JOIN MST_UOM U
                  ON U.UOM_NO = D.UOM_NO
                
                LEFT JOIN
                (
                    SELECT PRODUCT_NO,
                           SUM(NVL(QTY_IN,0)) - SUM(NVL(QTY_OUT,0)) STOCK_QTY
                      FROM TRN_STOCK_LEDGER
                     GROUP BY PRODUCT_NO
                ) STK
                ON STK.PRODUCT_NO = D.PRODUCT_NO
                
                WHERE D.ORDER_NO = :P17_ORDER_NO
                
                ORDER BY D.ORDER_DTL_NO
                );
                ```
            pageItemsToSubmit: P17_ORDER_NO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
