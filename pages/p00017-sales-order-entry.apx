    dynamicAction new_7 (
        name: DA_DELETE_ROW_SALES_GRID
        execution {
            sequence: 100
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .js-delete-row
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var region = apex.region("sales_dtl");
                    var gridView = region.call("getViews", "grid");
                    var record = gridView.getContextRecord(this.triggeringElement)[0];
                    
                    if (record) {
                        var model = gridView.model;
                    
                        if (model.allowDelete(record)) {
                            model.deleteRecords([record]);
                            calculateSalesTotals();
                        }
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

