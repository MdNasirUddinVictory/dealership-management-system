    process add-to-cart-product (
        name: ADD_TO_CART_PRODUCT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/8/2026 5:08:07 PM (QP5 v5.388) */
                DECLARE
                    V_DATA   CLOB;
                BEGIN
                    SELECT JSON_ARRAYAGG (
                               JSON_OBJECT (
                                   /* =========================================
                                      PRODUCT INFORMATION
                                   ========================================= */
                
                                   'PRODUCT_NO' VALUE P.PRODUCT_NO,
                                   'PRODUCT_CODE' VALUE P.PRODUCT_CODE,
                                   'PRODUCT_NAME' VALUE P.PRODUCT_NAME,
                                   'DESCRIPTION' VALUE P.DESCRIPTION,
                                   /* =========================================
                                      UOM
                                   ========================================= */
                
                                   'UOM_NO' VALUE P.UOM_NO,
                                   'UOM_NAME' VALUE U.UOM_NAME,
                                   /* =========================================
                                      QUANTITY
                                   ========================================= */
                
                                   'ORDER_QTY' VALUE 1,
                                   'PACK_QTY' VALUE  1,
                                  'BASE_QTY' VALUE 1,
                                   /* =========================================
                                      SALES RATE
                                   ========================================= */
                
                                   'SALES_RATE' VALUE NVL (CP.SALES_RATE, 0),
                                   'BASE_RATE' VALUE NVL (CP.SALES_RATE, 0),
                
                                   /* =========================================
                                      STOCK
                                   ========================================= */
                
                                   'STOCK_QTY' VALUE NVL (S.STOCK_QTY, 0),
                                   /* =========================================
                                      DISCOUNT %
                                   ========================================= */
                
                                   'DISCOUNT_PERCENT' VALUE
                                       NVL (
                                           (SELECT DISCOUNT_PERCENT
                                             FROM (  SELECT D.DISCOUNT_PERCENT
                                                       FROM MST_DISCOUNT_CONFIG D
                                                      WHERE     D.ACTIVE_FLAG = 1
                                                            AND SYSDATE >= D.EFFECTIVE_FROM
                                                            AND (   D.EFFECTIVE_TO IS NULL
                                                                 OR SYSDATE <= D.EFFECTIVE_TO)
                                                            AND (   D.PRODUCT_NO IS NULL
                                                                 OR D.PRODUCT_NO = P.PRODUCT_NO)
                                                            AND (   D.CATEGORY_NO IS NULL
                                                                 OR D.CATEGORY_NO =
                                                                    P.CATEGORY_NO)
                                                            AND (   D.CUSTOMER_NO IS NULL
                                                                 OR D.CUSTOMER_NO =
                                                                    APEX_APPLICATION.G_X02)
                                                   ORDER BY D.PRIORITY DESC,
                                                            D.DISCOUNT_CONFIG_NO DESC)
                                            WHERE ROWNUM = 1),
                                           0),
                                   /* =========================================
                                      DISCOUNT AMOUNT
                
                                      Gross = ORDER_QTY × SALES_RATE
                                      Discount = Gross × Discount% / 100
                                   ========================================= */
                
                                   'DISCOUNT_AMOUNT' VALUE
                                       ROUND (
                                             (1 * NVL (CP.SALES_RATE, 0))
                                           * NVL (
                                                 (SELECT DISCOUNT_PERCENT
                                                   FROM (  SELECT D.DISCOUNT_PERCENT
                                                             FROM MST_DISCOUNT_CONFIG D
                                                            WHERE     D.ACTIVE_FLAG = 1
                                                                  AND SYSDATE >=
                                                                      D.EFFECTIVE_FROM
                                                                  AND (   D.EFFECTIVE_TO
                                                                              IS NULL
                                                                       OR SYSDATE <=
                                                                          D.EFFECTIVE_TO)
                                                                  AND (   D.PRODUCT_NO IS NULL
                                                                       OR D.PRODUCT_NO =
                                                                          P.PRODUCT_NO)
                                                                  AND (   D.CATEGORY_NO IS NULL
                                                                       OR D.CATEGORY_NO =
                                                                          P.CATEGORY_NO)
                                                                  AND (   D.CUSTOMER_NO IS NULL
                                                                       OR D.CUSTOMER_NO =
                                                                          APEX_APPLICATION.G_X02)
                                                         ORDER BY D.PRIORITY DESC,
                                                                  D.DISCOUNT_CONFIG_NO DESC)
                                                  WHERE ROWNUM = 1),
                                                 0)
                                           / 100,
                                           2),
                                   /* =========================================
                                      TOTAL AMOUNT
                
                                      Gross - Discount
                                   ========================================= */
                
                                   'TOTAL_AMOUNT' VALUE
                                       ROUND (
                                             (1 * NVL (CP.SALES_RATE, 0))
                                           - (  (1 * NVL (CP.SALES_RATE, 0))
                                              * NVL (
                                                    (SELECT DISCOUNT_PERCENT
                                                      FROM (  SELECT D.DISCOUNT_PERCENT
                                                                FROM MST_DISCOUNT_CONFIG D
                                                               WHERE     D.ACTIVE_FLAG = 1
                                                                     AND SYSDATE >=
                                                                         D.EFFECTIVE_FROM
                                                                     AND (   D.EFFECTIVE_TO
                                                                                 IS NULL
                                                                          OR SYSDATE <=
                                                                             D.EFFECTIVE_TO)
                                                                     AND (   D.PRODUCT_NO
                                                                                 IS NULL
                                                                          OR D.PRODUCT_NO =
                                                                             P.PRODUCT_NO)
                                                                     AND (   D.CATEGORY_NO
                                                                                 IS NULL
                                                                          OR D.CATEGORY_NO =
                                                                             P.CATEGORY_NO)
                                                                     AND (   D.CUSTOMER_NO
                                                                                 IS NULL
                                                                          OR D.CUSTOMER_NO =
                                                                             APEX_APPLICATION.G_X02)
                                                            ORDER BY D.PRIORITY DESC,
                                                                     D.DISCOUNT_CONFIG_NO DESC)
                                                     WHERE ROWNUM = 1),
                                                    0)
                                              / 100),
                                           2)
                                   RETURNING CLOB)
                               RETURNING CLOB)
                      INTO V_DATA
                      FROM MST_PRODUCT  P
                           JOIN MST_UOM U ON U.UOM_NO = P.UOM_NO AND U.ACTIVE_FLAG = '1'
                           /* =========================================
                              CURRENT SALES PRICE
                           ========================================= */
                
                           LEFT JOIN
                           (SELECT PRODUCT_NO,
                                   UOM_NO,
                                   SALES_RATE,
                                   ROW_NUMBER ()
                                       OVER (
                                           PARTITION BY PRODUCT_NO, UOM_NO
                                           ORDER BY EFFECTIVE_DATE DESC, SALES_PRICE_NO DESC)    RN
                              FROM MST_SALES_PRICE
                             WHERE ACTIVE_FLAG = '1' AND EFFECTIVE_DATE <= SYSDATE) CP
                               ON     CP.PRODUCT_NO = P.PRODUCT_NO
                                  AND CP.UOM_NO = P.UOM_NO
                                  AND CP.RN = 1
                           /* =========================================
                              CURRENT STOCK
                           ========================================= */
                
                           LEFT JOIN
                           (  SELECT PRODUCT_NO,
                                     SUM (NVL (QTY_IN, 0)) - SUM (NVL (QTY_OUT, 0))    AS STOCK_QTY
                                FROM TRN_STOCK_LEDGER
                            GROUP BY PRODUCT_NO) S
                               ON S.PRODUCT_NO = P.PRODUCT_NO
                     WHERE P.PRODUCT_NO = APEX_APPLICATION.G_X01 AND P.ACTIVE_FLAG = 1;
                
                    HTP.PRN (NVL (V_DATA, '[]'));
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 15309683437803527
        }
    )

    process get-product-discount (
        name: GET_PRODUCT_DISCOUNT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Formatted on 9/7/2026 2:43:29 PM (QP5 v5.388) */
                DECLARE
                    V_DISCOUNT_PERCENT   NUMBER := 0;
                BEGIN
                    SELECT DISCOUNT_PERCENT
                      INTO V_DISCOUNT_PERCENT
                      FROM (  SELECT D.DISCOUNT_PERCENT
                                FROM MST_DISCOUNT_CONFIG D
                                     JOIN MST_PRODUCT P
                                         ON P.PRODUCT_NO = APEX_APPLICATION.G_X01
                               WHERE     D.ACTIVE_FLAG = 1
                                     AND SYSDATE >= D.EFFECTIVE_FROM
                                     AND (D.EFFECTIVE_TO IS NULL OR SYSDATE <= D.EFFECTIVE_TO)
                                     AND (   D.PRODUCT_NO IS NULL
                                          OR D.PRODUCT_NO = APEX_APPLICATION.G_X01)
                                     AND (   D.CATEGORY_NO IS NULL
                                          OR D.CATEGORY_NO = P.CATEGORY_NO)
                                     AND (   D.CUSTOMER_NO IS NULL
                                          OR D.CUSTOMER_NO = APEX_APPLICATION.G_X02)
                            ORDER BY D.PRIORITY DESC, D.DISCOUNT_CONFIG_NO DESC)
                     WHERE ROWNUM = 1;
                
                    HTP.P (V_DISCOUNT_PERCENT);
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        HTP.P ('0');
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 15160183944336121
        }
    )

