        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                        -- First clear old values
                        :P17_CUSTOMER_NO      := NULL;
                        :P17_CUSTOMER_NAME    := NULL;
                        :P17_DELIVERY_ADDRESS := NULL;
                    
                        BEGIN
                            SELECT CUSTOMER_NO,
                                   CUSTOMER_NAME,
                                   ADDRESS
                              INTO :P17_CUSTOMER_NO,
                                   :P17_CUSTOMER_NAME,
                                   :P17_DELIVERY_ADDRESS
                              FROM (
                                    SELECT CUSTOMER_NO,
                                           CUSTOMER_NAME,
                                           ADDRESS
                                      FROM MST_CUSTOMER
                                     WHERE MOBILE_NO = :P17_MOBILE_NO
                                       AND NVL(ACTIVE_FLAG, 1) = 1
                                     ORDER BY CUSTOMER_NO DESC
                                   )
                             WHERE ROWNUM = 1;
                    
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                NULL;
                        END;
                    
                    END;
                    ```
                itemsToSubmit: P17_MOBILE_NO
                itemsToReturn: [
                    P17_CUSTOMER_NO
                    P17_CUSTOMER_NAME
                    P17_ADDRESS
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new_3 (
        name: New
        execution {
            sequence: 140
        }
        when {
            event: keydown
            selectionType: items
            items: P17_RECEIVED_AMOUNT
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var e = this.browserEvent;
                    
                    if (!e || e.key !== "Enter") {
                        return;
                    }
                    
                    e.preventDefault();
                    e.stopPropagation();
                    
                    var netPay = parseFloat($v("P17_PAYABLE_AMOUNT")) || 0;
                    var receivedAmnt = parseFloat($v("P17_RECEIVED_AMOUNT")) || 0;
                    
                    var $received = $("#P17_RECEIVED_AMOUNT");
                    var $return = $("#P17_RETURN_AMOUNT");
                    
                    /* Remove Previous Colors */
                    $received.removeClass("received-error received-ok");
                    $return.removeClass("change-ok change-zero");
                    
                    /* =================================
                       RECEIVED LESS THAN PAYABLE
                       ================================= */
                    
                    if (receivedAmnt < netPay) {
                    
                        $received.addClass("received-error");
                    
                        $s("P17_RETURN_AMOUNT", "0.00");
                    
                        $return.addClass("change-zero");
                    
                        setTimeout(function () {
                            $received.focus();
                            $received.select();
                        }, 100);
                    
                        return;
                    }
                    
                    /* =================================
                       RECEIVED AMOUNT OK
                       ================================= */
                    
                    $received.addClass("received-ok");
                    
                    /* =================================
                       CALCULATE CHANGE
                       ================================= */
                    
                    var returnAmnt = receivedAmnt - netPay;
                    
                    $s(
                        "P17_RETURN_AMOUNT",
                        returnAmnt.toFixed(2)
                    );
                    
                    /* =================================
                       CHANGE COLOR
                       ================================= */
                    
                    if (returnAmnt > 0) {
                        $return.addClass("change-ok");
                    } else {
                        $return.addClass("change-zero");
                    }
                    
                    /* =================================
                       PAYMENT CONFIRMATION
                       ================================= */
                    
                    var confirmMessage =
                        "💰 PAYMENT CONFIRMATION\n\n" +
                        "━━━━━━━━━━━━━━━━━━━━\n" +
                        "💳 Payable Amount   :  " + netPay.toFixed(2) + "\n" +
                        "💵 Received Amount  :  " + receivedAmnt.toFixed(2) + "\n" +
                        "━━━━━━━━━━━━━━━━━━━━\n" +
                        "🟢 Change Amount    :  " + returnAmnt.toFixed(2) + "\n" +
                    
                        "Confirm Payment?";
                    
                    apex.message.confirm(
                        confirmMessage,
                        function (ok) {
                    
                            if (ok) {
                    
                                setTimeout(function () {
                                    $("#pb-save").click();
                                }, 100);
                    
                            } else {
                    
                                setTimeout(function () {
                                    $received.focus();
                                    $received.select();
                                }, 100);
                            }
                        }
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

