    region register_1 (
        name: "SALES DTL "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (
                SELECT D.ORDER_DTL_NO,
                       D.ORDER_NO,
                       D.PRODUCT_NO,
                       P.DESCRIPTION,
                       P.BRAND_NO,
                       P.PRODUCT_NAME,
                       P.PRODUCT_CODE,
                       D.UOM_NO,
                       U.UOM_NAME,
                       D.PACK_QTY,
                       D.ORDER_QTY,
                       D.BASE_QTY,
                       D.SALES_RATE,
                       D.BASE_RATE,
                       D.TOTAL_AMOUNT,
                       D.INVOICED_QTY,
                       D.DELIVERED_QTY,
                       D.BALANCE_QTY,
                       D.DISCOUNT_PERCENT,
                       D.DISCOUNT_AMOUNT,
                       D. NET_AMOUNT,
                       NVL(STK.STOCK_QTY, 0) AS STOCK_QTY,
                       D.REMARKS,
                       CASE
                           WHEN M.ORDER_STATUS = 'P' THEN 'UD'
                           ELSE 'X'
                       END AS ROW_STATUS,
                       NULL AS DELETE_ROW
                  FROM TRN_SALES_ORDER_DTL D
                  JOIN TRN_SALES_ORDER_MST M
                    ON M.ORDER_NO = D.ORDER_NO
                  JOIN MST_PRODUCT P
                    ON P.PRODUCT_NO = D.PRODUCT_NO
                  LEFT JOIN MST_UOM U
                    ON U.UOM_NO = D.UOM_NO
                  LEFT JOIN
                  (
                      SELECT PRODUCT_NO,
                             SUM(NVL(QTY_IN, 0))
                             - SUM(NVL(QTY_OUT, 0)) AS STOCK_QTY
                        FROM TRN_STOCK_LEDGER
                       GROUP BY PRODUCT_NO
                  ) STK
                    ON STK.PRODUCT_NO = D.PRODUCT_NO
                 WHERE D.ORDER_NO = :P17_ORDER_NO
                
                 ORDER BY D.ORDER_DTL_NO);
                ```
            pageItemsToSubmit: P17_ORDER_NO
        }
