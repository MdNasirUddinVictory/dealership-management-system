    process process-form-sales-mst-entry (
        name: Process form SALES MST ENTRY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                
                        -- Only restrict UPDATE, not INSERT
                    IF :P17_ORDER_NO IS NOT NULL THEN
                
                        IF :P17_ORDER_STATUS IN ('I','D','PD') THEN
                            RAISE_APPLICATION_ERROR(-20001,
                            'Modification not allowed: This order is already processed (Invoice/Delivery/Partial Delivery).');
                        END IF;
                
                    END IF;
                
                    ------------------------------------------------
                    -- Header Validation
                    ------------------------------------------------
                
                    IF :P17_ORDER_DATE IS NULL THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please enter order date.'
                        );
                
                    END IF;
                
                    IF :P17_CUSTOMER_NO IS NULL THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select customer.'
                        );
                
                    END IF;
                
                
                
                    ------------------------------------------------
                    -- New Order
                    ------------------------------------------------
                
                    IF :P17_ORDER_NO IS NULL THEN
                
                        :P17_ORDER_NO := SEQ_ORDER_NO.NEXTVAL;
                
                        INSERT INTO TRN_SALES_ORDER_MST
                        (
                            ORDER_NO,
                            ORDER_CODE,
                            ORDER_DATE,
                            CUSTOMER_NO,
                            CONTACT_NO,
                            DELIVERY_ADDRESS,
                            DELIVERY_DATE,
                            EXPECTED_DATE,
                            REMARKS,
                            ORDER_STATUS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            :P17_ORDER_NO,
                            'SO-' || LPAD(:P17_ORDER_NO,6,'0'),
                            :P17_ORDER_DATE,
                            :P17_CUSTOMER_NO,
                            :P17_MOBILE_NO,
                            :P17_ADDRESS,
                            :P17_DELIVERY_DATE,
                            :P17_EXPECTED_DATE,
                            :P17_REMARKS,
                            'P',
                            :APP_USER,
                            SYSDATE
                        );
                
                        apex_application.g_print_success_message :=
                        'Sales order saved successfully.';
                
                    ------------------------------------------------
                    -- Update
                    ------------------------------------------------
                
                    ELSE
                
                        ------------------------------------------------
                        -- Status Validation
                        ------------------------------------------------
                
                        IF :P17_ORDER_STATUS IN ('I','PD','D') THEN
                
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'This order cannot be modified.'
                            );
                
                        END IF;
                
                        UPDATE TRN_SALES_ORDER_MST
                           SET ORDER_DATE       = :P17_ORDER_DATE,
                               CUSTOMER_NO      = :P17_CUSTOMER_NO,
                               CONTACT_NO       = :P17_MOBILE_NO,
                               DELIVERY_ADDRESS = :P17_ADDRESS,
                               DELIVERY_DATE    = :P17_DELIVERY_DATE,
                               EXPECTED_DATE    = :P17_EXPECTED_DATE,
                               REMARKS          = :P17_REMARKS,
                               UPDATED_BY       = :APP_USER,
                               UPDATED_DATE     = SYSDATE
                         WHERE ORDER_NO = :P17_ORDER_NO;
                
                        apex_application.g_print_success_message :=
                        'Sales order updated successfully.';
                
                    END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 8538682784548592732
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process sales-dtl-save-interactive-grid-data (
        name: SALES DTL  - Save Interactive Grid Data
        type: executeCode
        editableRegion: @register_1
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    V_STOCK   NUMBER;
                    V_STATUS  VARCHAR2(1);
                    V_EXISTS  NUMBER;
                
                BEGIN
                
                    ------------------------------------------------
                    -- Header Saved?
                    ------------------------------------------------
                    IF :P17_ORDER_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please save order information first.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Product Validation
                    ------------------------------------------------
                    IF :PRODUCT_NO IS NULL THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Please select product.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Qty Validation
                    ------------------------------------------------
                    IF NVL(:ORDER_QTY,0) <= 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Order quantity must be greater than zero.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Rate Validation
                    ------------------------------------------------
                    IF NVL(:SALES_RATE,0) <= 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Sales rate must be greater than zero.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Stock Validation
                    ------------------------------------------------
                    IF :APEX$ROW_STATUS IN ('C','U') THEN
                
                        SELECT NVL(SUM(QTY_IN)-SUM(QTY_OUT),0)
                          INTO V_STOCK
                          FROM TRN_STOCK_LEDGER
                         WHERE PRODUCT_NO = :PRODUCT_NO;
                
                        IF NVL(:BASE_QTY,0) > V_STOCK THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Available stock is '
                                || V_STOCK
                                || '. Order quantity exceeds available stock.'
                            );
                        END IF;
                
                    END IF;
                
                    ------------------------------------------------
                    -- Duplicate Product Validation
                    ------------------------------------------------
                    IF :APEX$ROW_STATUS IN ('C','U') THEN
                
                        SELECT COUNT(*)
                          INTO V_EXISTS
                          FROM TRN_SALES_ORDER_DTL
                         WHERE ORDER_NO = :P17_ORDER_NO
                           AND PRODUCT_NO = :PRODUCT_NO
                           AND NVL(ORDER_DTL_NO,0) <>
                               NVL(:ORDER_DTL_NO,0);
                
                        IF V_EXISTS > 0 THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Product already exists in this order.'
                            );
                        END IF;
                
                    END IF;
                
                    ------------------------------------------------
                    -- INSERT
                    ------------------------------------------------
                    IF :APEX$ROW_STATUS = 'C' THEN
                
                        INSERT INTO TRN_SALES_ORDER_DTL
                        (
                            ORDER_DTL_NO,
                            ORDER_NO,
                            PRODUCT_NO,
                            UOM_NO,
                            PACK_QTY,
                            ORDER_QTY,
                            BASE_QTY,
                            SALES_RATE,
                            BASE_RATE,
                            TOTAL_AMOUNT,
                            INVOICED_QTY,
                            DELIVERED_QTY,
                            BALANCE_QTY,
                            DISCOUNT_AMOUNT,
                            DISCOUNT_PERCENT,
                            REMARKS,
                            CREATED_BY,
                            CREATED_DATE
                        )
                        VALUES
                        (
                            SEQ_ORDER_DTL_NO.NEXTVAL,
                            :P17_ORDER_NO,
                            :PRODUCT_NO,
                            :UOM_NO,
                            :PACK_QTY,
                            :ORDER_QTY,
                            :BASE_QTY,
                            :SALES_RATE,
                            :BASE_RATE,
                            :TOTAL_AMOUNT,
                            0,
                            0,
                            :BASE_QTY,
                            :DISCOUNT_AMOUNT,
                            :DISCOUNT_PERCENT,
                            :REMARKS,
                            :APP_USER,
                            SYSDATE
                        )
                        RETURNING ORDER_DTL_NO
                        INTO :ORDER_DTL_NO;
                
                    ------------------------------------------------
                    -- UPDATE
                    ------------------------------------------------
                    ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                        IF NVL(:INVOICED_QTY,0) > 0 THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Invoice already generated. Modification not allowed.'
                            );
                        END IF;
                
                        UPDATE TRN_SALES_ORDER_DTL
                           SET PRODUCT_NO    = :PRODUCT_NO,
                               UOM_NO        = :UOM_NO,
                               PACK_QTY      = :PACK_QTY,
                               ORDER_QTY     = :ORDER_QTY,
                               BASE_QTY      = :BASE_QTY,
                               SALES_RATE    = :SALES_RATE,
                               BASE_RATE     = :BASE_RATE,
                               TOTAL_AMOUNT  = :TOTAL_AMOUNT,
                               BALANCE_QTY   = :BASE_QTY - NVL(INVOICED_QTY,0),
                               DISCOUNT_AMOUNT = :DISCOUNT_AMOUNT,
                               DISCOUNT_PERCENT = :DISCOUNT_PERCENT,
                               REMARKS       = :REMARKS,
                               UPDATED_BY    = :APP_USER,
                               UPDATED_DATE  = SYSDATE
                         WHERE ORDER_DTL_NO = :ORDER_DTL_NO;
                
                    ------------------------------------------------
                    -- DELETE
                    ------------------------------------------------
                    ELSIF :APEX$ROW_STATUS = 'D' THEN
                
                        IF NVL(:INVOICED_QTY,0) > 0 THEN
                            RAISE_APPLICATION_ERROR(
                                -20001,
                                'Invoice already generated. Delete not allowed.'
                            );
                        END IF;
                
                        DELETE
                          FROM TRN_SALES_ORDER_DTL
                         WHERE ORDER_DTL_NO = :ORDER_DTL_NO;
                
                    END IF;
                
                    ------------------------------------------------
                    -- Update Order Total
                    ------------------------------------------------
                    PKG_SALES_ORDER.UPDATE_TOTAL
                    (
                        :P17_ORDER_NO
                    );
                
                EXCEPTION
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR
                        (
                            -20001,
                            SQLERRM
                        );
                END;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        advanced {
            executionMappingIdentifier: 8538683045729592735
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

