    dynamicAction new_4 (
        name: New
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @register_1
            columns: SALES_RATE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    setTimeout(function () {
                    
                        var model = apex.region('sales_dtl')
                            .widget()
                            .interactiveGrid('getViews', 'grid')
                            .model;
                    
                        var totalAmount = 0;
                        var totalDiscount = 0;
                    
                        model.forEach(function (record) {
                    
                            var rate = parseFloat(
                                model.getValue(record, 'SALES_RATE')
                            ) || 0;
                    
                            var qty = parseFloat(
                                model.getValue(record, 'ORDER_QTY')
                            ) || 0;
                    
                            var discount = parseFloat(
                                model.getValue(record, 'DISCOUNT_AMOUNT')
                            ) || 0;
                    
                            // Rate × Qty
                            totalAmount += rate * qty;
                    
                            // Total Discount
                            totalDiscount += discount;
                        });
                    
                        var payableAmount = totalAmount - totalDiscount;
                    
                        $s(
                            'P17_TOTAL_ORDER_AMOUNT',
                            totalAmount.toFixed(2)
                        );
                    
                        $s(
                            'P17_TOTAL_DISCOUNT',
                            totalDiscount.toFixed(2)
                        );
                    
                        $s(
                            'P17_PAYABLE_AMOUNT',
                            payableAmount.toFixed(2)
                        );
                    
                    }, 100);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

