    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this record?
            style: warning
        }
        advanced {
            htmlDomId: pb-delete
        }
    )

    button generate-invoice (
        buttonName: GENERATE_INVOICE
        label: Generate Invoice
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-credit-card-terminal
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                items: {
                    P21_ORDER_NO: &P17_ORDER_NO.
                    P21_MOBILE_NO: &P17_MOBILE_NO.
                    P21_TOTAL_AMOUNT: &P17_TOTAL_AMOUNT.
                    P21_CUSTOMER_NAME: &P17_CUSTOMER_NAME.
                    P21_CUSTOMER_NO: &P17_CUSTOMER_NO.
                }
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P17_ORDER_NO IS NOT NULL AND :P17_INVOICE_CNT = 0
        }
    )

