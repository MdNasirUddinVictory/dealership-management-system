    region new_1 (
        name: INVOICE_SUMMERY
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH X AS
                (
                    SELECT
                           I.INVOICE_NO,
                           I.INVOICE_CODE,
                           I.INVOICE_DATE,
                           SUM(NVL(D.SALES_QTY,0)) AS INVOICE_QTY,
                           SUM(NVL(D.TOTAL_AMOUNT,0)) AS INVOICE_AMOUNT,
                           ROW_NUMBER() OVER
                           (
                               ORDER BY I.INVOICE_DATE DESC,
                                        I.INVOICE_NO DESC
                           ) AS RN
                    FROM TRN_SALES_INVOICE_DTL D
                         JOIN TRN_SALES_INVOICE_MST I
                           ON I.INVOICE_NO = D.INVOICE_NO
                    WHERE 1 = 1
                      -- AND I.CUSTOMER_NO = :P17_CUSTOMER_NO
                    GROUP BY
                           I.INVOICE_NO,
                           I.INVOICE_CODE,
                           I.INVOICE_DATE
                )
                SELECT RN SL,
                       INVOICE_NO,
                       INVOICE_CODE,
                       INVOICE_DATE,
                       INVOICE_QTY,
                       INVOICE_AMOUNT
                FROM X
                WHERE RN <= 3
                ORDER BY INVOICE_DATE DESC,
                         INVOICE_NO DESC;
                ```
            pageItemsToSubmit: P17_PRODUCT_NO
        }
