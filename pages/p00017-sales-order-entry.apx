page 17 (
    name: Sales Order Entry
    alias: SALES-ORDER-ENTRY
    title: Sales Order Entry
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function salesCalculate() {
            
                var qty    = Number($v("ORDER_QTY")) || 0;
                var rate   = Number($v("SALES_RATE")) || 0;
                var factor = Number($v("PACK_QTY")) || 1;
                var stock  = Number($v("STOCK_QTY")) || 0;
            
                if (factor <= 0) {
                    factor = 1;
                }
            
                var baseQty  = qty * factor;
                var baseRate = rate / factor;
                var totalAmt = qty * rate;
            
                $s("BASE_QTY", baseQty);
                $s("BASE_RATE", baseRate.toFixed(2));
                $s("TOTAL_AMOUNT", totalAmt.toFixed(2));
            
                if (baseQty > stock) {
            
                    // apex.message.clearErrors();
            
                    // apex.message.showErrors([
                    // {
                    //     type: "error",
                    //     location: "page",
                    //     message: "Available Stock : " + stock +
                    //              " | Required : " + baseQty,
                    //     unsafe: false
                    // }]);
                     
                    $s("ORDER_QTY", "");
                    $s("BASE_QTY", "");
                    $s("TOTAL_AMOUNT", "");
                    apex.message.alert("Available Stock : " + stock + " | Required : " + baseQty);
                }
            
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

