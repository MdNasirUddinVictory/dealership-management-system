        column UOM_NAME (
            type: textField
            heading {
                heading: Base UOM
            }
            layout {
                sequence: 170
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: UOM_NAME
                dataType: varchar2
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
            advanced {
                htmlDomId: UOM_NAME
                customAttributes: readonly
            }
        )

        column UOM_NO (
            type: selectList
            heading {
                heading: Market UOM
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT UOM_NAME D,
                           UOM_NO   R
                    FROM
                    (
                        -- Base UOM
                        SELECT U.UOM_NAME,
                               U.UOM_NO,
                               1 ORD
                          FROM MST_PRODUCT P
                          JOIN MST_UOM U
                            ON U.UOM_NO = P.UOM_NO
                         WHERE P.PRODUCT_NO = :PRODUCT_NO
                    
                        UNION ALL
                    
                        -- Conversion UOM
                        SELECT U.UOM_NAME,
                               C.CONVERT_UOM_NO,
                               2 ORD
                          FROM MST_UOM_CONVERSION C
                          JOIN MST_UOM U
                            ON U.UOM_NO = C.CONVERT_UOM_NO
                         WHERE C.PRODUCT_NO = :PRODUCT_NO
                           AND C.ACTIVE_FLAG = 'Y'
                    )
                    ORDER BY ORD, D;
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: PRODUCT_NO
                itemsToSubmit: PRODUCT_NO
            }
            layout {
                sequence: 160
            }
            source {
                databaseColumn: UOM_NO
                dataType: number
            }
            enableUsersTo {
                hide: false
            }
            advanced {
                htmlDomId: UOM_NO
            }
        )

    )

