    region entry (
        name: SALES ORDER MST ENTRY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Formatted on 7/17/2026 6:02:07 PM (QP5 v5.287) */
                SELECT O.ORDER_NO,
                       O.ORDER_CODE,
                       O.ORDER_DATE,
                       O.CUSTOMER_NO,
                       C.CUSTOMER_CODE,
                       C.CUSTOMER_NAME,
                       C.MOBILE_NO,
                       C.ADDRESS,
                       O.ORDER_STATUS,
                       CASE O.ORDER_STATUS
                          WHEN 'P' THEN 'Pending'
                          WHEN 'PI' THEN 'Partially Invoiced'
                          WHEN 'I' THEN 'Invoiced'
                          WHEN 'PD' THEN 'Partially Delivered'
                          WHEN 'D' THEN 'Delivered'
                       END
                          ORDER_STATUS_NAME,
                       O.DELIVERY_ADDRESS,
                       O.CONTACT_NO,
                       O.EXPECTED_DATE,
                       O.REMARKS,
                       O.CREATED_BY,
                       O.CREATED_DATE,
                       O.UPDATED_BY,
                       O.UPDATED_DATE,
                       O.DELIVERY_BY,
                       O.DELIVERY_DATE,
                       O.TOTAL_AMOUNT,
                       O.TOTAL_QTY,
                       I.INVOICE_CNT,
                       I.INVOICE_NO,
                       I.INVOICE_CODE
                  FROM TRN_SALES_ORDER_MST O
                       , MST_CUSTOMER C ,
                        (SELECT COUNT (*) INVOICE_CNT,INVOICE_NO  ,INVOICE_CODE,ORDER_NO
                          FROM TRN_SALES_INVOICE_MST 
                         GROUP BY INVOICE_CODE, INVOICE_NO,ORDER_NO) I
                          
                       WHERE  C.CUSTOMER_NO = O.CUSTOMER_NO AND I.ORDER_NO = O.ORDER_NO
                 AND  O.ORDER_NO = :P17_ORDER_NO;
                ```
        }
