    dynamicAction new (
        name: New
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P17_CUSTOMER_NO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customer-summery
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: custom
            customEvent: input
            selectionType: columns
            interactiveGrid: @register_1
            columns: [
                ORDER_QTY
                SALES_RATE
