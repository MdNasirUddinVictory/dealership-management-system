                    SELECT NVL (AUTO_INVOICE_FLAG, '0'), NVL (AUTO_DELIVERY_FLAG, '0')
                      INTO :P17_AUTO_INVOICE, :P17_AUTO_DELIVERY
                      FROM SA_CONFIG;
                EXCEPTION
                    WHEN NO_DATA_FOUND
                    THEN
                        NULL;
                END;
