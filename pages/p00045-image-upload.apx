    dynamicAction close-after-upload (
        name: Close After Upload
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @upload
        }

        action native-dialog-close (
            action: closeDialog
            settings {
                itemsToReturn: P45_IMG_TYPE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-with-button (
        name: Close with Button
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @colose
        }

        action native-dialog-close (
            action: closeDialog
            settings {
                itemsToReturn: P45_IMG_TYPE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

