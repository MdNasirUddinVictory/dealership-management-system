page 45 (
    name: Image Upload
    alias: IMAGE-UPLOAD
    title: Image Upload
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            /* =========================================================
               CAMERA + IMAGE UPLOAD
               APEX 26.1
               ========================================================= */
            
            /* ---------- Elements ---------- */
            
            const video = document.getElementById("video");
            const canvas = document.getElementById("vid-canvas");
            const takeBtn = document.getElementById("vid-take");
            const imgPreview = document.getElementById("img");
            const fileInput = document.getElementById("inpFile");
            
            
            /* ---------- Session Storage ---------- */
            
            const cameraStorage = apex.storage.getScopedSessionStorage({
                prefix: "CAMERA",
                useAppId: true
            });
            
            /* =========================================================
               COMMON FUNCTION
               Resize + Save + Preview
               ========================================================= */
            
            function saveImage(source, maxSize = 450) {
            
                const tempCanvas = document.createElement("canvas");
                const ctx = tempCanvas.getContext("2d");
            
                let width = source.width;
                let height = source.height;
            
                /* Keep aspect ratio */
                if (width > height && width > maxSize) {
            
                    height = Math.round(height * maxSize / width);
                    width = maxSize;
            
                } else if (height > maxSize) {
            
                    width = Math.round(width * maxSize / height);
                    height = maxSize;
            
                }
            
                tempCanvas.width = width;
                tempCanvas.height = height;
            
                /* Draw image */
                ctx.drawImage(source, 0, 0, width, height);
            
                /* Convert to Base64 */
                const dataURL = tempCanvas
                    .toDataURL("image/jpeg", 0.9)
                    .replace(/^data:image\/jpeg;base64,/, "");
            
                /* Get image type */
                const imageType = apex.item("P45_IMG_TYPE").getValue();
            
                /* Save */
                cameraStorage.setItem(imageType, dataURL);
            
                /* Preview */
                if (imgPreview) {
                    imgPreview.src = tempCanvas.toDataURL("image/jpeg", 0.9);
                }
            
                return dataURL;
            }
            
            
            /* =========================================================
               CAMERA
               ========================================================= */
            
            async function startCamera() {
            
                if (!navigator.mediaDevices ||
                    !navigator.mediaDevices.getUserMedia) {
            
                    alert("Camera is not supported by this browser.");
                    return;
                }
            
                try {
            
                    const stream = await navigator.mediaDevices.getUserMedia({
                        video: true
                    });
            
                    video.srcObject = stream;
            
                    await video.play();
            
                } catch (error) {
            
                    console.error("Camera Error:", error);
            
                    alert("Unable to access camera.");
            
                }
            }
            
            
            /* Start Camera */
            
            if (video) {
                startCamera();
            }
            
            
            /* =========================================================
               CAPTURE PHOTO
               ========================================================= */
            
            if (takeBtn) {
            
                takeBtn.addEventListener("click", function () {
            
                    if (!video.videoWidth) {
                        alert("Camera is not ready.");
                        return;
                    }
            
                    /*
                     * Camera image normally has videoWidth/videoHeight.
                     * Use these instead of CSS width/height.
                     */
                    const tempCanvas = document.createElement("canvas");
            
                    const maxSize = 450;
            
                    let width = video.videoWidth;
                    let height = video.videoHeight;
            
                    /* Resize */
                    if (width > height && width > maxSize) {
            
                        height = Math.round(height * maxSize / width);
                        width = maxSize;
            
                    } else if (height > maxSize) {
            
                        width = Math.round(width * maxSize / height);
                        height = maxSize;
            
                    }
            
                    tempCanvas.width = width;
                    tempCanvas.height = height;
            
                    const ctx = tempCanvas.getContext("2d");
            
                    ctx.drawImage(video, 0, 0, width, height);
            
                    /* Save image */
                    const dataURL = tempCanvas
                        .toDataURL("image/jpeg", 0.9)
                        .replace(/^data:image\/jpeg;base64,/, "");
            
                    const imageType = apex.item("P45_IMG_TYPE").getValue();
            
                    cameraStorage.setItem(imageType, dataURL);
            
                    /* Show preview */
                    if (imgPreview) {
                        imgPreview.src = tempCanvas.toDataURL("image/jpeg", 0.9);
                    }
            
                });
            
            }
            
            
            /* =========================================================
               BROWSE / FILE UPLOAD
               ========================================================= */
            
            if (fileInput) {
            
                fileInput.addEventListener("change", function (event) {
            
                    const file = event.target.files[0];
            
                    if (!file) {
                        return;
                    }
            
                    /* Allowed file types */
                    const allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/gif"
                    ];
            
                    if (!allowedTypes.includes(file.type)) {
            
                        alert("Please select JPG, JPEG, PNG or GIF image.");
            
                        fileInput.value = "";
                        return;
                    }
            
                    /* Maximum 200 KB */
                    const maxFileSize = 200 * 1024;
            
                    if (file.size > maxFileSize) {
            
                        alert("File size must be less than 200 KB.");
            
                        fileInput.value = "";
                        return;
                    }
            
                    /* Read image */
                    const reader = new FileReader();
            
                    reader.onload = function (e) {
            
                        const image = new Image();
            
                        image.onload = function () {
            
                            /*
                             * Customer image/document
                             * can use smaller size.
                             */
                            const imageType =
                                apex.item("P45_IMG_TYPE").getValue();
            
                            let maxSize = 450;
            
                            if (
                                imageType === "FRONT_DOC" ||
                                imageType === "BACK_DOC" ||
                                imageType === "CUST_IMG"
                            ) {
                                maxSize = 300;
                            }
            
                            /* Save image */
                            saveImage(image, maxSize);
            
                        };
            
                        image.src = e.target.result;
            
                    };
            
                    reader.readAsDataURL(file);
            
                });
            
            }
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region breadcrumb-2 (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 50
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region camera (
        name: Camera
        type: staticContent
        source {
            htmlCode:
                ```html
                   <video id="video" width="500" height="450" autoplay></video>
                    <canvas id="canvas" style="display:none;"></canvas>
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region preview (
        name: Preview
        type: staticContent
        source {
            htmlCode:
                ```html
                <img id="img"  height="250" width="310" src="/i232/psb/icon/images.png" style="margin-left:12%;"/>
                <img id="imgChk" style="display:none;" src="" height="250" width="300" />
                <div id="vid-canvas" style="display:none;" > </div>
                <input type="file" name="inpFile" id="inpFile"  accept='image/*' style="margin-left:10%;"/>
                <center style="color :red;"><i>File Size Should be 200 kb</i></center>
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P45_IMG_TYPE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @camera
            slot: regionBody
        }
        default {
            type: static
            staticValue: CUST_IMG
        }
    )

    pageItem P45_PREFIX (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @camera
            slot: regionBody
        }
    )

    button capture (
        buttonName: Capture
        label: Capture
        layout {
            sequence: 30
