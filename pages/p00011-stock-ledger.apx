page 11 (
    name: Stock Ledger
    alias: STOCK-LEDGER
    title: Stock Ledger
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--stickToBottom
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region register (
        name: Stock Ledger
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT
                       L.LEDGER_NO,
                
                       L.TRAN_DATE,
                
                       P.PRODUCT_CODE,
                
                       P.PRODUCT_NAME,
                
                       L.TRAN_TYPE,
                
                       CASE L.TRAN_TYPE
                            WHEN 'OPENING' THEN 'Opening Stock'
                            WHEN 'PURCHASE' THEN 'Purchase'
                            WHEN 'SALES' THEN 'Sales'
                            WHEN 'DELIVERY' THEN 'Sales Delivery'
                            WHEN 'CUSTOMER_RETURN' THEN 'Customer Return'
                       END TRANSACTION_NAME,
                
                       L.REF_NO,
                
                       L.QTY_IN,
                
                       L.QTY_OUT,
                
                       SUM(
                            NVL(L.QTY_IN,0)
                            -
                            NVL(L.QTY_OUT,0)
                       )
                       OVER
                       (
                            PARTITION BY L.PRODUCT_NO
                            ORDER BY L.TRAN_DATE,
                                     L.LEDGER_NO
                       ) BALANCE,
                
                       L.CREATED_BY,
                
                       L.CREATED_DATE
                
                FROM TRN_STOCK_LEDGER L
                
                JOIN MST_PRODUCT P
                  ON P.PRODUCT_NO = L.PRODUCT_NO
                
                WHERE (:P11_PRODUCT_NO IS NULL
                       OR L.PRODUCT_NO = :P11_PRODUCT_NO)
                
                AND (:P11_DATE_FROM IS NULL
                     OR L.TRAN_DATE >= :P11_DATE_FROM)
                
                AND (:P11_DATE_TO IS NULL
                     OR L.TRAN_DATE <= :P11_DATE_TO)
                
                AND (:P11_TRAN_TYPE IS NULL
                     OR L.TRAN_TYPE = :P11_TRAN_TYPE)
                
                ORDER BY
                       L.PRODUCT_NO,
                       L.TRAN_DATE,
                       L.LEDGER_NO);
                ```
            pageItemsToSubmit: [
                P11_PRODUCT_NO
                P11_DATE_FROM
                P11_DATE_TO
                P11_TRAN_TYPE
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 25854766236000286015
        }

        savedReport primary (
