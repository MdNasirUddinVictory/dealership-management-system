    pageItem P11_TRAN_TYPE (
        type: selectList
        label {
            label: Tran Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Opening Stock' DISPLAY_VALUE, 'OPENING' RETURN_VALUE FROM DUAL
                UNION ALL
                SELECT 'Purchase', 'PURCHASE' FROM DUAL
                UNION ALL
                SELECT 'Sales Delivery', 'DELIVERY' FROM DUAL
                UNION ALL
                SELECT 'Customer Return', 'CUSTOMER_RETURN' FROM DUAL
                ```
            displayExtraValues: false
            nullDisplayValue: --Select--
        }
        layout {
