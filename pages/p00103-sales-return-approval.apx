    region purchase-details (
        name: RETURN  DETAILS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT D.RETURN_DTL_NO,
                       P.PRODUCT_CODE,
                       P.PRODUCT_NAME,
                       D.RETURN_QTY,
                       D.SALES_RATE,
                       D.TOTAL_AMOUNT,
                       S.SALES_QTY
                  FROM TRN_CUSTOMER_RETURN_MST  M,
                       TRN_CUSTOMER_RETURN_DTL  D,
                       TRN_CUSTOMER_RETURN_MST   IM,
                       TRN_SALES_INVOICE_DTL    S,
                       MST_PRODUCT              P
                 WHERE     M.RETURN_NO = D.RETURN_NO
                       AND M.INVOICE_NO = IM.INVOICE_NO
                       AND M.CUSTOMER_NO = IM.CUSTOMER_NO
                       AND D.PRODUCT_NO = S.PRODUCT_NO
                       AND P.PRODUCT_NO = D.PRODUCT_NO
                       AND D.RETURN_NO = :P103_RETURN_NO
                ```
            pageItemsToSubmit: P103_RETURN_NO
        }
