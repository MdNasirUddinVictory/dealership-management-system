    process approve-purchase (
        name: APPROVE_RETURN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_exists NUMBER;
                
                BEGIN
                
                    ------------------------------------------------
                    -- Return Exists
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_CUSTOMER_RETURN_MST
                     WHERE RETURN_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Customer Return not found.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Already Approved
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_CUSTOMER_RETURN_MST
                     WHERE RETURN_NO = APEX_APPLICATION.G_X01
                       AND APPROVAL_STATUS = 'A';
                
                    IF v_exists > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Customer Return already approved.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Detail Exists
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_CUSTOMER_RETURN_DTL
                     WHERE RETURN_NO = APEX_APPLICATION.G_X01;
                
                    IF v_exists = 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Return details not found.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Return Qty Validation
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_CUSTOMER_RETURN_DTL
                     WHERE RETURN_NO = APEX_APPLICATION.G_X01
                       AND NVL(RETURN_QTY,0) <= 0;
                
                    IF v_exists > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Return quantity must be greater than zero.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Stock Already Posted
                    ------------------------------------------------
                    SELECT COUNT(*)
                      INTO v_exists
                      FROM TRN_STOCK_LEDGER
                     WHERE TRAN_TYPE = 'CUSTOMER_RETURN'
                       AND REF_NO     = APEX_APPLICATION.G_X01;
                
                    IF v_exists > 0 THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            'Customer Return stock already posted.'
                        );
                    END IF;
                
                    ------------------------------------------------
                    -- Approve Header
                    ------------------------------------------------
                    UPDATE TRN_CUSTOMER_RETURN_MST
                       SET APPROVAL_STATUS = 'A',
                           APPROVED_BY     = :APP_USER,
                           APPROVED_DATE   = SYSDATE,
                           UPDATED_BY      = :APP_USER,
                           UPDATED_DATE    = SYSDATE
                     WHERE RETURN_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Stock Back (BASE_QTY)
                    ------------------------------------------------
                    INSERT INTO TRN_STOCK_LEDGER
                    (
                        LEDGER_NO,
                        TRAN_DATE,
                        TRAN_TYPE,
                        REF_NO,
                        PRODUCT_NO,
                        QTY_IN,
                        QTY_OUT,
                        CREATED_BY,
                        CREATED_DATE
                    )
                    SELECT
                        SEQ_LEDGER_NO.NEXTVAL,
                        SYSDATE,
                        'CUSTOMER_RETURN',
                        D.RETURN_NO,
                        D.PRODUCT_NO,
                        NVL(D.BASE_QTY,0),
                        0,
                        :APP_USER,
                        SYSDATE
                    FROM TRN_CUSTOMER_RETURN_DTL D
                    WHERE D.RETURN_NO = APEX_APPLICATION.G_X01;
                
                    ------------------------------------------------
                    -- Finance Voucher
                    ------------------------------------------------
                    PKG_FINANCE.POST_CUSTOMER_RETURN
                    (
                        P_RETURN_NO => APEX_APPLICATION.G_X01
                    );
                
                    COMMIT;
                
                    ------------------------------------------------
                    -- JSON Response
                    ------------------------------------------------
                    APEX_JSON.OPEN_OBJECT;
                
                    APEX_JSON.WRITE(
                        'status',
                        'SUCCESS'
                    );
                
                    APEX_JSON.WRITE(
                        'message',
                        'Customer Return approved successfully.'
                    );
                
                    APEX_JSON.CLOSE_OBJECT;
                
                EXCEPTION
                    WHEN OTHERS THEN
                
                        ROLLBACK;
                
                        APEX_JSON.OPEN_OBJECT;
                
                        APEX_JSON.WRITE(
                            'status',
                            'ERROR'
                        );
                
                        APEX_JSON.WRITE(
                            'message',
                            SQLERRM
                        );
                
                        APEX_JSON.CLOSE_OBJECT;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 9125263076821562361
        }
    )

    process reject-purchase (
        name: RETURN_REJECT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE TRN_CUSTOMER_RETURN_MST
                   SET APPROVAL_STATUS = 'R'
                 WHERE RETURN_NO = APEX_APPLICATION.G_X01;
                
                COMMIT;
                
                HTP.P('Customer return rejected.');
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
