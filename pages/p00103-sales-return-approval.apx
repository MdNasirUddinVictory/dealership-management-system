    region register (
        name: REGISTER
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       M.RETURN_NO,
                       M.RETURN_CODE,
                       M.RETURN_DATE,
                       I.INVOICE_CODE,
                       I.INVOICE_DATE,
                       C.CUSTOMER_NAME,
                       C.MOBILE_NO,
                       M.RETURN_REASON,
                       (
                           SELECT NVL(SUM(D.RETURN_QTY),0)
                             FROM TRN_CUSTOMER_RETURN_DTL D
                            WHERE D.RETURN_NO = M.RETURN_NO
                       ) TOTAL_QTY,
                       (
                           SELECT NVL(SUM(D.TOTAL_AMOUNT),0)
                             FROM TRN_CUSTOMER_RETURN_DTL D
                            WHERE D.RETURN_NO = M.RETURN_NO
                       ) TOTAL_AMOUNT,
                       CASE M.APPROVAL_STATUS
                           WHEN 'P' THEN
                               '<span class="t-Badge t-Badge--warning">
                                Pending
                                </span>'
                
                           WHEN 'A' THEN
                               '<span class="t-Badge t-Badge--success">
                                Approved
                                </span>'
                
                           WHEN 'R' THEN
                               '<span class="t-Badge t-Badge--danger">
                                Rejected
                                </span>'
                       END APPROVAL_STATUS,
                       M.CREATED_BY,
                       M.CREATED_DATE,
                         0 DETAILS_BTN
                FROM TRN_CUSTOMER_RETURN_MST M
                JOIN TRN_SALES_INVOICE_MST I
                  ON I.INVOICE_NO = M.INVOICE_NO
                JOIN MST_CUSTOMER C
                  ON C.CUSTOMER_NO = M.CUSTOMER_NO
                WHERE  M.APPROVAL_STATUS = 'P'
                ORDER BY M.RETURN_NO DESC;
                ```
        }
