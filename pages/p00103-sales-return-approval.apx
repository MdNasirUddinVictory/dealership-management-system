page 103 (
    name: Sales Return Approval
    alias: SALES-RETURN-APPROVAL
    title: Sales Return Approval
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function f_openModal (returnNo){
              $s('P103_RETURN_NO',returnNo);
              openModal ('return_approve');
              apex.region('return-detail').refresh();
            }
            
            function approveReturn(returnNo) {
            
                apex.message.confirm(
                    "Are you sure you want to approve this Customer Return?",
                    function (okPressed) {
            
                        if (okPressed) {
            
                            apex.server.process(
                                "APPROVE_RETURN",
                                {
                                    x01: returnNo
                                },
                                {
                                    dataType: "json",
            
                                    success: function (pData) {
            
                                        if (pData.status === "SUCCESS") {
            
                                            apex.message.showPageSuccess(pData.message);
            
                                            apex.region("return_list").refresh();
            
                                        } else {
            
                                            apex.message.alert(pData.message);
            
                                        }
                                    },
            
                                    error: function (xhr, status, error) {
            
                                        apex.message.alert(
                                            "Approval failed.<br>" + error
                                        );
            
                                    }
                                }
                            );
            
                        }
            
                    }
                );
            
            }
            function rejectReturn(returnNo) {
            
                apex.message.confirm(
                    "Are you sure you want to reject this Customer Return?",
                    function (okPressed) {
            
                        if (!okPressed) {
                            return;
                        }
            
                        apex.server.process(
                            "RETURN_REJECT",
                            {
                                x01: returnNo
                            },
                            {
                                dataType: "json",
            
                                success: function (pData) {
            
                                    if (pData.status === "SUCCESS") {
            
                                        apex.message.showPageSuccess(pData.message);
            
                                        apex.region("return_list").refresh();
            
                                    } else {
            
                                        apex.message.alert(pData.message);
            
                                    }
                                },
            
                                error: function (jqXHR) {
            
                                    apex.message.alert(
                                        "Error: " + jqXHR.responseText
                                    );
            
                                }
                            }
                        );
            
                    }
                );
            
            }
            ```
    }
