page 302 (
    name: Journal Voucher Register
    alias: JOURNAL-VOUCHER-REGISTER
    title: Journal Voucher Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function openVoucher(pVoucherNo, pvoucherCode, pVoucherType, pVoucherDate, pNarattion) {
                $s('P304_VOUCHER_NO', pVoucherNo);
                $s('P302_VOUCHER_CODE_DISPLAY', pvoucherCode);
                $s('P302_VOUCHER_TYPE_DISPLAY', pVoucherType);
                $s('P302_VOUCHER_DATE_DISPLAY', pVoucherDate);
                $s('P302_NARRATION_DISPLAY', pNarattion);
                apex.region('vioucherViewDtl').refresh();
                openModal('vioucherView');
            
            
            }
            ```
    }
    css {
        inline:
            ```css
            #voucher_details .voucher-wrapper {
                width: 100%;
                box-sizing: border-box;
                background: #ffffff;
                border: 1px solid #e5e7eb;
                border-radius: 14px;
                overflow: hidden;
                font-family: Arial, sans-serif;
            }
            
            
            /* ================= HEADER ================= */
            
            #voucher_details .voucher-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 18px 22px;
                border-bottom: 1px solid #e5e7eb;
                background: #fafafa;
            }
            
            #voucher_details .voucher-title {
                font-size: 20px;
                font-weight: 700;
            }
            
            #voucher_details .voucher-no {
                margin-top: 5px;
                font-size: 13px;
                color: #6b7280;
            }
            
            #voucher_details .voucher-total-box {
                display: flex;
                gap: 12px;
            }
            
            #voucher_details .total-item {
                min-width: 120px;
                padding: 8px 12px;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                background: #fff;
                text-align: center;
            }
            
            #voucher_details .total-label {
                display: block;
                font-size: 11px;
                color: #6b7280;
                margin-bottom: 3px;
            }
            
            #voucher_details .total-dr {
                font-weight: 700;
            }
            
            #voucher_details .total-cr {
                font-weight: 700;
            }
            
            
            /* ================= COLUMN HEADER ================= */
            
            #voucher_details .voucher-column-header {
                display: grid;
                grid-template-columns: 1fr 180px 1fr;
                gap: 15px;
                padding: 10px 15px;
                background: #f8fafc;
                border-bottom: 1px solid #e5e7eb;
                font-size: 12px;
                font-weight: 700;
            }
            
            #voucher_details .cr-header {
                display: flex;
                justify-content: space-between;
                color: #15803d;
            }
            
            #voucher_details .dr-header {
                display: flex;
                justify-content: space-between;
                color: #b45309;
            }
            
            #voucher_details .particular-header {
                text-align: center;
                color: #6b7280;
            }
            
            
            /* ================= BODY ================= */
            
            #voucher_details .voucher-row {
                display: grid;
                grid-template-columns: 1fr 180px 1fr;
                gap: 15px;
                align-items: center;
                padding: 12px 15px;
                border-bottom: 1px solid #f0f0f0;
            }
            
            #voucher_details .cr-side,
            #voucher_details .dr-side {
                min-width: 0;
            }
            
            
            /* ================= ACCOUNT CARD ================= */
            
            #voucher_details .account-card {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                padding: 11px 13px;
                border-radius: 9px;
                min-height: 52px;
                box-sizing: border-box;
            }
            
            #voucher_details .credit-card {
                border-left: 4px solid #22c55e;
                background: #f0fdf4;
            }
            
            #voucher_details .debit-card {
                border-right: 4px solid #f59e0b;
                background: #fffbeb;
            }
            
            #voucher_details .account-info {
                min-width: 0;
            }
            
            #voucher_details .account-code {
                font-size: 11px;
                color: #6b7280;
                margin-bottom: 3px;
            }
            
            #voucher_details .account-name {
                font-size: 13px;
                font-weight: 600;
                word-break: break-word;
            }
            
            #voucher_details .amount {
                white-space: nowrap;
                font-size: 14px;
                font-weight: 700;
            }
            
            #voucher_details .credit-amount {
                color: #15803d;
            }
            
            #voucher_details .debit-amount {
                color: #b45309;
            }
            
            
            /* ================= PARTICULAR ================= */
            
            #voucher_details .particular-side {
                position: relative;
                text-align: center;
                min-height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            
            #voucher_details .particular-line {
                position: absolute;
                width: 100%;
                height: 1px;
                background: #e5e7eb;
                top: 50%;
            }
            
            #voucher_details .particular-text {
                position: relative;
                z-index: 2;
                background: #ffffff;
                padding: 5px 10px;
                font-size: 12px;
                color: #6b7280;
                max-width: 160px;
                word-break: break-word;
            }
            
            #voucher_details .no-particular {
                color: #9ca3af;
            }
            
            
            /* ================= EMPTY ================= */
            
            #voucher_details .empty-side {
                text-align: center;
                color: #d1d5db;
                font-size: 18px;
            }
            
            
            /* ================= FOOTER ================= */
            
            #voucher_details .voucher-footer {
                display: grid;
                grid-template-columns: 1fr 180px 1fr;
                gap: 15px;
                padding: 15px;
                background: #fafafa;
                border-top: 1px solid #e5e7eb;
            }
            
            #voucher_details .footer-cr,
            #voucher_details .footer-dr {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 10px 13px;
                border-radius: 8px;
                font-size: 13px;
            }
            
            #voucher_details .footer-cr {
                background: #f0fdf4;
                color: #15803d;
            }
            
            #voucher_details .footer-dr {
                background: #fffbeb;
                color: #b45309;
            }
            
            #voucher_details .footer-status {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 6px;
                font-size: 12px;
                font-weight: 600;
                color: #15803d;
            }
            
            #voucher_details .balanced-icon {
                display: inline-flex;
                width: 20px;
                height: 20px;
                justify-content: center;
                align-items: center;
                border-radius: 50%;
                background: #22c55e;
                color: white;
            }
            
            
            /* ================= MOBILE ================= */
            
            @media (max-width: 768px) {
            
                #voucher_details .voucher-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }
            
                #voucher_details .voucher-total-box {
                    width: 100%;
                }
            
                #voucher_details .total-item {
                    flex: 1;
                }
            
                #voucher_details .voucher-column-header {
                    display: none;
                }
            
                #voucher_details .voucher-row {
                    display: grid;
                    grid-template-columns: 1fr;
                    gap: 8px;
                    padding: 12px;
                }
            
                #voucher_details .particular-side {
                    order: 2;
                }
            
                #voucher_details .cr-side {
                    order: 1;
                }
            
                #voucher_details .dr-side {
                    order: 3;
                }
            
                #voucher_details .particular-line {
                    display: none;
                }
            
                #voucher_details .particular-text {
                    max-width: 100%;
                    background: #f8fafc;
                    border-radius: 6px;
                }
            
                #voucher_details .voucher-footer {
                    grid-template-columns: 1fr;
                    gap: 8px;
                }
            
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
