page 302 (
    name: Journal Voucher Register
    alias: JOURNAL-VOUCHER-REGISTER
    title: Journal Voucher Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function openVoucher(pVoucherNo, pvoucherCode, pVoucherType, pVoucherDate, pNarattion) {
                $s('P304_VOUCHER_NO', pVoucherNo);
                $s('P302_VOUCHER_CODE_DISPLAY', pvoucherCode);
                $s('P302_VOUCHER_TYPE_DISPLAY', pVoucherType);
                $s('P302_VOUCHER_DATE_DISPLAY', pVoucherDate);
                $s('P302_NARRATION_DISPLAY', pNarattion);
                apex.region('vioucherViewDtl').refresh();
                openModal('vioucherView');
            
            
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

