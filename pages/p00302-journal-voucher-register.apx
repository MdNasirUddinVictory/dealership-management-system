                sequence: 3
            )

            displayColumn PARTICULARS (
                sequence: 5
            )

        )

    )

    region voucher-mst (
        name: "VOUCHER "
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_html           CLOB;
                
                    v_voucher_no     VARCHAR2(100);
                    v_voucher_code   VARCHAR2(100);
                    v_voucher_date   VARCHAR2(50);
                    v_voucher_type   VARCHAR2(100);
                    v_narration      VARCHAR2(4000);
                    v_created_by     VARCHAR2(200);
                
                    v_total_dr       NUMBER := 0;
                    v_total_cr       NUMBER := 0;
                
                
                    /* =========================================================
                       NUMBER TO WORDS
                       Bangladesh / Indian Numbering System
                       Crore -> Lakh -> Thousand -> Hundred
                       ========================================================= */
                
                    FUNCTION number_to_words(p_num NUMBER)
                        RETURN VARCHAR2
                    IS
                        v_num   NUMBER := TRUNC(NVL(p_num, 0));
                        v_words VARCHAR2(4000);
                
                
                        /* =====================================================
                           TWO DIGIT WORDS
                           ===================================================== */
                
                        FUNCTION two_digit_words(p NUMBER)
                            RETURN VARCHAR2
                        IS
                            v_result VARCHAR2(200);
                            v_tens   NUMBER;
                            v_ones   NUMBER;
                        BEGIN
                
                            IF p < 20 THEN
                
                                v_result :=
                                    CASE p
                                        WHEN 0  THEN 'Zero'
                                        WHEN 1  THEN 'One'
                                        WHEN 2  THEN 'Two'
                                        WHEN 3  THEN 'Three'
                                        WHEN 4  THEN 'Four'
                                        WHEN 5  THEN 'Five'
                                        WHEN 6  THEN 'Six'
                                        WHEN 7  THEN 'Seven'
                                        WHEN 8  THEN 'Eight'
                                        WHEN 9  THEN 'Nine'
                                        WHEN 10 THEN 'Ten'
                                        WHEN 11 THEN 'Eleven'
                                        WHEN 12 THEN 'Twelve'
                                        WHEN 13 THEN 'Thirteen'
                                        WHEN 14 THEN 'Fourteen'
                                        WHEN 15 THEN 'Fifteen'
                                        WHEN 16 THEN 'Sixteen'
                                        WHEN 17 THEN 'Seventeen'
                                        WHEN 18 THEN 'Eighteen'
                                        WHEN 19 THEN 'Nineteen'
                                    END;
                
                            ELSE
                
                                v_tens := TRUNC(p / 10);
                                v_ones := MOD(p, 10);
                
                                v_result :=
                                    CASE v_tens
                                        WHEN 2 THEN 'Twenty'
                                        WHEN 3 THEN 'Thirty'
                                        WHEN 4 THEN 'Forty'
                                        WHEN 5 THEN 'Fifty'
                                        WHEN 6 THEN 'Sixty'
                                        WHEN 7 THEN 'Seventy'
                                        WHEN 8 THEN 'Eighty'
                                        WHEN 9 THEN 'Ninety'
                                    END;
                
                                IF v_ones > 0 THEN
                
                                    v_result :=
                                        v_result || ' ' ||
                                        CASE v_ones
                                            WHEN 1 THEN 'One'
                                            WHEN 2 THEN 'Two'
                                            WHEN 3 THEN 'Three'
                                            WHEN 4 THEN 'Four'
                                            WHEN 5 THEN 'Five'
                                            WHEN 6 THEN 'Six'
                                            WHEN 7 THEN 'Seven'
                                            WHEN 8 THEN 'Eight'
                                            WHEN 9 THEN 'Nine'
                                        END;
                
                                END IF;
                
                            END IF;
                
                            RETURN v_result;
                
                        END two_digit_words;
                
                
                        /* =====================================================
                           THREE DIGIT WORDS
                           ===================================================== */
                
                        FUNCTION three_digit_words(p NUMBER)
                            RETURN VARCHAR2
                        IS
                            v_result   VARCHAR2(300);
                            v_hundreds NUMBER;
                            v_rem      NUMBER;
                        BEGIN
                
                            v_hundreds := TRUNC(p / 100);
                            v_rem      := MOD(p, 100);
                
                            IF v_hundreds > 0 THEN
                
                                v_result :=
                                    CASE v_hundreds
                                        WHEN 1 THEN 'One'
                                        WHEN 2 THEN 'Two'
                                        WHEN 3 THEN 'Three'
                                        WHEN 4 THEN 'Four'
                                        WHEN 5 THEN 'Five'
                                        WHEN 6 THEN 'Six'
                                        WHEN 7 THEN 'Seven'
                                        WHEN 8 THEN 'Eight'
                                        WHEN 9 THEN 'Nine'
                                    END || ' Hundred';
                
                                IF v_rem > 0 THEN
                
                                    v_result :=
                                        v_result || ' ' ||
                                        two_digit_words(v_rem);
                
                                END IF;
                
                            ELSE
                
                                v_result := two_digit_words(v_rem);
                
                            END IF;
                
                            RETURN v_result;
                
                        END three_digit_words;
                
                
                        /* =====================================================
                           CONVERT NUMBER
                           ===================================================== */
                
                        FUNCTION convert_number(p NUMBER)
                            RETURN VARCHAR2
                        IS
                            v_result VARCHAR2(4000);
                            v_part   NUMBER;
                        BEGIN
                
                            IF p >= 10000000 THEN
                
                                v_part := TRUNC(p / 10000000);
                
                                v_result :=
                                    convert_number(v_part) || ' Crore';
                
                                IF MOD(p, 10000000) > 0 THEN
                
                                    v_result :=
                                        v_result || ' ' ||
                                        convert_number(MOD(p, 10000000));
                
                                END IF;
                
                
                            ELSIF p >= 100000 THEN
                
                                v_part := TRUNC(p / 100000);
                
                                v_result :=
                                    convert_number(v_part) || ' Lakh';
                
                                IF MOD(p, 100000) > 0 THEN
                
                                    v_result :=
                                        v_result || ' ' ||
                                        convert_number(MOD(p, 100000));
                
                                END IF;
                
                
                            ELSIF p >= 1000 THEN
                
                                v_part := TRUNC(p / 1000);
                
                                v_result :=
                                    convert_number(v_part) || ' Thousand';
                
                                IF MOD(p, 1000) > 0 THEN
                
                                    v_result :=
                                        v_result || ' ' ||
                                        convert_number(MOD(p, 1000));
                
                                END IF;
                
                
                            ELSIF p >= 100 THEN
                
                                v_result := three_digit_words(p);
                
                
                            ELSE
                
                                v_result := two_digit_words(p);
                
                            END IF;
                
                            RETURN v_result;
                
                        END convert_number;
                
                    BEGIN
                
                        IF v_num = 0 THEN
                            RETURN 'Zero';
                        END IF;
                
                        RETURN convert_number(v_num);
                
                    END number_to_words;
                
                
                BEGIN
                
                    /* =========================================================
                       GET VOUCHER MASTER
                       ========================================================= */
                
                    BEGIN
                
                        SELECT
                            M.VOUCHER_NO,
                            M.VOUCHER_CODE,
                            TO_CHAR(M.VOUCHER_DATE, 'DD-Mon-YYYY'),
                            M.VOUCHER_TYPE,
                            M.NARRATION,
                            M.CREATED_BY
                
                        INTO
                            v_voucher_no,
                            v_voucher_code,
                            v_voucher_date,
                            v_voucher_type,
                            v_narration,
                            v_created_by
                
                        FROM ACC_VOUCHER_MST M
                
                        WHERE M.VOUCHER_NO = :P302_VOUCHER_TYPE;
                
                
                    EXCEPTION
                
                        WHEN NO_DATA_FOUND THEN
                
                            RETURN TO_CLOB(
                                '<div style="
                                    padding:30px;
                                    text-align:center;
                                    color:#b91c1c;
                                    font-family:Arial,sans-serif;
                                    font-size:16px;
                                ">
                                    Voucher not found.
                                </div>'
                            );
                
                    END;
                
                
                    /* =========================================================
                       GET TOTAL DEBIT / CREDIT
                       ========================================================= */
                
                    SELECT
                        NVL(SUM(DEBIT_AMOUNT), 0),
                        NVL(SUM(CREDIT_AMOUNT), 0)
                
                    INTO
                        v_total_dr,
                        v_total_cr
                
                    FROM ACC_VOUCHER_DTL
                
                    WHERE VOUCHER_NO = :P302_VOUCHER_TYPE;
                
                
                    /* =========================================================
                       HTML START
                       ========================================================= */
                
                    v_html := TO_CLOB('
                
                <style>
                
                /* =========================================================
                   GLOBAL
                   ========================================================= */
                
                * {
                    box-sizing: border-box;
                }
                
                
                /* =========================================================
                   MAIN VOUCHER
                   ========================================================= */
                
                .voucher-print {
                
                    width: 100%;
                    max-width: 1050px;
                
                    margin: 0 auto;
                
                    padding: 25px 35px;
                
                    background: #ffffff;
                
                    color: #111111;
                
                    font-family:
                        Arial,
                        "Noto Sans Bengali",
                        sans-serif;
                
                    font-size: 13px;
                
                }
                
                
                /* =========================================================
                   HEADER
                   ========================================================= */
                
                .voucher-top {
                
                    width: 100%;
                
                    display: grid;
                
                    grid-template-columns:
                        22%
                        56%
                        22%;
                
                    align-items: start;
                
                    margin-bottom: 18px;
                
                }
                
                
                .bank-left {
                
                    font-size: 12px;
                
                    padding-top: 8px;
                
                }
                
                
                .bank-center {
                
                    text-align: center;
                
                }
                
                
                .bank-logo {
                
                    width: 55px;
                
                    height: 55px;
                
                    margin:
                        0 auto 4px auto;
                
                    border:
                        1px solid #555;
                
                    border-radius: 50%;
                
                    display: flex;
                
                    align-items: center;
                
                    justify-content: center;
                
                    font-size: 24px;
                
                }
                
                
                .bank-name {
                
                    font-size: 22px;
                
                    font-weight: 700;
                
                }
                
                
                .branch-name {
                
                    font-size: 17px;
                
                    margin-top: 3px;
                
                }
                
                
                .bank-right {
                
                    text-align: right;
                
                    font-size: 12px;
                
                    line-height: 1.8;
                
                }
                
                
                /* =========================================================
                   INFORMATION
                   ========================================================= */
                
                .voucher-info {
                
                    width: 100%;
                
                    display: grid;
                
                    grid-template-columns:
                        1fr
                        1fr;
                
                    gap: 25px;
                
                    margin:
                        15px 0 20px 0;
                
                }
                
                
                .info-line {
                
                    border-bottom:
                        1px dotted #222;
                
                    padding: 5px 0;
                
                    min-height: 27px;
                
                }
                
                
                .info-label {
                
                    font-weight: 600;
                
                }
                
                
                /* =========================================================
                   MAIN TABLE
                   ========================================================= */
                
                .voucher-table {
                
                    width: 100%;
                
                    border-collapse: collapse;
                
                    table-layout: fixed;
                
                }
                
                
                .voucher-table th,
                .voucher-table td {
                
                    border:
                        1px solid #111;
                
                }
                
                
                .voucher-table th {
                
                    text-align: center;
                
                    vertical-align: middle;
                
                    font-weight: 600;
                
                }
                
                
                .group-header {
                
                    height: 40px;
                
                    font-size: 14px;
                
                }
                
                
                .sub-header {
                
                    height: 58px;
                
                    font-size: 12px;
                
                }
                
                
                .dr-group {
                
                    width: 30%;
                
                }
                
                
                .particular-group {
                
                    width: 40%;
                
                }
                
                
                .cr-group {
                
                    width: 30%;
                
                }
                
                
                /* =========================================================
                   COLUMNS
                   ========================================================= */
                
                .amount-col {
                
                    width: 15%;
                
                    text-align: right;
                
                    padding: 7px;
                
                    vertical-align: middle;
                
                }
                
                
                .account-col {
                
                    width: 15%;
                
                    padding: 7px;
                
                    vertical-align: middle;
                
                }
                
                
                .particular-col {
                
                    width: 40%;
                
                    padding:
                        7px 12px;
                
                    text-align: center;
                
                    vertical-align: middle;
                
                }
                
                
                /* =========================================================
                   ACCOUNT
                   ========================================================= */
                
                .account-name {
                
                    font-size: 12px;
                
                    font-weight: 600;
                
                    line-height: 1.35;
                
                }
                
                
                .account-code {
                
                    font-size: 11px;
                
                    margin-top: 3px;
                
                    color: #333333;
                
                }
                
                
                .branch-code {
                
                    font-size: 10px;
                
                    color: #555555;
                
                }
                
                
                /* =========================================================
                   BODY
                   ========================================================= */
                
                .voucher-row td {
                
                    height: 48px;
                
                }
                
                
                .particular-text {
                
                    font-size: 12px;
                
                    line-height: 1.4;
                
                }
                
                
                /* =========================================================
                   TOTAL ROW
                   ========================================================= */
                
                .total-row {
                
                    background:
                        #f8fafc;
                
                    border-top:
                        2px solid #111;
                
                    border-bottom:
                        2px solid #111;
                
                }
                
                
                .total-row td {
                
                    height: 58px;
                
                    vertical-align: middle;
                
                    font-weight: 700;
                
                }
                
                
                /* Amount */
                
                .total-amount {
                
                    text-align: right;
                
                    padding:
                        8px 12px;
                
                    font-size: 14px;
                
                    font-weight: 700;
                
                    white-space: nowrap;
                
                }
                
                
                /* Debit / Credit small title */
                
                .total-side-label {
                
                    display: block;
                
                    font-size: 10px;
                
                    font-weight: 600;
                
                    color: #666;
                
                    margin-bottom: 3px;
                
                    letter-spacing: .4px;
                
                }
                
                
                /* Center Total */
                
                .total-center {
                
                    text-align: center;
                
                    padding:
                        7px 15px;
                
                    vertical-align: middle;
                
                }
                
                
                .total-title {
                
                    font-size: 14px;
                
                    font-weight: 700;
                
                    margin-bottom: 4px;
                
                }
                
                
                .amount-words {
                
                    font-size: 11px;
                
                    font-weight: 600;
                
                    line-height: 1.35;
                
                    color: #333;
                
                    text-transform: uppercase;
                
                }
                
                
                /* =========================================================
                   ATTACHMENT
                   ========================================================= */
                
                .attachment {
                
                    margin-top: 12px;
                
                    font-size: 12px;
                
                }
                
                
                /* =========================================================
                   NARRATION
                   ========================================================= */
                
                .narration {
                
                    margin-top: 12px;
                
                    font-size: 12px;
                
                    line-height: 1.5;
                
                }
                
                
                /* =========================================================
                   SIGNATURE
                   ========================================================= */
                
                .signature-area {
                
                    margin-top: 55px;
                
                    display: grid;
                
                    grid-template-columns:
                        1fr
                        1fr
                        1fr;
                
                    gap: 50px;
                
                    text-align: center;
                
                }
                
                
                .signature-box {
                
                    min-height: 75px;
                
                }
                
                
                .signature-name {
                
                    font-size: 12px;
                
                    margin-bottom: 4px;
                
                }
                
                
                .signature-line {
                
                    border-top:
                        1px solid #222;
                
                    padding-top: 7px;
                
                    font-weight: 600;
                
                }
                
                
                /* =========================================================
                   PRINT
                   ========================================================= */
                
                @media print {
                
                    .voucher-print {
                
                        width: 100%;
                
                        max-width: none;
                
                        padding:
                            10mm 12mm;
                
                    }
                
                
                    @page {
                
                        size: A4 landscape;
                
                        margin: 8mm;
                
                    }
                
                }
                
                
                /* =========================================================
                   MOBILE
                   ========================================================= */
                
                @media (max-width: 700px) {
                
                    .voucher-print {
                
                        padding: 10px;
                
                        overflow-x: auto;
                
                    }
                
                
                    .voucher-top {
                
                        grid-template-columns: 1fr;
                
                        text-align: center;
                
                    }
                
                
                    .bank-left {
                
                        display: none;
                
                    }
                
                
                    .bank-right {
                
                        text-align: center;
                
                        margin-top: 8px;
                
                    }
                
                
                    .bank-name {
                
                        font-size: 18px;
                
                    }
                
                
                    .branch-name {
                
                        font-size: 15px;
                
                    }
                
                
                    .voucher-info {
                
                        grid-template-columns: 1fr;
                
                        gap: 5px;
                
                    }
                
                
                    .voucher-table {
                
                        min-width: 750px;
                
                    }
                
                
                    .signature-area {
                
                        min-width: 750px;
                
                    }
                
                }
                
                </style>
                
                
                <div class="voucher-print">
                
                
                    <!-- =====================================================
                         HEADER
                         ===================================================== -->
                
                    <div class="voucher-top">
                
                
                        <div class="bank-left">
                
                            পিএসবি-এফ - ১০
                
                        </div>
                
                
                        <div class="bank-center">
                
                            <div class="bank-logo">
                                🏦
                            </div>
                
                
                            <div class="bank-name">
                
                                Sales Management System
                
                            </div>
                
                
                            <div class="branch-name">
                
                                Hizla, Barishal - 8261
                
                            </div>
                
                        </div>
                
                
                        <div class="bank-right">
                
                            <div>
                
                                তারিখ:
                
                                <strong>' ||
                
                                apex_escape.html(
                                    v_voucher_date
                                ) ||
                
                                '</strong>
                
                            </div>
                
                
                            <div>
                
                                নং:
                
                                <strong>' ||
                
                                apex_escape.html(
                                    v_voucher_no
                                ) ||
                
                                '</strong>
                
                            </div>
                
                        </div>
                
                
                    </div>
                
                
                    <!-- =====================================================
                         VOUCHER INFORMATION
                         ===================================================== -->
                
                    <div class="voucher-info">
                
                
                        <div>
                
                            <div class="info-line">
                
                                <span class="info-label">
                
                                    প্রেরণ নং:
                
                                </span>
                
                            </div>
                
                
                            <div class="info-line">
                
                                <span class="info-label">
                
                                    ভাউচার কোড:
                
                                </span>
                
                                ' ||
                
                                apex_escape.html(
                                    NVL(
                                        v_voucher_code,
                                        ''
                                    )
                                ) ||
                
                                '
                
                            </div>
                
                        </div>
                
                
                        <div>
                
                            <div class="info-line">
                
                                <span class="info-label">
                
                                    অনুমোদন নং:
                
                                </span>
                
                            </div>
                
                
                            <div class="info-line">
                
                                <span class="info-label">
                
                                    ভাউচার টাইপ:
                
                                </span>
                
                                ' ||
                
                                apex_escape.html(
                                    NVL(
                                        v_voucher_type,
                                        ''
                                    )
                                ) ||
                
                                '
                
                            </div>
                
                        </div>
                
                
                    </div>
                
                
                    <!-- =====================================================
                         MAIN TABLE
                         ===================================================== -->
                
                    <table class="voucher-table">
                
                
                        <!-- GROUP HEADER -->
                
                        <tr>
                
                
                            <th
                                colspan="2"
                                class="group-header">
                
                                ডেবিট
                
                            </th>
                
                
                            <th
                                rowspan="2"
                                class="group-header">
                
                                বিবরণ
                
                            </th>
                
                
                            <th
                                colspan="2"
                                class="group-header">
                
                                ক্রেডিট
                
                            </th>
                
                
                        </tr>
                
                
                        <!-- SUB HEADER -->
                
                        <tr>
                
                
                            <th class="sub-header">
                
                                টাকা
                
                            </th>
                
                
                            <th class="sub-header">
                
                                হিসাবের নাম, A/C No. ও<br>
                                শাখা কোড
                
                            </th>
                
                
                            <th class="sub-header">
                
                                হিসাবের নাম, A/C No. ও<br>
                                শাখা কোড
                
                            </th>
                
                
                            <th class="sub-header">
                
                                টাকা
                
                            </th>
                
                
                        </tr>
                ');
                
                
                    /* =========================================================
                       DETAIL DATA
                       DEBIT + CREDIT SIDE BY SIDE
                       ========================================================= */
                
                    FOR r IN (
                
                        SELECT
                
                            NVL(
                                dr.rn,
                                cr.rn
                            ) AS rn,
                
                
                            dr.account_code
                                AS dr_account_code,
                
                            dr.account_name
                                AS dr_account_name,
                
                            dr.amount
                                AS dr_amount,
                
                
                            cr.account_code
                                AS cr_account_code,
                
                            cr.account_name
                                AS cr_account_name,
                
                            cr.amount
                                AS cr_amount,
                
                
                            NVL(
                                dr.particulars,
                                cr.particulars
                            ) AS particulars
                
                
                        FROM
                        (
                
                            /* =================================================
                               DEBIT
                               ================================================= */
                
                            SELECT
                
                                ROW_NUMBER() OVER (
                                    ORDER BY
                                        D.VOUCHER_DTL_NO
                                ) AS rn,
                
                
                                A.ACCOUNT_CODE,
                
                                A.ACCOUNT_NAME,
                
                                D.DEBIT_AMOUNT
                                    AS amount,
                
                                D.PARTICULARS
                
                
                            FROM ACC_VOUCHER_DTL D
                
                
                            JOIN MST_ACCOUNT_HEAD A
                
                                ON A.ACCOUNT_NO =
                                   D.ACCOUNT_NO
                
                
                            WHERE D.VOUCHER_NO =
                                  :P302_VOUCHER_TYPE
                
                              AND NVL(
                                    D.DEBIT_AMOUNT,
                                    0
                                  ) > 0
                
                        ) dr
                
                
                        FULL OUTER JOIN
                
                
                        (
                
                            /* =================================================
                               CREDIT
                               ================================================= */
                
                            SELECT
                
                                ROW_NUMBER() OVER (
                                    ORDER BY
                                        D.VOUCHER_DTL_NO
                                ) AS rn,
                
                
                                A.ACCOUNT_CODE,
                
                                A.ACCOUNT_NAME,
                
                                D.CREDIT_AMOUNT
                                    AS amount,
                
                                D.PARTICULARS
                
                
                            FROM ACC_VOUCHER_DTL D
                
                
                            JOIN MST_ACCOUNT_HEAD A
                
                                ON A.ACCOUNT_NO =
                                   D.ACCOUNT_NO
                
                
                            WHERE D.VOUCHER_NO =
                                  :P302_VOUCHER_TYPE
                
                              AND NVL(
                                    D.CREDIT_AMOUNT,
                                    0
                                  ) > 0
                
                        ) cr
                
                
                        ON dr.rn = cr.rn
                
                
                        ORDER BY
                            NVL(
                                dr.rn,
                                cr.rn
                            )
                
                    )
                
                    LOOP
                
                
                        v_html :=
                            v_html ||
                            TO_CLOB('
                
                            <tr class="voucher-row">
                
                
                                <!-- =========================================
                                     DEBIT AMOUNT
                                     ========================================= -->
                
                                <td class="amount-col">
                        ');
                
                
                        IF r.dr_amount IS NOT NULL THEN
                
                            v_html :=
                                v_html ||
                
                                TO_CHAR(
                                    r.dr_amount,
                                    'FM999G999G999G999G990D00'
                                );
                
                        END IF;
                
                
                        v_html :=
                            v_html ||
                            TO_CLOB('
                
                                </td>
                
                
                                <!-- =========================================
                                     DEBIT ACCOUNT
                                     ========================================= -->
                
                                <td class="account-col">
                        ');
                
                
                        IF r.dr_account_name IS NOT NULL THEN
                
                            v_html :=
                                v_html ||
                
                                '<div class="account-name">' ||
                
                                apex_escape.html(
                                    r.dr_account_name
                                ) ||
                
                                '</div>' ||
                
                
                                '<div class="account-code">' ||
                
                                apex_escape.html(
                                    NVL(
                                        r.dr_account_code,
                                        ''
                                    )
                                ) ||
                
                                '</div>';
                
                        END IF;
                
                
                        v_html :=
                            v_html ||
                            TO_CLOB('
                
                                </td>
                
                
                                <!-- =========================================
                                     PARTICULARS
                                     ========================================= -->
                
                                <td class="particular-col">
                
                                    <div class="particular-text">
                        ');
                
                
                        IF r.particulars IS NOT NULL THEN
                
                            v_html :=
                                v_html ||
                
                                apex_escape.html(
                                    r.particulars
                                );
                
                        END IF;
                
                
                        v_html :=
                            v_html ||
                            TO_CLOB('
                
                                    </div>
                
                                </td>
                
                
                                <!-- =========================================
                                     CREDIT ACCOUNT
                                     ========================================= -->
                
                                <td class="account-col">
                        ');
                
                
                        IF r.cr_account_name IS NOT NULL THEN
                
                            v_html :=
                                v_html ||
                
                                '<div class="account-name">' ||
                
                                apex_escape.html(
                                    r.cr_account_name
                                ) ||
                
                                '</div>' ||
                
                
                                '<div class="account-code">' ||
                
                                apex_escape.html(
                                    NVL(
                                        r.cr_account_code,
                                        ''
                                    )
                                ) ||
                
                                '</div>';
                
                        END IF;
                
                
                        v_html :=
                            v_html ||
                            TO_CLOB('
                
                                </td>
                
                
                                <!-- =========================================
                                     CREDIT AMOUNT
                                     ========================================= -->
                
                                <td class="amount-col">
                        ');
                
                
                        IF r.cr_amount IS NOT NULL THEN
                
                            v_html :=
                                v_html ||
                
                                TO_CHAR(
                                    r.cr_amount,
                                    'FM999G999G999G999G990D00'
                                );
                
                        END IF;
                
                
                        v_html :=
                            v_html ||
                            TO_CLOB('
                
                                </td>
                
                            </tr>
                
                        ');
                
                
                    END LOOP;
                
                
                    /* =========================================================
                       TOTAL ROW
                       ========================================================= */
                
                    v_html :=
                        v_html ||
                        TO_CLOB('
                
                        <tr class="total-row">
                
                
                            <!-- =============================================
                                 DEBIT TOTAL
                                 ============================================= -->
                
                            <td class="total-amount">
                
                                <span class="total-side-label">
                                    DEBIT TOTAL
                                </span>
                
                                ' ||
                
                                TO_CHAR(
                                    v_total_dr,
                                    'FM999G999G999G999G990D00'
                                ) ||
                
                                '
                
                            </td>
                
                
                            <!-- =============================================
                                 TOTAL / AMOUNT IN WORDS
                                 ============================================= -->
                
                            <td
                                colspan="3"
                                class="total-center">
                
                
                                <div class="total-title">
                
                                    সর্বমোট / TOTAL
                
                                </div>
                
                
                                <div class="amount-words">
                
                                    TK. ' ||
                
                                    apex_escape.html(
                                        number_to_words(
                                            v_total_dr
                                        )
                                    ) ||
                
                                    ' ONLY
                
                                </div>
                
                
                            </td>
                
                
                            <!-- =============================================
                                 CREDIT TOTAL
                                 ============================================= -->
                
                            <td class="total-amount">
                
                                <span class="total-side-label">
                                    CREDIT TOTAL
                                </span>
                
                                ' ||
                
                                TO_CHAR(
                                    v_total_cr,
                                    'FM999G999G999G999G990D00'
                                ) ||
                
                                '
                
                            </td>
                
                
                        </tr>
                
                
                    </table>
                
                
                    <!-- =====================================================
                         ATTACHMENT
                         ===================================================== -->
                
                    <div class="attachment">
                
                        সংযুক্তি:
                        ....................................................................................
                
                    </div>
                
                
                    <!-- =====================================================
                         NARRATION
                         ===================================================== -->
                
                    <div class="narration">
                
                        <strong>বিবরণ:</strong>
                
                        ' ||
                
                        apex_escape.html(
                            NVL(
                                v_narration,
                                ''
                            )
                        ) ||
                
                        '
                
                    </div>
                
                
                    <!-- =====================================================
                         SIGNATURE
                         ===================================================== -->
                
                    <div class="signature-area">
                
                
                        <!-- PREPARED BY -->
                
                        <div class="signature-box">
                
                            <div class="signature-name">
                
                                ' ||
                
                                apex_escape.html(
                                    NVL(
                                        v_created_by,
                                        ''
                                    )
                                ) ||
                
                                '
                
                            </div>
                
                
                            <div class="signature-line">
                
                                প্রস্তুতকারীর স্বাক্ষর
                
                            </div>
                
                        </div>
                
                
                        <!-- APPROVED 1 -->
                
                        <div class="signature-box">
                
                            <div style="height:35px;"></div>
                
                
                            <div class="signature-line">
                
                                ১) অনুমোদিত স্বাক্ষর
                
                            </div>
                
                        </div>
                
                
                        <!-- APPROVED 2 -->
                
                        <div class="signature-box">
                
                            <div style="height:35px;"></div>
                
                
                            <div class="signature-line">
                
                                ২) অনুমোদিত স্বাক্ষর
                
                            </div>
                
                        </div>
                
                
                    </div>
                
                
                </div>
                
                ');
                
                
                    /* =========================================================
                       RETURN HTML CLOB
                       ========================================================= */
                
                    RETURN v_html;
                
                
                END;
                ```
            pageItemsToSubmit: [
                P302_FROM_DATE
                P302_TO_DATE
                P302_VOUCHER_TYPE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region voucher-mst_1 (
        name: VOUCHER REGISTER
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (SELECT
                       M.VOUCHER_NO,
                
                       M.VOUCHER_CODE,
                
                       M.VOUCHER_DATE,
                
                       M.VOUCHER_TYPE,
                
                       M.NARRATION,
                
                       (
                           SELECT NVL(SUM(DEBIT_AMOUNT),0)
                           FROM ACC_VOUCHER_DTL D
                           WHERE D.VOUCHER_NO = M.VOUCHER_NO
                       ) TOTAL_DEBIT,
                
                       (
                           SELECT NVL(SUM(CREDIT_AMOUNT),0)
                           FROM ACC_VOUCHER_DTL D
                           WHERE D.VOUCHER_NO = M.VOUCHER_NO
                       ) TOTAL_CREDIT,
                
                       CASE M.APPROVAL_STATUS
                
                           WHEN 'A' THEN
                               '<span class="t-Badge t-Badge--success">
                                Approved
                                </span>'
                
                           WHEN 'P' THEN
                               '<span class="t-Badge t-Badge--warning">
                                Pending
                                </span>'
                
                           WHEN 'R' THEN
                               '<span class="t-Badge t-Badge--danger">
                                Rejected
                                </span>'
                
                       END STATUS,
                
                       M.CREATED_BY,
                
                       M.CREATED_DATE,
                NULL VIEW_BTN
                
                FROM ACC_VOUCHER_MST M
                
                WHERE (:P302_FROM_DATE IS NULL
                       OR M.VOUCHER_DATE >= :P302_FROM_DATE)
                
                AND (:P302_TO_DATE IS NULL
                     OR M.VOUCHER_DATE <= :P302_TO_DATE)
                
                AND (:P302_VOUCHER_TYPE IS NULL
                     OR M.VOUCHER_TYPE = :P302_VOUCHER_TYPE)
                
                AND (:P302_STATUS IS NULL
                     OR M.APPROVAL_STATUS = :P302_STATUS)
                
                ORDER BY M.VOUCHER_NO DESC)
                ```
            pageItemsToSubmit: [
                P302_FROM_DATE
                P302_TO_DATE
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        config {
            buildOption: @commented-out
        }
