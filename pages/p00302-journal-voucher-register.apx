                }
                linkText: <span class="t-Button-label">View</span>
                linkAttributes: class="t-Button t-Button--hot t-Button--small t-Button--primary t-Button--stretch"
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
