    region details (
        name: DETAILS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       A.ACCOUNT_CODE,
                
                       A.ACCOUNT_NAME,
                
                       D.DEBIT_AMOUNT,
                
                       D.CREDIT_AMOUNT,
                
                       D.PARTICULARS
                
                FROM ACC_VOUCHER_DTL D
                
                JOIN MST_ACCOUNT_HEAD A
                  ON A.ACCOUNT_NO = D.ACCOUNT_NO
                
                WHERE D.VOUCHER_NO =
                      :P304_VOUCHER_NO
                
                ORDER BY D.VOUCHER_DTL_NO
                ```
            pageItemsToSubmit: P304_VOUCHER_NO
        }
        layout {
            sequence: 10
            parentRegion: @voucher-view
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: vioucherViewDtl
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 14042069450494665319
        }

