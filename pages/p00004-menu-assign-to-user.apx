    dynamicAction da-get-submenu-no (
        name: DA_GET_SUBMENU_NO
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @submenu
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                        let gridsrl = apex.region('submenu').widget().interactiveGrid('getViews', 'grid');
                        let modelsrl = gridsrl.model;
                        let selectedRow3 = gridsrl.view$.grid('getSelection');
                        let subMenuNo =[];
                        for (i = 0; i < selectedRow3.length; i++) {
                            id = $(selectedRow3[i][0]).data('id');
                            var r = modelsrl.getRecord(id);
                            
                            // userNo += Number(modelsrl.getValue(r, "USER_NO"));
                            let u = Number(modelsrl.getValue(r, "SUBMENU_NO")); // for multiple select 
                            subMenuNo.push(u);
                            
                            // let v = Number(modelsrl.getValue(r, "USER_NO")); // for single select 
                            // $s("P2_S_USER_NO", v);
                    
                        }
                        
                    $s("P4_P_SUBMENU_NO",',' +subMenuNo +','); // Set Multiple user no
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

