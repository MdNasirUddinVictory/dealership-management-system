    region grand-object (
        name: GRAND-OBJECT
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select M.GR_OBJECT_NO,
                       M.SUBMENU_NO,
                       M.USER_NO,
                       M.CAN_VIEW,
                       M.CAN_MODIFY,
                       M.CAN_REMOVE,
                       M.CAN_SHARE,
                       M.CAN_CREATE,
                       U.USER_NAME,
                       SM.SUBMENU_NAME
                  from SA_GRANTOBJECT M,SA_USER U,SA_SUBMENU SM
                  WHERE M.USER_NO = U.USER_NO(+)
                  AND M.SUBMENU_NO = SM.SUBMENU_NO(+)
                ```
        }
        layout {
            sequence: 40
            parentRegion: @div-id-userperm-class-fa-fa-pencile-user-wise-menu-permission-div
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-none
                margin-bottom-none
            ]
        }
        masterDetail {
            masterRegion: @user
        }
        advanced {
            htmlDomId: object
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        componentAppearance {
            selectFirstRow: false
        }
