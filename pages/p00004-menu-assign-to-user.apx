    region submenu (
        name: SUBMENU
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                  S.SUBMENU_NO,
                  S.SUBMENU_ID,
                  S.MENU_NO,
                  S.SUBMENU_NAME,
                  S.SUBMENU_TYPE,
                  S.ACTIVE_FLAG,
                  S.CAN_VIEW,
                  S.CAN_MODIFY,
                  S.CAN_REMOVE,
                  S.CAN_CREATE
                FROM SA_SUBMENU S
                WHERE NOT EXISTS (
                  SELECT 1 
                  FROM SA_GRANTOBJECT G
                  WHERE G.SUBMENU_NO = S.SUBMENU_NO
                    AND G.USER_NO = TO_NUMBER(REGEXP_SUBSTR(:P4_P_USER_NO, '\d+'))
                );
                
                ```
            pageItemsToSubmit: P4_P_USER_NO
        }
        layout {
            sequence: 30
            parentRegion: @div-id-userperm-class-fa-fa-pencile-user-wise-menu-permission-div
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-none
                margin-bottom-none
            ]
        }
