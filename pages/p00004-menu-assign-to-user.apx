    process ajx-grant-obj (
        name: AJX_GRANT_OBJ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_MSG               VARCHAR2 (100);
                    V_CUTDTL_NO_ARRAY   APEX_APPLICATION_GLOBAL.VC_ARR2;
                    v_pk                NUMBER;
                
                    /* CURSOR CUR_EMP IS
                        SELECT USER_NO
                          FROM HR_EMP
                         WHERE INSTR (',' || APEX_APPLICATION.G_x01, ',' || USER_NO || ',') > 0
                         AND USER_NO IS NOT NULL; */
                    CURSOR CUR_EMP IS
                        SELECT USER_NO
                          FROM SA_USER
                         WHERE INSTR (',' || APEX_APPLICATION.G_x01, ',' || USER_NO || ',') > 0
                         AND USER_NO IS NOT NULL;
                
                    CURSOR CUR_MENU IS
                        SELECT SUBMENU_NO
                          FROM SA_SUBMENU
                         WHERE INSTR (',' || APEX_APPLICATION.G_x02,',' || SUBMENU_NO || ',') > 0;
                
                BEGIN
                    APEX_JSON.OPEN_OBJECT;
                    V_CUTDTL_NO_ARRAY :=
                        APEX_UTIL.STRING_TO_TABLE (APEX_APPLICATION.G_X01, ',');
                
                    FOR I IN CUR_EMP
                    LOOP
                            FOR K IN CUR_MENU
                            LOOP
                                SELECT NVL (MAX (TO_NUMBER (GR_OBJECT_NO)), 0) + 1
                                  INTO v_pk
                                  FROM SA_GRANTOBJECT;
                
                                -- v_pk := S_SA_GRANTOBJECT.nextval;
                                INSERT INTO SA_GRANTOBJECT (GR_OBJECT_NO,
                                                            SUBMENU_NO,
                                                            USER_NO,
                                                            CAN_VIEW,
                                                            CAN_MODIFY,
                                                            CAN_REMOVE,
                                                            CAN_SHARE,
                                                            CAN_CREATE,
                                                            --ROLE_NO,
                                                            ACTIVE_FLAG
                                                            )
                                     VALUES (v_pk,
                                             K.SUBMENU_NO,
                                             i.USER_NO,
                                             1,                      --APEX_APPLICATION.G_X03,
                                             1,                      --APEX_APPLICATION.G_X04,
                                             1,                      --APEX_APPLICATION.G_X05,
                                             1,                     -- APEX_APPLICATION.G_X06,
                                             1,                      --APEX_APPLICATION.G_X07,
                                             --APEX_APPLICATION.G_X10,
                                             1                    --APEX_APPLICATION.G_X08,
                                             );
                            END LOOP;
                    END LOOP;
                
                    V_MSG := 'Object Garnd Successgully';
                    APEX_JSON.WRITE ('stat', '200');
                    --    APEX_JSON.WRITE ('V_LINEINPUT_NO', V_LINEINPUT_NO);
                    APEX_JSON.CLOSE_ALL;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        APEX_JSON.WRITE ('stat', SQLERRM);
                        APEX_JSON.CLOSE_ALL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 8045880511268862421
        }
    )

    process grand-object-save-interactive-grid-data (
        name: GRAND-OBJECT - Save Interactive Grid Data
        type: executeCode
        editableRegion: @grand-object
        source {
            plsqlCode:
                ```plsql
                CASE :APEX$ROW_STATUS WHEN 'C' THEN NULL;
                WHEN  'U' THEN NULL;
                WHEN 'D' THEN 
                DELETE SA_GRANTOBJECT
                WHERE GR_OBJECT_NO = :GR_OBJECT_NO;
                END CASE;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8045871773392862408
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_MSG               VARCHAR2 (100);
                    V_CUTDTL_NO_ARRAY   APEX_APPLICATION_GLOBAL.VC_ARR2;
                    v_pk                NUMBER;
                
                    /* CURSOR CUR_EMP IS
                        SELECT USER_NO
                          FROM HR_EMP
                         WHERE INSTR (',' || APEX_APPLICATION.G_x01, ',' || USER_NO || ',') > 0
                         AND USER_NO IS NOT NULL; */
                    CURSOR CUR_EMP IS
                        SELECT USER_NO
                          FROM SA_USERS
                         WHERE INSTR (',' || APEX_APPLICATION.G_x01, ',' || USER_NO || ',') > 0
                         AND USER_NO IS NOT NULL;
                
                    CURSOR CUR_MENU IS
                        SELECT SUBMENU_NO
                          FROM SA_SUBMENU
                         WHERE INSTR (',' || APEX_APPLICATION.G_x02,',' || SUBMENU_NO || ',') > 0;
                
                    CURSOR CUR_COM IS
                        SELECT COMPANY_NO
                          FROM SA_COMPANY
                         WHERE INSTR (':' || NVL ( APEX_APPLICATION.G_x09, COMPANY_NO) || ':', ':' || COMPANY_NO || ':') > 0;
                BEGIN
                    APEX_JSON.OPEN_OBJECT;
                    V_CUTDTL_NO_ARRAY :=
                        APEX_UTIL.STRING_TO_TABLE (APEX_APPLICATION.G_X01, ',');
                
                    FOR I IN CUR_EMP
                    LOOP
                        FOR J IN CUR_COM
                        LOOP
                            FOR K IN CUR_MENU
                            LOOP
                                SELECT NVL (MAX (TO_NUMBER (GR_OBJECT_NO)), 0) + 1
                                  INTO v_pk
                                  FROM SA_GRANTOBJECT;
                
                                -- v_pk := S_SA_GRANTOBJECT.nextval;
                                INSERT INTO SA_GRANTOBJECT (GR_OBJECT_NO,
                                                            SUBMENU_NO,
                                                            USER_NO,
                                                            CAN_VIEW,
                                                            CAN_MODIFY,
                                                            CAN_REMOVE,
                                                            CAN_SHARE,
                                                            CAN_CREATE,
                                                            ROLE_NO,
                                                            ACTIVE_FLAG,
                                                            COMPANY_NO)
                                     VALUES (v_pk,
                                             K.SUBMENU_NO,
                                             I.USER_NO,
                                             1,                      --APEX_APPLICATION.G_X03,
                                             1,                      --APEX_APPLICATION.G_X04,
                                             1,                      --APEX_APPLICATION.G_X05,
                                             1,                     -- APEX_APPLICATION.G_X06,
                                             1,                      --APEX_APPLICATION.G_X07,
                                             APEX_APPLICATION.G_X10,
                                             1,                      --APEX_APPLICATION.G_X08,
                                             J.COMPANY_NO);
                            END LOOP;
                        END LOOP;
                    END LOOP;
                
                    V_MSG := 'Successfully Inserted';
                    APEX_JSON.WRITE ('stat', '200');
                    --    APEX_JSON.WRITE ('V_LINEINPUT_NO', V_LINEINPUT_NO);
                    APEX_JSON.CLOSE_ALL;
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        APEX_JSON.WRITE ('stat', SQLERRM);
                        APEX_JSON.CLOSE_ALL;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 8045880125522862420
        }
        config {
            buildOption: @commented-out
        }
    )

)

