page 4 (
    name: Menu Assign To User
    alias: MENU-ASSIGN-TO-USER
    title: Menu Assign To User
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // GRANT OBJECTS
            function grantObject() {
            
                // let activeFlug,
                //     cView,
                //     cModify,
                //     cRemove,
                //     cShare,
                //     cCreate,
                //     rollNo;
            
            
                // select grid ckeck boxs
                var grid = apex.region("submenu").call("getViews", "grid");
                var model = grid.model;
                var selectedRow = grid.view$.grid('getSelection');
                if (selectedRow.length > 0) {
                    var id = $(selectedRow[0][0]).data('id');
                    var record = model.getRecord(id);
                    // cView = model.getValue(record, 'CAN_VIEW');
                    // cModify = model.getValue(record, 'CAN_MODIFY');
                    // cRemove = model.getValue(record, 'CAN_REMOVE');
                    // cShare = model.getValue(record, 'CAN_SHARE');
                    // cCreate = model.getValue(record, 'CAN_CREATE');
                    // activeFlug = model.getValue(record, 'ACTIVE_FLAG');
                    // rollNo = model.getValue(record, 'ROLL_NO'); 
                }
            
            
                apex.server.process('AJX_GRANT_OBJ',
                    {
                        // x01: $v('P100044_EMP_NO'),
                        x01: $v('P4_P_USER_NO'),
                        x02: $v('P4_P_SUBMENU_NO'),
                        // x03: cView,
                        // x04: cModify,
                        // x05: cRemove,
                        // x06: cShare,
                        // x07: cCreate,
                        // x08: activeFlug,
                        // x09: $v('P100044_COM'),
                        // x10: rollNo
            
                    },
                    {
                        success: function (pData) {
                            console.log(pData);
                            // console.log("v_SEQ := " + pData.V_LINEINPUT_NO);
                            if (pData.stat == 200) {
                                apex.message.showPageSuccess('Inserted Successfully!');
                                 apex.region('object').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                // apex.region('role').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                // apex.region('company').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                // apex.region('submenu').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                // apex.region('HR_EMP').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                // apex.region('grantCom').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                // apex.region('grantRole').widget().interactiveGrid('getViews', 'grid').model.clearChanges();
                                apex.region('object').refresh();
                                // apex.region("object").refresh();
                            }
                            else if (pData.stat == 400) {
                                apex.message.showErrors(
                                    { type: "error", location: "page", message: "Can not Forward. Somthing Problem..!", unsafe: false });
                            }
                        },
                        error: function (e) {
                            console.log(e);
                            // apex.message.showPageSuccess('Can not be Insert !');
                            apex.message.showErrors(
                                { type: "error", location: "page", message: "Somthing Problem..!", unsafe: false });
                        },
                        dataType: "json"
                    }
                );
            }
            
            console.log($v('P4_P_SUBMENU_NO').length)
            
            
            
            ```
    }
