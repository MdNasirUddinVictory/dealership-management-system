            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORY_NAME (
                sequence: 3
            )

            displayColumn CURRENT_STOCK (
                sequence: 9
            )

            displayColumn MIN_STOCK_QTY (
                sequence: 6
            )

            displayColumn PRODUCT_CODE (
                sequence: 1
            )

            displayColumn PRODUCT_NAME (
                sequence: 2
            )

            displayColumn PURCHASE_RATE (
                sequence: 4
            )

            displayColumn SALES_RATE (
                sequence: 5
            )

            displayColumn STATUS_ICON (
                sequence: 12
            )

            displayColumn STOCK_IN (
                sequence: 7
            )

            displayColumn STOCK_OUT (
                sequence: 8
            )

            displayColumn STOCK_STATUS (
                sequence: 11
