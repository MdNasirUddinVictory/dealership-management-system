    region register (
        name: Current Stock
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM
                (
                    SELECT
                           P.PRODUCT_NO,
                           P.PRODUCT_CODE,
                           P.PRODUCT_NAME,
                
                           C.CATEGORY_NAME,
                
                           P.PURCHASE_RATE,
                           P.SALES_RATE,
                
                           NVL(P.MIN_STOCK_QTY,0) MIN_STOCK_QTY,
                
                           NVL(SUM(NVL(L.QTY_IN,0)),0) STOCK_IN,
                
                           NVL(SUM(NVL(L.QTY_OUT,0)),0) STOCK_OUT,
                
                           NVL(
                               SUM(NVL(L.QTY_IN,0))
                               -
                               SUM(NVL(L.QTY_OUT,0)),
                               0
                           ) CURRENT_STOCK,
                
                           ROUND(
                               NVL(
                                   SUM(NVL(L.QTY_IN,0))
                                   -
                                   SUM(NVL(L.QTY_OUT,0)),
                                   0
                               ) * NVL(P.PURCHASE_RATE,0),
                               2
                           ) STOCK_VALUE,
                
                          CASE
                    WHEN NVL(
                             SUM(NVL(L.QTY_IN,0))
                             -
                             SUM(NVL(L.QTY_OUT,0)),
                             0
                         ) <= 0
                    THEN
                        '<span style="
                            display:inline-block;
                            background:#fee2e2;
                            color:#b91c1c;
                            border:1px solid #fecaca;
                            padding:2px 8px;
                            border-radius:12px;
                            font-size:11px;
                            font-weight:600;
                            white-space:nowrap;">
                            Out of Stock
                         </span>'
                
                    WHEN NVL(
                             SUM(NVL(L.QTY_IN,0))
                             -
                             SUM(NVL(L.QTY_OUT,0)),
                             0
                         ) < NVL(P.MIN_STOCK_QTY,0)
                    THEN
                        '<span style="
                            display:inline-block;
                            background:#fef3c7;
                            color:#b45309;
                            border:1px solid #fde68a;
                            padding:2px 8px;
                            border-radius:12px;
                            font-size:11px;
                            font-weight:600;
                            white-space:nowrap;">
                            Low Stock
                         </span>'
                
                    ELSE
                        '<span style="
                            display:inline-block;
                            background:#dcfce7;
                            color:#15803d;
                            border:1px solid #bbf7d0;
                            padding:2px 8px;
                            border-radius:12px;
                            font-size:11px;
                            font-weight:600;
                            white-space:nowrap;">
                            Available
                         </span>'
                END STOCK_STATUS,
                
                           CASE
                    WHEN NVL(
                             SUM(NVL(L.QTY_IN,0))
                             -
                             SUM(NVL(L.QTY_OUT,0)),
                             0
                         ) <= 0
                    THEN
                        '<span class="fa fa-times-circle"
                               style="
                                   color:#dc2626;
                                   font-size:13px;
                                   vertical-align:middle;
                                   line-height:1;"
                               title="Out of Stock">
                         </span>'
                
                    WHEN NVL(
                             SUM(NVL(L.QTY_IN,0))
                             -
                             SUM(NVL(L.QTY_OUT,0)),
                             0
                         ) < NVL(P.MIN_STOCK_QTY,0)
                    THEN
                        '<span class="fa fa-exclamation-triangle"
                               style="
                                   color:#f59e0b;
                                   font-size:13px;
                                   vertical-align:middle;
                                   line-height:1;"
                               title="Low Stock">
                         </span>'
                
                    ELSE
                        '<span class="fa fa-check-circle"
                               style="
                                   color:#16a34a;
                                   font-size:13px;
                                   vertical-align:middle;
                                   line-height:1;"
                               title="Available">
                         </span>'
                END STATUS_ICON
                
                    FROM MST_PRODUCT P
                
                    LEFT JOIN MST_PRODUCT_CATEGORY C
                           ON C.CATEGORY_NO = P.CATEGORY_NO
                
                    LEFT JOIN TRN_STOCK_LEDGER L
                           ON L.PRODUCT_NO = P.PRODUCT_NO
                
                    WHERE (:P10_CATEGORY_NO IS NULL
                           OR P.CATEGORY_NO = :P10_CATEGORY_NO)
                
                      AND (:P10_PRODUCT_NO IS NULL
                           OR P.PRODUCT_NO = :P10_PRODUCT_NO)
                
                    GROUP BY
                           P.PRODUCT_NO,
                           P.PRODUCT_CODE,
                           P.PRODUCT_NAME,
                           C.CATEGORY_NAME,
                           P.PURCHASE_RATE,
                           P.SALES_RATE,
                           P.MIN_STOCK_QTY
                )
                WHERE
                (
                      :P10_STATUS IS NULL
                
                   OR (:P10_STATUS = 'A'
                       AND CURRENT_STOCK >= MIN_STOCK_QTY)
                
                   OR (:P10_STATUS = 'L'
                       AND CURRENT_STOCK > 0
                       AND CURRENT_STOCK < MIN_STOCK_QTY)
                
                   OR (:P10_STATUS = 'O'
                       AND CURRENT_STOCK <= 0)
                )
                
                ORDER BY PRODUCT_NAME;
                ```
            pageItemsToSubmit: [
                P10_CATEGORY_NO
                P10_PRODUCT_NO
                P10_STATUS
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--removeHeader js-removeLandmark
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
            ]
        }
