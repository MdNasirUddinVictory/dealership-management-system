        )

    )

    pageItem P10_CATEGORY_NO (
        type: selectList
        label {
            label: Category Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'All Categories' DISPLAY_VALUE,
                       NULL RETURN_VALUE
                FROM DUAL
                
                UNION ALL
                
                SELECT CATEGORY_NAME,
                       CATEGORY_NO
                FROM MST_PRODUCT_CATEGORY
                
                ORDER BY 1;
                ```
            displayExtraValues: false
            nullDisplayValue: --Select--
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

    pageItem P10_PRODUCT_NO (
        type: popupLov
        label {
            label: Product_Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PRODUCT_CODE
                       || ' - '
                       || PRODUCT_NAME DISPLAY_VALUE,
                
                       PRODUCT_NO RETURN_VALUE
                
                FROM MST_PRODUCT
                
                WHERE (:P10_CATEGORY_NO IS NULL
                       OR CATEGORY_NO = :P10_CATEGORY_NO)
                
                AND ACTIVE_FLAG = 1
                
                ORDER BY PRODUCT_NAME;
                ```
            displayExtraValues: false
            nullDisplayValue: --Select--
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P10_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Available' DISPLAY_VALUE,
                       'A' RETURN_VALUE
                FROM DUAL
                
                UNION ALL
                
                SELECT 'Low Stock',
                       'L'
                FROM DUAL
                
                UNION ALL
                
                SELECT 'Out of Stock',
                       'O'
                FROM DUAL
                ```
            displayExtraValues: false
            nullDisplayValue: --Select--
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
    )

