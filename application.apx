app DEALER-INVENTORY-SALES-MANAGEMENT-SYSTEM (
    name: Dealer Inventory & Sales Management System
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#POS_LOGO-removebg-preview.png
        text: Dealer Inventory & Sales Management System
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @database-menu-access
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        usersCanChooseThemeStyle: true
        addBuiltWithApexToFooter: false
        autoDismissSuccessMessages: true
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    css {
        fileUrls: #APP_FILES#Custom_main.css
    }
    authentication {
        scheme: @database-user-authentication
    }
    sessionStateProtection {
        checksumSalt: 157AE48DCCC09F46623DB56DB747E45CFA5A3AAD87CD5CC5ACC7D167D5A224EA
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Dealer Inventory & Sales Management System
        }
    )

)

