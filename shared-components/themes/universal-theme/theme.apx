theme universal-theme (
    name: Universal Theme
    themeNumber: 42
    baseTheme: ut-26.1
    style {
        currentThemeStyle: @vita-slate-copy-1
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @/standard
        navigationBarList: @/navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @/top-navigation-menu
        navigationMenuListSide: @/side-navigation-menu
        loginPage: @/login
        errorPage: @/login
        printerFriendlyPage: @/standard
        breadcrumb: @/breadcrumb
        button: @/text
        defaultLabel: @/optional-floating
        optionalLabel: @/optional-floating
        requiredLabel: @/required-floating
        list: @/links-list
        region: @/standard
        classicReport: @/standard
    }
    regionDefaults {
        breadcrumbs: @/title-bar
        charts: @/standard
        forms: @/standard
        lists: @/standard
        reports: @/standard
        wizards: @/standard
        interactiveReports: @/interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @/blank-with-attributes
        dialogButtonRegion: @/buttons-container
        dialogPage: @/modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/26.1/
        identifier: UNIVERSAL_THEME
    }

    style vita-slate-copy-1 (
        name: Vita - Slate (copy_1)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Slate.less
            outputCssFileUrl: #THEME_DB_FILES#8097320806955135105.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Form-Item-BG\":\"#fcfcfc\",\"@g_Form-Item-FG\":\"#1833a7\",\"@g_Form-BorderRadius\":\"10px\",\"@g_Button-BorderRadius\":\"6px\",\"@Head-Height\":\"48px\",\"@Nav-Exp\":\"210px\",\"@Actions-Exp\":\"200px\",\"@Side-Exp\":\"200px\",\"@g_Nav_Style\":\"dark\",\"@g_Nav-BG\":\"#374484\",\"@g_Nav-FG\":\"#f8f8f8\",\"@g_NavBarMenu-BG\":\"#ddbaba\",\"@g_NavBarMenu-FG\":\"#3a3939\",\"@g_NavBarMenu-Active-BG\":\"#1772c7\",\"@g_NavBarMenu-Active-FG\":\"#ffffff\",\"@g_Nav-Active-BG\":\"#38478f\",\"@g_Nav-Active-FG\":\"#abf080\",\"@g_Nav-Icon\":\"#14d711\",\"@g_Nav-Icon-Active\":\"#3cf935\",\"@g_Link-Base\":\"#024486\",\"@g_Header-BG\":\"#5166b1\",\"@g_Header-FG\":\"#f8faf8\",\"@g_Container-BorderRadius\":\"12px\",\"@g_Body-BG\":\"#f2f2f2\",\"@g_Body-Text\":\"#66367f\",\"@g_Region-Header-BG\":\"#bccfd9\",\"@g_Region-Header-FG\":\"#1d1d1d\",\"@g_Disabled-BG\":\"#666262\",\"@g_Disabled-FG\":\"#ffffff\",\"@g_Accent-OG\":\"#de3636\",\"@g_Form-Label\":\"#393993\",\"@irrBg\":\"#f4f2f2\",\"@g_Body-Title-BG\":\"#6baef1\",\"@g_Body-Title-FG\":\"#000000\",\"@g_Region-BG\":\"#f5f5f5\",\"@g_Region-FG\":\"#262626\",\"@g_Accent-BG\":\"#8dbae4\",\"@g_Actions-Col-BG\":\"#913232\",\"@g_Actions-Col-Text\":\"#ffffff\",\"@l_Left-Col-BG\":\"#d67272\",\"@l_Left-Col-Text\":\"#66367f\",\"@g_Nav-Badge-BG\":\"#689dce\",\"@g_Nav-Badge-FG\":\"#000000\"},\"customCSS\":\".t-Body-contentInner{\\n    padding:3px;\\n}\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
        }
    )

)

