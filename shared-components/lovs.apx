)

lov lov-27-supplier-purchase (
    name: LOV_27_SUPPLIER_PURCHASE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT M.PURCHASE_NO                              AS INVOICE_NO,
                   M.PURCHASE_CODE                            AS DOC_CODE,
                   TO_CHAR(M.PURCHASE_DATE, 'DD-MON-YYYY')    AS DOC_DATE,
                   M.TOTAL_AMOUNT                             AS INVOICE_AMOUNT,
                   NVL(M.DUE_AMOUNT, 0)                       AS DUE_AMOUNT,
                   NVL(M.PAID_AMOUNT, 0)                      AS PAYMENT_AMOUNT,
                   NVL(M.DUE_AMOUNT, 0)                       AS PAY_DUE_AMOUNT
              FROM TRN_PURCHASE_MST M
             WHERE M.SUPPLIER_NO = :P27_PARTY_NO
               AND NVL(M.DUE_AMOUNT, 0) > 0
             ORDER BY M.PURCHASE_DATE DESC;
            ```
