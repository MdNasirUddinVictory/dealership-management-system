lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov lov-102-product (
    name: LOV_102_PRODUCT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT P.PRODUCT_CODE
                   || ' - '
                   || P.PRODUCT_NAME DISPLAY_VALUE,
                   P.PRODUCT_NO RETURN_VALUE,
                   D.SALES_RATE,
                   D.SALES_QTY
            FROM TRN_SALES_INVOICE_DTL D
            JOIN MST_PRODUCT P
              ON P.PRODUCT_NO = D.PRODUCT_NO
            WHERE D.INVOICE_NO = :P102_INVOICE_NO
            ORDER BY P.PRODUCT_NAME
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }

    column DISPLAY_VALUE (
        heading {
            heading: Product Name
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column RETURN_VALUE (
        show: false
        layout {
            sequence: 20
        }
        source {
            dataType: number
        }
    )

    column SALES_QTY (
        heading {
            heading: Sales Qty
        }
        layout {
            sequence: 40
        }
        source {
            dataType: number
        }
    )

    column SALES_RATE (
        heading {
            heading: Sales Rate
        }
        layout {
            sequence: 30
        }
        source {
            dataType: number
        }
    )

)

lov lov-105-invoice-lov (
    name: LOV_105_INVOICE_LOV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                   I.INVOICE_NO,
            
                   I.INVOICE_CODE,
            
                   I.INVOICE_DATE,
            
                   i.CUSTOMER_NO,
            
                   C.CUSTOMER_NAME,
            
                   C.MOBILE_NO,
            
                   I.TOTAL_AMOUNT,
            
                   (
                       SELECT NVL(SUM(D.SALES_QTY),0)
                         FROM TRN_SALES_INVOICE_DTL D
                        WHERE D.INVOICE_NO = I.INVOICE_NO
                   ) TOTAL_QTY
            
            FROM TRN_SALES_INVOICE_MST I
            JOIN MST_CUSTOMER C
              ON C.CUSTOMER_NO = I.CUSTOMER_NO
            
            WHERE (
                    I.DELIVERY_STATUS IN ('P','PD')
                 OR EXISTS
                    (
                        SELECT 1
                          FROM TRN_DELIVERY_MST D
                         WHERE D.DELIVERY_NO = :P105_DELIVERY_NO
                           AND D.INVOICE_NO = I.INVOICE_NO
                    )
                  )
            
            ORDER BY I.INVOICE_NO DESC
            ```
    }
    columnMapping {
        return: INVOICE_NO
        display: INVOICE_CODE
    }

    column CUSTOMER_NAME (
        heading {
            heading: Customer Name
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column CUSTOMER_NO (
        show: false
        heading {
            heading: Customer No
        }
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
    )

    column INVOICE_CODE (
        heading {
            heading: Invoice Code
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column INVOICE_DATE (
        heading {
            heading: Invoice Date
        }
        layout {
            sequence: 30
        }
        source {
            dataType: date
        }
    )

    column INVOICE_NO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column MOBILE_NO (
        heading {
            heading: Mobile No
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column TOTAL_AMOUNT (
        heading {
            heading: Total Amount
        }
        layout {
            sequence: 60
        }
        source {
            dataType: number
        }
    )

    column TOTAL_QTY (
        heading {
            heading: Total Qty
        }
        layout {
            sequence: 70
        }
        source {
            dataType: number
        }
    )

)

lov lov-11-product (
    name: LOV_11_PRODUCT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                   PRODUCT_NO,
            
                   PRODUCT_CODE,
            
                   PRODUCT_NAME,
            
                   PURCHASE_RATE,
            
                   SALES_RATE,
            
                   MIN_STOCK_QTY
            
            FROM MST_PRODUCT
            
            WHERE ACTIVE_FLAG = 1
            
            ORDER BY PRODUCT_NAME;
            ```
    }
    columnMapping {
        return: PRODUCT_NO
        display: PRODUCT_CODE
    }
)

