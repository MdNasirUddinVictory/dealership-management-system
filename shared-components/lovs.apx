lov lov-17-product (
    name: LOV_17_PRODUCT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT P.PRODUCT_NO,
                   P.PRODUCT_CODE || ' - ' || P.PRODUCT_NAME AS PRODUCT_NAME,
                   P.DESCRIPTION,
                   P.UOM_NO,
                   U.UOM_NAME,
                   P.PURCHASE_RATE,
                   P.SALES_RATE,
                   NVL(S.STOCK_QTY,0) AS STOCK_QTY
            FROM MST_PRODUCT P
            JOIN MST_UOM U
              ON U.UOM_NO = P.UOM_NO
            LEFT JOIN
            (
                SELECT PRODUCT_NO,
                       SUM(QTY_IN) - SUM(QTY_OUT) AS STOCK_QTY
                  FROM TRN_STOCK_LEDGER
                 GROUP BY PRODUCT_NO
            ) S
              ON S.PRODUCT_NO = P.PRODUCT_NO
            WHERE P.ACTIVE_FLAG = 1
            ORDER BY P.PRODUCT_NAME;
            ```
    }
    columnMapping {
        return: PRODUCT_NO
        display: PRODUCT_NAME
    }

    column DESCRIPTION (
        heading {
            heading: Description
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column PRODUCT_NAME (
