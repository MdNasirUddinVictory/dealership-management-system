)

lov lov-21-invoice (
    name: LOV_21_INVOICE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT O.ORDER_CODE
                   || ' - '
                   || TO_CHAR(O.ORDER_DATE,'DD-MON-YYYY') AS ORDER_CODE,
            
                   O.ORDER_NO,
            
                   O.CUSTOMER_NO,
            
                   C.CUSTOMER_NAME,
            
                   C.MOBILE_NO,
            
                   C.ADDRESS,
            
                   O.ORDER_DATE,
            
                   O.REMARKS,
            
                   NVL(
                       (
                           SELECT SUM(D.TOTAL_AMOUNT)
                             FROM TRN_SALES_ORDER_DTL D
                            WHERE D.ORDER_NO = O.ORDER_NO
                       ),
                       0
                   ) TOTAL_AMOUNT
            
            FROM TRN_SALES_ORDER_MST O
            JOIN MST_CUSTOMER C
              ON C.CUSTOMER_NO = O.CUSTOMER_NO
            
            WHERE EXISTS
            (
                SELECT 1
                  FROM TRN_SALES_ORDER_DTL D
                 WHERE D.ORDER_NO = O.ORDER_NO
                   AND NVL(D.BALANCE_QTY,0) > 0
            )
            OR O.ORDER_NO = :P21_ORDER_NO
            
            ORDER BY O.ORDER_NO DESC;
            ```
    }
    columnMapping {
        return: ORDER_NO
        display: ORDER_CODE
    }

    column ADDRESS (
        show: false
        heading {
            heading: Address
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

    column CUSTOMER_NAME (
