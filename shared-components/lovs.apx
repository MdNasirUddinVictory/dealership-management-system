            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column CUSTOMER_NO (
        show: false
        heading {
            heading: Customer No
        }
        layout {
            sequence: 30
        }
        source {
            dataType: number
        }
    )

    column MOBILE_NO (
        heading {
            heading: Mobile No
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column ORDER_CODE (
        heading {
            heading: Order Code
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column ORDER_DATE (
        show: false
        heading {
            heading: Order Date
        }
        layout {
            sequence: 70
        }
        source {
            dataType: date
        }
    )

    column ORDER_NO (
