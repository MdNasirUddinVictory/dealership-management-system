lov lov-302-voucher-list (
    name: LOV_302_VOUCHER_LIST
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
              SELECT    M.VOUCHER_CODE
                     || ' - '
                     || TO_CHAR (M.VOUCHER_DATE, 'DD-MON-YYYY')
                     || ' - '
                     || M.VOUCHER_TYPE    AS DISPLAY_VALUE,
                     M.VOUCHER_NO         AS RETURN_VALUE,
                     M.VOUCHER_CODE,
                     M.VOUCHER_DATE,
                     M.VOUCHER_TYPE,
                     M.NARRATION,
                     CASE M.APPROVAL_STATUS
                         WHEN 'A' THEN 'Approved'
                         WHEN 'P' THEN 'Pending'
                         WHEN 'R' THEN 'Rejected'
                         ELSE M.APPROVAL_STATUS
                     END                  AS STATUS
                FROM ACC_VOUCHER_MST M
               WHERE     (   :P302_FROM_DATE IS NULL
                          OR M.VOUCHER_DATE >= TO_DATE ( :P302_FROM_DATE, 'MM/DD/YYYY'))
                     AND (   :P302_TO_DATE IS NULL
                          OR M.VOUCHER_DATE < TO_DATE ( :P302_TO_DATE, 'MM/DD/YYYY') + 1)
                     AND (   :P302_VOUCHER_TYPE IS NULL
                          OR M.VOUCHER_TYPE = :P302_VOUCHER_TYPE)
            --   AND ( :P302_STATUS IS NULL OR M.APPROVAL_STATUS = :P302_STATUS)
            ORDER BY M.VOUCHER_DATE DESC, M.VOUCHER_NO DESC;
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }

    column DISPLAY_VALUE (
        heading {
            heading: Display Value
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column NARRATION (
        heading {
            heading: Narration
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

    column RETURN_VALUE (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column STATUS (
        heading {
            heading: Status
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column VOUCHER_CODE (
        heading {
            heading: Voucher Code
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column VOUCHER_DATE (
        heading {
            heading: Voucher Date
        }
        layout {
            sequence: 40
        }
        source {
            dataType: date
